@page "/table-with-search"
@using NovaAccounts.Components.Shared
@using NovaAccounts.Components.UsageModes
@using NovaAccounts.SharedModels.DataFields
@inject IJSRuntime JSRuntime

<h3>Transaction Management</h3>

<Validation 
    ButtonText="Process Invoice"
    IconClass="icon-wallet"
    ValidationUrl="/invoices/validate"
    RedirectUrl="/invoices/process"
    DialogTitle="Invoice Number"
    ParameterName="InvoiceNumber" />
<div class="mb-3">
    <ReusableSearchBox SearchValue="@transactionSearchTerm"
                       SearchValueChanged="@(value => transactionSearchTerm = value)"
                       OnSearchChanged="@HandleTransactionSearch"
                       Placeholder="Search transactions..."
                       TableId="customtransactionTable"
                       MaxWidth="500px"
                       ShowClearButton="true" />
</div>

<ReusableDataTable TItem="Transaction" 
                   Data="@transactions" 
                   Columns="@transactionColumns"
                   Options="@transactionOptions" />

<h3 class="mt-5">Employee Management</h3>

@* Custom Search Box for Employees *@
<div class="mb-3">
    <ReusableSearchBox SearchValue="@employeeSearchTerm"
                       SearchValueChanged="@(value => employeeSearchTerm = value)"
                       OnSearchChanged="@HandleEmployeeSearch"
                       Placeholder="Search employees by name, email, or department..."
                       TableId="customemployeeTable"
                       MaxWidth="600px"
                       BorderColor="#28a745"
                       FocusColor="#28a745"
                       HoverColor="#218838" />
</div>

<ReusableDataTable TItem="Employee" 
                   Data="@employees" 
                   Columns="@employeeColumns" 
                   Options="@employeeOptions" />

@* Example: Standalone Search (not linked to table) *@
<div class="mt-5">
    <h4>Standalone Search Example</h4>
    <ReusableSearchBox SearchValue="@standaloneSearch"
                       SearchValueChanged="@(value => standaloneSearch = value)"
                       OnSearchSubmit="@HandleStandaloneSearch"
                       Placeholder="Search anything..."
                       MaxWidth="400px"
                       ShowClearButton="true" />
    
    @if (!string.IsNullOrWhiteSpace(searchResult))
    {
        <div class="alert alert-info mt-3">
            <strong>Search Result:</strong> @searchResult
        </div>
    }
</div>

@code {
    private List<Transaction> transactions = new();
    private List<Employee> employees = new();
    private List<DataTableColumn> transactionColumns = new();
    private List<DataTableColumn> employeeColumns = new();
    private DataTableOptions transactionOptions = new();
    private DataTableOptions employeeOptions = new();

    // Search terms
    private string transactionSearchTerm = string.Empty;
    private string employeeSearchTerm = string.Empty;
    private string standaloneSearch = string.Empty;
    private string searchResult = string.Empty;

    protected override void OnInitialized()
    {
        LoadTransactionData();
        LoadEmployeeData();
        ConfigureTransactionTable();
        ConfigureEmployeeTable();
    }

    private void LoadTransactionData()
    {
        transactions = new List<Transaction>
        {
            new() { TransDate = DateTime.Now.AddDays(-1), Amount = 1250.00m, Status = "Completed", Reference = "TXN001234" },
            new() { TransDate = DateTime.Now.AddDays(-2), Amount = 750.50m, Status = "Pending", Reference = "TXN001235" },
            new() { TransDate = DateTime.Now.AddDays(-3), Amount = 2100.00m, Status = "Completed", Reference = "TXN001236" },
            new() { TransDate = DateTime.Now.AddDays(-4), Amount = 455.75m, Status = "Failed", Reference = "TXN001237" }
        };
    }

    private void LoadEmployeeData()
    {
        employees = new List<Employee>
        {
            new() { Id = 1, FirstName = "John", LastName = "Doe", Email = "john.doe@company.com", Department = "IT", Salary = 75000, HireDate = DateTime.Now.AddYears(-2), IsActive = true },
            new() { Id = 2, FirstName = "Jane", LastName = "Smith", Email = "jane.smith@company.com", Department = "HR", Salary = 65000, HireDate = DateTime.Now.AddYears(-1), IsActive = true },
            new() { Id = 3, FirstName = "Bob", LastName = "Johnson", Email = "bob.johnson@company.com", Department = "Finance", Salary = 80000, HireDate = DateTime.Now.AddYears(-3), IsActive = false },
            new() { Id = 4, FirstName = "Alice", LastName = "Brown", Email = "alice.brown@company.com", Department = "Marketing", Salary = 70000, HireDate = DateTime.Now.AddYears(-1), IsActive = true },
            new() { Id = 5, FirstName = "Charlie", LastName = "Wilson", Email = "charlie.wilson@company.com", Department = "Sales", Salary = 60000, HireDate = DateTime.Now.AddMonths(-6), IsActive = true },
            new() { Id = 6, FirstName = "Diana", LastName = "Davis", Email = "diana.davis@company.com", Department = "IT", Salary = 85000, HireDate = DateTime.Now.AddYears(-4), IsActive = true },
            new() { Id = 7, FirstName = "Eve", LastName = "Miller", Email = "eve.miller@company.com", Department = "HR", Salary = 68000, HireDate = DateTime.Now.AddYears(-2), IsActive = false },
            new() { Id = 8, FirstName = "Frank", LastName = "Garcia", Email = "frank.garcia@company.com", Department = "Finance", Salary = 90000, HireDate = DateTime.Now.AddYears(-5), IsActive = true },
            new() { Id = 9, FirstName = "Grace", LastName = "Lee", Email = "grace.lee@company.com", Department = "Marketing", Salary = 72000, HireDate = DateTime.Now.AddYears(-3), IsActive = true },
            new() { Id = 10, FirstName = "Henry", LastName = "Taylor", Email = "henry.taylor@company.com", Department = "Sales", Salary = 65000, HireDate = DateTime.Now.AddYears(-1), IsActive = false }
        };
    }

    private void ConfigureTransactionTable()
    {
        transactionColumns = new List<DataTableColumn>
        {
            new() { Header = "TRANS DATE", PropertyName = nameof(Transaction.TransDate), DataType = "date"},
            new() { 
                Header = "AMOUNT", 
                PropertyName = nameof(Transaction.Amount), 
                DataType = "currency",
                CustomRenderer = (item) => ((Transaction)item).Amount.ToString("C")
            },
            new() { 
                Header = "STATUS", 
                PropertyName = nameof(Transaction.Status), 
                Sortable = false,
                CustomRenderer = (item) => ((Transaction)item).StatusBadge
            },
            new() { Header = "REFERENCE", PropertyName = nameof(Transaction.Reference) },
            new() { 
                Header = "ACTION", 
                PropertyName = "", 
                Sortable = false, 
                Searchable = false,
                CustomRenderer = (item) => "<button class='btn btn-sm btn-outline-primary'>View</button>"
            }
        };

        transactionOptions = new DataTableOptions
        {
            PageLength = 10,
            SearchPlaceholder = "Search Transactions",
            TableId = "customtransactionTable",
            HeaderCssClass = "leadBold bg-blue-chambray font-white",
            RowCssClass = "lead font-blue-ebonyclay",
            Striped = true,
            AdditionalOptions = new Dictionary<string, object>
            {
                ["select"] = true,
                ["buttons"] = new[] { "copy", "csv", "excel", "pdf", "print", "colvis" },
                ["dom"] = "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6 text-end'Bf>>" +
                         "<'row'<'col-sm-12'tr>>" +
                         "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                ["order"] = new object[] { new object[] { 0, "desc" } }
                // NOTE: Do NOT set ["searching"] = false - we need searching enabled for custom search to work!
            }
        };
    }

    private void ConfigureEmployeeTable()
    {
        employeeColumns = new List<DataTableColumn>
        {
            new() { Header = "ID", PropertyName = nameof(Employee.Id), DataType = "number", Width = 80 },
            new() { 
                Header = "FULL NAME", 
                PropertyName = nameof(Employee.FullName),
                CustomRenderer = (item) => $"<strong>{((Employee)item).FullName}</strong>"
            },
            new() { Header = "EMAIL", PropertyName = nameof(Employee.Email) },
            new() { Header = "DEPARTMENT", PropertyName = nameof(Employee.Department) },
            new() { 
                Header = "SALARY", 
                PropertyName = nameof(Employee.Salary), 
                DataType = "currency",
                CustomRenderer = (item) => ((Employee)item).Salary.ToString("C")
            },
            new() { Header = "HIRE DATE", PropertyName = nameof(Employee.HireDate), DataType = "date" },
            new() { 
                Header = "STATUS", 
                PropertyName = nameof(Employee.IsActive),
                CustomRenderer = (item) => ((Employee)item).IsActive 
                    ? "<span class='badge badge-success'>Active</span>" 
                    : "<span class='badge badge-secondary'>Inactive</span>"
            }
        };

        employeeOptions = new DataTableOptions
        {
            PageLength = 5,
            LengthMenu = new[] { 5, 10, 20 },
            LengthMenuLabels = new[] { "5", "10", "20" },
            SearchPlaceholder = "Search Employees",
            TableId = "customemployeeTable",
            HeaderCssClass = "leadBold bg-blue-chambray font-white",
            RowCssClass = "lead font-blue-ebonyclay",
            Striped = true,
            AdditionalOptions = new Dictionary<string, object>
            {
                ["select"] = true,
                ["searching"] = true, // Disable built-in search since we're using custom search box
                ["language"] = new Dictionary<string, object>
                {
                    ["lengthMenu"] = "Show _MENU_ employees per page",
                    ["info"] = "Showing _START_ to _END_ of _TOTAL_ employees",
                    ["infoEmpty"] = "No employees found",
                    ["infoFiltered"] = "(filtered from _MAX_ total employees)",
                    ["emptyTable"] = "No employee data available",
                    ["zeroRecords"] = "No matching employees found"
                }
            }
        };
    }

    // Search event handlers
    private async Task HandleTransactionSearch(string searchTerm)
    {
        await JSRuntime.InvokeVoidAsync("triggerDataTableSearch", "customtransactionTable", searchTerm);
        Console.WriteLine($"Transaction search: {searchTerm}");
    }

    private async Task HandleEmployeeSearch(string searchTerm)
    {
        await JSRuntime.InvokeVoidAsync("triggerDataTableSearch", "customemployeeTable", searchTerm);
        Console.WriteLine($"Employee search: {searchTerm}");
    }

    private Task HandleStandaloneSearch(string searchTerm)
    {
        searchResult = $"You searched for: '{searchTerm}'";
        StateHasChanged();
        return Task.CompletedTask;
    }
}