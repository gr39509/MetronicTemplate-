            await Task.Delay(1000); // Simulate API call
            
            // Remove processed transactions from the list
            tempTransactions = tempTransactions.Where(t => !selectedTransactions.Contains(t.Id)).ToList();
            
            successMessage = $"Successfully processed {selectedTransactions.Count} transaction(s)";
            selectedTransactions.Clear();
            ApplyFilters();
            CalculateStatistics();
            
            Console.WriteLine($"✅ Processed {selectedTransactions.Count} transactions");
