    private async Task ExportToExcel()
    {
        try
        {
            var csvContent = "Transaction Date,Account Number,Account Name,Transaction Type,Amount,Reference,Status,User ID,Voucher Number,Batch Number\n";
            
            foreach (var transaction in filteredTransactions.OrderByDescending(t => t.TransactionDate))
            {
                csvContent += $"\"{transaction.TransactionDate:yyyy-MM-dd HH:mm}\",";
                csvContent += $"\"{transaction.AccountNumber}\",";
                csvContent += $"\"{transaction.AccountName}\",";
                csvContent += $"\"{transaction.TransType}\",";
                csvContent += $"\"{transaction.TransAmount:N2}\",";
                csvContent += $"\"{transaction.TransRef}\",";
                csvContent += $"\"{transaction.Status}\",";
                csvContent += $"\"{transaction.UserID}\",";
                csvContent += $"\"{transaction.VoucherNumber}\",";
                csvContent += $"\"{transaction.BatchNumber}\"\n";
            }

            var fileName = $"TempTransactions_{DateTime.Now:yyyyMMddHHmmss}.csv";
            await JSRuntime.InvokeVoidAsync("downloadCsv", csvContent, fileName);
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to export data: " + ex.Message;
            StateHasChanged();
        }
    }

