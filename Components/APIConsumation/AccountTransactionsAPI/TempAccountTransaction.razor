    private void CalculateStatistics()
    {
        totalAmount = tempTransactions.Sum(t => t.TransAmount);
        uniqueAccounts = tempTransactions.Select(t => t.AccountNumber).Distinct().Count();
        uniqueUsers = tempTransactions.Select(t => t.UserID).Distinct().Count();
    }

    private void ResetStatistics()
    {
        totalAmount = 0;
        uniqueAccounts = 0;
        uniqueUsers = 0;
    }

    private string GetTransactionTypeBadgeClass(string transType)
    {
        return transType?.ToLower() switch
        {
            "deposit" or "credit" => "bg-success",
            "withdrawal" or "debit" => "bg-danger",
            "transfer" => "bg-info",
            "payment" => "bg-primary",
            "fee" => "bg-warning",
            _ => "bg-secondary"
        };
    }

    private string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "approved" => "bg-success",
            "pending" => "bg-warning",
            "rejected" => "bg-danger",
            "processing" => "bg-info",
            _ => "bg-secondary"
        };
    }

