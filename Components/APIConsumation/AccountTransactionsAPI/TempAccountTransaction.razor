<script>
    // Make the DotNet reference available globally
    window.dotNetReference = null;

    // Set the DotNet reference when the component is initialized
    window.setDotNetReference = (reference) => {
        window.dotNetReference = reference;
    };

    window.toggleTransactionSelection = function(transactionId, isSelected) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('ToggleTransactionSelection', transactionId, isSelected)
                .catch(err => {
                    console.error('Error calling ToggleTransactionSelection:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    window.viewTransactionDetails = function(transactionId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('ViewTransactionDetails', transactionId)
                .catch(err => {
                    console.error('Error calling ViewTransactionDetails:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    window.processTransaction = function(transactionId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('ProcessTransaction', transactionId)
                .catch(err => {
                    console.error('Error calling ProcessTransaction:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    function downloadCsv(content, fileName) {
        const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);
        
        link.setAttribute('href', url);
        link.setAttribute('download', fileName);
        link.style.visibility = 'hidden';
        
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    // Initialize DotNet reference when the page loads
    document.addEventListener('DOMContentLoaded', function() {
        // This will be set by the Blazor component
    });
</script>