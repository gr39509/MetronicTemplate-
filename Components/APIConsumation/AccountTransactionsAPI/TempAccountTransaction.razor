@page "/temp-transactions"
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.DataFields
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime

<div class="container mt-4">
    <h1 class="page-title">
        Temporary Transactions
        <small>View and manage temporary transaction records</small>
    </h1>

    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-docs font-dark"></i>
                <span class="caption-subject bold uppercase">Temporary Transactions</span>
            </div>
            <div class="actions">
                <button class="btn btn-circle btn-icon-only btn-default" @onclick="LoadTempTransactions" title="Refresh">
                    <i class="fa fa-refresh"></i>
                </button>
            </div>
        </div>
        <div class="portlet-body">
            <!-- Statistics Cards -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-warning text-white">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">@tempTransactions.Count</h4>
                                    <small>Total Temp Records</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="fa fa-files-o fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">$@totalAmount.ToString("N2")</h4>
                                    <small>Total Amount</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="fa fa-money fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">@uniqueAccounts</h4>
                                    <small>Unique Accounts</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="fa fa-users fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">@uniqueUsers</h4>
                                    <small>Initiated By</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="fa fa-user fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filter Section -->
            <div class="row mb-3">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="fa fa-filter me-2"></i>
                                Filters
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="form-label">Account Number</label>
                                        <input type="text" class="form-control" @bind="filterAccountNumber" placeholder="Filter by account..." />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="form-label">Transaction Type</label>
                                        <select class="form-select" @bind="filterTransactionType">
                                            <option value="">All Types</option>
                                            <option value="Deposit">Deposit</option>
                                            <option value="Withdrawal">Withdrawal</option>
                                            <option value="Transfer">Transfer</option>
                                            <option value="Payment">Payment</option>
                                            <option value="Fee">Fee</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="form-label">User ID</label>
                                        <input type="text" class="form-control" @bind="filterUserId" placeholder="Filter by user..." />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="form-label">Status</label>
                                        <select class="form-select" @bind="filterStatus">
                                            <option value="">All Status</option>
                                            <option value="Pending">Pending</option>
                                            <option value="Approved">Approved</option>
                                            <option value="Rejected">Rejected</option>
                                            <option value="Processing">Processing</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-12">
                                    <button class="btn btn-info me-2" @onclick="ApplyFilters">
                                        <i class="fa fa-search"></i> Apply Filters
                                    </button>
                                    <button class="btn btn-secondary" @onclick="ClearFilters">
                                        <i class="fa fa-times"></i> Clear Filters
                                    </button>
                                    <button class="btn btn-success" @onclick="ExportToExcel" disabled="@(!filteredTransactions.Any())">
                                        <i class="fa fa-download"></i> Export Excel
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="row mb-3">
                <div class="col-12">
                    <div class="btn-group">
                        <button type="button" class="btn btn-success" @onclick="ProcessSelected" disabled="@(!selectedTransactions.Any() || isProcessing)">
                            <i class="fa fa-cog"></i> Process Selected (@selectedTransactions.Count)
                        </button>
                        <button type="button" class="btn btn-danger" @onclick="DeleteSelected" disabled="@(!selectedTransactions.Any() || isProcessing)">
                            <i class="fa fa-trash"></i> Delete Selected
                        </button>
                        <button type="button" class="btn btn-info" @onclick="SelectAll" disabled="@(!filteredTransactions.Any())">
                            <i class="fa fa-check-square"></i> Select All
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="ClearSelection" disabled="@(!selectedTransactions.Any())">
                            <i class="fa fa-square-o"></i> Clear Selection
                        </button>
                    </div>
                </div>
            </div>

            <!-- Processing Overlay -->
            @if (isProcessing)
            {
                <div class="alert alert-info text-center">
                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                    Processing... Please wait
                </div>
            }

            <!-- Results Section -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-danger alert-dismissible">
                            <button type="button" class="close" @onclick="ClearErrorMessage">
                                <span>&times;</span>
                            </button>
                            <strong>Error!</strong> @errorMessage
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-success alert-dismissible">
                            <button type="button" class="close" @onclick="ClearSuccessMessage">
                                <span>&times;</span>
                            </button>
                            <strong>Success!</strong> @successMessage
                        </div>
                    </div>
                </div>
            }

            @if (filteredTransactions?.Any() == true)
            {
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-warning text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-list-alt me-2"></i>
                                    Temporary Transactions
                                    <span class="badge bg-light text-dark ms-2">@filteredTransactions.Count records</span>
                                    @if (!string.IsNullOrEmpty(filterAccountNumber))
                                    {
                                        <span class="badge bg-info ms-2">Account: @filterAccountNumber</span>
                                    }
                                    @if (!string.IsNullOrEmpty(filterTransactionType))
                                    {
                                        <span class="badge bg-info ms-2">Type: @filterTransactionType</span>
                                    }
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <ReusableDataTable TItem="AccountTransactionViewModel"
                                                 Data="@filteredTransactions"
                                                 Columns="@transactionColumns"
                                                 Options="@transactionOptions"
                                                 OnRowClick="@OnTransactionRowClick" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Transaction Details Modal -->
                @if (showTransactionModal && selectedTransaction != null)
                {
                    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header bg-primary text-white">
                                    <h5 class="modal-title">
                                        <i class="fa fa-info-circle me-2"></i>
                                        Transaction Details - @selectedTransaction.TransRef
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" @onclick="CloseTransactionModal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="detail-group">
                                                <span class="detail-label">Transaction ID</span>
                                                <span class="detail-value">@selectedTransaction.Id</span>
                                            </div>
                                            <div class="detail-group">
                                                <span class="detail-label">Account Number</span>
                                                <span class="detail-value"><code>@selectedTransaction.AccountNumber</code></span>
                                            </div>
                                            <div class="detail-group">
                                                <span class="detail-label">Account Name</span>
                                                <span class="detail-value">@selectedTransaction.AccountName</span>
                                            </div>
                                            <div class="detail-group">
                                                <span class="detail-label">Account Type</span>
                                                <span class="detail-value"><span class="badge bg-info">@selectedTransaction.AccountType</span></span>
                                            </div>
                                            <div class="detail-group">
                                                <span class="detail-label">Transaction Type</span>
                                                <span class="detail-value">
                                                    <span class="badge @GetTransactionTypeBadgeClass(selectedTransaction.TransType)">@selectedTransaction.TransType</span>
                                                </span>
                                            </div>
                                            <div class="detail-group">
                                                <span class="detail-label">Amount</span>
                                                <span class="detail-value">
                                                    <span class="@(selectedTransaction.TransAmount >= 0 ? "text-success" : "text-danger") fw-bold">
                                                        $@selectedTransaction.TransAmount.ToString("N2")
                                                    </span>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="detail-group">
                                                <span class="detail-label">Reference</span>
                                                <span class="detail-value"><code>@selectedTransaction.TransRef</code></span>
                                            </div>
                                            <div class="detail-group">
                                                <span class="detail-label">Voucher Number</span>
                                                <span class="detail-value">@selectedTransaction.VoucherNumber</span>
                                            </div>
                                            <div class="detail-group">
                                                <span class="detail-label">Batch Number</span>
                                                <span class="detail-value">@selectedTransaction.BatchNumber</span>
                                            </div>
                                            <div class="detail-group">
                                                <span class="detail-label">Transaction Date</span>
                                                <span class="detail-value">@selectedTransaction.TransactionDate.ToString("dd MMM yyyy HH:mm")</span>
                                            </div>
                                            <div class="detail-group">
                                                <span class="detail-label">Entry Timestamp</span>
                                                <span class="detail-value">@selectedTransaction.EntryTimestamp.ToString("dd MMM yyyy HH:mm")</span>
                                            </div>
                                            <div class="detail-group">
                                                <span class="detail-label">Initiated By</span>
                                                <span class="detail-value"><code>@selectedTransaction.UserID</code></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <div class="detail-group">
                                                <span class="detail-label">Description</span>
                                                <span class="detail-value">@selectedTransaction.TransNarration</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <div class="detail-group">
                                                <span class="detail-label">Status</span>
                                                <span class="detail-value">
                                                    <span class="badge @GetStatusBadgeClass(selectedTransaction.Status)">@selectedTransaction.Status</span>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="detail-group">
                                                <span class="detail-label">Approved By</span>
                                                <span class="detail-value">
                                                    @if (string.IsNullOrEmpty(selectedTransaction.UserApproved))
                                                    {
                                                        <span class="text-muted">Not approved</span>
                                                    }
                                                    else
                                                    {
                                                        <code>@selectedTransaction.UserApproved</code>
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <div class="card">
                                                <div class="card-header bg-light">
                                                    <h6 class="mb-0">Additional Information</h6>
                                                </div>
                                                <div class="card-body">
                                                    <div class="row">
                                                        <div class="col-md-4">
                                                            <small class="text-muted">Client Product</small>
                                                            <div>@selectedTransaction.ClientProduct</div>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <small class="text-muted">Currency</small>
                                                            <div><span class="badge bg-secondary">@selectedTransaction.Currency</span></div>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <small class="text-muted">Exchange Rate</small>
                                                            <div>@selectedTransaction.ExRate.ToString("N4")</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" @onclick="CloseTransactionModal">Close</button>
                                    @* <button type="button" class="btn btn-success" @onclick="ProcessTransaction" disabled="@(selectedTransaction.Status == "Approved")"> *@
                                    @*     <i class="fa fa-check"></i> Process *@
                                    @* </button> *@
                                    <button type="button" class="btn btn-danger" @onclick="DeleteTransaction">
                                        <i class="fa fa-trash"></i> Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (hasLoaded && !isLoading)
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-success text-center">
                            <i class="fa fa-check-circle fa-2x mb-3"></i>
                            <h5>No Temporary Transactions</h5>
                            <p class="mb-0">No temporary transaction records found.</p>
                        </div>
                    </div>
                </div>
            }

            <!-- Loading State -->
            @if (isLoading)
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-info text-center">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                            Loading temporary transactions...
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<AccountTransactionViewModel> tempTransactions = new();
    private List<AccountTransactionViewModel> filteredTransactions = new();
    private List<DataTableColumn> transactionColumns = new();
    private DataTableOptions transactionOptions = new();
    private HashSet<int> selectedTransactions = new();
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool hasLoaded = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    
    // Filter fields
    private string filterAccountNumber = "";
    private string filterTransactionType = "";
    private string filterUserId = "";
    private string filterStatus = "";
    
    // Modal fields
    private bool showTransactionModal = false;
    private AccountTransactionViewModel selectedTransaction = null;
    
    // Statistics
    private double totalAmount = 0;
    private int uniqueAccounts = 0;
    private int uniqueUsers = 0;

    protected override async Task OnInitializedAsync()
    {
        ConfigureTransactionTable();
        await LoadTempTransactions();
    }

    private void ConfigureTransactionTable()
    {
        transactionColumns = new List<DataTableColumn>
        {
            new()
            {
                Header = "SELECT",
                PropertyName = "",
                Sortable = false,
                Searchable = false,
                Width = 50,
                CssClass = "text-center",
                CustomRenderer = (item) =>
                {
                    var transaction = (AccountTransactionViewModel)item;
                    var isChecked = selectedTransactions.Contains(transaction.Id);
                    return $"<input type='checkbox' class='form-check-input' {(isChecked ? "checked" : "")} onchange='toggleTransactionSelection({transaction.Id}, this.checked)'>";
                }
            },
            new()
            {
                Header = "TRANSACTION DATE",
                PropertyName = nameof(AccountTransactionViewModel.TransactionDate),
                Width = 150,
                CustomRenderer = (item) =>
                {
                    var date = ((AccountTransactionViewModel)item).TransactionDate;
                    return $"<small>{date:dd MMM yyyy HH:mm}</small>";
                }
            },
            new()
            {
                Header = "ACCOUNT NUMBER",
                PropertyName = nameof(AccountTransactionViewModel.AccountNumber),
                Width = 130,
                CustomRenderer = (item) =>
                {
                    var account = ((AccountTransactionViewModel)item).AccountNumber;
                    return string.IsNullOrEmpty(account)
                        ? "<span class='text-muted'>N/A</span>"
                        : $"<code>{account}</code>";
                }
            },
            new()
            {
                Header = "ACCOUNT NAME",
                PropertyName = nameof(AccountTransactionViewModel.AccountName),
                Width = 150,
                CustomRenderer = (item) =>
                {
                    var name = ((AccountTransactionViewModel)item).AccountName;
                    return string.IsNullOrEmpty(name)
                        ? "<span class='text-muted'>N/A</span>"
                        : $"<strong>{name}</strong>";
                }
            },
            new()
            {
                Header = "TRANSACTION TYPE",
                PropertyName = nameof(AccountTransactionViewModel.TransType),
                Width = 120,
                CustomRenderer = (item) =>
                {
                    var type = ((AccountTransactionViewModel)item).TransType;
                    return $"<span class='badge {GetTransactionTypeBadgeClass(type)}'>{type}</span>";
                }
            },
            new()
            {
                Header = "AMOUNT",
                PropertyName = nameof(AccountTransactionViewModel.TransAmount),
                Width = 120,
                CustomRenderer = (item) =>
                {
                    var amount = ((AccountTransactionViewModel)item).TransAmount;
                    var amountClass = amount >= 0 ? "text-success" : "text-danger";
                    var symbol = amount >= 0 ? "" : "-";
                    return $"<span class='{amountClass} fw-bold'>{symbol}${Math.Abs(amount):N2}</span>";
                }
            },
            new()
            {
                Header = "REFERENCE",
                PropertyName = nameof(AccountTransactionViewModel.TransRef),
                Width = 120,
                CustomRenderer = (item) =>
                {
                    var reference = ((AccountTransactionViewModel)item).TransRef;
                    return string.IsNullOrEmpty(reference)
                        ? "<span class='text-muted'>N/A</span>"
                        : $"<code class='small'>{reference}</code>";
                }
            },
            new()
            {
                Header = "STATUS",
                PropertyName = nameof(AccountTransactionViewModel.Status),
                Width = 100,
                CustomRenderer = (item) =>
                {
                    var status = ((AccountTransactionViewModel)item).Status;
                    return $"<span class='badge {GetStatusBadgeClass(status)}'>{status}</span>";
                }
            },
            new()
            {
                Header = "INITIATED BY",
                PropertyName = nameof(AccountTransactionViewModel.UserID),
                Width = 120,
                CustomRenderer = (item) =>
                {
                    var user = ((AccountTransactionViewModel)item).UserID;
                    return string.IsNullOrEmpty(user)
                        ? "<span class='text-muted'>System</span>"
                        : $"<code>{user}</code>";
                }
            },
            new()
            {
                Header = "ACTIONS",
                PropertyName = "",
                Sortable = false,
                Searchable = false,
                Width = 100,
                CssClass = "text-center",
                CustomRenderer = (item) => 
                {
                    var transaction = (AccountTransactionViewModel)item;
                    return $@"
                        <div class='btn-group btn-group-sm' role='group'>
                            <button type='button' class='btn btn-info btn-xs' onclick='viewTransactionDetails({transaction.Id})' title='View Details'>
                                <i class='fa fa-eye'></i>
                            </button>
                            <button type='button' class='btn btn-success btn-xs' onclick='processTransaction({transaction.Id})' title='Process'>
                                <i class='fa fa-cog'></i>
                            </button>
                        </div>";
                }
            }
        };

        transactionOptions = new DataTableOptions
        {
            PageLength = 20,
            LengthMenu = new[] { 20, 50, 100 },
            LengthMenuLabels = new[] { "20", "50", "100" },
            SearchPlaceholder = "Search temporary transactions...",
            TableId = "tempTransactionsTable",
            TableCssClass = "table table-striped table-bordered table-hover mb-0",
            HeaderCssClass = "leadBold bg-yellow-gold font-white",
            RowCssClass = "",
            ShowSearch = true,
            ShowPaging = true,
            ShowInfo = true,
            ShowLengthMenu = true,
            Responsive = true,
            AdditionalOptions = new Dictionary<string, object>
            {
                ["order"] = new object[] { new object[] { 1, "desc" } }, // Default sort by transaction date (newest first)
                ["language"] = new Dictionary<string, object>
                {
                    ["search"] = "Search temporary transactions:",
                    ["lengthMenu"] = "Show _MENU_ records per page",
                    ["info"] = "Showing _START_ to _END_ of _TOTAL_ temporary transactions",
                    ["infoEmpty"] = "No temporary transactions found",
                    ["infoFiltered"] = "(filtered from _MAX_ total records)",
                    ["emptyTable"] = "No temporary transaction data available",
                    ["zeroRecords"] = "No matching temporary transactions found"
                }
            }
        };
    }

    private async Task LoadTempTransactions()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;
            StateHasChanged();

            Console.WriteLine($"🔍 Loading temporary transactions...");

            var result = await ApiClient.GetTempAccountTransactionsAsync(
                bP_Tenant: null,
                accept_Language: null
            );

            if (result?.Payload != null)
            {
                tempTransactions = result.Payload.ToList();
                ApplyFilters(); // Apply initial filters
                CalculateStatistics();
                Console.WriteLine($"✅ Found {tempTransactions.Count} temporary transaction records");
            }
            else
            {
                tempTransactions = new List<AccountTransactionViewModel>();
                filteredTransactions = new List<AccountTransactionViewModel>();
                ResetStatistics();
                Console.WriteLine($"ℹ️ No temporary transaction records found");
            }
            
            hasLoaded = true;
        }
        catch (ApiException<ApiErrorResponse> apiEx)
        {
            errorMessage = apiEx.Result?.ErrorMessage ?? "Failed to load temporary transactions.";
            Console.WriteLine($"❌ API Error loading temporary transactions: {apiEx.Message}");
            tempTransactions = new List<AccountTransactionViewModel>();
            filteredTransactions = new List<AccountTransactionViewModel>();
            ResetStatistics();
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}). Please try again.";
            Console.WriteLine($"❌ API Exception: {ex.Message}");
            tempTransactions = new List<AccountTransactionViewModel>();
            filteredTransactions = new List<AccountTransactionViewModel>();
            ResetStatistics();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load temporary transactions. Please check your connection.";
            Console.WriteLine($"❌ Error loading temporary transactions: {ex.Message}");
            tempTransactions = new List<AccountTransactionViewModel>();
            filteredTransactions = new List<AccountTransactionViewModel>();
            ResetStatistics();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        filteredTransactions = tempTransactions;

        if (!string.IsNullOrEmpty(filterAccountNumber))
        {
            filteredTransactions = filteredTransactions.Where(t => 
                t.AccountNumber?.Contains(filterAccountNumber, StringComparison.OrdinalIgnoreCase) == true).ToList();
        }

        if (!string.IsNullOrEmpty(filterTransactionType))
        {
            filteredTransactions = filteredTransactions.Where(t => 
                t.TransType?.Equals(filterTransactionType, StringComparison.OrdinalIgnoreCase) == true).ToList();
        }

        if (!string.IsNullOrEmpty(filterUserId))
        {
            filteredTransactions = filteredTransactions.Where(t => 
                t.UserID?.Contains(filterUserId, StringComparison.OrdinalIgnoreCase) == true).ToList();
        }

        if (!string.IsNullOrEmpty(filterStatus))
        {
            filteredTransactions = filteredTransactions.Where(t => 
                t.Status?.Equals(filterStatus, StringComparison.OrdinalIgnoreCase) == true).ToList();
        }

        StateHasChanged();
    }

    private void ClearFilters()
