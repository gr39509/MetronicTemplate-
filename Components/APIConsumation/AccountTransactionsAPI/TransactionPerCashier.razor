@page "/cashier-transactions"
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.DataFields
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime

<div class="container mt-4">
    <h1 class="page-title">
        Cashier Transactions
        <small>Search transactions by cashier ID and date range</small>
    </h1>

    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-wallet font-dark"></i>
                <span class="caption-subject bold uppercase">Search Cashier Transactions</span>
            </div>
        </div>
        <div class="portlet-body">
            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="form-horizontal">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Start Date</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                                        <input type="date" class="form-control" @bind="startDate" @bind:format="yyyy-MM-dd" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">End Date</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                                        <input type="date" class="form-control" @bind="endDate" @bind:format="yyyy-MM-dd" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group row mb-4">
                            <label class="col-md-3 col-form-label text-md-right">Cashier ID</label>
                            <div class="col-md-9">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa fa-id-card"></i></span>
                                    <input type="text" class="form-control" @bind="cashierID" placeholder="Enter cashier ID" />
                                </div>
                                <small class="form-text text-muted">Enter the cashier's unique identifier</small>
                            </div>
                        </div>
                        
                        <div class="form-group row">
                            <div class="col-md-3"></div>
                            <div class="col-md-9">
                                <button type="button" class="btn btn-info text-white" @onclick="SearchTransactions" disabled="@isLoading">
                                    <i class="fa fa-search"></i>
                                    @if (isLoading)
                                    {
                                        <span>Searching...</span>
                                    }
                                    else
                                    {
                                        <span style="padding-left: 10px;">Search Transactions</span>
                                    }
                                </button>
                                @if (transactions?.Any() == true)
                                {
                                    <button type="button" class="btn btn-secondary ms-2" @onclick="ClearSearch">
                                        <i class="fa fa-times"></i> Clear
                                    </button>
                                    <button type="button" class="btn btn-success ms-2" @onclick="ExportToExcel">
                                        <i class="fa fa-download"></i> Export Excel
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Date Validation Warning -->
            @if (hasDateValidationError)
            {
                <div class="row justify-content-center mt-3">
                    <div class="col-md-10">
                        <div class="alert alert-warning">
                            <i class="fa fa-exclamation-triangle"></i>
                            <strong>Date Range Warning:</strong> End date should be greater than or equal to start date.
                        </div>
                    </div>
                </div>
            }

            <!-- Results Section -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-10">
                        <div class="alert alert-danger alert-dismissible">
                            <button type="button" class="close" @onclick="@(() => errorMessage = string.Empty)">
                                <span>&times;</span>
                            </button>
                            <strong>Error!</strong> @errorMessage
                        </div>
                    </div>
                </div>
            }

            @if (transactions?.Any() == true)
            {
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-list-alt me-2"></i>
                                    Cashier Transactions
                                    <span class="badge bg-light text-dark ms-2">@transactions.Count records found</span>
                                    @if (!string.IsNullOrEmpty(cashierID))
                                    {
                                        <small class="ms-3">Cashier: @cashierID</small>
                                    }
                                    <small class="ms-3">
                                        Period: @startDate.ToString("dd MMM yyyy") - @endDate.ToString("dd MMM yyyy")
                                    </small>
                                </h5>
                            </div>
                            <br/>
                            <div class="card-body p-0">
                                <ReusableDataTable TItem="TransactionsView"
                                                 Data="@transactions"
                                                 Columns="@transactionColumns"
                                                 Options="@transactionOptions"
                                                 OnRowClick="@OnTransactionRowClick" />
                            </div>
                            
                            <!-- Summary Section -->
                            <div class="card-footer">
                                <div class="row text-center">
                                    <div class="col-md-2">
                                        <small class="text-muted">Total Records</small>
                                        <h5 class="mb-0">@transactions.Count</h5>
                                    </div>
                                    <div class="col-md-2">
                                        <small class="text-muted">Total Amount</small>
                                        <h5 class="mb-0 text-primary">@totalAmount.ToString("N2")</h5>
                                    </div>
                                    <div class="col-md-2">
                                        <small class="text-muted">Transaction Types</small>
                                        <h5 class="mb-0 text-info">@transactions.Select(x => x.TransactionType).Distinct().Count()</h5>
                                    </div>
                                    <div class="col-md-2">
                                        <small class="text-muted">Unique Accounts</small>
                                        <h5 class="mb-0 text-warning">@transactions.Select(x => x.AccountNumber).Distinct().Count()</h5>
                                    </div>
                                    <div class="col-md-2">
                                        <small class="text-muted">Latest Transaction</small>
                                        <h5 class="mb-0 text-success">@transactions.Max(x => x.TransactionDate).ToString("dd MMM HH:mm")</h5>
                                    </div>
                                    <div class="col-md-2">
                                        <small class="text-muted">Average Amount</small>
                                        <h5 class="mb-0 text-info">@averageAmount.ToString("N2")</h5>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (hasSearched && !isLoading)
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-10">
                        <div class="alert alert-info text-center">
                            <i class="fa fa-info-circle fa-2x mb-3"></i>
                            <h5>No Transactions Found</h5>
                            <p class="mb-0">
                                No transactions found 
                                @if (!string.IsNullOrEmpty(cashierID))
                                {
                                    <text>for cashier: <strong>@cashierID</strong><br /></text>
                                }
                                Period: <strong>@startDate.ToString("dd MMM yyyy") - @endDate.ToString("dd MMM yyyy")</strong>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private DateTime startDate = DateTime.Today.AddDays(-7); // Default to last 7 days
    private DateTime endDate = DateTime.Today;
    private string cashierID = string.Empty;
    private List<TransactionsView> transactions = new();
    private List<DataTableColumn> transactionColumns = new();
    private DataTableOptions transactionOptions = new();
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private bool hasSearched = false;
    private bool hasDateValidationError = false;
    private double totalAmount = 0;
    private double averageAmount = 0;

    protected override void OnInitialized()
    {
        ConfigureTransactionTable();
    }

    private void ConfigureTransactionTable()
    {
        transactionColumns = new List<DataTableColumn>
        {
            new()
            {
                Header = "TRANSACTION DATE",
                PropertyName = nameof(TransactionsView.TransactionDate),
                Width = 150,
                CustomRenderer = (item) =>
                {
                    var date = ((TransactionsView)item).TransactionDate;
                    return $"<small>{date:dd MMM yyyy HH:mm}</small>";
                }
            },
            new()
            {
                Header = "ACCOUNT NUMBER",
                PropertyName = nameof(TransactionsView.AccountNumber),
                Width = 130,
                CustomRenderer = (item) =>
                {
                    var account = ((TransactionsView)item).AccountNumber;
                    return string.IsNullOrEmpty(account)
                        ? "<span class='text-muted'>N/A</span>"
                        : $"<code>{account}</code>";
                }
            },
            new()
            {
                Header = "ACCOUNT NAME",
                PropertyName = nameof(TransactionsView.AccountName),
                Width = 150,
                CustomRenderer = (item) =>
                {
                    var name = ((TransactionsView)item).AccountName;
                    return string.IsNullOrEmpty(name)
                        ? "<span class='text-muted'>N/A</span>"
                        : $"<strong>{name}</strong>";
                }
            },
            new()
            {
                Header = "TYPE",
                PropertyName = nameof(TransactionsView.TransactionType),
                Width = 100,
                CustomRenderer = (item) =>
                {
                    var type = ((TransactionsView)item).TransactionType;
                    var badgeClass = type?.ToLower() switch
                    {
                        "deposit" or "credit" => "bg-success",
                        "withdrawal" or "debit" => "bg-danger",
                        "transfer" => "bg-info",
                        "payment" => "bg-primary",
                        "fee" => "bg-warning",
                        _ => "bg-secondary"
                    };
                    return string.IsNullOrEmpty(type)
                        ? "<span class='text-muted'>N/A</span>"
                        : $"<span class='badge {badgeClass}'>{type}</span>";
                }
            },
            new()
            {
                Header = "AMOUNT",
                PropertyName = nameof(TransactionsView.TransAmount),
                Width = 120,
                CustomRenderer = (item) =>
                {
                    var amount = ((TransactionsView)item).TransAmount;
                    var amountClass = amount >= 0 ? "text-success" : "text-danger";
                    var symbol = amount >= 0 ? "" : "-";
                    return $"<span class='{amountClass} fw-bold'>{symbol}${Math.Abs(amount):N2}</span>";
                }
            },
            new()
            {
                Header = "DESCRIPTION",
                PropertyName = nameof(TransactionsView.TransNarration),
                CustomRenderer = (item) =>
                {
                    var narration = ((TransactionsView)item).TransNarration;
                    return string.IsNullOrEmpty(narration)
                        ? "<span class='text-muted'>No description</span>"
                        : $"<div class='text-truncate' style='max-width: 250px;' title='{narration}'>{narration}</div>";
                }
            },
            new()
            {
                Header = "REFERENCE",
                PropertyName = nameof(TransactionsView.TransRef),
                Width = 120,
                CustomRenderer = (item) =>
                {
                    var reference = ((TransactionsView)item).TransRef;
                    return string.IsNullOrEmpty(reference)
                        ? "<span class='text-muted'>N/A</span>"
                        : $"<code class='small'>{reference}</code>";
                }
            },
            new()
            {
                Header = "STATUS",
                PropertyName = nameof(TransactionsView.Status),
                Width = 100,
                CustomRenderer = (item) =>
                {
                    var status = ((TransactionsView)item).Status;
                    var badgeClass = status?.ToLower() switch
                    {
                        "completed" or "success" => "bg-success",
                        "pending" => "bg-warning",
                        "failed" or "rejected" => "bg-danger",
                        "processing" => "bg-info",
                        _ => "bg-secondary"
                    };
                    return string.IsNullOrEmpty(status)
                        ? "<span class='text-muted'>N/A</span>"
                        : $"<span class='badge {badgeClass}'>{status}</span>";
                }
            },
            new()
            {
                Header = "BATCH",
                PropertyName = nameof(TransactionsView.BatchNumber),
                Width = 100,
                CustomRenderer = (item) =>
                {
                    var batch = ((TransactionsView)item).BatchNumber;
                    return string.IsNullOrEmpty(batch)
                        ? "<span class='text-muted'>N/A</span>"
                        : $"<small>{batch}</small>";
                }
            },
            new()
            {
                Header = "BRANCH",
                PropertyName = nameof(TransactionsView.BranchCode),
                Width = 100,
                CustomRenderer = (item) =>
                {
                    var branch = ((TransactionsView)item).BranchCode;
                    return string.IsNullOrEmpty(branch)
                        ? "<span class='text-muted'>N/A</span>"
                        : $"<code>{branch}</code>";
                }
            }
        };

        transactionOptions = new DataTableOptions
        {
            PageLength = 20,
            LengthMenu = new[] { 20, 50, 100, 200 },
            LengthMenuLabels = new[] { "20", "50", "100", "200" },
            SearchPlaceholder = "Search transactions...",
            TableId = "transactionsTable",
            TableCssClass = "table table-striped table-bordered table-hover mb-0",
            HeaderCssClass = "leadBold bg-green-jungle font-white",
            RowCssClass = "",
            ShowSearch = true,
            ShowPaging = true,
            ShowInfo = true,
            ShowLengthMenu = true,
            Responsive = true,
            AdditionalOptions = new Dictionary<string, object>
            {
                ["order"] = new object[] { new object[] { 0, "desc" } }, // Default sort by transaction date (newest first)
                ["language"] = new Dictionary<string, object>
                {
                    ["search"] = "Search transactions:",
                    ["lengthMenu"] = "Show _MENU_ records per page",
                    ["info"] = "Showing _START_ to _END_ of _TOTAL_ transactions",
                    ["infoEmpty"] = "No transactions found",
                    ["infoFiltered"] = "(filtered from _MAX_ total records)",
                    ["emptyTable"] = "No transaction data available",
                    ["zeroRecords"] = "No matching transactions found"
                }
            }
        };
    }

    private async Task SearchTransactions()
    {
        // Validate inputs
        if (endDate < startDate)
        {
            hasDateValidationError = true;
            errorMessage = "End date cannot be earlier than start date.";
            return;
        }

        if (string.IsNullOrWhiteSpace(cashierID))
        {
            errorMessage = "Cashier ID is required.";
            return;
        }

        hasDateValidationError = false;

        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            hasSearched = true;
            StateHasChanged();

            Console.WriteLine($"🔍 Searching transactions - Cashier ID: {cashierID}, Date Range: {startDate:yyyy-MM-dd} to {endDate:yyyy-MM-dd}");

            var result = await ApiClient.GetAccountTransactionsPerCashierAsync(
                cashierID: cashierID.Trim(),
                startDate: startDate,
                endDate: endDate,
                bP_Tenant: null,
                accept_Language: null
            );

            if (result?.Payload != null)
            {
                transactions = result.Payload.ToList();
                CalculateSummary();
                Console.WriteLine($"✅ Found {transactions.Count} transaction records");
            }
            else
            {
                transactions = new List<TransactionsView>();
                ResetSummary();
                Console.WriteLine($"ℹ️ No transaction records found");
            }
        }
        catch (ApiException<ApiErrorResponse> apiEx)
        {
            errorMessage = apiEx.Result?.ErrorMessage ?? "Failed to search transactions.";
            Console.WriteLine($"❌ API Error searching transactions: {apiEx.Message}");
            transactions = new List<TransactionsView>();
            ResetSummary();
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}). Please try again.";
            Console.WriteLine($"❌ API Exception: {ex.Message}");
            transactions = new List<TransactionsView>();
            ResetSummary();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to search transactions. Please check your connection.";
            Console.WriteLine($"❌ Error searching transactions: {ex.Message}");
            transactions = new List<TransactionsView>();
            ResetSummary();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CalculateSummary()
    {
        totalAmount = transactions.Sum(t => t.TransAmount);
        averageAmount = transactions.Count > 0 ? totalAmount / transactions.Count : 0;
    }

    private void ResetSummary()
    {
        totalAmount = 0;
        averageAmount = 0;
    }

    private void ClearSearch()
    {
        startDate = DateTime.Today.AddDays(-7);
        endDate = DateTime.Today;
        cashierID = string.Empty;
        transactions = new List<TransactionsView>();
        hasSearched = false;
        errorMessage = string.Empty;
        hasDateValidationError = false;
        ResetSummary();
        StateHasChanged();
    }

    private async Task ExportToExcel()
    {
        try
        {
            // Simple CSV export implementation
            var csvContent = "Transaction Date,Account Number,Account Name,Type,Amount,Description,Reference,Status,Batch,Branch\n";
            
            foreach (var transaction in transactions.OrderByDescending(t => t.TransactionDate))
            {
                csvContent += $"\"{transaction.TransactionDate:yyyy-MM-dd HH:mm}\",";
                csvContent += $"\"{transaction.AccountNumber}\",";
                csvContent += $"\"{transaction.AccountName}\",";
                csvContent += $"\"{transaction.TransactionType}\",";
                csvContent += $"\"{transaction.TransAmount:N2}\",";
                csvContent += $"\"{transaction.TransNarration}\",";
                csvContent += $"\"{transaction.TransRef}\",";
                csvContent += $"\"{transaction.Status}\",";
                csvContent += $"\"{transaction.BatchNumber}\",";
                csvContent += $"\"{transaction.BranchCode}\"\n";
            }

            var fileName = $"CashierTransactions_{cashierID}_{startDate:yyyyMMdd}_{endDate:yyyyMMdd}.csv";
            await JSRuntime.InvokeVoidAsync("downloadCsv", csvContent, fileName);
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to export data: " + ex.Message;
            StateHasChanged();
        }
    }

    private void OnTransactionRowClick(TransactionsView transaction)
    {
        Console.WriteLine($"Transaction row clicked: {transaction.TransactionType} - {transaction.AccountNumber} - ${transaction.TransAmount:N2}");
        // You can add additional functionality here, like opening a details modal
    }
}

<style>
    .page-title {
        margin: 20px 0;
        font-size: 28px;
        font-weight: 300;
    }

    .page-title small {
        color: #888;
        font-size: 14px;
        margin-left: 10px;
    }

    .portlet.light.bordered {
        background-color: #fff;
        border: 1px solid #e7ecf1;
        margin-bottom: 20px;
    }

    .portlet > .portlet-title {
        border-bottom: 1px solid #eee;
        padding: 15px 20px;
        margin-bottom: 0;
    }

    .portlet > .portlet-body {
        padding: 20px;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border-color: #ddd;
    }

    .btn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .text-truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .card-footer {
        background-color: #f8f9fa;
        border-top: 1px solid #dee2e6;
    }

    code {
        background-color: #f8f9fa;
        padding: 2px 4px;
        border-radius: 3px;
        font-size: 0.875em;
        color: #e83e8c;
    }

    .fw-bold {
        font-weight: bold;
    }
</style>

<script>
    function downloadCsv(content, fileName) {
        const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);
        
        link.setAttribute('href', url);
        link.setAttribute('download', fileName);
        link.style.visibility = 'hidden';
        
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>