</style>

<script>
    // Make the DotNet reference available globally
    window.dotNetReference = null;

    // Set the DotNet reference when the component is initialized
    window.setDotNetReference = (reference) => {
        window.dotNetReference = reference;
    };

    window.viewClient = function(clientId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('ViewClient', clientId)
                .catch(err => {
                    console.error('Error calling ViewClient:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    window.editClient = function (clientNumber) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('EditClient', clientNumber)
                .catch(err => {
                    console.error('Error calling EditClient:', err);
                });
        } else {
            console.error('DotNet reference not available for editClient');
        }
    };

    window.transactionHistory = function(clientId) {
        console.log('Transaction history for client:', clientId);
        window.location.href = '/clients/transactions/' + clientId;
    };

    // Initialize DotNet reference when the page loads
    document.addEventListener('DOMContentLoaded', function() {
        // This will be set by the Blazor component
    });
</script>


