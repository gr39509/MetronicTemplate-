@page "/clients"
@using NovaAccounts.Models
@using NovaAccounts.Services
@using NovaAccounts.Components
@using Microsoft.AspNetCore.Authorization
@using NovaAccounts.Components.Dashboard.QuickNav
@using NovaAccounts.SharedModels.DataFields
@using NovaAccounts.Components.Layout
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@attribute [Authorize]

@rendermode InteractiveServer
@layout MainLayout

<PageTitle>Clients</PageTitle>

<!-- Add Client Modal -->
<Nav></Nav>

<!-- Client Details Modal -->
<ClientDetailsModal @ref="clientDetailsModal"
                   />

<h1 class="page-title">
    Clients Management
    <small>View and manage all clients</small>
</h1>

<!-- Rest of your content remains the same -->
@if (isLoading)
{
    <!-- Your loading state -->
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <!-- Your error state -->
}
else
{
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-users font-dark"></i>
                <span class="caption-subject bold uppercase">Clients List</span>
            </div>
            <div class="actions">
                <button class="btn btn-circle btn-icon-only btn-default" @onclick="LoadClients" title="Refresh">
                    <i class="fa fa-refresh"></i>
                </button>
            </div>
        </div>
        <div class="portlet-body">
            <ReusableDataTable TItem="ClientViewModel"
                             Data="@clients"
                             Columns="@clientColumns"
                             Options="@clientOptions"
                             OnRowClick="@OnClientRowClick" />
        </div>
    </div>
}

@code {
    private List<ClientViewModel> clients = new();
    private List<DataTableColumn> clientColumns = new();
    private DataTableOptions clientOptions = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private ClientDetailsModal clientDetailsModal = null!;
    
    // Add these fields for header parameters
    // private string bpTenant = "default"; // Set your tenant value
    // private string acceptLanguage = "en"; // Set your language
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("setDotNetReference", 
                DotNetObjectReference.Create(this));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // You can get these values from configuration, user claims, or other sources
        // bpTenant = Configuration["Tenant:Id"] ?? "default";
        // acceptLanguage = Configuration["Culture:Default"] ?? "en";
        
        ConfigureClientTable();
        await LoadClients();
    }

    private void ConfigureClientTable()
    {
        clientColumns = new List<DataTableColumn>
        {
            new()
            {
                Header = "CLIENT ID",
                PropertyName = nameof(ClientViewModel.ClientID),
                Width = 100,
                CssClass = "text-center"
            },
            new()
            {
                Header = "CLIENT NAME",
                PropertyName = nameof(ClientViewModel.ClientName),
                CustomRenderer = (item) => $"<strong class='text-primary'>{((ClientViewModel)item).ClientName}</strong>"
            },
            new()
            {
                Header = "ACCOUNT NAME",
                PropertyName = nameof(ClientViewModel.AccountName),
                CustomRenderer = (item) =>
                {
                    var accountName = ((ClientViewModel)item).AccountName;
                    return string.IsNullOrEmpty(accountName)
                        ? "<span class='text-muted'>Not set</span>"
                        : accountName;
                }
            },
            new()
            {
                Header = "PHONE NUMBER",
                PropertyName = nameof(ClientViewModel.PhoneNumber),
                CustomRenderer = (item) =>
                {
                    var phone = ((ClientViewModel)item).PhoneNumber;
                    return phone == "0" || string.IsNullOrEmpty(phone)
                        ? "<span class='text-muted'>Not provided</span>"
                        : $"<a href='tel:{phone}'>{phone}</a>";
                }
            },
            new()
            {
                Header = "EMAIL ADDRESS",
                PropertyName = nameof(ClientViewModel.EmailAddress),
                CustomRenderer = (item) =>
                {
                    var email = ((ClientViewModel)item).EmailAddress;
                    return string.IsNullOrEmpty(email)
                        ? "<span class='text-muted'>Not provided</span>"
                        : $"<a href='mailto:{email}'>{email}</a>";
                }
            },
            new()
            {
                Header = "BALANCE",
                PropertyName = nameof(ClientViewModel.Balance),
                DataType = "num",
                CssClass = "text-right",
                CustomRenderer = (item) =>
                {
                    var balance = ((ClientViewModel)item).Balance;
                    var cssClass = balance > 0 ? "text-success" : balance < 0 ? "text-danger" : "text-muted";
                    return $"<span class='{cssClass}'><strong>GH₵ {balance:N2}</strong></span>";
                }
            },
            new()
            {
                Header = "ACTIONS",
                PropertyName = "",
                Sortable = false,
                Searchable = false,
                Width = 150,
                CssClass = "text-center",
                CustomRenderer = (item) => 
                {
                    var client = (ClientViewModel)item;
                    return $@"
                        <div class='btn-group btn-group-sm' role='group'>
                            <button type='button' class='btn btn-primary btn-xs' onclick='viewClient({client.Id})' title='View Details'>
                                <i class='fa fa-eye'></i>
                            </button>
                            <button type='button' class='btn btn-info btn-xs' onclick='editClient({client.Id})' title='Edit Client'>
                                <i class='fa fa-edit'></i>
                            </button>
                            <button type='button' class='btn btn-success btn-xs' onclick='transactionHistory({client.Id})' title='Transactions'>
                                <i class='fa fa-history'></i>
                            </button>
                        </div>";
                }
            }
        };

        clientOptions = new DataTableOptions
        {
            PageLength = 10,
            LengthMenu = new[] { 10, 25, 50, 100 },
            LengthMenuLabels = new[] { "10", "25", "50", "100" },
            SearchPlaceholder = "Search Clients",
            TableId = "clientsTable",
            TableCssClass = "table table-striped table-bordered table-hover",
            HeaderCssClass = "leadBold bg-blue-chambray font-white",
            RowCssClass = "",
            ShowSearch = true,
            ShowPaging = true,
            ShowInfo = true,
            ShowLengthMenu = true,
            Responsive = true,
            AdditionalOptions = new Dictionary<string, object>
            {
                ["order"] = new object[] { new object[] { 1, "asc" } },
                ["language"] = new Dictionary<string, object>
                {
                    ["search"] = "Search:",
                    ["lengthMenu"] = "Show _MENU_ clients per page",
                    ["info"] = "Showing _START_ to _END_ of _TOTAL_ clients",
                    ["infoEmpty"] = "No clients found",
                    ["infoFiltered"] = "(filtered from _MAX_ total clients)",
                    ["emptyTable"] = "No client data available",
                    ["zeroRecords"] = "No matching clients found"
                }
            }
        };
    }

    private async Task LoadClients()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            // Use the same header parameters for consistency
            var result = await ApiClient.GetClientsAsync(
                bP_Tenant: null,
                accept_Language: null
            );

            if (result?.Payload != null)
            {
                clients = result.Payload.ToList();
                Console.WriteLine($"✅ Loaded {clients.Count} clients");
            }
            else
            {
                errorMessage = "No clients data received from server.";
                clients = new List<ClientViewModel>();
            }
        }
        catch (ApiException<ApiErrorResponse> apiEx)
        {
            errorMessage = apiEx.Result?.ErrorMessage ?? "Failed to load clients.";
            Console.WriteLine($"❌ API Error loading clients: {apiEx.Message}");
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}). Please try again.";
            Console.WriteLine($"❌ API Exception: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load clients. Please check your connection.";
            Console.WriteLine($"❌ Error loading clients: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // This method will be called from JavaScript
    [JSInvokable]
    public async Task ViewClient(int clientId)
    {
        if (clientDetailsModal != null)
        {
            await clientDetailsModal.OpenModal(clientId);
        }
    }

    private async Task OnClientRowClick(ClientViewModel client)
    {
        Console.WriteLine($"Client row clicked: {client.ClientName}");
        // Optional: Open details modal on row click too
        // await ViewClient(client.Id);
    }

    // Add this method to handle component disposal
    public void Dispose()
    {
        // Cleanup if needed
    }
}

<style>
    .detail-group {
        margin-bottom: 1rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .detail-label {
        font-weight: 600;
        color: #555;
        display: block;
        margin-bottom: 0.25rem;
    }

    .detail-value {
        color: #333;
        font-size: 1rem;
    }

    .badge {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }

    .portlet.light.bordered {
        background-color: #fff;
        border: 1px solid #e7ecf1;
        margin-bottom: 20px;
    }

    .portlet > .portlet-title {
        border-bottom: 1px solid #eee;
        padding: 15px 20px;
        margin-bottom: 0;
    }

    .portlet > .portlet-body {
        padding: 20px;
    }

    .page-title {
        margin: 20px 0;
        font-size: 28px;
        font-weight: 300;
    }

    .page-title small {
        color: #888;
        font-size: 14px;
        margin-left: 10px;
    }

    .btn-xs {
        padding: 1px 5px;
        font-size: 12px;
        line-height: 1.5;
    }

    .text-right {
        text-align: right !important;
    }

    .spinner-border {
        width: 3rem;
        height: 3rem;
        border-width: 0.3em;
    }
</style>

<script>
    // Make the DotNet reference available globally
    window.dotNetReference = null;

    // Set the DotNet reference when the component is initialized
    window.setDotNetReference = (reference) => {
        window.dotNetReference = reference;
    };

    window.viewClient = function(clientId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('ViewClient', clientId)
                .catch(err => {
                    console.error('Error calling ViewClient:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    window.editClient = function(clientId) {
        console.log('Edit client:', clientId);
        window.location.href = '/clients/edit/' + clientId;
    };

    window.transactionHistory = function(clientId) {
        console.log('Transaction history for client:', clientId);
        window.location.href = '/clients/transactions/' + clientId;
    };

    // Initialize DotNet reference when the page loads
    document.addEventListener('DOMContentLoaded', function() {
        // This will be set by the Blazor component
    });
</script>



