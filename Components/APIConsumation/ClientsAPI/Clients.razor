@page "/clients"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using NovaAccounts.Components.Dashboard.QuickShow
@using NovaAccounts.SharedModels.DataFields
@using NovaAccounts.Components.Layout
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@using NovaAccounts.Services.AuthServices;
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

@rendermode InteractiveServer
@layout MainLayout

<PageTitle>Clients</PageTitle>

<!-- Add Client Modal -->
@* <OverLayShow></OverLayShow> *@


@* The below codes are very important for the modals to open *@
<ClientDetailsModal @ref="clientDetailsModal"/>
<ClientEditModal @ref="clientEditModal" OnClientUpdated="HandleClientUpdated" />
                   

<h1 class="page-title">
    Clients Management
    <small>View and manage all clients</small>
</h1>

<!-- Rest of your content remains the same -->
@if (isLoading)
{
    <div class="portlet light bordered">
        <div class="portlet-body text-center" style="padding: 50px 0;">
            <div class="spinner-border text-primary" role="status">
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-3">Loading CBS clients...</p>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" @onclick="@(() => errorMessage = string.Empty)">
            <span>&times;</span>
        </button>
        <strong>Error!</strong> @errorMessage
        <button class="btn btn-sm btn-warning" @onclick="LoadClients" style="margin-left: 10px;">
            <i class="fa fa-refresh"></i> Retry
        </button>
    </div>
}
else
{
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-users font-dark"></i>
                <span class="caption-subject bold uppercase">Clients List</span>
            </div>
            <div class="actions">
                <button class="btn btn-circle btn-icon-only btn-default" @onclick="LoadClients" title="Refresh">
                    <i class="fa fa-refresh"></i>
                </button>
            </div>
        </div>
        <div class="portlet-body">
            <ReusableDataTable TItem="ClientViewModel"
                             Data="@clients"
                             Columns="@clientColumns"
                             Options="@clientOptions"
                             OnRowClick="@OnClientRowClick" />
        </div>
    </div>
}

@code {
    private List<ClientViewModel> clients = new();
    private List<DataTableColumn> clientColumns = new();
    private DataTableOptions clientOptions = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private ClientDetailsModal clientDetailsModal = null!;
    private ClientEditModal clientEditModal = null!;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("setDotNetReference", 
                DotNetObjectReference.Create(this));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ConfigureClientTable();
        await LoadClients();
    }

    private void ConfigureClientTable()
    {
        clientColumns = new List<DataTableColumn>
        {
            new()
            {
                Header = "CLIENT ID",
                PropertyName = nameof(ClientViewModel.ClientID),
                Width = 100,
                CssClass = "text-center"
            },
            new()
            {
                Header = "CLIENT NAME",
                PropertyName = nameof(ClientViewModel.ClientName),
                CustomRenderer = (item) => $"<strong class='text-primary'>{((ClientViewModel)item).ClientName}</strong>"
            },
            new()
            {
                Header = "ACCOUNT NAME",
                PropertyName = nameof(ClientViewModel.AccountName),
                CustomRenderer = (item) =>
                {
                    var accountName = ((ClientViewModel)item).AccountName;
                    return string.IsNullOrEmpty(accountName)
                        ? "<span class='text-muted'>Not set</span>"
                        : accountName;
                }
            },
            new()
            {
                Header = "PHONE NUMBER",
                PropertyName = nameof(ClientViewModel.PhoneNumber),
                CustomRenderer = (item) =>
                {
                    var phone = ((ClientViewModel)item).PhoneNumber;
                    return phone == "0" || string.IsNullOrEmpty(phone)
                        ? "<span class='text-muted'>Not provided</span>"
                        : $"<a href='tel:{phone}'>{phone}</a>";
                }
            },
            new()
            {
                Header = "EMAIL ADDRESS",
                PropertyName = nameof(ClientViewModel.EmailAddress),
                CustomRenderer = (item) =>
                {
                    var email = ((ClientViewModel)item).EmailAddress;
                    return string.IsNullOrEmpty(email)
                        ? "<span class='text-muted'>Not provided</span>"
                        : $"<a href='mailto:{email}'>{email}</a>";
                }
            },
            new()
            {
                Header = "BALANCE",
                PropertyName = nameof(ClientViewModel.Balance),
                DataType = "num",
                CssClass = "text-right",
                CustomRenderer = (item) =>
                {
                    var balance = ((ClientViewModel)item).Balance;
                    var cssClass = balance > 0 ? "text-success" : balance < 0 ? "text-danger" : "text-muted";
                    return $"<span class='{cssClass}'><strong>GH₵ {balance:N2}</strong></span>";
                }
            },
            new()
            {
                Header = "ACTIONS",
                PropertyName = "",
                Sortable = false,
                Searchable = false,
                Width = 150,
                CssClass = "text-center",
                CustomRenderer = (item) => 
                {
                    var client = (ClientViewModel)item;
                    return $@"
                        <div class='btn-group btn-group-sm' role='group'>
                            <button type='button' class='btn btn-primary btn-xs' onclick='viewClient({client.Id})' title='View Details'>
                                <i class='fa fa-eye'></i>
                            </button>
                            <button type='button' class='btn btn-info btn-xs' onclick='editClient({client.Id})' title='Edit Client'>
                                <i class='fa fa-edit'></i>
                            </button>
                            <button type='button' class='btn btn-success btn-xs' onclick='transactionHistory({client.Id})' title='Transactions'>
                                <i class='fa fa-history'></i>
                            </button>
                        </div>";
                }
            }
        };

        clientOptions = new DataTableOptions
        {
            PageLength = 10,
            LengthMenu = new[] { 10, 25, 50, 100 },
            LengthMenuLabels = new[] { "10", "25", "50", "100" },
            SearchPlaceholder = "Search Clients",
            TableId = "clientsTable",
            TableCssClass = "table table-striped table-bordered table-hover",
            HeaderCssClass = "leadBold bg-blue-chambray font-white",
            RowCssClass = "",
            ShowSearch = true,
            ShowPaging = true,
            ShowInfo = true,
            ShowLengthMenu = true,
            Responsive = true,
            AdditionalOptions = new Dictionary<string, object>
            {
                ["order"] = new object[] { new object[] { 1, "asc" } },
                ["language"] = new Dictionary<string, object>
                {
                    ["search"] = "Search:",
                    ["lengthMenu"] = "Show _MENU_ clients per page",
                    ["info"] = "Showing _START_ to _END_ of _TOTAL_ clients",
                    ["infoEmpty"] = "No clients found",
                    ["infoFiltered"] = "(filtered from _MAX_ total clients)",
                    ["emptyTable"] = "No client data available",
                    ["zeroRecords"] = "No matching clients found"
                }
            }
        };
    }

    private async Task LoadClients()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            var result = await ApiClient.GetClientsAsync(
                bP_Tenant: null,
                accept_Language: null
            );

            if (result?.Payload != null)
            {
                clients = result.Payload.ToList();
                Console.WriteLine($"✅ Loaded {clients.Count} clients");
            }
            else
            {
                errorMessage = "No clients data received from server.";
                clients = new List<ClientViewModel>();
            }
        }
        catch (ApiException<ApiErrorResponse> apiEx)
        {
            errorMessage = apiEx.Result?.ErrorMessage ?? "Failed to load clients.";
            Console.WriteLine($"❌ API Error loading clients: {apiEx.Message}");
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}). Please try and login again.";
            Console.WriteLine($"❌ API Exception: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load clients. Please try and login again.";
            Console.WriteLine($"❌ Error loading clients: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ADD THIS METHOD TO HANDLE CLIENT UPDATES
    private async Task HandleClientUpdated(UpdateClientCommand updatedClient)
    {
        Console.WriteLine($"🔄 Handling client update for ID: {updatedClient.Id}");
        
        try
        {
            // Show loading state briefly
            isLoading = true;
            StateHasChanged();
            
            // Small delay to ensure smooth UI transition
            await Task.Delay(300);
            
            // Reload the clients from server to get fresh data
            await LoadClients();
            
            Console.WriteLine("✅ Client list refreshed after update");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error refreshing client list: {ex.Message}");
            errorMessage = "Client was updated but couldn't refresh the list. Please refresh the page.";
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task ViewClient(int clientId)
    {
        if (clientDetailsModal != null)
        {
            await clientDetailsModal.OpenModal(clientId);
        }
    }
    
    [JSInvokable]
    public async Task EditClient(int clientNumber)
    {
        Console.WriteLine($"📝 EditClient called with clientNumber: {clientNumber}");

        if (clientEditModal == null)
        {
            Console.WriteLine("❌ clientEditModal is null");
            return;
        }

        await clientEditModal.OpenModal(clientNumber);
    }

    private async Task OnClientRowClick(ClientViewModel client)
    {
        Console.WriteLine($"Client row clicked: {client.ClientName}");
    }

    public void Dispose()
    {
        // Cleanup if needed
    }
}

