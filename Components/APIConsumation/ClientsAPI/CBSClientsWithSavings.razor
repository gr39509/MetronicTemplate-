@page "/clients/cbs/savings"
@using NovaAccounts.Components
@using NovaAccounts.SharedModels.DataFields
@using NovaAccounts.Components.Layout
@using Microsoft.AspNetCore.Authorization
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService

@inject IJSRuntime JSRuntime
@inject ApiClient ApiClient
@attribute [Authorize]
@layout MainLayout
@rendermode InteractiveServer

<PageTitle>CBS Clients with Savings</PageTitle>

<h1 class="page-title">
    CBS Clients with Savings
    <small>View clients and their savings accounts</small>
</h1>

@if (isLoading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3">Loading clients with savings accounts...</p>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @errorMessage
    </div>
}
else
{
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-briefcase font-dark"></i>
                <span class="caption-subject bold uppercase">Clients with Savings</span>
            </div>
            <div class="actions">
                <button class="btn btn-circle btn-default" @onclick="LoadCbsClientsWithSavings" title="Refresh">
                    <i class="fa fa-refresh"></i>
                </button>
            </div>
        </div>
        <div class="portlet-body">
            <ReusableDataTable TItem="CBSClientViewModel"
                               Data="@clients"
                               Columns="@columns"
                               Options="@options"
                               OnRowClick="@OnClientClick" />
        </div>
    </div>
}

@code {
    private List<CBSClientViewModel> clients = new();
    private List<DataTableColumn> columns = new();
    private DataTableOptions options = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ConfigureTable();
        await LoadCbsClientsWithSavings();
    }
    
    private async Task LoadCbsClientsWithSavings()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            
            var result = await ApiClient.GetCBSClientsWithSavingsAccountsAsync(
                bP_Tenant: null,
                accept_Language: null
            );

            if (result?.Payload != null)
            {
                clients = result.Payload.ToList();
                Console.WriteLine($"✅ Loaded {clients.Count} clients");
            }
            else
            {
                errorMessage = "No clients data received from server.";
                clients = new List<CBSClientViewModel>();
            }
        }
        catch (ApiException<ApiErrorResponse> apiEx)
        {
            errorMessage = apiEx.Result?.ErrorMessage ?? "Failed to load clients.";
            Console.WriteLine($"❌ API Error loading clients: {apiEx.Message}");
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}). Please try again.";
            Console.WriteLine($"❌ API Exception: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load clients. Please try and login again.";
            Console.WriteLine($"❌ Error loading clients: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

