@page "/clients/cbs/savings"
@using NovaAccounts.Components
@using NovaAccounts.SharedModels.DataFields
@using NovaAccounts.Components.Layout
@using Microsoft.AspNetCore.Authorization
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService

@inject IJSRuntime JSRuntime
@inject ApiClient ApiClient
@attribute [Authorize]
@layout MainLayout
@rendermode InteractiveServer

<PageTitle>CBS Clients with Savings</PageTitle>
<Approve></Approve>

<CBSClientWithSavingsDetailsModal @ref="clientDetailsModalModal" />

<h1 class="page-title">
    CBS Clients with Savings
    <small>View clients and their savings accounts</small>
</h1>

@if (isLoading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3">Loading clients with savings accounts...</p>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @errorMessage
    </div>
}
else
{
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-briefcase font-dark"></i>
                <span class="caption-subject bold uppercase">Clients with Savings</span>
            </div>
            <div class="actions">
                <button class="btn btn-circle btn-default" @onclick="LoadCbsClientsWithSavings" title="Refresh">
                    <i class="fa fa-refresh"></i>
                </button>
            </div>
        </div>
        <div class="portlet-body">
            <ReusableDataTable TItem="CBSClientViewModel"
                               Data="@clients"
                               Columns="@columns"
                               Options="@options"
                               OnRowClick="@OnClientClick" />
        </div>
    </div>
}

@code {
    private List<CBSClientViewModel> clients = new();
    private List<DataTableColumn> columns = new();
    private DataTableOptions options = new();
    private CBSClientWithSavingsDetailsModal clientDetailsModalModal = null!;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("🔍 OnAfterRenderAsync - First render");
            await JSRuntime.InvokeVoidAsync("setDotNetReference", 
                DotNetObjectReference.Create(this));
            
            // Check if modal component is initialized
            if (clientDetailsModalModal == null)
            {
                Console.WriteLine("❌ Modal component is NULL after first render");
            }
            else
            {
                Console.WriteLine("✅ Modal component reference is set");
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ConfigureTable();
        await LoadCbsClientsWithSavings();
    }
    
    
    
    private async Task LoadCbsClientsWithSavings()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            
            var result = await ApiClient.GetCBSClientsWithSavingsAccountsAsync(
                bP_Tenant: null,
                accept_Language: null
            );

            if (result?.Payload != null)
            {
                clients = result.Payload.ToList();
                Console.WriteLine($"✅ Loaded {clients.Count} clients");
            }
            else
            {
                errorMessage = "No clients data received from server.";
                clients = new List<CBSClientViewModel>();
            }
        }
        catch (ApiException<ApiErrorResponse> apiEx)
        {
            errorMessage = apiEx.Result?.ErrorMessage ?? "Failed to load clients.";
            Console.WriteLine($"❌ API Error loading clients: {apiEx.Message}");
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}). Please try and login again.";
            Console.WriteLine($"❌ API Exception: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load clients. Please try and login again.";
            Console.WriteLine($"❌ Error loading clients: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    
    
    [JSInvokable]
    public async Task ViewClient(string clientNumber)
    {
        Console.WriteLine($"🔍 ViewClient called with clientNumber: {clientNumber}");
        
        try
        {
            if (clientDetailsModalModal == null)
            {
                Console.WriteLine("❌ clientDetailsModalModal is null - modal component not found");
                return;
            }

            Console.WriteLine("✅ Modal reference found, calling OpenModal...");
            await clientDetailsModalModal.OpenModal(clientNumber);
            Console.WriteLine("✅ OpenModal completed");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error in ViewClient: {ex.Message}");
            Console.WriteLine($"❌ Stack trace: {ex.StackTrace}");
        }
    }

    // private async Task LoadClients()
    // {
    //     try
    //     {
    //         isLoading = true;
    //         errorMessage = string.Empty;
    //         StateHasChanged();
    //
    //         clients = await ClientService.GetCBSClientsWithSavingsAsync();
    //         Console.WriteLine($"Loaded {clients.Count} CBS clients with savings accounts");
    //     }
    //     catch (Exception ex)
    //     {
    //         errorMessage = ex.Message;
    //         Console.WriteLine($"Error loading clients: {ex.Message}");
    //     }
    //     finally
    //     {
    //         isLoading = false;
    //         StateHasChanged();
    //     }
    // }

    private void ConfigureTable()
    {
        columns = new List<DataTableColumn>
        {
            new() { Header = "CLIENT NO", PropertyName = nameof(CBSClientViewModel.ClientNum), CssClass = "text-center" },
            new()
            {
                Header = "FULL NAME",
                PropertyName = nameof(CBSClientViewModel.FullName),
                CustomRenderer = (item) =>
                {
                    var client = (CBSClientViewModel)item;
                    return $"<strong class='text-primary'>{client.FullName}</strong>";
                }
            },
            new() { Header = "GENDER", PropertyName = nameof(CBSClientViewModel.Gender) },
            new()
            {
                Header = "SAVINGS ACCOUNTS",
                PropertyName = nameof(CBSClientViewModel.SavingsAccounts),
                CustomRenderer = (item) =>
                {
                    var client = (CBSClientViewModel)item;
                    if (client.SavingsAccounts == null || !client.SavingsAccounts.Any())
                        return "<span class='text-muted'>No accounts</span>";

                    var accounts = string.Join("<br/>",
                        client.SavingsAccounts.Select(a =>
                            $"{a.AccountNumber} - <em>{a.AccountStatus}</em> ({a.Currency})"));

                    return $"<div>{accounts}</div>";
                }
            },
            new() { Header = "BRANCH", PropertyName = nameof(CBSClientViewModel.BranchName) },
            new() { Header = "RELATIONSHIP OFFICER", PropertyName = nameof(CBSClientViewModel.RelationshipOfficer) },
            new()
            {
                Header = "ACTIONS",
                PropertyName = "",
                Sortable = false,
                Searchable = false,
                Width = 150,
                CssClass = "text-center",
                CustomRenderer = (item) => 
                {
                    var client = (CBSClientViewModel)item;
                    return $@"
        <div class='btn-group btn-group-sm' role='group'>
            <button type='button' class='btn btn-primary btn-xs' onclick='viewClient(""{client.ClientNum}"")' title='View Details'>
                <i class='fa fa-eye'></i>
            </button>
           
        </div>";
                }

            }
        };

        options = new DataTableOptions
        {
            PageLength = 10,
            TableId = "cbsClientsSavingsTable",
            TableCssClass = "table table-striped table-bordered table-hover",
            SearchPlaceholder = "Search Clients",
            ShowSearch = true,
            ShowPaging = true,
            ShowInfo = true
        };
    }

    private async Task OnClientClick(CBSClientViewModel client)
    {
        Console.WriteLine($"Clicked: {client.FullName}");
        await JSRuntime.InvokeVoidAsync("alert", $"Client: {client.FullName}");
    }
}


<script>

    // Make the DotNet reference available globally
    window.dotNetReference = null;

    // Set the DotNet reference when the component is initialized
    window.setDotNetReference = (reference) => {
        window.dotNetReference = reference;
    };

    window.viewClient = function(clientNumber) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('ViewClient', clientNumber)
                .catch(err => {
                    console.error('Error calling ViewClient:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    window.editClient = function (clientNumber) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('EditClient', clientNumber)
                .catch(err => {
                    console.error('Error calling EditClient:', err);
                });
        } else {
            console.error('DotNet reference not available for editClient');
        }
    };
    
    // window.viewCbsClient = function (clientId) {
    //     console.log('View CBS Client:', clientId);
    //     window.location.href = '/clients/cbs/view/' + clientId;
    // };

    window.viewTransactions = function (clientId) {
        console.log('View CBS Client Transactions:', clientId);
        window.location.href = '/clients/cbs/transactions/' + clientId;
    };
</script>