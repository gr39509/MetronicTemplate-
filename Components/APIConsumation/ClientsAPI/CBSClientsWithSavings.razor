    private void ConfigureTable()
    {
        columns = new List<DataTableColumn>
        {
            new() { Header = "CLIENT NO", PropertyName = nameof(CBSClientViewModel.ClientNum), CssClass = "text-center" },
            new()
            {
                Header = "FULL NAME",
                PropertyName = nameof(CBSClientViewModel.FullName),
                CustomRenderer = (item) =>
                {
                    var client = (CBSClientViewModel)item;
                    return $"<strong class='text-primary'>{client.FullName}</strong>";
                }
            },
            new() { Header = "GENDER", PropertyName = nameof(CBSClientViewModel.Gender) },
            new()
            {
                Header = "SAVINGS ACCOUNTS",
                PropertyName = nameof(CBSClientViewModel.SavingsAccounts),
                CustomRenderer = (item) =>
                {
                    var client = (CBSClientViewModel)item;
                    if (client.SavingsAccounts == null || !client.SavingsAccounts.Any())
                        return "<span class='text-muted'>No accounts</span>";

                    var accounts = string.Join("<br/>",
                        client.SavingsAccounts.Select(a =>
                            $"{a.AccountNumber} - <em>{a.AccountStatus}</em> ({a.Currency})"));

                    return $"<div>{accounts}</div>";
                }
            },
            new() { Header = "BRANCH", PropertyName = nameof(CBSClientViewModel.BranchName) },
            new() { Header = "RELATIONSHIP OFFICER", PropertyName = nameof(CBSClientViewModel.RelationshipOfficer) }
        };

        options = new DataTableOptions
        {
            PageLength = 10,
            TableId = "cbsClientsSavingsTable",
            TableCssClass = "table table-striped table-bordered table-hover",
            SearchPlaceholder = "Search Clients",
            ShowSearch = true,
            ShowPaging = true,
            ShowInfo = true
        };
    }

    private async Task OnClientClick(CBSClientViewModel client)
    {
        Console.WriteLine($"Clicked: {client.FullName}");
        await JSRuntime.InvokeVoidAsync("alert", $"Client: {client.FullName}");
    }
}
