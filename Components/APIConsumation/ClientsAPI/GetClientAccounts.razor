    private async Task SearchClientAccounts()
    {
        if (productId <= 0)
        {
            errorMessage = "Please enter a valid product ID.";
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            hasSearched = true;
            StateHasChanged();

            Console.WriteLine($"🔍 Searching client accounts for product ID: {productId}");

            var result = await ApiClient.GetClientAccountsAsync(
                productId: productId,
                bP_Tenant: null,
                accept_Language: null
            );

            if (result?.Payload != null)
            {
                clientAccounts = result.Payload.ToList();
                Console.WriteLine($"✅ Found {clientAccounts.Count} client accounts for product ID: {productId}");
            }
            else
            {
                clientAccounts = new List<ClientViewModel>();
                Console.WriteLine($"ℹ️ No client accounts found for product ID: {productId}");
            }
        }
        catch (ApiException<ApiErrorResponse> apiEx)
        {
            errorMessage = apiEx.Result?.ErrorMessage ?? "Failed to search client accounts.";
            Console.WriteLine($"❌ API Error searching client accounts: {apiEx.Message}");
            clientAccounts = new List<ClientViewModel>();
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}). Please try again.";
            Console.WriteLine($"❌ API Exception: {ex.Message}");
            clientAccounts = new List<ClientViewModel>();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to search client accounts. Please check your connection.";
            Console.WriteLine($"❌ Error searching client accounts: {ex.Message}");
            clientAccounts = new List<ClientViewModel>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ClearSearch()
    {
        productId = 0;
        clientAccounts = new List<ClientViewModel>();
        hasSearched = false;
        errorMessage = string.Empty;
        StateHasChanged();
    }

    private void OnClientAccountRowClick(ClientViewModel clientAccount)
    {
        Console.WriteLine($"Client account row clicked: {clientAccount.AccountName}");
        // You can add additional functionality here, like opening a details modal
    }
}

