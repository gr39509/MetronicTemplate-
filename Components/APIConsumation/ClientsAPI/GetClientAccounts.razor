@page "/get-client-account"
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.DataFields
@inject ApiClient ApiClient

<div class="container mt-4">
    <h1 class="page-title">
        Get Client Accounts
        <small>Search client accounts by product ID</small>
    </h1>

    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-magnifier font-dark"></i>
                <span class="caption-subject bold uppercase">Search Client Accounts</span>
            </div>
        </div>
        <div class="portlet-body">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="form-horizontal">
                        <div class="form-group row mb-4">
                            <label class="col-md-4 col-form-label text-md-right">Product ID</label>
                            <div class="col-md-8">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa fa-product-hunt"></i></span>
                                    <input type="number" class="form-control" @bind="productId" placeholder="Enter product ID" required />
                                </div>
                                <small class="form-text text-muted">Enter the product ID to search for associated client accounts</small>
                            </div>
                        </div>
                        
                        <div class="form-group row">
                            <div class="col-md-4"></div>
                            <div class="col-md-8">
                                <button type="button" class="btn btn-success" @onclick="SearchClientAccounts" disabled="@isLoading">
                                    <i class="fa fa-search"></i> 
                                    @if (isLoading)
                                    {
                                        <span>Searching...</span>
                                    }
                                    else
                                    {
                                        <span>Search</span>
                                    }
                                </button>
                                @if (clientAccounts?.Any() == true)
                                {
                                    <button type="button" class="btn btn-secondary ms-2" @onclick="ClearSearch">
                                        <i class="fa fa-times"></i> Clear
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results Section -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-8">
                        <div class="alert alert-danger alert-dismissible">
                            <button type="button" class="close" @onclick="@(() => errorMessage = string.Empty)">
                                <span>&times;</span>
                            </button>
                            <strong>Error!</strong> @errorMessage
                        </div>
                    </div>
                </div>
            }

            @if (clientAccounts?.Any() == true)
            {
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-users me-2"></i>
                                    Client Accounts for Product ID: @productId
                                    <span class="badge bg-light text-dark ms-2">@clientAccounts.Count accounts found</span>
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <ReusableDataTable TItem="ClientViewModel"
                                                 Data="@clientAccounts"
                                                 Columns="@clientAccountColumns"
                                                 Options="@clientAccountOptions"
                                                 OnRowClick="@OnClientAccountRowClick" />
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (hasSearched && !isLoading)
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-8">
                        <div class="alert alert-info text-center">
                            <i class="fa fa-info-circle fa-2x mb-3"></i>
                            <h5>No Client Accounts Found</h5>
                            <p class="mb-0">No client accounts were found for product ID: <strong>@productId</strong></p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

