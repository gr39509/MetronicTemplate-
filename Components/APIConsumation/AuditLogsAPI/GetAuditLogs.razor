    }

    .changes-container::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 3px;
    }

    .changes-container::-webkit-scrollbar-thumb:hover {
        background: #a8a8a8;
    }

    code {
        background-color: #f8f9fa;
        padding: 2px 4px;
        border-radius: 3px;
        font-size: 0.875em;
        color: #e83e8c;
    }
</style>

