        margin: 20px 0;
        font-size: 28px;
        font-weight: 300;
    }

    .page-title small {
        color: #888;
        font-size: 14px;
        margin-left: 10px;
    }

    .portlet.light.bordered {
        background-color: #fff;
        border: 1px solid #e7ecf1;
        margin-bottom: 20px;
    }

    .portlet > .portlet-title {
        border-bottom: 1px solid #eee;
        padding: 15px 20px;
        margin-bottom: 0;
    }

    .portlet > .portlet-body {
        padding: 20px;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border-color: #ddd;
    }

    .btn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .text-truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .card-footer {
        background-color: #f8f9fa;
        border-top: 1px solid #dee2e6;
    }

    /* Custom styles for changes container */
    .changes-container {
        max-height: 120px;
        overflow-y: auto;
        padding: 8px;
        border: 1px solid #e9ecef;
        border-radius: 4px;
        background-color: #f8f9fa;
        font-size: 0.75rem;
    }

    .changes-container::-webkit-scrollbar {
        width: 6px;
    }

    .changes-container::-webkit-scrollbar-track {
        background: #f1f1f1;
