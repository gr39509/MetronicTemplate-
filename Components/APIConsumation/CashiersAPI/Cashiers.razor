@page "/"
@using Microsoft.AspNetCore.Authorization
@using NovaAccounts.SharedModels.DataFields
@using NovaAccounts.Components.Layout
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@attribute [Authorize]
@rendermode InteractiveServer
@inject ApiClient ApiClient
@layout MainLayout

<PageTitle>CBS Clients</PageTitle>

@* The below codes are very important for the modals to open *@
<CashierDetailsModal @ref="cashierDetailsModal" />
<CashierEditModal @ref="cashierEditModal" OnCashierUpdated="HandleCashierUpdated"/>



<h1 class="page-title">
    CBS Clients Management
    <small>View CBS client information</small>
</h1>

<!-- Loading State -->
@if (isLoading)
{
    <div class="portlet light bordered">
        <div class="portlet-body text-center" style="padding: 50px 0;">
            <div class="spinner-border text-primary" role="status">
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-3">Loading CBS clients...</p>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" @onclick="@(() => errorMessage = string.Empty)">
            <span>&times;</span>
        </button>
        <strong>Error!</strong> @errorMessage
        <button class="btn btn-sm btn-warning" @onclick="LoadCashiers" style="margin-left: 10px;">
            <i class="fa fa-refresh"></i> Retry
        </button>
    </div>
}
else
{
    <div class="portlet">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-user font-dark"></i>
                <span class="caption-subject bold uppercase">Cashiers</span>
            </div>
            <div class="actions">
                <button class="btn btn-circle btn-icon-only btn-default" @onclick="LoadCashiers" title="Refresh">
                    <i class="fa fa-refresh"></i>
                </button>
            </div>
        </div>
        <div class="portlet-body">
            <ReusableDataTable TItem="CashierViewModel"
                               Data="@cashiers"
                               Columns="@cbsColumns"
                               Options="@cbsOptions"
                               OnRowClick="@OnCbsClientRowClick" />
        </div>
    </div>
}

@code {
    private List<CashierViewModel> cashiers = new();
    private List<DataTableColumn> cbsColumns = new();
    private DataTableOptions cbsOptions = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private CashierDetailsModal cashierDetailsModal = null!;
    private CashierEditModal cashierEditModal = null!;
    
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("🔍 OnAfterRenderAsync - First render");
            await JSRuntime.InvokeVoidAsync("setDotNetReference", 
                DotNetObjectReference.Create(this));
            
            // Check if modal component is initialized
            if (cashierDetailsModal == null)
            {
                Console.WriteLine("❌ Modal component is NULL after first render");
            }
            else
            {
                Console.WriteLine("✅ Modal component reference is set");
            }
        }
    }


    [JSInvokable]
    public async Task EditCashier(string cashierID)
    {
        Console.WriteLine($"📝 EditClient called with clientNumber: {cashierID}");
    
        if (cashierEditModal == null)
        {
            Console.WriteLine("❌ clientEditModal is null");
            return;
        }
    
        await cashierEditModal.OpenModal(cashierID);
    }



    

    protected override async Task OnInitializedAsync()
    {
        ConfigureCbsCashiersTable();
        await LoadCashiers();
    }
    
    [JSInvokable]
    public async Task ViewCashier(string cashierId)
    {
        Console.WriteLine($"🔍 ViewCashier called with clientNumber: {cashierId}");
        
        try
        {
            if (cashierDetailsModal == null)
            {
                Console.WriteLine("❌ clientDetailsModalModal is null - modal component not found");
                return;
            }
    
            Console.WriteLine("✅ Modal reference found, calling OpenModal...");
            await cashierDetailsModal.OpenModal(cashierId);
            Console.WriteLine("✅ OpenModal completed");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error in ViewClient: {ex.Message}");
            Console.WriteLine($"❌ Stack trace: {ex.StackTrace}");
        }
    }

    private async Task LoadCashiers()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            
            var result = await ApiClient.GetCashiersAsync(
                bP_Tenant: null,
                accept_Language: null
            );

            if (result?.Payload != null)
            {
                cashiers = result.Payload.ToList();
                Console.WriteLine($"✅ Loaded {cashiers.Count} clients");
            }
            else
            {
                errorMessage = "No clients data received from server.";
                cashiers = new List<CashierViewModel>();
            }
        }
        catch (ApiException<ApiErrorResponse> apiEx)
        {
            errorMessage = apiEx.Result?.ErrorMessage ?? "Failed to load clients.";
            Console.WriteLine($"❌ API Error loading clients: {apiEx.Message}");
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}). Please try and login again.";
            Console.WriteLine($"❌ API Exception: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load clients. Please try and login again.";
            Console.WriteLine($"❌ Error loading clients: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }



    private void ConfigureCbsCashiersTable()
    {
        cbsColumns = new List<DataTableColumn>
        {
            new()
            {
                Header = "CASHIER NO",
                PropertyName = nameof(CashierViewModel.CashierID),
                CssClass = "text-center"
            },
            new()
            {
                Header = "FULL NAME",
                PropertyName = nameof(CashierViewModel.CashierName),
                CustomRenderer = (item) =>
                    $"<strong class='text-primary'>{((CashierViewModel)item).CashierName}</strong>"
            },
            new()
            {
                Header = "Cash Deposits",
                PropertyName = nameof(CashierViewModel.CashDeposits)
            },
            new()
            {
                Header = "Cheque Deposits",
                PropertyName = nameof(CashierViewModel.ChequeDeposits)
            },
            new()
            {
                Header = "Field Agent Account Number",
                PropertyName = nameof(CashierViewModel.FieldAgentAccountNumber),
                CustomRenderer = (item) =>
                {
                    var agentAccountNumber = ((CashierViewModel)item).FieldAgentAccountNumber;
                    return string.IsNullOrEmpty(agentAccountNumber)
                        ? "<span class='text-muted'>Not provided</span>"
                        : $"<a href='tel:{agentAccountNumber}'>{agentAccountNumber}</a>";
                }
            },
           
            new()
            {
                Header = "ACTIONS",
                PropertyName = "",
                Sortable = false,
                Searchable = false,
                Width = 150,
                CssClass = "text-center",
                CustomRenderer = (item) => 
                {
                    var cashier = (CashierViewModel)item;
                    return $@"
        <div class='btn-group btn-group-sm' role='group'>
            <button type='button' class='btn btn-primary btn-xs' onclick='viewCashier(""{cashier.CashierID}"")' title='View Details'>
                <i class='fa fa-eye'></i>
            </button>
            <button type='button' class='btn btn-info btn-xs' onclick='editCashier(""{cashier.CashierID}"")' title='Edit Cashier'>
                <i class='fa fa-edit'></i>
            </button>
            <button type='button' class='btn btn-success btn-xs' onclick='transactionHistory({cashier.CashierID})' title='Transactions'>
                <i class='fa fa-history'></i>
            </button>
        </div>";
                }

            }
        };

        cbsOptions = new DataTableOptions
        {
            PageLength = 10,
            LengthMenu = new[] { 10, 25, 50 },
            LengthMenuLabels = new[] { "10", "25", "50" },
            SearchPlaceholder = "Search CBS Clients",
            TableId = "cbsClientsTable",
            TableCssClass = "table table-striped table-bordered table-hover",
            HeaderCssClass = "leadBold bg-blue-chambray font-white",
            ShowSearch = true,
            ShowPaging = true,
            ShowInfo = true,
            Responsive = true,
            AdditionalOptions = new Dictionary<string, object>
            {
                ["order"] = new object[] { new object[] { 1, "asc" } }
            }
        };
    }
    
    
    
    // THIS METHOD TO HANDLE CLIENT UPDATES
    private async Task HandleCashierUpdated(UpdateCashierCommand updatedCashier)
    {
        Console.WriteLine($"🔄 Handling client update for ID: {updatedCashier.CashierID}");
        
        try
        {
            // Show loading state briefly
            isLoading = true;
            StateHasChanged();
            
            // Small delay to ensure smooth UI transition
            await Task.Delay(300);
            
            // Reload the clients from server to get fresh data
            await LoadCashiers();
            
            Console.WriteLine("✅ Client list refreshed after update");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error refreshing client list: {ex.Message}");
            errorMessage = "Client was updated but couldn't refresh the list. Please refresh the page.";
            StateHasChanged();
        }
    }
    
   

    private async Task OnCbsClientRowClick(CashierViewModel cashier)
    {
        Console.WriteLine($"CBS Client clicked: {cashier.CashierName}");
        await JSRuntime.InvokeVoidAsync("viewCbsClient", cashier.Id);
    }
}
