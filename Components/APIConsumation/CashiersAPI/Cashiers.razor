<script>

    // Make the DotNet reference available globally
    window.dotNetReference = null;

    // Set the DotNet reference when the component is initialized
    window.setDotNetReference = (reference) => {
        window.dotNetReference = reference;
    };

    window.viewCashier = function(cashierNumber) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('ViewCashier', cashierNumber)
                .catch(err => {
                    console.error('Error calling ViewCashier:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    window.editCashier = function (cashierID) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('EditCashier', cashierID)
                .catch(err => {
                    console.error('Error calling EditClient:', err);
                });
        } else {
            console.error('DotNet reference not available for editClient');
        }
    };
    
    // window.viewCbsClient = function (clientId) {
    //     console.log('View CBS Client:', clientId);
    //     window.location.href = '/clients/cbs/view/' + clientId;
    // };

    window.viewTransactions = function (clientId) {
        console.log('View CBS Client Transactions:', clientId);
        window.location.href = '/clients/cbs/transactions/' + clientId;
    };
</script>
