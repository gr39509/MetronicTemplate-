    private async Task LoadIDTypes()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;
            validationMessage = string.Empty;
            StateHasChanged();

            Console.WriteLine($"🔍 Loading ID types...");

            var result = await ApiClient.GetIDTypesAsync(
                bP_Tenant: null,
                accept_Language: null
            );

            if (result?.Payload != null)
            {
                idTypes = result.Payload.ToList();
                ApplyFilters();
                CalculateStatistics();
                Console.WriteLine($"✅ Found {idTypes.Count} ID types");
            }
            else
            {
                idTypes = new List<IDTypeViewModel>();
                filteredIDTypes = new List<IDTypeViewModel>();
                ResetStatistics();
                Console.WriteLine($"ℹ️ No ID types found");
            }
            
            hasLoaded = true;
        }
        catch (ApiException<ApiErrorResponse> apiEx)
        {
            errorMessage = apiEx.Result?.ErrorMessage ?? "Failed to load ID types.";
            Console.WriteLine($"❌ API Error loading ID types: {apiEx.Message}");
            idTypes = new List<IDTypeViewModel>();
            filteredIDTypes = new List<IDTypeViewModel>();
            ResetStatistics();
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}). Please try again.";
            Console.WriteLine($"❌ API Exception: {ex.Message}");
            idTypes = new List<IDTypeViewModel>();
            filteredIDTypes = new List<IDTypeViewModel>();
            ResetStatistics();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load ID types. Please check your connection.";
            Console.WriteLine($"❌ Error loading ID types: {ex.Message}");
            idTypes = new List<IDTypeViewModel>();
            filteredIDTypes = new List<IDTypeViewModel>();
            ResetStatistics();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        var query = idTypes.AsEnumerable();

        // Apply search filter
        if (!string.IsNullOrEmpty(searchTerm))
        {
            query = query.Where(it =>
                it.IdentificationTypeName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true
            );
        }

        // Apply sorting
        query = sortBy switch
        {
            "id" => sortOrder == "asc" 
                ? query.OrderBy(it => it.Id)
                : query.OrderByDescending(it => it.Id),
            "length" => sortOrder == "asc" 
                ? query.OrderBy(it => it.IdentificationTypeName?.Length ?? 0)
                : query.OrderByDescending(it => it.IdentificationTypeName?.Length ?? 0),
            _ => sortOrder == "asc" 
                ? query.OrderBy(it => it.IdentificationTypeName)
                : query.OrderByDescending(it => it.IdentificationTypeName)
        };

        filteredIDTypes = query.ToList();
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void ClearSearch()
    {
        searchTerm = "";
        ApplyFilters();
    }

    private void CalculateStatistics()
    {
        highestTypeId = idTypes.Any() ? idTypes.Max(it => it.Id) : 0;
        commonIDTypes = idTypes.Count(it => 
            commonTypeSuggestions.Contains(it.IdentificationTypeName, StringComparer.OrdinalIgnoreCase));
        recentlyAdded = idTypes.Count(it => it.Id > highestTypeId - 5); // Last 5 added
    }

    private void ResetStatistics()
    {
        highestTypeId = 0;
        commonIDTypes = 0;
        recentlyAdded = 0;
    }

    private string GetIDTypeBadgeClass(int typeId)
    {
        return typeId switch
        {
            <= 5 => "bg-primary",    // Primary ID types
            <= 10 => "bg-success",   // Secondary ID types
            <= 15 => "bg-info",      // Tertiary ID types
            <= 20 => "bg-warning",   // Additional ID types
            _ => "bg-secondary"      // Other ID types
        };
    }

    private string GetIDTypeIcon(string typeName)
    {
        if (string.IsNullOrEmpty(typeName)) return "fa-id-card";
        
        var lowerName = typeName.ToLower();
        return lowerName switch
        {
            var n when n.Contains("passport") => "fa-passport",
            var n when n.Contains("driver") => "fa-car",
            var n when n.Contains("license") => "fa-id-card-alt",
            var n when n.Contains("birth") => "fa-birthday-cake",
            var n when n.Contains("social") => "fa-shield-alt",
            var n when n.Contains("voter") => "fa-vote-yea",
            var n when n.Contains("tax") => "fa-receipt",
            var n when n.Contains("resident") => "fa-home",
            var n when n.Contains("work") => "fa-briefcase",
            var n when n.Contains("student") => "fa-graduation-cap",
            _ => "fa-id-card"
        };
    }

    private string GetIDTypeCategory(string typeName)
    {
        if (string.IsNullOrEmpty(typeName)) return "General";
        
        var lowerName = typeName.ToLower();
        return lowerName switch
        {
            var n when n.Contains("passport") || n.Contains("visa") => "International",
            var n when n.Contains("national") || n.Contains("federal") => "Government",
            var n when n.Contains("driver") || n.Contains("license") => "License",
            var n when n.Contains("birth") || n.Contains("certificate") => "Certificate",
            var n when n.Contains("social") || n.Contains("security") => "Social",
            var n when n.Contains("student") || n.Contains("school") => "Education",
            var n when n.Contains("work") || n.Contains("business") => "Employment",
            _ => "General"
        };
    }

    private string GetCategoryBadgeClass(string category)
    {
        return category switch
        {
            "International" => "bg-primary",
            "Government" => "bg-success",
            "License" => "bg-info",
            "Certificate" => "bg-warning",
            "Social" => "bg-purple",
            "Education" => "bg-teal",
            "Employment" => "bg-orange",
            _ => "bg-secondary"
        };
    }

