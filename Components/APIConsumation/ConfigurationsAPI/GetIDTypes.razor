                    ["info"] = "Showing _START_ to _END_ of _TOTAL_ ID types",
                    ["infoEmpty"] = "No ID types found",
                    ["infoFiltered"] = "(filtered from _MAX_ total ID types)",
                    ["emptyTable"] = "No ID type data available",
