    private async Task ValidateBulkData()
    {
        if (string.IsNullOrEmpty(bulkIDTypesData))
        {
            bulkActionsMessage = "Error: Please enter data to validate.";
            return;
        }

        try
        {
            var lines = bulkIDTypesData.Split('\n', StringSplitOptions.RemoveEmptyEntries);
            var validEntries = new List<string>();
            var errors = new List<string>();

            for (int i = 0; i < lines.Length; i++)
            {
                var line = lines[i].Trim();
                if (string.IsNullOrEmpty(line)) continue;

                var parts = line.Split(',', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length != 2)
                {
                    errors.Add($"Line {i + 1}: Invalid format. Expected 'ID,Name'");
                    continue;
                }

                if (!int.TryParse(parts[0].Trim(), out int id) || id <= 0)
                {
                    errors.Add($"Line {i + 1}: Invalid ID '{parts[0]}'. Must be a positive number.");
                    continue;
                }

                if (string.IsNullOrEmpty(parts[1].Trim()))
                {
                    errors.Add($"Line {i + 1}: ID type name cannot be empty.");
                    continue;
                }

                if (idTypes.Any(it => it.Id == id))
                {
                    errors.Add($"Line {i + 1}: ID Type ID {id} already exists.");
                    continue;
                }

                if (idTypes.Any(it => 
                    it.IdentificationTypeName?.Equals(parts[1].Trim(), StringComparison.OrdinalIgnoreCase) == true))
                {
                    errors.Add($"Line {i + 1}: ID Type name '{parts[1].Trim()}' already exists.");
                    continue;
                }

                validEntries.Add($"ID: {id}, Name: {parts[1].Trim()}");
            }

            if (errors.Any())
            {
                bulkActionsMessage = $"Validation failed with {errors.Count} error(s):\n" + string.Join("\n", errors.Take(5));
                if (errors.Count > 5)
                {
                    bulkActionsMessage += $"\n... and {errors.Count - 5} more error(s)";
                }
            }
            else
            {
                bulkActionsMessage = $"✅ Validation successful! Found {validEntries.Count} valid ID type(s) ready for import.";
            }
        }
        catch (Exception ex)
        {
            bulkActionsMessage = $"Error during validation: {ex.Message}";
        }

        StateHasChanged();
    }

    private async Task ImportBulkIDTypes()
    {
        try
        {
            var lines = bulkIDTypesData.Split('\n', StringSplitOptions.RemoveEmptyEntries);
            var importedCount = 0;

            foreach (var line in lines)
            {
                var trimmedLine = line.Trim();
                if (string.IsNullOrEmpty(trimmedLine)) continue;

                var parts = trimmedLine.Split(',', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length == 2 && int.TryParse(parts[0].Trim(), out int id) && id > 0)
                {
                    var name = parts[1].Trim();
                    if (!string.IsNullOrEmpty(name) && 
                        !idTypes.Any(it => it.Id == id) &&
                        !idTypes.Any(it => it.IdentificationTypeName?.Equals(name, StringComparison.OrdinalIgnoreCase) == true))
                    {
                        idTypes.Add(new IDTypeViewModel
                        {
                            Id = id,
                            IdentificationTypeName = name
                        });
                        importedCount++;
                    }
                }
            }

            if (importedCount > 0)
            {
                ApplyFilters();
                CalculateStatistics();
                successMessage = $"Successfully imported {importedCount} ID type(s)!";
                CloseBulkActionsModal();
            }
            else
            {
                bulkActionsMessage = "No valid ID types were imported. Please check your data.";
            }
        }
        catch (Exception ex)
        {
            bulkActionsMessage = $"Error during import: {ex.Message}";
        }

        StateHasChanged();
    }

