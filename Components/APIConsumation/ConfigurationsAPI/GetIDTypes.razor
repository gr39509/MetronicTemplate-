@page "/id-types"
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.DataFields
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime

<div class="container mt-4">
    <h1 class="page-title">
        ID Types Management
        <small>Manage identification document types for client verification</small>
    </h1>

    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-badge font-dark"></i>
                <span class="caption-subject bold uppercase">Identification Types</span>
            </div>
            <div class="actions">
                <button class="btn btn-circle btn-icon-only btn-default" @onclick="LoadIDTypes" title="Refresh">
                    <i class="fa fa-refresh"></i>
                </button>
                <button class="btn btn-circle btn-icon-only btn-success" @onclick="ShowAddModal" title="Add New ID Type">
                    <i class="fa fa-plus"></i>
                </button>
            </div>
        </div>
        <div class="portlet-body">
            <!-- Statistics Cards -->
            @if (idTypes.Any())
            {
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card bg-primary text-white">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="flex-grow-1">
                                        <h4 class="mb-0">@idTypes.Count</h4>
                                        <small>Total ID Types</small>
                                    </div>
                                    <div class="flex-shrink-0">
                                        <i class="fa fa-id-card fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-success text-white">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="flex-grow-1">
                                        <h4 class="mb-0">@commonIDTypes</h4>
                                        <small>Common Types</small>
                                    </div>
                                    <div class="flex-shrink-0">
                                        <i class="fa fa-star fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-info text-white">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="flex-grow-1">
                                        <h4 class="mb-0">@highestTypeId</h4>
                                        <small>Highest Type ID</small>
                                    </div>
                                    <div class="flex-shrink-0">
                                        <i class="fa fa-hashtag fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-warning text-white">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="flex-grow-1">
                                        <h4 class="mb-0">@recentlyAdded</h4>
                                        <small>Recently Added</small>
                                    </div>
                                    <div class="flex-shrink-0">
                                        <i class="fa fa-clock fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Quick Actions -->
            @if (idTypes.Any())
            {
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">
                                    <i class="fa fa-bolt me-2"></i>
                                    Quick Actions
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-12">
                                        @* <button class="btn btn-outline-primary me-2" @onclick="AddCommonIDTypes"> *@
                                        @*     <i class="fa fa-magic me-1"></i> Add Common ID Types *@
                                        @* </button> *@
                                        @* <button class="btn btn-outline-info me-2" @onclick="ShowBulkActionsModal"> *@
                                        @*     <i class="fa fa-upload me-1"></i> Bulk Import *@
                                        @* </button> *@
                                        <button class="btn btn-outline-success" @onclick="ExportToExcel" disabled="@(!filteredIDTypes.Any())">
                                            <i class="fa fa-download me-1"></i> Export to Excel
                                        </button>
                                        <button class="btn btn-outline-warning float-end" @onclick="ShowUsageGuide">
                                            <i class="fa fa-question-circle me-1"></i> Usage Guide
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Search and Filter Section -->
            @if (idTypes.Any())
            {
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">
                                    <i class="fa fa-search me-2"></i>
                                    Search & Filter
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">Search ID Types</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="fa fa-search"></i></span>
                                                <input type="text" class="form-control" @bind="searchTerm" @oninput="OnSearchInput" placeholder="Search by ID type name..." />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label class="form-label">Sort By</label>
                                            <select class="form-select" @bind="sortBy">
                                                <option value="name">ID Type Name</option>
                                                <option value="id">ID Type ID</option>
                                                <option value="length">Name Length</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label class="form-label">Sort Order</label>
                                            <select class="form-select" @bind="sortOrder">
                                                <option value="asc">Ascending</option>
                                                <option value="desc">Descending</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-md-12">
                                        <button class="btn btn-secondary" @onclick="ClearSearch">
                                            <i class="fa fa-times"></i> Clear Search
                                        </button>
                                        <span class="badge bg-info ms-2">
                                            <i class="fa fa-filter"></i> Showing @filteredIDTypes.Count of @idTypes.Count types
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Results Section -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-danger alert-dismissible">
                            <button type="button" class="close" @onclick="ClearErrorMessage">
                                <span>&times;</span>
                            </button>
                            <strong>Error!</strong> @errorMessage
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-success alert-dismissible">
                            <button type="button" class="close" @onclick="ClearSuccessMessage">
                                <span>&times;</span>
                            </button>
                            <strong>Success!</strong> @successMessage
                        </div>
                    </div>
                </div>
            }

            @if (filteredIDTypes?.Any() == true)
            {
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-id-card me-2"></i>
                                    Identification Types
                                    <span class="badge bg-light text-dark ms-2">@filteredIDTypes.Count records</span>
                                    @if (!string.IsNullOrEmpty(searchTerm))
                                    {
                                        <span class="badge bg-info ms-2">Search: "@searchTerm"</span>
                                    }
                                </h5>
                            </div>
                            <br/>
                            <div class="card-body p-0">
                                <ReusableDataTable TItem="IDTypeViewModel"
                                                 Data="@filteredIDTypes"
                                                 Columns="@idTypeColumns"
                                                 Options="@idTypeOptions"
                                                 OnRowClick="@OnIDTypeRowClick" />
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (hasLoaded && !isLoading)
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-info text-center">
                            <i class="fa fa-info-circle fa-2x mb-3"></i>
                            <h5>No ID Types Found</h5>
                            <p class="mb-0">
                                @if (!string.IsNullOrEmpty(searchTerm))
                                {
                                    <text>No ID types found matching your search criteria.</text>
                                }
                                else
                                {
                                    <text>No identification types have been configured in the system.</text>
                                }
                            </p>
                            @if (!string.IsNullOrEmpty(searchTerm))
                            {
                                <button class="btn btn-info mt-2" @onclick="ClearSearch">
                                    <i class="fa fa-times"></i> Clear Search
                                </button>
                            }
                            else
                            {
                                <div class="mt-3">
                                    <button class="btn btn-success me-2" @onclick="ShowAddModal">
                                        <i class="fa fa-plus"></i> Add First ID Type
                                    </button>
                                    <button class="btn btn-outline-primary" @onclick="AddCommonIDTypes">
                                        <i class="fa fa-magic"></i> Add Common ID Types
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Loading State -->
            @if (isLoading)
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-info text-center">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                            Loading ID types...
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add/Edit ID Type Modal -->
@if (showIDTypeModal)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header @(isEditing ? "bg-warning" : "bg-success") text-white">
                    <h5 class="modal-title">
                        <i class="fa @(isEditing ? "fa-edit" : "fa-plus") me-2"></i>
                        @(isEditing ? "Edit ID Type" : "Add New ID Type")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseIDTypeModal"></button>
                </div>
                <div class="modal-body">
                    @if (isEditing)
                    {
                        <div class="form-group mb-3">
                            <label class="form-label">ID Type ID</label>
                            <input type="text" class="form-control" value="@currentIDType.Id" disabled />
                            <small class="form-text text-muted">ID Type ID cannot be changed</small>
                        </div>
                    }
                    else
                    {
                        <div class="form-group mb-3">
                            <label class="form-label">ID Type ID *</label>
                            <input type="number" class="form-control" @bind="newIDTypeId" 
                                   placeholder="Enter unique ID type ID" min="1" />
                            <small class="form-text text-muted">Unique numeric identifier for the ID type</small>
                        </div>
                    }
                    <div class="form-group mb-3">
                        <label class="form-label">Identification Type Name *</label>
                        <input type="text" class="form-control" @bind="currentIDType.IdentificationTypeName" 
                               placeholder="Enter identification type name" maxlength="100" />
                        <small class="form-text text-muted">Name of the identification document type (e.g., Passport, Driver's License, National ID)</small>
                    </div>
                    
                    <!-- Common ID Types Suggestions -->
                    @if (!isEditing)
                    {
                        <div class="form-group mb-3">
                            <label class="form-label">Quick Suggestions</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var suggestion in commonTypeSuggestions)
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => UseSuggestion(suggestion)">
                                        @suggestion
                                    </button>
                                }
                            </div>
                            <small class="form-text text-muted">Click to quickly use common ID type names</small>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(validationMessage))
                    {
                        <div class="alert alert-warning">
                            <i class="fa fa-exclamation-triangle"></i> @validationMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseIDTypeModal">Cancel</button>
                    <button type="button" class="btn @(isEditing ? "btn-warning" : "btn-success")" 
                            @onclick="SaveIDType" disabled="@IsSaveDisabled">
                        <i class="fa @(isEditing ? "fa-save" : "fa-plus") me-1"></i>
                        @(isEditing ? "Update" : "Create") ID Type
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && idTypeToDelete != null)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        Confirm Deletion
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the following ID type?</p>
                    <div class="alert alert-warning">
                        <strong>ID: @idTypeToDelete.Id</strong> - @idTypeToDelete.IdentificationTypeName
                    </div>
                    <p class="text-danger">
                        <i class="fa fa-warning"></i> This action cannot be undone! This may affect client verification processes that use this ID type.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
                        <i class="fa fa-trash me-1"></i> Delete ID Type
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Bulk Actions Modal -->
@if (showBulkActionsModal)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">
                        <i class="fa fa-upload me-2"></i>
                        Bulk ID Types Import
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseBulkActionsModal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i> 
                        You can add multiple ID types at once. Enter one ID type per line in the format: <code>ID,Name</code>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label class="form-label">Bulk ID Types Data</label>
                        <textarea class="form-control" @bind="bulkIDTypesData" rows="10" 
                                  placeholder="Example:&#10;1,Passport&#10;2,National ID&#10;3,Driver's License&#10;4,Birth Certificate&#10;5,Social Security Card"></textarea>
                        <small class="form-text text-muted">
                            Format: <strong>ID,Name</strong> (one per line). IDs must be unique numeric values.
                        </small>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Quick Templates</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="LoadInternationalTemplate">
                                International Documents
                            </button>
                            <button type="button" class="btn btn-outline-success btn-sm" @onclick="LoadGovernmentTemplate">
                                Government IDs
                            </button>
                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="LoadBusinessTemplate">
                                Business Documents
                            </button>
                        </div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(bulkActionsMessage))
                    {
                        <div class="alert @(bulkActionsMessage.Contains("Error") ? "alert-danger" : "alert-success")">
                            @bulkActionsMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseBulkActionsModal">Cancel</button>
                    <button type="button" class="btn btn-info" @onclick="ValidateBulkData">
                        <i class="fa fa-check"></i> Validate Data
                    </button>
                    <button type="button" class="btn btn-success" @onclick="ImportBulkIDTypes" disabled="@string.IsNullOrEmpty(bulkIDTypesData)">
                        <i class="fa fa-upload"></i> Import ID Types
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Usage Guide Modal -->
@if (showUsageGuideModal)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fa fa-question-circle me-2"></i>
                        ID Types Usage Guide
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseUsageGuideModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6><i class="fa fa-lightbulb text-warning me-2"></i>Best Practices</h6>
                            <ul class="list-unstyled">
                                <li><i class="fa fa-check text-success me-2"></i>Use clear, descriptive names</li>
                                <li><i class="fa fa-check text-success me-2"></i>Include country-specific ID types</li>
                                <li><i class="fa fa-check text-success me-2"></i>Group similar document types</li>
                                <li><i class="fa fa-check text-success me-2"></i>Keep names consistent</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="fa fa-list text-info me-2"></i>Common Types</h6>
                            <ul class="list-unstyled">
                                <li>• Passport</li>
                                <li>• National ID</li>
                                <li>• Driver's License</li>
                                <li>• Birth Certificate</li>
                                <li>• Social Security Card</li>
                            </ul>
                        </div>
                    </div>
                    <div class="alert alert-warning mt-3">
                        <i class="fa fa-exclamation-triangle"></i>
                        <strong>Note:</strong> ID types are used for client verification and KYC compliance. Ensure all types are properly configured for your regulatory requirements.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="CloseUsageGuideModal">
                        <i class="fa fa-check"></i> Got It
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<IDTypeViewModel> idTypes = new();
    private List<IDTypeViewModel> filteredIDTypes = new();
    private List<DataTableColumn> idTypeColumns = new();
    private DataTableOptions idTypeOptions = new();
    private bool isLoading = false;
    private bool hasLoaded = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string validationMessage = string.Empty;
    
    // Search and filter fields
    private string searchTerm = "";
    private string sortBy = "name";
    private string sortOrder = "asc";
    
    // Modal fields
    private bool showIDTypeModal = false;
    private bool showDeleteModal = false;
    private bool showBulkActionsModal = false;
    private bool showUsageGuideModal = false;
    private bool isEditing = false;
    private IDTypeViewModel currentIDType = new();
    private IDTypeViewModel idTypeToDelete = null;
    private int newIDTypeId = 0;
    
    // Bulk actions
    private string bulkIDTypesData = "";
    private string bulkActionsMessage = "";
    
    // Statistics
    private int highestTypeId = 0;
    private int commonIDTypes = 0;
    private int recentlyAdded = 0;

    // Common suggestions
    private readonly List<string> commonTypeSuggestions = new()
    {
        "Passport",
        "National ID",
        "Driver's License",
        "Birth Certificate",
        "Social Security Card",
        "Voter ID",
        "Tax ID",
        "Residence Permit",
        "Work Permit",
        "Student ID"
    };

    protected override async Task OnInitializedAsync()
    {
        ConfigureIDTypeTable();
        await LoadIDTypes();
    }

    private void ConfigureIDTypeTable()
    {
        idTypeColumns = new List<DataTableColumn>
        {
            new()
            {
                Header = "ID TYPE ID",
                PropertyName = nameof(IDTypeViewModel.Id),
                Width = 120,
                CssClass = "text-center",
                CustomRenderer = (item) =>
                {
                    var typeId = ((IDTypeViewModel)item).Id;
                    var badgeClass = GetIDTypeBadgeClass(typeId);
                    return $"<span class='badge {badgeClass}'>{typeId}</span>";
                }
            },
            new()
            {
                Header = "IDENTIFICATION TYPE",
                PropertyName = nameof(IDTypeViewModel.IdentificationTypeName),
                CustomRenderer = (item) =>
                {
                    var idType = (IDTypeViewModel)item;
                    var name = idType.IdentificationTypeName;
                    
                    if (string.IsNullOrEmpty(name))
                    {
                        return "<span class='text-muted'><i>Unnamed ID Type</i></span>";
                    }
                    
                    var icon = GetIDTypeIcon(name);
                    var typeCategory = GetIDTypeCategory(name);
                    var categoryBadge = $"<span class='badge {GetCategoryBadgeClass(typeCategory)} ms-2'>{typeCategory}</span>";
                    
                    return $@"
                        <div class='d-flex align-items-center'>
                            <div class='id-type-icon me-3'>
                                <i class='fa {icon} text-primary'></i>
                            </div>
                            <div>
                                <strong class='text-primary'>{name}</strong>
                                <br/>
                                <small class='text-muted'>Identification Document Type</small>
                            </div>
                            {categoryBadge}
                        </div>";
                }
            },
            new()
            {
                Header = "NAME LENGTH",
                PropertyName = nameof(IDTypeViewModel.IdentificationTypeName),
                Width = 120,
                CssClass = "text-center",
                CustomRenderer = (item) =>
                {
                    var name = ((IDTypeViewModel)item).IdentificationTypeName;
                    var length = string.IsNullOrEmpty(name) ? 0 : name.Length;
                    var badgeClass = length < 10 ? "bg-success" : length < 20 ? "bg-info" : "bg-warning";
                    return $"<span class='badge {badgeClass}'>{length} chars</span>";
                }
            }
            // new()
            // {
            //     Header = "ACTIONS",
            //     PropertyName = "",
            //     Sortable = false,
            //     Searchable = false,
            //     Width = 120,
            //     CssClass = "text-center",
            //     CustomRenderer = (item) => 
            //     {
            //         var idType = (IDTypeViewModel)item;
            //         return $@"
            //             <div class='btn-group btn-group-sm' role='group'>
            //                 <button type='button' class='btn btn-warning btn-xs' onclick='editIDType({idType.Id})' title='Edit'>
            //                     <i class='fa fa-edit'></i>
            //                 </button>
            //                 <button type='button' class='btn btn-danger btn-xs' onclick='deleteIDType({idType.Id})' title='Delete'>
            //                     <i class='fa fa-trash'></i>
            //                 </button>
            //             </div>";
            //     }
            // }
        };

        idTypeOptions = new DataTableOptions
        {
            PageLength = 15,
            LengthMenu = new[] { 15, 30, 50, 100 },
            LengthMenuLabels = new[] { "15", "30", "50", "100" },
            SearchPlaceholder = "Search ID types...",
            TableId = "idTypesTable",
            TableCssClass = "table table-striped table-bordered table-hover mb-0",
            HeaderCssClass = "leadBold bg-blue-madison font-white",
            RowCssClass = "",
            ShowSearch = true,
            ShowPaging = true,
            ShowInfo = true,
            ShowLengthMenu = true,
            Responsive = true,
            AdditionalOptions = new Dictionary<string, object>
            {
                ["order"] = new object[] { new object[] { 1, "asc" } }, // Default sort by ID type name
                ["language"] = new Dictionary<string, object>
                {
