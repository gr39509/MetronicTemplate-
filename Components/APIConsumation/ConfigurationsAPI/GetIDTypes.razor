    private async Task ExportToExcel()
    {
        try
        {
            var csvContent = "ID Type ID,Identification Type Name,Category\n";
            
            foreach (var idType in filteredIDTypes)
            {
                csvContent += $"\"{idType.Id}\",";
                csvContent += $"\"{idType.IdentificationTypeName}\",";
                csvContent += $"\"{GetIDTypeCategory(idType.IdentificationTypeName)}\"\n";
            }

            var fileName = $"IDTypes_{DateTime.Now:yyyyMMddHHmmss}.csv";
            await JSRuntime.InvokeVoidAsync("downloadCsv", csvContent, fileName);
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to export data: " + ex.Message;
            StateHasChanged();
        }
    }

