    private async Task SaveIDType()
    {
        try
        {
            validationMessage = string.Empty;

            if (string.IsNullOrEmpty(currentIDType.IdentificationTypeName?.Trim()))
            {
                validationMessage = "Identification Type Name is required.";
                return;
            }

            // TODO: Implement actual API call to save ID type
            await Task.Delay(500);

            if (isEditing)
            {
                // Update existing ID type
                var existing = idTypes.FirstOrDefault(it => it.Id == currentIDType.Id);
                if (existing != null)
                {
                    existing.IdentificationTypeName = currentIDType.IdentificationTypeName.Trim();
                }
                successMessage = "ID type updated successfully!";
            }
            else
            {
                // Check if ID already exists
                if (idTypes.Any(it => it.Id == newIDTypeId))
                {
                    validationMessage = $"An ID type with ID {newIDTypeId} already exists.";
                    return;
                }

                // Check if name already exists
                if (idTypes.Any(it => 
                    it.IdentificationTypeName?.Equals(currentIDType.IdentificationTypeName.Trim(), StringComparison.OrdinalIgnoreCase) == true))
                {
                    validationMessage = $"An ID type with name '{currentIDType.IdentificationTypeName.Trim()}' already exists.";
                    return;
                }

                // Add new ID type
                idTypes.Add(new IDTypeViewModel
                {
                    Id = newIDTypeId,
                    IdentificationTypeName = currentIDType.IdentificationTypeName.Trim()
                });
                successMessage = "ID type created successfully!";
            }

            ApplyFilters();
            CalculateStatistics();
            CloseIDTypeModal();
            
            Console.WriteLine($"✅ {(isEditing ? "Updated" : "Created")} ID type: {currentIDType.IdentificationTypeName}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to {(isEditing ? "update" : "create")} ID type. Please try again.";
            Console.WriteLine($"❌ Error saving ID type: {ex.Message}");
        }
    }

