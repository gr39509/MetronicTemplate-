    private async Task ExportToExcel()
    {
        try
        {
            var csvContent = "Officer ID,Officer Name\n";
            
            foreach (var officer in filteredRelationshipOfficers)
            {
                csvContent += $"\"{officer.Id}\",";
                csvContent += $"\"{officer.Name}\"\n";
            }

            var fileName = $"RelationshipOfficers_{DateTime.Now:yyyyMMddHHmmss}.csv";
            await JSRuntime.InvokeVoidAsync("downloadCsv", csvContent, fileName);
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to export data: " + ex.Message;
            StateHasChanged();
        }
    }

