<script>
    // Make the DotNet reference available globally
    window.dotNetReference = null;

    // Set the DotNet reference when the component is initialized
    window.setDotNetReference = (reference) => {
        window.dotNetReference = reference;
    };

    window.editCharge = function(savingsFeesSettingID) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('EditCharge', savingsFeesSettingID)
                .catch(err => {
                    console.error('Error calling EditCharge:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    window.deleteCharge = function(savingsFeesSettingID) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('DeleteCharge', savingsFeesSettingID)
                .catch(err => {
                    console.error('Error calling DeleteCharge:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    function downloadCsv(content, fileName) {
        const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);
        
        link.setAttribute('href', url);
        link.setAttribute('download', fileName);
        link.style.visibility = 'hidden';
        
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    // Initialize DotNet reference when the page loads
    document.addEventListener('DOMContentLoaded', function() {
        // This will be set by the Blazor component
    });
</script>