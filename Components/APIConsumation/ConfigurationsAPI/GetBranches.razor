    private async Task SaveBranch()
    {
        try
        {
            validationMessage = string.Empty;

            // Validation
            if (string.IsNullOrEmpty(currentBranch.BranchName?.Trim()))
            {
                validationMessage = "Branch Name is required.";
                return;
            }

            if (string.IsNullOrEmpty(currentBranch.BranchCode?.Trim()))
            {
                validationMessage = "Branch Code is required.";
                return;
            }

            if (string.IsNullOrEmpty(currentBranch.Country?.Trim()))
            {
                validationMessage = "Country is required.";
                return;
            }

            if (string.IsNullOrEmpty(currentBranch.Currency?.Trim()))
            {
                validationMessage = "Currency is required.";
                return;
            }

            // Parse open date
            if (DateTime.TryParse(branchOpenDateString, out DateTime openDate))
            {
                currentBranch.BranchOpenDate = new DateTimeOffset(openDate);
            }
            else
            {
                validationMessage = "Invalid branch open date.";
                return;
            }

            // TODO: Implement actual API call to save branch
            await Task.Delay(500);

            if (isEditing)
            {
                // Update existing branch
                var existing = branches.FirstOrDefault(b => b.Id == currentBranch.Id);
                if (existing != null)
                {
                    existing.BranchName = currentBranch.BranchName.Trim();
                    existing.BranchCode = currentBranch.BranchCode.Trim();
                    existing.BranchOpenDate = currentBranch.BranchOpenDate;
                    existing.Country = currentBranch.Country.Trim();
                    existing.Currency = currentBranch.Currency.Trim();
                    existing.DateFormat = currentBranch.DateFormat;
                    existing.BranchAddress = currentBranch.BranchAddress;
                    existing.BranchCity = currentBranch.BranchCity;
                    existing.BranchLandLine = currentBranch.BranchLandLine;
                    existing.BranchMobile = currentBranch.BranchMobile;
                    existing.MinimumLoanAmount = currentBranch.MinimumLoanAmount;
                    existing.MaximumLoanAmount = currentBranch.MaximumLoanAmount;
                    existing.MinimumInterestRate = currentBranch.MinimumInterestRate;
                    existing.MaximumLoanInterestRate = currentBranch.MaximumLoanInterestRate;
                    existing.SessionOpen = currentBranch.SessionOpen;
                    existing.SuspenseAccountNumber = currentBranch.SuspenseAccountNumber;
                }
                successMessage = "Branch updated successfully!";
            }
            else
            {
                // Check if ID already exists
                if (branches.Any(b => b.Id == newBranchId))
                {
                    validationMessage = $"A branch with ID {newBranchId} already exists.";
                    return;
                }

                // Check if branch code already exists
                if (branches.Any(b => b.BranchCode == currentBranch.BranchCode))
                {
                    validationMessage = $"A branch with code {currentBranch.BranchCode} already exists.";
                    return;
                }

                // Add new branch
                currentBranch.Id = newBranchId;
                branches.Add(currentBranch);
                successMessage = "Branch created successfully!";
            }

            ApplyFilters();
            CalculateStatistics();
            CloseBranchModal();
            
            Console.WriteLine($"✅ {(isEditing ? "Updated" : "Created")} branch: {currentBranch.BranchName}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to {(isEditing ? "update" : "create")} branch. Please try again.";
            Console.WriteLine($"❌ Error saving branch: {ex.Message}");
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            if (branchToDelete == null) return;

            // TODO: Implement actual API call to delete branch
            await Task.Delay(500);

            branches.RemoveAll(b => b.Id == branchToDelete.Id);
            successMessage = "Branch deleted successfully!";
            
            ApplyFilters();
            CalculateStatistics();
            CloseDeleteModal();
            
            Console.WriteLine($"✅ Deleted branch: {branchToDelete.BranchName}");
        }
        catch (Exception ex)
