<script>
    // Make the DotNet reference available globally
    window.dotNetReference = null;

    // Set the DotNet reference when the component is initialized
    window.setDotNetReference = (reference) => {
        window.dotNetReference = reference;
    };

    window.editBranch = function(branchId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('EditBranch', branchId)
                .catch(err => {
                    console.error('Error calling EditBranch:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    window.deleteBranch = function(branchId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('DeleteBranch', branchId)
                .catch(err => {
                    console.error('Error calling DeleteBranch:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    window.toggleBranchSession = function(branchId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('ToggleBranchSession', branchId)
                .catch(err => {
                    console.error('Error calling ToggleBranchSession:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    function downloadCsv(content, fileName) {
        const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);
        
        link.setAttribute('href', url);
        link.setAttribute('download', fileName);
        link.style.visibility = 'hidden';
        
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    // Initialize DotNet reference when the page loads
    document.addEventListener('DOMContentLoaded', function() {
        // This will be set by the Blazor component
    });
</script>