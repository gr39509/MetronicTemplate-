    private async Task ExportToExcel()
    {
        try
        {
            var csvContent = "Branch ID,Branch Code,Branch Name,Open Date,Country,Currency,City,Address,Landline,Mobile,Min Loan,Max Loan,Min Interest Rate,Max Interest Rate,Session Open,Suspense Account\n";
            
            foreach (var branch in filteredBranches)
            {
                csvContent += $"\"{branch.Id}\",";
                csvContent += $"\"{branch.BranchCode}\",";
                csvContent += $"\"{branch.BranchName}\",";
                csvContent += $"\"{branch.BranchOpenDate:yyyy-MM-dd}\",";
                csvContent += $"\"{branch.Country}\",";
                csvContent += $"\"{branch.Currency}\",";
                csvContent += $"\"{branch.BranchCity}\",";
                csvContent += $"\"{branch.BranchAddress}\",";
                csvContent += $"\"{branch.BranchLandLine}\",";
                csvContent += $"\"{branch.BranchMobile}\",";
                csvContent += $"\"{branch.MinimumLoanAmount}\",";
                csvContent += $"\"{branch.MaximumLoanAmount}\",";
                csvContent += $"\"{branch.MinimumInterestRate}\",";
                csvContent += $"\"{branch.MaximumLoanInterestRate}\",";
                csvContent += $"\"{(branch.SessionOpen ? "Yes" : "No")}\",";
                csvContent += $"\"{branch.SuspenseAccountNumber}\"\n";
            }

            var fileName = $"Branches_{DateTime.Now:yyyyMMddHHmmss}.csv";
            await JSRuntime.InvokeVoidAsync("downloadCsv", csvContent, fileName);
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to export data: " + ex.Message;
            StateHasChanged();
        }
    }

