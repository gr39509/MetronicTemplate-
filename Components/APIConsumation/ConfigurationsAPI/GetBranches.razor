@page "/branches"
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.DataFields
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime

<div class="container mt-4">
    <h1 class="page-title">
        Branches Management
        <small>Manage bank branches and their configurations</small>
    </h1>

    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-home font-dark"></i>
                <span class="caption-subject bold uppercase">Branches</span>
            </div>
            <div class="actions">
                <button class="btn btn-circle btn-icon-only btn-default" @onclick="LoadBranches" title="Refresh">
                    <i class="fa fa-refresh"></i>
                </button>
                <button class="btn btn-circle btn-icon-only btn-success" @onclick="ShowAddModal" title="Add New Branch">
                    <i class="fa fa-plus"></i>
                </button>
            </div>
        </div>
        <div class="portlet-body">
            <!-- Statistics Cards -->
            @if (branches.Any())
            {
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card bg-primary text-white">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="flex-grow-1">
                                        <h4 class="mb-0">@branches.Count</h4>
                                        <small>Total Branches</small>
                                    </div>
                                    <div class="flex-shrink-0">
                                        <i class="fa fa-building fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-success text-white">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="flex-grow-1">
                                        <h4 class="mb-0">@activeSessions</h4>
                                        <small>Active Sessions</small>
                                    </div>
                                    <div class="flex-shrink-0">
                                        <i class="fa fa-play-circle fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-info text-white">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="flex-grow-1">
                                        <h4 class="mb-0">@uniqueCountries</h4>
                                        <small>Countries</small>
                                    </div>
                                    <div class="flex-shrink-0">
                                        <i class="fa fa-globe fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-warning text-white">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="flex-grow-1">
                                        <h4 class="mb-0">GHC @totalLoanCapacity.ToString("F2")</h4>
                                        <small>Total Loan Capacity</small>
                                    </div>
                                    <div class="flex-shrink-0">
                                        <i class="fa fa-money fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Search and Filter Section -->
            @if (branches.Any())
            {
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">
                                    <i class="fa fa-search me-2"></i>
                                    Search & Filter
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="form-label">Search Branches</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="fa fa-search"></i></span>
                                                <input type="text" class="form-control" @bind="searchTerm" @oninput="OnSearchInput" placeholder="Search by branch name, code, city..." />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label class="form-label">Country</label>
                                            <select class="form-select" @bind="countryFilter">
                                                <option value="">All Countries</option>
                                                @foreach (var country in availableCountries)
                                                {
                                                    <option value="@country">@country</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label class="form-label">Session Status</label>
                                            <select class="form-select" @bind="sessionStatusFilter">
                                                <option value="all">All Sessions</option>
                                                <option value="active">Active Only</option>
                                                <option value="inactive">Inactive Only</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label class="form-label">Sort By</label>
                                            <select class="form-select" @bind="sortBy">
                                                <option value="name">Branch Name</option>
                                                <option value="code">Branch Code</option>
                                                <option value="date">Open Date</option>
                                                <option value="country">Country</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-md-12">
                                        <button class="btn btn-secondary" @onclick="ClearSearch">
                                            <i class="fa fa-times"></i> Clear Filters
                                        </button>
                                        <button class="btn btn-success" @onclick="ExportToExcel" disabled="@(!filteredBranches.Any())">
                                            <i class="fa fa-download"></i> Export to Excel
                                        </button>
                                        @* <button class="btn btn-info" @onclick="ToggleSessionAll" title="Toggle sessions for all branches"> *@
                                        @*     <i class="fa fa-power-off"></i>  *@
                                        @*     @(allSessionsActive ? "Close All Sessions" : "Open All Sessions") *@
                                        @* </button> *@
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Results Section -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-danger alert-dismissible">
                            <button type="button" class="close" @onclick="ClearErrorMessage">
                                <span>&times;</span>
                            </button>
                            <strong>Error!</strong> @errorMessage
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-success alert-dismissible">
                            <button type="button" class="close" @onclick="ClearSuccessMessage">
                                <span>&times;</span>
                            </button>
                            <strong>Success!</strong> @successMessage
                        </div>
                    </div>
                </div>
            }

            @if (filteredBranches?.Any() == true)
            {
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-building me-2"></i>
                                    Bank Branches
                                    <span class="badge bg-light text-dark ms-2">@filteredBranches.Count records</span>
                                    @if (!string.IsNullOrEmpty(searchTerm))
                                    {
                                        <span class="badge bg-info ms-2">Search: "@searchTerm"</span>
                                    }
                                    @if (!string.IsNullOrEmpty(countryFilter))
                                    {
                                        <span class="badge bg-warning ms-2">Country: @countryFilter</span>
                                    }
                                    @if (sessionStatusFilter != "all")
                                    {
                                        <span class="badge bg-success ms-2">@sessionStatusFilter.ToUpper()</span>
                                    }
                                </h5>
                            </div>
                            <br/>
                            <div class="card-body p-0">
                                <ReusableDataTable TItem="BranchViewModel"
                                                 Data="@filteredBranches"
                                                 Columns="@branchColumns"
                                                 Options="@branchOptions"
                                                 OnRowClick="@OnBranchRowClick" />
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (hasLoaded && !isLoading)
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-info text-center">
                            <i class="fa fa-info-circle fa-2x mb-3"></i>
                            <h5>No Branches Found</h5>
                            <p class="mb-0">
                                @if (!string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(countryFilter) || sessionStatusFilter != "all")
                                {
                                    <text>No branches found matching your search criteria.</text>
                                }
                                else
                                {
                                    <text>No branches have been configured in the system.</text>
                                }
                            </p>
                            @if (!string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(countryFilter) || sessionStatusFilter != "all")
                            {
                                <button class="btn btn-info mt-2" @onclick="ClearSearch">
                                    <i class="fa fa-times"></i> Clear Filters
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-success mt-2" @onclick="ShowAddModal">
                                    <i class="fa fa-plus"></i> Add First Branch
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Loading State -->
            @if (isLoading)
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-info text-center">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                            Loading branches...
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add/Edit Branch Modal -->
@if (showBranchModal)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header @(isEditing ? "bg-warning" : "bg-success") text-white">
                    <h5 class="modal-title">
                        <i class="fa @(isEditing ? "fa-edit" : "fa-plus") me-2"></i>
                        @(isEditing ? "Edit Branch" : "Add New Branch")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseBranchModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        @if (isEditing)
                        {
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label">Branch ID</label>
                                    <input type="text" class="form-control" value="@currentBranch.Id" disabled />
                                    <small class="form-text text-muted">Branch ID cannot be changed</small>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label">Branch ID *</label>
                                    <input type="number" class="form-control" @bind="newBranchId" 
                                           placeholder="Enter unique branch ID" min="1" />
                                    <small class="form-text text-muted">Unique numeric identifier for the branch</small>
                                </div>
                            </div>
                        }
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Branch Code *</label>
                                <input type="text" class="form-control" @bind="currentBranch.BranchCode" 
                                       placeholder="e.g., BR001" maxlength="20" />
                                <small class="form-text text-muted">Unique branch code identifier</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Branch Name *</label>
                                <input type="text" class="form-control" @bind="currentBranch.BranchName" 
                                       placeholder="Enter branch name" maxlength="100" />
                                <small class="form-text text-muted">Full name of the branch</small>
                            </div>
                        </div>
                        @* <div class="col-md-6"> *@
                        @*     <div class="form-group mb-3"> *@
                        @*         <label class="form-label">Branch Open Date *</label> *@
                        @*         <input type="date" class="form-control" @bind="branchOpenDateString" /> *@
                        @*         <small class="form-text text-muted">Date when the branch was opened</small> *@
                        @*     </div> *@
                        @* </div> *@
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Country *</label>
                                <input type="text" class="form-control" @bind="currentBranch.Country" 
                                       placeholder="Enter country" maxlength="50" />
                                <small class="form-text text-muted">Country where the branch is located</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Currency *</label>
                                <input type="text" class="form-control" @bind="currentBranch.Currency" 
                                       placeholder="e.g., USD, EUR" maxlength="10" />
                                <small class="form-text text-muted">Primary currency for the branch</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">City</label>
                                <input type="text" class="form-control" @bind="currentBranch.BranchCity" 
                                       placeholder="Enter city" maxlength="50" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Date Format</label>
                                <input type="text" class="form-control" @bind="currentBranch.DateFormat" 
                                       placeholder="e.g., MM/dd/yyyy" maxlength="20" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Branch Address</label>
                        <textarea class="form-control" @bind="currentBranch.BranchAddress" 
                                  placeholder="Enter full branch address" rows="2" maxlength="200"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Landline Phone</label>
                                <input type="text" class="form-control" @bind="currentBranch.BranchLandLine" 
                                       placeholder="e.g., +1234567890" maxlength="20" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Mobile Phone</label>
                                <input type="text" class="form-control" @bind="currentBranch.BranchMobile" 
                                       placeholder="e.g., +1234567890" maxlength="20" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Minimum Loan Amount</label>
                                <input type="number" class="form-control" @bind="currentBranch.MinimumLoanAmount" 
                                       placeholder="0.00" step="0.01" min="0" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Maximum Loan Amount</label>
                                <input type="number" class="form-control" @bind="currentBranch.MaximumLoanAmount" 
                                       placeholder="0.00" step="0.01" min="0" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Minimum Interest Rate (%)</label>
                                <input type="number" class="form-control" @bind="currentBranch.MinimumInterestRate" 
                                       placeholder="0.00" step="0.01" min="0" max="100" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Maximum Interest Rate (%)</label>
                                <input type="number" class="form-control" @bind="currentBranch.MaximumLoanInterestRate" 
                                       placeholder="0.00" step="0.01" min="0" max="100" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Suspense Account Number</label>
                        <input type="text" class="form-control" @bind="currentBranch.SuspenseAccountNumber" 
                               placeholder="Enter account number" maxlength="50" />
                    </div>

                    <div class="form-group mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" @bind="currentBranch.SessionOpen" />
                            <label class="form-check-label">
                                <strong>Session Open</strong>
                            </label>
                        </div>
                        <small class="form-text text-muted">
                            @if (currentBranch.SessionOpen)
                            {
                                <text>Branch session is currently active</text>
                            }
                            else
                            {
                                <text>Branch session is currently closed</text>
                            }
                        </small>
                    </div>

                    @if (!string.IsNullOrEmpty(validationMessage))
                    {
                        <div class="alert alert-warning">
                            <i class="fa fa-exclamation-triangle"></i> @validationMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseBranchModal">Cancel</button>
                    <button type="button" class="btn @(isEditing ? "btn-warning" : "btn-success")" 
                            @onclick="SaveBranch" disabled="@IsSaveDisabled">
                        <i class="fa @(isEditing ? "fa-save" : "fa-plus") me-1"></i>
                        @(isEditing ? "Update" : "Create") Branch
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && branchToDelete != null)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        Confirm Deletion
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the following branch?</p>
                    <div class="alert alert-warning">
                        <strong>@branchToDelete.BranchName</strong> (Code: @branchToDelete.BranchCode)<br />
                        <small>ID: @branchToDelete.Id | Country: @branchToDelete.Country</small>
                    </div>
                    <p class="text-danger">
                        <i class="fa fa-warning"></i> This action cannot be undone! This will affect all accounts and transactions associated with this branch.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
                        <i class="fa fa-trash me-1"></i> Delete Branch
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Session Toggle Modal -->
@if (showSessionModal && branchForSession != null)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header @(branchForSession.SessionOpen ? "bg-warning" : "bg-success") text-white">
                    <h5 class="modal-title">
                        <i class="fa fa-power-off me-2"></i>
                        @(branchForSession.SessionOpen ? "Close Branch Session" : "Open Branch Session")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseSessionModal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to @(branchForSession.SessionOpen ? "close" : "open") the session for:</p>
                    <div class="alert @(branchForSession.SessionOpen ? "alert-warning" : "alert-success")">
                        <strong>@branchForSession.BranchName</strong> (Code: @branchForSession.BranchCode)<br />
                        <small>@branchForSession.BranchCity, @branchForSession.Country</small>
                    </div>
                    @if (branchForSession.SessionOpen)
                    {
                        <p class="text-warning">
                            <i class="fa fa-info-circle"></i> Closing the session will prevent new transactions until the session is reopened.
                        </p>
                    }
                    else
                    {
                        <p class="text-success">
                            <i class="fa fa-info-circle"></i> Opening the session will allow new transactions to be processed.
                        </p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseSessionModal">Cancel</button>
                    <button type="button" class="btn @(branchForSession.SessionOpen ? "btn-warning" : "btn-success")" @onclick="ToggleSession">
                        <i class="fa fa-power-off me-1"></i>
                        @(branchForSession.SessionOpen ? "Close Session" : "Open Session")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BranchViewModel> branches = new();
    private List<BranchViewModel> filteredBranches = new();
    private List<DataTableColumn> branchColumns = new();
    private DataTableOptions branchOptions = new();
    private bool isLoading = false;
    private bool hasLoaded = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string validationMessage = string.Empty;
    
    // Search and filter fields
    private string searchTerm = "";
    private string countryFilter = "";
    private string sessionStatusFilter = "all";
    private string sortBy = "name";
    
    // Modal fields
    private bool showBranchModal = false;
    private bool showDeleteModal = false;
    private bool showSessionModal = false;
    private bool isEditing = false;
    private BranchViewModel currentBranch = new();
    private BranchViewModel branchToDelete = null;
    private BranchViewModel branchForSession = null;
    private int newBranchId = 0;
    private string branchOpenDateString = "";
    
    // Statistics
    private int activeSessions = 0;
    private int uniqueCountries = 0;
    private double totalLoanCapacity = 0;
    private bool allSessionsActive = false;

    protected override async Task OnInitializedAsync()
    {
        ConfigureBranchTable();
        await LoadBranches();
    }

    private void ConfigureBranchTable()
    {
        branchColumns = new List<DataTableColumn>
        {
            new()
            {
                Header = "BRANCH ID",
                PropertyName = nameof(BranchViewModel.Id),
                Width = 100,
                CssClass = "text-center",
                CustomRenderer = (item) =>
                {
                    var branchId = ((BranchViewModel)item).Id;
                    var badgeClass = GetBranchBadgeClass(branchId);
                    return $"<span class='badge {badgeClass}'>{branchId}</span>";
                }
            },
            new()
            {
                Header = "BRANCH CODE",
                PropertyName = nameof(BranchViewModel.BranchCode),
                Width = 120,
                CssClass = "text-center",
                CustomRenderer = (item) =>
                {
                    var branchCode = ((BranchViewModel)item).BranchCode;
                    return string.IsNullOrEmpty(branchCode)
                        ? "<span class='text-muted'>N/A</span>"
                        : $"<strong class='text-primary'>{branchCode}</strong>";
                }
            },
            new()
            {
                Header = "BRANCH NAME",
                PropertyName = nameof(BranchViewModel.BranchName),
                CustomRenderer = (item) =>
                {
                    var branch = (BranchViewModel)item;
                    var name = branch.BranchName;
                    var city = branch.BranchCity;
                    
                    var display = string.IsNullOrEmpty(name)
                        ? "<span class='text-muted'><i>Unnamed Branch</i></span>"
                        : $"<strong class='text-primary'>{name}</strong>";
                    
                    if (!string.IsNullOrEmpty(city))
                    {
                        display += $"<br/><small class='text-muted'><i class='fa fa-map-marker'></i> {city}</small>";
                    }
                    
                    return display;
                }
            },
            new()
            {
                Header = "LOCATION",
                PropertyName = nameof(BranchViewModel.Country),
                Width = 150,
                CustomRenderer = (item) =>
                {
                    var branch = (BranchViewModel)item;
                    var country = branch.Country;
                    var currency = branch.Currency;
                    
                    var display = string.IsNullOrEmpty(country)
                        ? "<span class='text-muted'>N/A</span>"
