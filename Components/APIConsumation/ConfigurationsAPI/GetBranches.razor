    private async Task LoadBranches()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;
            validationMessage = string.Empty;
            StateHasChanged();

            Console.WriteLine($"🔍 Loading branches...");

            var result = await ApiClient.GetBranchesAsync(
                bP_Tenant: null,
                accept_Language: null
            );

            if (result?.Payload != null)
            {
                branches = result.Payload.ToList();
                ApplyFilters();
                CalculateStatistics();
                Console.WriteLine($"✅ Found {branches.Count} branches");
            }
            else
            {
                branches = new List<BranchViewModel>();
                filteredBranches = new List<BranchViewModel>();
                ResetStatistics();
                Console.WriteLine($"ℹ️ No branches found");
            }
            
            hasLoaded = true;
        }
        catch (ApiException<ApiErrorResponse> apiEx)
        {
            errorMessage = apiEx.Result?.ErrorMessage ?? "Failed to load branches.";
            Console.WriteLine($"❌ API Error loading branches: {apiEx.Message}");
            branches = new List<BranchViewModel>();
            filteredBranches = new List<BranchViewModel>();
            ResetStatistics();
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}). Please try again.";
            Console.WriteLine($"❌ API Exception: {ex.Message}");
            branches = new List<BranchViewModel>();
            filteredBranches = new List<BranchViewModel>();
            ResetStatistics();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load branches. Please check your connection.";
            Console.WriteLine($"❌ Error loading branches: {ex.Message}");
            branches = new List<BranchViewModel>();
            filteredBranches = new List<BranchViewModel>();
            ResetStatistics();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        var query = branches.AsEnumerable();

        // Apply search filter
        if (!string.IsNullOrEmpty(searchTerm))
        {
            query = query.Where(b =>
                b.BranchName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true ||
                b.BranchCode?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true ||
                b.BranchCity?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true ||
                b.Country?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true
            );
        }

        // Apply country filter
        if (!string.IsNullOrEmpty(countryFilter))
        {
            query = query.Where(b => b.Country == countryFilter);
        }

        // Apply session status filter
        if (sessionStatusFilter != "all")
        {
            var sessionOpen = sessionStatusFilter == "active";
            query = query.Where(b => b.SessionOpen == sessionOpen);
        }

        // Apply sorting
        query = sortBy switch
        {
            "code" => query.OrderBy(b => b.BranchCode),
            "date" => query.OrderBy(b => b.BranchOpenDate),
            "country" => query.OrderBy(b => b.Country).ThenBy(b => b.BranchName),
            _ => query.OrderBy(b => b.BranchName)
        };

        filteredBranches = query.ToList();
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void ClearSearch()
    {
        searchTerm = "";
        countryFilter = "";
        sessionStatusFilter = "all";
        ApplyFilters();
    }

    private List<string> availableCountries => branches
        .Where(b => !string.IsNullOrEmpty(b.Country))
        .Select(b => b.Country)
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    private void CalculateStatistics()
    {
        activeSessions = branches.Count(b => b.SessionOpen);
        uniqueCountries = branches.Select(b => b.Country).Distinct().Count();
        totalLoanCapacity = branches.Sum(b => b.MaximumLoanAmount);
        allSessionsActive = branches.All(b => b.SessionOpen) && branches.Any();
    }

    private void ResetStatistics()
    {
        activeSessions = 0;
        uniqueCountries = 0;
        totalLoanCapacity = 0;
        allSessionsActive = false;
    }

    private string GetBranchBadgeClass(int branchId)
    {
        return branchId switch
        {
            <= 5 => "bg-primary",    // Primary branches
            <= 10 => "bg-success",   // Secondary branches
            <= 15 => "bg-info",      // Tertiary branches
            <= 20 => "bg-warning",   // Additional branches
            _ => "bg-secondary"      // Other branches
        };
    }

