            errorMessage = "Failed to delete branch. Please try again.";
            Console.WriteLine($"❌ Error deleting branch: {ex.Message}");
        }
    }

    private async Task ToggleSession()
    {
        try
        {
            if (branchForSession == null) return;

            // TODO: Implement actual API call to toggle session
            await Task.Delay(300);

            branchForSession.SessionOpen = !branchForSession.SessionOpen;
            if (branchForSession.SessionOpen)
            {
                branchForSession.SessionLastOpenedAt = DateTimeOffset.Now;
            }

            successMessage = $"Session {(branchForSession.SessionOpen ? "opened" : "closed")} for {branchForSession.BranchName}!";
            
            ApplyFilters();
            CalculateStatistics();
            CloseSessionModal();
            
            Console.WriteLine($"✅ {(branchForSession.SessionOpen ? "Opened" : "Closed")} session for branch: {branchForSession.BranchName}");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to toggle session. Please try again.";
            Console.WriteLine($"❌ Error toggling session: {ex.Message}");
        }
    }

    private async Task ToggleSessionAll()
    {
        try
        {
            var newSessionState = !allSessionsActive;
            
            // TODO: Implement actual API call to toggle all sessions
            await Task.Delay(500);

            foreach (var branch in branches)
            {
                branch.SessionOpen = newSessionState;
                if (newSessionState)
                {
                    branch.SessionLastOpenedAt = DateTimeOffset.Now;
                }
            }

            successMessage = $"All sessions {(newSessionState ? "opened" : "closed")} successfully!";
            ApplyFilters();
            CalculateStatistics();
            
            Console.WriteLine($"✅ {(newSessionState ? "Opened" : "Closed")} all branch sessions");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to toggle all sessions. Please try again.";
            Console.WriteLine($"❌ Error toggling all sessions: {ex.Message}");
        }
    }

