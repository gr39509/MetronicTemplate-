@page "/document-types"
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.DataFields
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime

<div class="container mt-4">
    <h1 class="page-title">
        Document Types
        <small>Manage and view all document types</small>
    </h1>

    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-doc font-dark"></i>
                <span class="caption-subject bold uppercase">Document Types Management</span>
            </div>
            <div class="actions">
                <button class="btn btn-circle btn-icon-only btn-default" @onclick="LoadDocumentTypes" title="Refresh">
                    <i class="fa fa-refresh"></i>
                </button>
                <button class="btn btn-circle btn-icon-only btn-success" @onclick="ShowAddModal" title="Add New Document Type">
                    <i class="fa fa-plus"></i>
                </button>
            </div>
        </div>
        <div class="portlet-body">
            <!-- Statistics Cards -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">@documentTypes.Count</h4>
                                    <small>Total Document Types</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="fa fa-file-text fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">@highestDocumentTypeId</h4>
                                    <small>Highest Document Type ID</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="fa fa-hashtag fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search and Filter Section -->
            <div class="row mb-3">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="fa fa-search me-2"></i>
                                Search & Filter
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">Search Document Types</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fa fa-search"></i></span>
                                            <input type="text" class="form-control" @bind="searchTerm" @oninput="OnSearchInput" placeholder="Search by document type name..." />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="form-label">Sort By</label>
                                        <select class="form-select" @bind="sortBy">
                                            <option value="name">Type Name</option>
                                            <option value="id">Document Type ID</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="form-label">Sort Order</label>
                                        <select class="form-select" @bind="sortOrder">
                                            <option value="asc">Ascending</option>
                                            <option value="desc">Descending</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-12">
                                    <button class="btn btn-secondary" @onclick="ClearSearch">
                                        <i class="fa fa-times"></i> Clear Search
                                    </button>
                                    <button class="btn btn-success" @onclick="ExportToExcel" disabled="@(!filteredDocumentTypes.Any())">
                                        <i class="fa fa-download"></i> Export to Excel
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results Section -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-danger alert-dismissible">
                            <button type="button" class="close" @onclick="ClearErrorMessage">
                                <span>&times;</span>
                            </button>
                            <strong>Error!</strong> @errorMessage
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-success alert-dismissible">
                            <button type="button" class="close" @onclick="ClearSuccessMessage">
                                <span>&times;</span>
                            </button>
                            <strong>Success!</strong> @successMessage
                        </div>
                    </div>
                </div>
            }

            @if (filteredDocumentTypes?.Any() == true)
            {
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-file-text me-2"></i>
                                    Document Types
                                    <span class="badge bg-light text-dark ms-2">@filteredDocumentTypes.Count records</span>
                                    @if (!string.IsNullOrEmpty(searchTerm))
                                    {
                                        <span class="badge bg-info ms-2">Search: "@searchTerm"</span>
                                    }
                                </h5>
                            </div>
                            <br/>
                            <div class="card-body p-0">
                                <ReusableDataTable TItem="DocumentTypeViewModel"
                                                 Data="@filteredDocumentTypes"
                                                 Columns="@documentTypeColumns"
                                                 Options="@documentTypeOptions"
                                                 OnRowClick="@OnDocumentTypeRowClick" />
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (hasLoaded && !isLoading)
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-info text-center">
                            <i class="fa fa-info-circle fa-2x mb-3"></i>
                            <h5>No Document Types Found</h5>
                            <p class="mb-0">
                                @if (!string.IsNullOrEmpty(searchTerm))
                                {
                                    <text>No document types found matching your search criteria.</text>
                                }
                                else
                                {
                                    <text>No document types have been configured yet.</text>
                                }
                            </p>
                            @if (!string.IsNullOrEmpty(searchTerm))
                            {
                                <button class="btn btn-info mt-2" @onclick="ClearSearch">
                                    <i class="fa fa-times"></i> Clear Search
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-success mt-2" @onclick="ShowAddModal">
                                    <i class="fa fa-plus"></i> Add First Document Type
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Loading State -->
            @if (isLoading)
            {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-12">
                        <div class="alert alert-info text-center">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                            Loading document types...
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add/Edit Document Type Modal -->
@if (showDocumentTypeModal)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header @(isEditing ? "bg-warning" : "bg-success") text-white">
                    <h5 class="modal-title">
                        <i class="fa @(isEditing ? "fa-edit" : "fa-plus") me-2"></i>
                        @(isEditing ? "Edit Document Type" : "Add New Document Type")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDocumentTypeModal"></button>
                </div>
                <div class="modal-body">
                    @if (isEditing)
                    {
                        <div class="form-group mb-3">
                            <label class="form-label">Document Type ID</label>
                            <input type="text" class="form-control" value="@currentDocumentType.DocumentTypeID" disabled />
                            <small class="form-text text-muted">Document Type ID cannot be changed</small>
                        </div>
                    }
                    else
                    {
                        <div class="form-group mb-3">
                            <label class="form-label">Document Type ID *</label>
                            <input type="number" class="form-control" @bind="newDocumentTypeId" 
                                   placeholder="Enter unique document type ID" min="1" />
                            <small class="form-text text-muted">Unique numeric identifier for the document type</small>
                        </div>
                    }
                    <div class="form-group mb-3">
                        <label class="form-label">Document Type Name *</label>
                        <input type="text" class="form-control" @bind="currentDocumentType.TypeName" 
                               placeholder="Enter document type name" />
                        <small class="form-text text-muted">Descriptive name for the document type</small>
                    </div>
                    @if (!string.IsNullOrEmpty(validationMessage))
                    {
                        <div class="alert alert-warning">
                            <i class="fa fa-exclamation-triangle"></i> @validationMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDocumentTypeModal">Cancel</button>
                    <button type="button" class="btn @(isEditing ? "btn-warning" : "btn-success")" 
                            @onclick="SaveDocumentType" disabled="@IsSaveDisabled">
                        <i class="fa @(isEditing ? "fa-save" : "fa-plus") me-1"></i>
                        @(isEditing ? "Update" : "Create") Document Type
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && documentTypeToDelete != null)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        Confirm Deletion
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the following document type?</p>
                    <div class="alert alert-warning">
                        <strong>ID: @documentTypeToDelete.DocumentTypeID</strong> - @documentTypeToDelete.TypeName
                    </div>
                    <p class="text-danger">
                        <i class="fa fa-warning"></i> This action cannot be undone!
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
                        <i class="fa fa-trash me-1"></i> Delete Document Type
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DocumentTypeViewModel> documentTypes = new();
    private List<DocumentTypeViewModel> filteredDocumentTypes = new();
    private List<DataTableColumn> documentTypeColumns = new();
    private DataTableOptions documentTypeOptions = new();
    private bool isLoading = true;
    private bool hasLoaded = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string validationMessage = string.Empty;
    
    // Search and filter fields
    private string searchTerm = "";
    private string sortBy = "name";
    private string sortOrder = "asc";
    
    // Modal fields
    private bool showDocumentTypeModal = false;
    private bool showDeleteModal = false;
    private bool isEditing = false;
    private DocumentTypeViewModel currentDocumentType = new();
    private DocumentTypeViewModel documentTypeToDelete = null;
    private int newDocumentTypeId = 0;
    
    // Statistics
    private int highestDocumentTypeId = 0;

    protected override async Task OnInitializedAsync()
    {
        ConfigureDocumentTypeTable();
        await LoadDocumentTypes();
    }

    private void ConfigureDocumentTypeTable()
    {
        documentTypeColumns = new List<DataTableColumn>
        {
            new()
            {
                Header = "DOCUMENT TYPE ID",
                PropertyName = nameof(DocumentTypeViewModel.DocumentTypeID),
                Width = 150,
                CssClass = "text-center",
                CustomRenderer = (item) =>
                {
                    var typeId = ((DocumentTypeViewModel)item).DocumentTypeID;
                    return $"<span class='badge bg-primary'>{typeId}</span>";
                }
            },
            new()
            {
                Header = "DOCUMENT TYPE NAME",
                PropertyName = nameof(DocumentTypeViewModel.TypeName),
                CustomRenderer = (item) =>
                {
                    var typeName = ((DocumentTypeViewModel)item).TypeName;
                    return string.IsNullOrEmpty(typeName)
                        ? "<span class='text-muted'>N/A</span>"
                        : $"<strong class='text-primary'>{typeName}</strong>";
                }
            },
            new()
            {
                Header = "ACTIONS",
                PropertyName = "",
                Sortable = false,
                Searchable = false,
                Width = 120,
                CssClass = "text-center",
                CustomRenderer = (item) => 
                {
                    var documentType = (DocumentTypeViewModel)item;
                    return $@"
                        <div class='btn-group btn-group-sm' role='group'>
                            <button type='button' class='btn btn-warning btn-xs' onclick='editDocumentType({documentType.DocumentTypeID})' title='Edit'>
                                <i class='fa fa-edit'></i>
                            </button>
                            <button type='button' class='btn btn-danger btn-xs' onclick='deleteDocumentType({documentType.DocumentTypeID})' title='Delete'>
                                <i class='fa fa-trash'></i>
                            </button>
                        </div>";
                }
            }
        };

        documentTypeOptions = new DataTableOptions
        {
            PageLength = 15,
            LengthMenu = new[] { 15, 30, 50, 100 },
            LengthMenuLabels = new[] { "15", "30", "50", "100" },
            SearchPlaceholder = "Search document types...",
            TableId = "documentTypesTable",
            TableCssClass = "table table-striped table-bordered table-hover mb-0",
            HeaderCssClass = "leadBold bg-green-meadow font-white",
            RowCssClass = "",
            ShowSearch = true,
            ShowPaging = true,
            ShowInfo = true,
            ShowLengthMenu = true,
            Responsive = true,
            AdditionalOptions = new Dictionary<string, object>
            {
                ["order"] = new object[] { new object[] { 1, "asc" } }, // Default sort by type name
                ["language"] = new Dictionary<string, object>
                {
                    ["search"] = "Search document types:",
                    ["lengthMenu"] = "Show _MENU_ records per page",
                    ["info"] = "Showing _START_ to _END_ of _TOTAL_ document types",
                    ["infoEmpty"] = "No document types found",
                    ["infoFiltered"] = "(filtered from _MAX_ total document types)",
                    ["emptyTable"] = "No document type data available",
                    ["zeroRecords"] = "No matching document types found"
                }
            }
        };
    }

    private async Task LoadDocumentTypes()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;
            validationMessage = string.Empty;
            StateHasChanged();

            Console.WriteLine($"🔍 Loading document types...");

            var result = await ApiClient.GetDocumentTypesAsync(
                bP_Tenant: null,
                accept_Language: null
            );

            if (result?.Payload != null)
            {
                documentTypes = result.Payload.ToList();
                ApplyFilters();
                CalculateStatistics();
                Console.WriteLine($"✅ Found {documentTypes.Count} document type records");
            }
            else
            {
                documentTypes = new List<DocumentTypeViewModel>();
                filteredDocumentTypes = new List<DocumentTypeViewModel>();
                ResetStatistics();
                Console.WriteLine($"ℹ️ No document type records found");
            }
            
            hasLoaded = true;
        }
        catch (ApiException<ApiErrorResponse> apiEx)
        {
            errorMessage = apiEx.Result?.ErrorMessage ?? "Failed to load document types.";
            Console.WriteLine($"❌ API Error loading document types: {apiEx.Message}");
            documentTypes = new List<DocumentTypeViewModel>();
            filteredDocumentTypes = new List<DocumentTypeViewModel>();
            ResetStatistics();
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}). Please try again.";
            Console.WriteLine($"❌ API Exception: {ex.Message}");
            documentTypes = new List<DocumentTypeViewModel>();
            filteredDocumentTypes = new List<DocumentTypeViewModel>();
            ResetStatistics();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load document types. Please check your connection.";
            Console.WriteLine($"❌ Error loading document types: {ex.Message}");
            documentTypes = new List<DocumentTypeViewModel>();
            filteredDocumentTypes = new List<DocumentTypeViewModel>();
            ResetStatistics();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        var query = documentTypes.AsEnumerable();

        // Apply search filter
        if (!string.IsNullOrEmpty(searchTerm))
        {
            query = query.Where(dt =>
                (dt.TypeName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
                dt.DocumentTypeID.ToString().Contains(searchTerm)
            );
        }

        // Apply sorting
        query = sortBy switch
        {
            "id" => sortOrder == "asc" 
                ? query.OrderBy(dt => dt.DocumentTypeID)
                : query.OrderByDescending(dt => dt.DocumentTypeID),
            _ => sortOrder == "asc" 
                ? query.OrderBy(dt => dt.TypeName)
                : query.OrderByDescending(dt => dt.TypeName)
        };

        filteredDocumentTypes = query.ToList();
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void ClearSearch()
    {
        searchTerm = "";
        ApplyFilters();
    }

    private void CalculateStatistics()
    {
        highestDocumentTypeId = documentTypes.Any() ? documentTypes.Max(dt => dt.DocumentTypeID) : 0;
    }

    private void ResetStatistics()
    {
        highestDocumentTypeId = 0;
    }

    private void ShowAddModal()
    {
        currentDocumentType = new DocumentTypeViewModel();
        newDocumentTypeId = highestDocumentTypeId + 1; // Suggest next available ID
        isEditing = false;
        validationMessage = string.Empty;
        showDocumentTypeModal = true;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task EditDocumentType(int documentTypeId)
    {
        var documentType = documentTypes.FirstOrDefault(dt => dt.DocumentTypeID == documentTypeId);
        if (documentType != null)
        {
            currentDocumentType = new DocumentTypeViewModel
            {
                DocumentTypeID = documentType.DocumentTypeID,
                TypeName = documentType.TypeName
            };
            isEditing = true;
            validationMessage = string.Empty;
            showDocumentTypeModal = true;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task DeleteDocumentType(int documentTypeId)
    {
        documentTypeToDelete = documentTypes.FirstOrDefault(dt => dt.DocumentTypeID == documentTypeId);
        if (documentTypeToDelete != null)
        {
            showDeleteModal = true;
            StateHasChanged();
        }
    }

    private async Task SaveDocumentType()
    {
        try
        {
            validationMessage = string.Empty;

            if (isEditing)
            {
                if (string.IsNullOrEmpty(currentDocumentType.TypeName))
                {
                    validationMessage = "Document Type Name is required.";
                    return;
                }
            }
            else
            {
                if (newDocumentTypeId <= 0)
                {
                    validationMessage = "Please enter a valid Document Type ID (must be greater than 0).";
                    return;
                }

                if (string.IsNullOrEmpty(currentDocumentType.TypeName))
                {
                    validationMessage = "Document Type Name is required.";
                    return;
                }

                if (documentTypes.Any(dt => dt.DocumentTypeID == newDocumentTypeId))
                {
                    validationMessage = "A document type with this ID already exists.";
                    return;
                }

                if (documentTypes.Any(dt => dt.TypeName?.Equals(currentDocumentType.TypeName, StringComparison.OrdinalIgnoreCase) == true))
                {
                    validationMessage = "A document type with this name already exists.";
                    return;
                }
            }

            // TODO: Implement actual API call to save document type
            // For now, we'll simulate the save operation
            await Task.Delay(500);

            if (isEditing)
            {
                // Update existing document type
                var existing = documentTypes.FirstOrDefault(dt => dt.DocumentTypeID == currentDocumentType.DocumentTypeID);
                if (existing != null)
                {
                    existing.TypeName = currentDocumentType.TypeName;
                }
                successMessage = "Document type updated successfully!";
            }
            else
            {
                // Add new document type
                documentTypes.Add(new DocumentTypeViewModel
                {
                    DocumentTypeID = newDocumentTypeId,
                    TypeName = currentDocumentType.TypeName
                });
                successMessage = "Document type created successfully!";
            }

            ApplyFilters();
            CalculateStatistics();
            CloseDocumentTypeModal();
            
            Console.WriteLine($"✅ {(isEditing ? "Updated" : "Created")} document type: {currentDocumentType.TypeName}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to {(isEditing ? "update" : "create")} document type. Please try again.";
            Console.WriteLine($"❌ Error saving document type: {ex.Message}");
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            if (documentTypeToDelete == null) return;

            // TODO: Implement actual API call to delete document type
            await Task.Delay(500);

            documentTypes.RemoveAll(dt => dt.DocumentTypeID == documentTypeToDelete.DocumentTypeID);
            successMessage = "Document type deleted successfully!";
            
            ApplyFilters();
            CalculateStatistics();
            CloseDeleteModal();
            
            Console.WriteLine($"✅ Deleted document type: {documentTypeToDelete.TypeName}");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to delete document type. Please try again.";
            Console.WriteLine($"❌ Error deleting document type: {ex.Message}");
        }
    }

    private void CloseDocumentTypeModal()
    {
        showDocumentTypeModal = false;
        currentDocumentType = new DocumentTypeViewModel();
        newDocumentTypeId = 0;
        validationMessage = string.Empty;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        documentTypeToDelete = null;
        StateHasChanged();
    }

    private bool IsSaveDisabled
    {
        get
        {
            if (isEditing)
            {
                return string.IsNullOrEmpty(currentDocumentType.TypeName);
            }
            else
            {
                return newDocumentTypeId <= 0 || string.IsNullOrEmpty(currentDocumentType.TypeName);
            }
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            var csvContent = "Document Type ID,Document Type Name\n";
            
            foreach (var documentType in filteredDocumentTypes)
            {
                csvContent += $"\"{documentType.DocumentTypeID}\",";
                csvContent += $"\"{documentType.TypeName}\"\n";
            }

            var fileName = $"DocumentTypes_{DateTime.Now:yyyyMMddHHmmss}.csv";
            await JSRuntime.InvokeVoidAsync("downloadCsv", csvContent, fileName);
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to export data: " + ex.Message;
            StateHasChanged();
        }
    }

    private void ClearErrorMessage()
    {
        errorMessage = string.Empty;
        StateHasChanged();
    }

    private void ClearSuccessMessage()
    {
        successMessage = string.Empty;
        StateHasChanged();
    }

    private void OnDocumentTypeRowClick(DocumentTypeViewModel documentType)
    {
        Console.WriteLine($"Document type row clicked: {documentType.TypeName} (ID: {documentType.DocumentTypeID})");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("setDotNetReference", 
                DotNetObjectReference.Create(this));
        }
    }
}

<style>
    .page-title {
        margin: 20px 0;
        font-size: 28px;
        font-weight: 300;
    }

    .page-title small {
        color: #888;
        font-size: 14px;
        margin-left: 10px;
    }

    .portlet.light.bordered {
        background-color: #fff;
        border: 1px solid #e7ecf1;
        margin-bottom: 20px;
    }

    .portlet > .portlet-title {
        border-bottom: 1px solid #eee;
        padding: 15px 20px;
        margin-bottom: 0;
    }

    .portlet > .portlet-body {
        padding: 20px;
    }

    .card {
        margin-bottom: 1rem;
    }

    .btn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .text-truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    code {
        background-color: #f8f9fa;
        padding: 2px 4px;
        border-radius: 3px;
        font-size: 0.875em;
        color: #e83e8c;
    }

    .fw-bold {
        font-weight: bold;
    }

    .spinner-border-sm {
        width: 1rem;
        height: 1rem;
    }

    .modal {
        backdrop-filter: blur(5px);
    }

    .btn-xs {
        padding: 1px 5px;
        font-size: 12px;
        line-height: 1.5;
    }

    .form-text {
        font-size: 0.875rem;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.35em 0.65em;
    }
</style>

<script>
    // Make the DotNet reference available globally
    window.dotNetReference = null;

    // Set the DotNet reference when the component is initialized
    window.setDotNetReference = (reference) => {
        window.dotNetReference = reference;
    };

    window.editDocumentType = function(documentTypeId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('EditDocumentType', documentTypeId)
                .catch(err => {
                    console.error('Error calling EditDocumentType:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    window.deleteDocumentType = function(documentTypeId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('DeleteDocumentType', documentTypeId)
                .catch(err => {
                    console.error('Error calling DeleteDocumentType:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    function downloadCsv(content, fileName) {
        const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);
        
        link.setAttribute('href', url);
        link.setAttribute('download', fileName);
        link.style.visibility = 'hidden';
        
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    // Initialize DotNet reference when the page loads
    document.addEventListener('DOMContentLoaded', function() {
        // This will be set by the Blazor component
    });
</script>