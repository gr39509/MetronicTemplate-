<script>
    // Make the DotNet reference available globally
    window.dotNetReference = null;

    // Set the DotNet reference when the component is initialized
    window.setDotNetReference = (reference) => {
        window.dotNetReference = reference;
    };

    window.editClientType = function(clientTypeId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('EditClientType', clientTypeId)
                .catch(err => {
                    console.error('Error calling EditClientType:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    window.deleteClientType = function(clientTypeId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('DeleteClientType', clientTypeId)
                .catch(err => {
                    console.error('Error calling DeleteClientType:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    function downloadCsv(content, fileName) {
        const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);
        
        link.setAttribute('href', url);
        link.setAttribute('download', fileName);
        link.style.visibility = 'hidden';
        
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    // Initialize DotNet reference when the page loads
    document.addEventListener('DOMContentLoaded', function() {
        // This will be set by the Blazor component
    });
</script>