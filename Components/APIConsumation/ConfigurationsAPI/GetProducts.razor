    private async Task ExportToExcel()
    {
        try
        {
            var csvContent = "Product ID,Product Name,Product Type,GL Code,GL Name,Income GL,Intermediary GL,Is Susu,Is Fixed Deposit,Has Taxes,Date Created,Created By\n";

            foreach (var product in filteredProducts)
            {
                csvContent += $"\"{product.ProductID}\",";
                csvContent += $"\"{product.ProductName}\",";
                csvContent += $"\"{product.ProductTypeName}\",";
                csvContent += $"\"{product.GlCode}\",";
                csvContent += $"\"{product.GlName}\",";
                csvContent += $"\"{product.IncomeGL}\",";
                csvContent += $"\"{product.IntermediaryGL}\",";
                csvContent += $"\"{(product.IsSusu ? "Yes" : "No")}\",";
                csvContent += $"\"{(product.IsFixedDeposit ? "Yes" : "No")}\",";
                csvContent += $"\"{(product.HasTaxes ? "Yes" : "No")}\",";
                csvContent += $"\"{product.DateCreated:yyyy-MM-dd}\",";
                csvContent += $"\"{product.UserCreated}\"\n";
            }

            var fileName = $"Products_{DateTime.Now:yyyyMMddHHmmss}.csv";
            await JSRuntime.InvokeVoidAsync("downloadCsv", csvContent, fileName);
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to export data: " + ex.Message;
            StateHasChanged();
        }
    }

