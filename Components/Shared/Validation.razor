@inject NavigationManager Navigation
@inject IJSRuntime JS

<nav class="quick-nav">
    <a class="quick-nav-trigger" href="#0">
        <span aria-hidden="true"></span>
    </a>
    <ul id="myNav">
        <li @onclick="HandleAction">
            <a class="active">
                <span style="font-size: 15px;">@ButtonText</span>
                <i class="@IconClass"></i>
            </a>
        </li>
    </ul>
    <span aria-hidden="true" class="quick-nav-bg"></span>
</nav>
<div class="quick-nav-overlay"></div>

@code {
    [Parameter]
    public string ButtonText { get; set; } = "Start New Action";

    [Parameter]
    public string IconClass { get; set; } = "icon-wallet";

    [Parameter]
    public string ValidationUrl { get; set; } = "/api/validate";

    [Parameter]
    public string RedirectUrl { get; set; } = "/action/create";

    [Parameter]
    public string DialogTitle { get; set; } = "Enter Value";

    [Parameter]
    public string InputPlaceholder { get; set; } = "";

    [Parameter]
    public string ParameterName { get; set; } = "value";

    private async Task HandleAction()
    {
        var result = await JS.InvokeAsync<string>("showInputDialog", 
            DialogTitle,
            InputPlaceholder,
            ValidationUrl,
            RedirectUrl,
            ParameterName);
    }
}
<style>
   .quick-nav a {
        text-decoration: none;
        
    }
   
</style>
<script>
    window.showInputDialog = function(title, placeholder, validationUrl, redirectUrl, paramName) {
        return new Promise((resolve) => {
            swal({
                title: '<span class="lead"><span class="font-red-flamingo">' + title + '</span></span>',
                input: 'text',
                inputPlaceholder: placeholder,
                showCancelButton: true,
                confirmButtonText: 'Verify',
                confirmButtonColor: '#1BA39C',
                cancelButtonColor: '#22313F',
                showLoaderOnConfirm: true,
                preConfirm: function (inputValue) {
                    return new Promise(function (resolveInner, reject) {
                        setTimeout(function () {
                            if (inputValue == '') {
                                reject('Invalid input. Please try again.')
                            }
                            else {
                                var url = validationUrl + "?" + paramName + "=" + encodeURI(inputValue);
                                $.get(url, function (data) {
                                    if (data.includes('success')) {
                                        swal(
                                            'Verified!',
                                            data,
                                            'success'
                                        ).then(function () {
                                            location.href = redirectUrl + '?' + paramName + '=' + encodeURI(inputValue);
                                            resolveInner()
                                        })
                                    }
                                    else {
                                        swal({
                                            title: 'Error!',
                                            type: 'error',
                                            text: data
                                        })
                                    }
                                })
                            }
                        }, 2000)
                    })
                },
                allowOutsideClick: false
            }).then(function() {
                resolve('completed');
            }).catch(function() {
                resolve('cancelled');
            });
        });
    }
</script>

<link href="@Assets["/assets/global/plugins/SweetAlert2/sweetalert2.css"]" rel="stylesheet" />
<script src="@Assets["/assets/global/plugins/SweetAlert2/sweetalert2.all.js"]"></script>
<script src="@Assets["/assets/layouts/global/scripts/quick-nav.js"]" type="text/javascript"></script>
