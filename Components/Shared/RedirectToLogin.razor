@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

@code {
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("🔄 RedirectToLogin component initialized");
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        Console.WriteLine($"🔄 RedirectToLogin auth state - IsAuthenticated: {state.User.Identity?.IsAuthenticated}");
        Console.WriteLine($"🔄 Current URL: {NavManager.Uri}");
        
        if (!state.User.Identity?.IsAuthenticated ?? true)
        {
            Console.WriteLine("🔄 User not authenticated, redirecting to login");
            NavManager.NavigateTo($"/login?ReturnUrl={Uri.EscapeDataString(NavManager.Uri)}", true);
        }
        else
        {
            Console.WriteLine("🔄 User is authenticated but RedirectToLogin was called - this shouldn't happen");
        }
    }
}
