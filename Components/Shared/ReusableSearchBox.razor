@* ReusableSearchBox.razor *@

<div class="search-wrapper" style="max-width: @MaxWidth;">
    <div class="input-group">
        <input type="search" 
               @bind="SearchValue"
               @bind:event="oninput"
               class="form-control search-animated border-0 border-bottom rounded-0 shadow-none py-3" 
               placeholder="@Placeholder"
               disabled="@Disabled">
        <button class="btn btn-link border-0 border-bottom rounded-0 search-button" 
                type="button"
                disabled="@Disabled"
                @onclick="HandleSearch">
            <i class="fas fa-search"></i>
        </button>
        @if (ShowClearButton && !string.IsNullOrWhiteSpace(SearchValue))
        {
            <button class="btn btn-link border-0 border-bottom rounded-0 search-button" 
                    type="button"
                    @onclick="ClearSearch">
                <i class="fas fa-times"></i>
            </button>
        }
    </div>
</div>

<style>
    .search-animated {
        transition: all 0.3s ease;
        border-bottom-color: @BorderColor !important;
    }

    .search-animated:focus {
        border-bottom-width: 2px !important;
        border-bottom-color: @FocusColor !important;
        background-color: transparent;
    }

    .search-button {
        border-bottom-color: @BorderColor !important;
        color: @BorderColor !important;
    }

    .search-button:hover {
        color: @HoverColor !important;
    }

    .search-animated:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }
</style>

@code {
    private string _searchValue = string.Empty;

    [Parameter]
    public string SearchValue 
    { 
        get => _searchValue;
        set
        {
            if (_searchValue != value)
            {
                _searchValue = value;
                SearchValueChanged.InvokeAsync(value);
                OnSearchChanged.InvokeAsync(value);
            }
        }
    }

    [Parameter]
    public EventCallback<string> SearchValueChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnSearchChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnSearchSubmit { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Type to search...";

    [Parameter]
    public string MaxWidth { get; set; } = "400px";

    [Parameter]
    public string BorderColor { get; set; } = "#32c5d2";

    [Parameter]
    public string FocusColor { get; set; } = "#32c5d2";

    [Parameter]
    public string HoverColor { get; set; } = "#2a9fb8";

    [Parameter]
    public bool ShowClearButton { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string TableId { get; set; } = string.Empty;

    private async Task HandleSearch()
    {
        await OnSearchSubmit.InvokeAsync(SearchValue);
        
        // If TableId is provided, trigger DataTable search
        if (!string.IsNullOrWhiteSpace(TableId))
        {
            await TriggerDataTableSearch();
        }
    }

    private async Task ClearSearch()
    {
        SearchValue = string.Empty;
        await HandleSearch();
    }

    private async Task TriggerDataTableSearch()
    {
        // Trigger DataTable search via JavaScript
        await JSRuntime.InvokeVoidAsync("triggerDataTableSearch", TableId, SearchValue);
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize JavaScript functions with better error handling
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (!window.triggerDataTableSearch) {
                    window.triggerDataTableSearch = function(tableId, searchValue) {
                        console.log('Searching table:', tableId, 'for:', searchValue);
                        
                        // Check if jQuery is loaded
                        if (typeof $ === 'undefined') {
                            console.error('jQuery is not loaded!');
                            return;
                        }
                        
                        // Check if DataTables is loaded
                        if (typeof $.fn.DataTable === 'undefined') {
                            console.error('DataTables is not loaded!');
                            return;
                        }
                        
                        var tableElement = $('#' + tableId);
                        console.log('Table element found:', tableElement.length);
                        
                        if ($.fn.DataTable.isDataTable('#' + tableId)) {
                            var table = tableElement.DataTable();
                            console.log('DataTable instance found, applying search...');
                            table.search(searchValue).draw();
                            console.log('Search applied successfully');
                        } else {
                            console.error('Table is not initialized as DataTable:', tableId);
                            
                            // Try to wait and retry
                            setTimeout(function() {
                                if ($.fn.DataTable.isDataTable('#' + tableId)) {
                                    console.log('Retry successful, applying search...');
                                    $('#' + tableId).DataTable().search(searchValue).draw();
                                } else {
                                    console.error('Table still not initialized after retry');
                                }
                            }, 500);
                        }
                    };
                    
                    window.clearDataTableSearch = function(tableId) {
                        if (typeof $ !== 'undefined' && $.fn.DataTable && $.fn.DataTable.isDataTable('#' + tableId)) {
                            $('#' + tableId).DataTable().search('').draw();
                        }
                    };
                }
            ");
        }
    }
}