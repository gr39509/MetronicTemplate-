@page "/message/sms"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using NovaAccounts.Shared
@inject IJSRuntime JSRuntime
@inject ApiClient ApiClient

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>

  :root {
    --bg:        #f0f2f7;
    --surface:   #ffffff;
    --border:    #e2e6f0;
    --text:      #1a1f36;
    --muted:     #6b7399;
    --accent:    #4f46e5;
    --accent-lt: #eef2ff;
    --danger:    #ef4444;
    --success:   #22c55e;
    --amber:     #f59e0b;
    --radius:    12px;
    --shadow:    0 1px 4px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.06);
  }

  /* ── breadcrumb ─────────────────────────────────── */
  .breadcrumb {
    font-size: .8rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: .4rem;
  }
  .breadcrumb span { color: var(--accent); font-weight: 500; }
  .breadcrumb .sep { opacity: .4; }

  /* ── grid layout ────────────────────────────────── */
  .container-fluid.mt-4 {
    padding: 1.75rem 2rem;
    max-width: 1800px;
    margin: 0 auto;
  }

  .top-row {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  @@media (max-width: 860px) {
    .top-row { grid-template-columns: 1fr; }
  }

  /* ── card ───────────────────────────────────────── */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .card-header {
    padding: .85rem 1.25rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: .6rem;
  }
  .card-header h2 {
    font-size: .9rem;
    font-weight: 600;
    letter-spacing: .01em;
    margin: 0;
  }
  .card-header .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .card-body { padding: 1.25rem; }

  /* ── form controls ──────────────────────────────── */
  label {
    display: block;
    font-size: .75rem;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: .4rem;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .input-wrap {
    position: relative;
  }
  .input-wrap .icon {
    position: absolute;
    left: .75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    font-size: .85rem;
    pointer-events: none;
  }
  .input-wrap input,
  .input-wrap select {
    width: 100%;
    padding: .6rem .75rem .6rem 2.1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-family: inherit;
    font-size: .85rem;
    color: var(--text);
    background: var(--surface);
    transition: border-color .18s, box-shadow .18s;
    appearance: none;
    box-sizing: border-box;
  }
  .input-wrap input.is-invalid,
  .input-wrap select.is-invalid {
    border-color: var(--danger);
  }
  .input-wrap input::placeholder { color: #b0b7d3; }
  .input-wrap input:focus,
  .input-wrap select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(79,70,229,.1);
  }
  .select-arrow {
    position: absolute;
    right: .75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
    font-size: .7rem;
  }

  .field-error {
    font-size: .73rem;
    color: var(--danger);
    margin-top: .3rem;
    display: block;
  }

  /* scheduling row */
  .schedule-row {
    display: flex;
    align-items: center;
    gap: .75rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: .6rem .9rem;
    cursor: pointer;
    transition: border-color .18s;
    user-select: none;
  }
  .schedule-row:hover { border-color: var(--accent); }
  .schedule-row.active { border-color: var(--accent); background: var(--accent-lt); }
  .schedule-row input[type=checkbox] { accent-color: var(--accent); cursor: pointer; }
  .schedule-row .sched-label { font-size: .85rem; color: var(--muted); flex: 1; }
  .schedule-row .tz {
    font-family: 'DM Mono', monospace;
    font-size: .75rem;
    color: var(--muted);
    background: var(--border);
    padding: .2rem .5rem;
    border-radius: 4px;
  }

  .schedule-expand {
    margin-top: .75rem;
    animation: fadeSlide .18s ease;
  }
  @@keyframes fadeSlide {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── message text ───────────────────────────────── */
  .msg-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: .6rem;
  }
  .personalise-check {
    display: flex;
    align-items: center;
    gap: .4rem;
    font-size: .8rem;
    color: var(--muted);
    cursor: pointer;
    text-transform: none;
    letter-spacing: 0;
    margin: 0;
  }
  .personalise-check input { accent-color: var(--accent); }

  textarea {
    width: 100%;
    min-height: 130px;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: .75rem;
    font-family: 'DM Sans', sans-serif;
    font-size: .875rem;
    color: var(--text);
    resize: vertical;
    transition: border-color .18s, box-shadow .18s;
    line-height: 1.55;
    box-sizing: border-box;
  }
  textarea.is-invalid { border-color: var(--danger) !important; }
  textarea::placeholder { color: #b0b7d3; }
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(79,70,229,.1);
  }

  .msg-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: .6rem;
  }
  .char-count {
    font-size: .78rem;
    color: var(--amber);
    font-family: 'DM Mono', monospace;
    font-weight: 500;
  }
  .char-count.warn  { color: var(--amber); }
  .char-count.over  { color: var(--danger); }
  .char-count.ok    { color: #b0b7d3; }
  .btn-template {
    display: flex;
    align-items: center;
    gap: .4rem;
    padding: .45rem .9rem;
    border: 1.5px solid var(--accent);
    background: var(--accent-lt);
    color: var(--accent);
    border-radius: 7px;
    font-family: inherit;
    font-size: .8rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .18s, transform .12s;
  }
  .btn-template:hover { background: var(--accent); color: #fff; transform: translateY(-1px); }

  /* ── destinations ───────────────────────────────── */
  .dest-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .75rem 1.1rem;
    border-bottom: 1px solid var(--border);
    background: #fafbfd;
    flex-wrap: wrap;
    gap: .5rem;
  }
  .dest-header h2 { font-size: .9rem; font-weight: 600; margin: 0; }
  .dest-actions { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .35rem .75rem;
    border-radius: 6px;
    font-size: .78rem;
    font-weight: 500;
    cursor: pointer;
    border: none;
    font-family: inherit;
    transition: opacity .15s, transform .12s;
  }
  .action-btn:hover:not(:disabled) { opacity: .85; transform: translateY(-1px); }
  .action-btn:disabled { opacity: .4; cursor: not-allowed; }
  .btn-paste  { background: #e0f2fe; color: #0369a1; }
  .btn-import { background: #dcfce7; color: #166534; }
  .btn-delete { background: #fee2e2; color: #991b1b; }
  .btn-clear  { background: var(--bg); color: var(--muted); border: 1px solid var(--border); }

  .dest-table-wrap { overflow-x: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: .83rem;
  }
  thead tr {
    background: #f5f6fa;
    border-bottom: 1px solid var(--border);
  }
  thead th {
    padding: .55rem 1rem;
    text-align: left;
    font-weight: 600;
    color: var(--muted);
    font-size: .75rem;
    letter-spacing: .05em;
    text-transform: uppercase;
  }
  thead th:first-child { width: 40px; text-align: center; }
  thead th:nth-child(2) { width: 50px; text-align: center; }

  tbody tr {
    border-bottom: 1px solid #f0f2f7;
    transition: background .12s;
  }
  tbody tr:hover  { background: var(--accent-lt); }
  tbody tr.selected { background: #eef2ff; }
  tbody td { padding: .55rem 1rem; color: var(--muted); }

  .phone-cell {
    font-family: 'DM Mono', monospace;
    color: var(--text);
    font-size: .82rem;
  }

  .empty-state {
    text-align: center;
    padding: 2.5rem 1rem;
    color: #c0c6de;
  }
  .empty-state .icon { font-size: 1.8rem; margin-bottom: .5rem; }
  .empty-state p { font-size: .82rem; }

  /* dest counter badge */
  .dest-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    font-size: .7rem;
    font-weight: 700;
    font-family: 'DM Mono', monospace;
    border-radius: 10px;
    padding: .1rem .5rem;
    min-width: 22px;
    margin-left: .4rem;
  }

  /* pagination */
  .dest-pagination {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .65rem 1rem;
    border-top: 1px solid var(--border);
    background: #fafbfd;
    flex-wrap: wrap;
  }
  .pg-select {
    padding: .25rem .5rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    font-family: 'DM Mono', monospace;
    font-size: .78rem;
    color: var(--text);
  }
  .pg-btn {
    width: 26px; height: 26px;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    font-size: .75rem;
    transition: background .15s;
  }
  .pg-btn:hover:not(:disabled) { background: var(--accent-lt); color: var(--accent); }
  .pg-btn:disabled { opacity: .35; cursor: not-allowed; }
  .pg-input {
    width: 38px;
    text-align: center;
    padding: .25rem .3rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    font-family: 'DM Mono', monospace;
    font-size: .78rem;
  }
  .pg-info { font-size: .78rem; color: var(--muted); margin-left: auto; }

  /* ── paste modal overlay ────────────────────────── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(26,31,54,.45);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 999;
    animation: fadeIn .15s ease;
  }
  @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  .modal-box {
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: 0 8px 40px rgba(0,0,0,.2);
    width: 460px;
    max-width: 95vw;
    overflow: hidden;
    animation: slideUp .18s ease;
  }
  @@keyframes slideUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .modal-header {
    padding: .9rem 1.25rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .modal-header h3 { font-size: .95rem; font-weight: 600; margin: 0; color: var(--text); }
  .btn-x {
    background: none; border: none;
    font-size: 1rem; color: var(--muted);
    cursor: pointer; padding: .1rem .3rem;
    border-radius: 4px;
    transition: background .15s, color .15s;
  }
  .btn-x:hover { background: #fee2e2; color: var(--danger); }

  .modal-body { padding: 1.25rem; }
  .modal-footer {
    padding: .85rem 1.25rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: flex-end;
    gap: .5rem;
    background: #fafbfd;
  }

  .btn-cancel {
    padding: .45rem 1rem;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    border-radius: 7px;
    font-family: inherit;
    font-size: .83rem;
    font-weight: 500;
    cursor: pointer;
    transition: background .15s;
  }
  .btn-cancel:hover { background: var(--bg); }

  .btn-apply {
    padding: .45rem 1.1rem;
    border: none;
    background: var(--accent);
    color: #fff;
    border-radius: 7px;
    font-family: inherit;
    font-size: .83rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(79,70,229,.25);
    transition: background .15s, transform .12s;
  }
  .btn-apply:hover { background: #4338ca; transform: translateY(-1px); }

  .detected-hint {
    font-size: .75rem;
    color: var(--muted);
    margin-top: .4rem;
    font-family: 'DM Mono', monospace;
  }
  .detected-hint strong { color: var(--accent); }

  /* ── import modal specifics ─────────────────────── */
  .import-drop-zone {
    border: 2px dashed var(--border);
    border-radius: 10px;
    padding: 2rem 1.5rem;
    text-align: center;
    cursor: pointer;
    transition: border-color .18s, background .18s;
    background: var(--bg);
    position: relative;
  }
  .import-drop-zone:hover,
  .import-drop-zone.drag-over {
    border-color: var(--accent);
    background: var(--accent-lt);
  }
  .import-drop-zone .dz-icon { font-size: 2rem; margin-bottom: .5rem; }
  .import-drop-zone .dz-title {
    font-size: .88rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: .25rem;
  }
  .import-drop-zone .dz-sub {
    font-size: .76rem;
    color: var(--muted);
  }
  .import-drop-zone .dz-browse {
    display: inline-block;
    margin-top: .75rem;
    padding: .4rem 1rem;
    background: var(--accent);
    color: #fff;
    border-radius: 6px;
    font-size: .78rem;
    font-weight: 600;
    cursor: pointer;
  }

  .import-col-picker {
    margin-top: 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: .85rem 1rem;
    animation: fadeSlide .18s ease;
  }
  .import-col-picker label {
    text-transform: none;
    letter-spacing: 0;
    font-size: .82rem;
    margin-bottom: .5rem;
  }
  .import-col-picker select {
    width: 100%;
    padding: .5rem .75rem;
    border: 1px solid var(--border);
    border-radius: 7px;
    font-family: inherit;
    font-size: .83rem;
    color: var(--text);
    background: var(--surface);
    appearance: none;
  }
  .import-col-picker select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(79,70,229,.1);
  }

  .import-preview-table {
    margin-top: .75rem;
    max-height: 160px;
    overflow-y: auto;
    border: 1px solid var(--border);
    border-radius: 7px;
    font-size: .78rem;
  }
  .import-preview-table table { font-size: .78rem; }
  .import-preview-table thead th { font-size: .7rem; padding: .4rem .75rem; }
  .import-preview-table tbody td { padding: .35rem .75rem; }

  .import-file-info {
    display: flex;
    align-items: center;
    gap: .6rem;
    background: #dcfce7;
    border: 1px solid #bbf7d0;
    border-radius: 7px;
    padding: .55rem .9rem;
    margin-bottom: .75rem;
    font-size: .8rem;
    color: #166534;
  }
  .import-file-info .fi-name { font-weight: 600; flex: 1; }
  .import-file-info .fi-meta { font-family: 'DM Mono', monospace; font-size: .72rem; opacity: .8; }
  .btn-reselect {
    background: none;
    border: none;
    color: #166534;
    cursor: pointer;
    font-size: .8rem;
    text-decoration: underline;
    font-family: inherit;
    padding: 0;
  }

  /* ── send row ───────────────────────────────────── */
  .send-row {
    margin-top: 1.25rem;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn-send {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .7rem 1.75rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 9px;
    font-family: inherit;
    font-size: .9rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(79,70,229,.35);
    transition: background .18s, transform .12s, box-shadow .18s;
  }
  .btn-send:hover:not(:disabled) {
    background: #4338ca;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(79,70,229,.4);
  }
  .btn-send:active:not(:disabled) { transform: translateY(0); }
  .btn-send:disabled { opacity: .55; cursor: not-allowed; box-shadow: none; }

  .send-hint {
    font-size: .8rem;
    color: var(--muted);
  }
  .send-hint strong { color: var(--text); }

  /* spinner */
  .spin {
    display: inline-block;
    width: 14px; height: 14px;
    border: 2px solid rgba(255,255,255,.35);
    border-top-color: #fff;
    border-radius: 50%;
    animation: rot .65s linear infinite;
  }
  @@keyframes rot { to { transform: rotate(360deg); } }

  /* ── alert banners ──────────────────────────────── */
  .alert {
    margin-top: 1rem;
    padding: .75rem 1rem;
    border-radius: 8px;
    font-size: .85rem;
    display: flex;
    align-items: flex-start;
    gap: .5rem;
    animation: fadeSlide .2s ease;
  }
  .alert-success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
  .alert-danger  { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
  .alert-icon { font-size: 1rem; flex-shrink: 0; margin-top: .05rem; }

  /* ── preview strip ──────────────────────────────── */
  .preview-strip {
    margin-top: 1rem;
    background: var(--accent-lt);
    border: 1px solid #c7d2fe;
    border-radius: 8px;
    padding: .7rem 1rem;
    font-size: .82rem;
    color: var(--text);
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .preview-strip .ps-item { display: flex; flex-direction: column; gap: .1rem; }
  .preview-strip .ps-label { font-size: .68rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
  .preview-strip .ps-val  { font-family: 'DM Mono', monospace; font-weight: 500; color: var(--accent); }

</style>

<div class="container-fluid mt-4">

  <!-- Breadcrumb -->
  <div class="breadcrumb">
    Portal <span class="sep">/</span> Message <span class="sep">/</span> <span>Send SMS</span>
  </div>

  <!-- Top row: Message Properties + Message Text -->
  <div class="top-row">

    <!-- ── Message Properties ────────────────────── -->
    <div class="card">
      <div class="card-header">
        <div class="dot"></div>
        <h2>Message Properties</h2>
      </div>
      <div class="card-body">

        <!-- SMS Configuration selector -->
        <div style="margin-bottom:1rem;">
          <label>SMS Configuration *</label>
          @if (isLoadingConfigs)
          {
            <div style="font-size:.82rem;color:var(--muted);padding:.5rem 0;display:flex;align-items:center;gap:.5rem;">
              <span class="spin" style="border-color:rgba(107,115,153,.25);border-top-color:var(--muted);"></span>
              Loading configurations…
            </div>
          }
          else
          {
            <div class="input-wrap">
              <span class="icon">☁</span>
              <select class="@(showValidation && selectedConfig == null ? "is-invalid" : "")"
                      value="@selectedConfig?.ClientProviderConfigurationId"
                      @onchange="HandleConfigChange">
                <option value="">— Select configuration —</option>
                @foreach (var cfg in smsConfigurations)
                {
                  <option value="@cfg.ClientProviderConfigurationId">
                    @cfg.Provider?.Name — @cfg.Description @(cfg.IsDefault ? "★" : "")
                  </option>
                }
              </select>
              <span class="select-arrow">▾</span>
            </div>
            @if (showValidation && selectedConfig == null)
            {
              <span class="field-error">Please select an SMS configuration.</span>
            }
            @if (selectedConfig != null)
            {
              <span style="font-size:.72rem;color:var(--muted);margin-top:.3rem;display:block;">
                Client: <strong style="color:var(--accent);">@selectedConfig.ClientIdentifier</strong>
                @if (selectedConfig.IsDefault)
                {
                  <span style="margin-left:.4rem;background:var(--accent-lt);color:var(--accent);padding:.1rem .4rem;border-radius:4px;font-size:.68rem;font-weight:600;">DEFAULT</span>
                }
              </span>
            }
          }
        </div>

        <div class="form-row">
          <!-- Sender Name -->
          <div>
            <label for="senderName">Sender Name</label>
            <div class="input-wrap">
              <span class="icon"></span>
              <input id="senderName"
                     type="text"
                     placeholder="Sender Name (max 11 chars)"
                     maxlength="11"
                     @bind="senderName"
                     @bind:event="oninput" />
            </div>
            <span style="font-size:.7rem;color:var(--muted);margin-top:.3rem;display:block;">
              @senderName.Length / 11 characters
            </span>
          </div>

          <!-- Message Type -->
          <div>
            <label for="msgType">Message Type</label>
            <div class="input-wrap">
              <span class="icon">☰</span>
              <select id="msgType" @bind="messageType">
                <option value="TEXT">TEXT</option>
                <option value="UNICODE">UNICODE</option>
                <option value="FLASH">FLASH</option>
              </select>
              <span class="select-arrow">▾</span>
            </div>
          </div>
        </div>

        <!-- Scheduling -->
        <div>
          <label>Scheduling</label>
          <div class="schedule-row @(isScheduled ? "active" : "")" @onclick="ToggleSchedule">
            <input type="checkbox"
                   checked="@isScheduled"
                   @onclick:stopPropagation
                   @onchange="ToggleSchedule" />
            <span class="sched-label">
              @(isScheduled ? "Scheduled for a specific time" : "Click to schedule time")
            </span>
            <span class="tz">+00:00 UTC</span>
          </div>

          @if (isScheduled)
          {
            <div class="schedule-expand">
              <div class="input-wrap">
                <span class="icon" style="top:.65rem;transform:none;">🗓</span>
                <input type="datetime-local"
                       style="padding-left:2.1rem;"
                       @bind="scheduledAt"
                       @bind:event="oninput" />
              </div>
            </div>
          }
        </div>

      </div>
    </div>

    <!-- ── Message Text ──────────────────────────── -->
    <div class="card">
      <div class="card-header">
        <div class="dot" style="background:var(--amber)"></div>
        <h2>Message Text</h2>
      </div>
      <div class="card-body">

        <div class="msg-header-row">
          <label style="margin:0">Message</label>
          <label class="personalise-check">
            <input type="checkbox" @bind="personalise" /> Personalise
          </label>
        </div>

        <textarea class="@(showValidation && string.IsNullOrWhiteSpace(messageBody) ? "is-invalid" : "")"
                  placeholder="Enter your message here…"
                  maxlength="1600"
                  @bind="messageBody"
                  @bind:event="oninput"></textarea>

        @if (showValidation && string.IsNullOrWhiteSpace(messageBody))
        {
          <span class="field-error">Message is required.</span>
        }

        <div class="msg-footer">
          <span class="char-count @CharCountClass">
            @messageBody.Length Characters (@SmsSegments SMS)
            @if (messageBody.Length > 160)
            {
              <span style="opacity:.7;"> · @SmsSegments parts</span>
            }
          </span>
          <span style="font-size:.72rem;color:var(--muted);">Max 1,600</span>
        </div>

        @if (personalise)
        {
          <div style="margin-top:.75rem;padding:.65rem .9rem;background:var(--bg);border-radius:7px;border:1px dashed var(--border);font-size:.78rem;color:var(--muted);">
            💡 Use <code style="background:#e2e6f0;padding:.1rem .3rem;border-radius:3px;">{FirstName}</code>,
            <code style="background:#e2e6f0;padding:.1rem .3rem;border-radius:3px;">{LastName}</code> as placeholders.
          </div>
        }

      </div>
    </div>
  </div>

  <!-- ── Message Destinations ───────────────────── -->
  <div class="card">
    <div class="dest-header">
      <div style="display:flex;align-items:center;gap:.5rem;">
        <h2>Message Destinations</h2>
        @if (phoneNumbers.Count > 0)
        {
          <span class="dest-count">@phoneNumbers.Count</span>
        }
        @if (showValidation && !phoneNumbers.Any())
        {
          <span class="field-error" style="margin:0;">At least one number is required.</span>
        }
      </div>
      <div class="dest-actions">
        <button class="action-btn btn-paste" @onclick="OpenPasteModal">✎ Type / Paste</button>
        <button class="action-btn btn-import" @onclick="OpenImportModal">⬆ Import Excel / CSV</button>
        <button class="action-btn btn-delete"
                disabled="@(!selectedRows.Any())"
                @onclick="DeleteSelected">
          Delete (@selectedRows.Count)
        </button>
        <button class="action-btn btn-clear"
                disabled="@(!phoneNumbers.Any())"
                @onclick="ClearAll">
          ✕ Clear All
        </button>
      </div>
    </div>

    <div class="dest-table-wrap">
      <table>
        <thead>
          <tr>
            <th style="text-align:center;">#</th>
            <th style="text-align:center;">
              <input type="checkbox"
                     style="accent-color:var(--accent)"
                     checked="@AllOnPageSelected"
                     @onchange="ToggleSelectAll" />
            </th>
            <th>Phone Number</th>
            <th>Country</th>
          </tr>
        </thead>
        <tbody>
          @if (!PagedNumbers.Any())
          {
            <tr>
              <td colspan="4">
                <div class="empty-state">
                  <div class="icon">📱</div>
                  <p>No destinations added yet. Use <strong>Type / Paste</strong> or <strong>Import Excel / CSV</strong> to add numbers.</p>
                </div>
              </td>
            </tr>
          }
          else
          {
            @foreach (var (num, i) in PagedNumbers.Select((n, i) => (n, i)))
            {
              var globalIndex = (currentPage - 1) * pageSize + i + 1;
              <tr class="@(selectedRows.Contains(num) ? "selected" : "")">
                <td style="text-align:center;font-family:'DM Mono',monospace;font-size:.72rem;color:#c0c6de;">
                  @globalIndex
                </td>
                <td style="text-align:center;">
                  <input type="checkbox"
                         style="accent-color:var(--accent)"
                         checked="@selectedRows.Contains(num)"
                         @onchange="e => ToggleRow(num, e)" />
                </td>
                <td class="phone-cell">@num</td>
                <td style="font-size:.78rem;">@InferCountry(num)</td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>

    <div class="dest-pagination">
      <select class="pg-select" @bind="pageSize" @bind:after="OnPageSizeChange">
        <option value="30">30</option>
        <option value="50">50</option>
        <option value="100">100</option>
      </select>
      <button class="pg-btn" @onclick='() => GoPage(1)' disabled="@(currentPage <= 1)">«</button>
      <button class="pg-btn" @onclick='() => GoPage(currentPage - 1)' disabled="@(currentPage <= 1)">‹</button>
      <span style="font-size:.78rem;color:var(--muted)">Page</span>
      <input class="pg-input" type="number" value="@currentPage" min="1" max="@TotalPages"
             @onchange="OnPageInputChange" />
      <span style="font-size:.78rem;color:var(--muted)">of @TotalPages</span>
      <button class="pg-btn" @onclick='() => GoPage(currentPage + 1)' disabled="@(currentPage >= TotalPages)">›</button>
      <button class="pg-btn" @onclick='() => GoPage(TotalPages)' disabled="@(currentPage >= TotalPages)">»</button>
      <button class="pg-btn" title="Refresh" @onclick="StateHasChanged">↻</button>
      <span class="pg-info">@phoneNumbers.Count total · @selectedRows.Count selected</span>
    </div>
  </div>

  <!-- Preview strip (shown when both message and numbers are present) -->
  @if (phoneNumbers.Any() && !string.IsNullOrWhiteSpace(messageBody))
  {
    <div class="preview-strip">
      <div class="ps-item">
        <span class="ps-label">Recipients</span>
        <span class="ps-val">@phoneNumbers.Count</span>
      </div>
      <div class="ps-item">
        <span class="ps-label">Characters</span>
        <span class="ps-val">@messageBody.Length / 1600</span>
      </div>
      <div class="ps-item">
        <span class="ps-label">Segments / recipient</span>
        <span class="ps-val">@SmsSegments</span>
      </div>
      <div class="ps-item">
        <span class="ps-label">Total SMS dispatched</span>
        <span class="ps-val">@(SmsSegments * phoneNumbers.Count)</span>
      </div>
      @if (!string.IsNullOrWhiteSpace(senderName))
      {
        <div class="ps-item">
          <span class="ps-label">Sender ID</span>
          <span class="ps-val">@senderName</span>
        </div>
      }
      @if (isScheduled && scheduledAt.HasValue)
      {
        <div class="ps-item">
          <span class="ps-label">Scheduled at</span>
          <span class="ps-val">@scheduledAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
      }
    </div>
  }

  <!-- Feedback alerts -->
  @if (!string.IsNullOrEmpty(successMessage))
  {
    <div class="alert alert-success">
      <span class="alert-icon">✔</span>
      <span>@successMessage</span>
    </div>
  }
  @if (!string.IsNullOrEmpty(errorMessage))
  {
    <div class="alert alert-danger">
      <span class="alert-icon">⚠</span>
      <span>@errorMessage</span>
    </div>
  }

  <!-- Send -->
  <div class="send-row">
    <button class="btn-send" disabled="@isSending" @onclick="HandleSend">
      @if (isSending)
      {
        <span class="spin"></span>
        <span>Sending…</span>
      }
      else
      {
        <span>▶ Send Message</span>
      }
    </button>

    @if (!string.IsNullOrEmpty(messageBody) && phoneNumbers.Any() && !isSending)
    {
      <span class="send-hint">
        <strong>@phoneNumbers.Count</strong> recipient(s) ·
        <strong>@SmsSegments</strong> segment(s) each ·
        <strong>@(SmsSegments * phoneNumbers.Count)</strong> total SMS
      </span>
    }
  </div>

</div>

<!-- ── Paste / Type Modal ────────────────────────── -->
@if (showPasteModal)
{
  <div class="modal-overlay" @onclick="ClosePasteModal">
    <div class="modal-box" @onclick:stopPropagation>

      <div class="modal-header">
        <h3>✎ Type / Paste Phone Numbers</h3>
        <button class="btn-x" @onclick="ClosePasteModal">✕</button>
      </div>

      <div class="modal-body">
        <label style="margin-bottom:.5rem;text-transform:none;letter-spacing:0;font-size:.8rem;">
          Enter one number per line, or separate with commas. Include the country code.
        </label>
        <textarea style="min-height:180px;"
                  placeholder="+233244000000&#10;+233201000000&#10;+233271000000"
                  @bind="pasteBuffer"
                  @bind:event="oninput"></textarea>
        <div class="detected-hint">
          <strong>@ParsedPasteCount</strong> number(s) detected
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn-cancel" @onclick="ClosePasteModal">Cancel</button>
        <button class="btn-apply" @onclick="ApplyPaste" disabled="@(ParsedPasteCount == 0)">
          Add @(ParsedPasteCount > 0 ? ParsedPasteCount : "") Number(s)
        </button>
      </div>

    </div>
  </div>
}

<!-- ── Import Excel / CSV Modal ──────────────────── -->
@if (showImportModal)
{
  <div class="modal-overlay" @onclick="CloseImportModal">
    <div class="modal-box" style="width:520px;" @onclick:stopPropagation>

      <div class="modal-header">
        <h3>⬆ Import from Excel / CSV</h3>
        <button class="btn-x" @onclick="CloseImportModal">✕</button>
      </div>

      <div class="modal-body">

        @if (importFileName == null)
        {
          <!-- Drop zone / file picker -->
          <input type="file" 
                 id="fileUploadInput" 
                 accept=".csv,.xlsx,.xls" 
                 style="display:none;" />

          <div class="import-drop-zone" @onclick="TriggerFileUpload">
            <div class="dz-icon">📂</div>
            <div class="dz-title">Choose a file to import</div>
            <div class="dz-sub">Supports .csv, .xlsx, and .xls files</div>
            <div class="dz-browse">Browse File</div>
          </div>
          <div style="font-size:.74rem;color:var(--muted);margin-top:.6rem;line-height:1.5;">
            💡 <strong>Tip:</strong> Your file should have a column containing phone numbers with country codes (e.g. <code style="background:#e2e6f0;padding:.1rem .3rem;border-radius:3px;">+233244000000</code>).
          </div>
        }
        else
        {
          <!-- File loaded state -->
          <div class="import-file-info">
            <span>📄</span>
            <span class="fi-name">@importFileName</span>
            <span class="fi-meta">@importRawRows.Count rows · @importColumns.Count cols</span>
            <button class="btn-reselect" @onclick="ResetImportFile">Change file</button>
          </div>

          @if (importColumns.Count > 0)
          {
            <div class="import-col-picker">
              <label style="margin-bottom:.4rem;display:block;font-weight:600;font-size:.8rem;color:var(--text);">
                Select the column containing phone numbers
              </label>
              <div style="position:relative;">
                <select @bind="importSelectedColumn">
                  <option value="">— Choose column —</option>
                  @foreach (var col in importColumns)
                  {
                    <option value="@col">@col</option>
                  }
                </select>
              </div>
            </div>

            @if (!string.IsNullOrEmpty(importSelectedColumn))
            {
              var preview = GetImportPreview();
              <div class="import-preview-table">
                <table>
                  <thead>
                    <tr>
                      <th>Row</th>
                      <th>Value (from "@importSelectedColumn")</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (var (row, idx) in preview.Take(8).Select((r, i) => (r, i + 1)))
                    {
                      var isValid = IsLikelyPhoneNumber(row);
                      <tr>
                        <td style="color:#c0c6de;font-family:'DM Mono',monospace;">@idx</td>
                        <td class="phone-cell">@row</td>
                        <td>
                          @if (isValid)
                          { <span style="color:var(--success);font-size:.72rem;">✔ valid</span> }
                          else
                          { <span style="color:var(--amber);font-size:.72rem;">⚠ check</span> }
                        </td>
                      </tr>
                    }
                    @if (preview.Count > 8)
                    {
                      <tr>
                        <td colspan="3" style="text-align:center;color:var(--muted);font-size:.72rem;padding:.4rem;">
                          … and @(preview.Count - 8) more rows
                        </td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
              <div class="detected-hint" style="margin-top:.5rem;">
                <strong>@ImportReadyCount</strong> number(s) ready to import
                @if (ImportSkippedCount > 0)
                {
                  <span style="color:var(--amber);margin-left:.5rem;">· @ImportSkippedCount empty/skipped</span>
                }
              </div>
            }
          }

          @if (!string.IsNullOrEmpty(importError))
          {
            <div class="alert alert-danger" style="margin-top:.75rem;">
              <span class="alert-icon">⚠</span>
              <span>@importError</span>
            </div>
          }
        }

      </div>

      <div class="modal-footer">
        <button class="btn-cancel" @onclick="CloseImportModal">Cancel</button>
        <button class="btn-apply"
                @onclick="ApplyImport"
                disabled="@(string.IsNullOrEmpty(importSelectedColumn) || ImportReadyCount == 0)">
          Add @(ImportReadyCount > 0 ? ImportReadyCount : "") Number(s)
        </button>
      </div>

    </div>
  </div>
}

@code {

    private const string HardcodedClientCode = "CN1302638";

    private List<SMSClientProviderConfigurationViewModel> smsConfigurations = new();
    private SMSClientProviderConfigurationViewModel?      selectedConfig     = null;
    private bool isLoadingConfigs = false;

    private string    senderName  = string.Empty;
    private string    messageType = "TEXT";
    private string    messageBody = string.Empty;
    private bool      personalise = false;
    private bool      isScheduled = false;
    private DateTime? scheduledAt = null;

    private List<string>    phoneNumbers = new();
    private HashSet<string> selectedRows = new();
    private int currentPage = 1;
    private int pageSize    = 30;

    private bool   showPasteModal = false;
    private string pasteBuffer    = string.Empty;

    // ── Import state ────────────────────────────────────────────────────────
    private bool                    showImportModal      = false;
    private string?                 importFileName       = null;
    private List<string>            importColumns        = new();
    private List<Dictionary<string,string>> importRawRows = new();
    private string                  importSelectedColumn = string.Empty;
    private string                  importError          = string.Empty;
    private bool                    isParsingFile        = false;

    private bool   isSending      = false;
    private bool   showValidation = false;
    private string successMessage = string.Empty;
    private string errorMessage   = string.Empty;

    // ── Computed ────────────────────────────────────────────────────────────

    private int SmsSegments => messageBody.Length == 0
        ? 0 : (int)Math.Ceiling(messageBody.Length / 160.0);

    private string CharCountClass =>
        messageBody.Length == 0   ? "ok"   :
        messageBody.Length > 1200 ? "over" :
        messageBody.Length > 160  ? "warn" : "ok";

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(phoneNumbers.Count / (double)pageSize));

    private IEnumerable<string> PagedNumbers =>
        phoneNumbers.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private bool AllOnPageSelected =>
        PagedNumbers.Any() && PagedNumbers.All(n => selectedRows.Contains(n));

    private int ParsedPasteCount => ParseNumbers(pasteBuffer).Count;

    private List<string> GetImportPreview() =>
        string.IsNullOrEmpty(importSelectedColumn)
            ? new()
            : importRawRows
                .Select(r => r.TryGetValue(importSelectedColumn, out var v) ? NormalisePhone(v.Trim()) : string.Empty)
                .Where(v => !string.IsNullOrWhiteSpace(v))
                .ToList();

    private int ImportReadyCount =>
        GetImportPreview().Count(IsLikelyPhoneNumber);

    private int ImportSkippedCount =>
        string.IsNullOrEmpty(importSelectedColumn) ? 0 :
        importRawRows.Count - GetImportPreview().Count;

    // ── Lifecycle ───────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await LoadConfigurations();
    }

    private async Task LoadConfigurations()
    {
        try
        {
            isLoadingConfigs = true;
            errorMessage     = string.Empty;
            StateHasChanged();

            var result = await ApiClient.ConfigurationsPerClient4Async(HardcodedClientCode);

            if (result?.Success == true && result.Data != null)
            {
                smsConfigurations = result.Data
                    .Where(c => c.IsActive)
                    .OrderByDescending(c => c.IsDefault)
                    .ThenBy(c => c.ProviderName)
                    .ToList();

                selectedConfig = smsConfigurations.FirstOrDefault(c => c.IsDefault)
                              ?? smsConfigurations.FirstOrDefault();
            }
            else
            {
                errorMessage = result?.Message ?? "No active SMS configurations found for this client.";
            }
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}): could not load configurations.";
            Console.WriteLine($"ApiException loading SMS configs: {ex}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading configurations: {ex.Message}";
            Console.WriteLine($"Exception loading SMS configs: {ex}");
        }
        finally
        {
            isLoadingConfigs = false;
            StateHasChanged();
        }
    }
    
    [JSInvokable]
    public async Task HandleFileUpload(string fileName, string base64Content)
    {
      try
      {
        importError = string.Empty;
        importFileName = fileName;
        isParsingFile = true;
        StateHasChanged();

        // Convert base64 to stream
        byte[] fileBytes = Convert.FromBase64String(base64Content);
        using var ms = new MemoryStream(fileBytes);

        var ext = Path.GetExtension(fileName).ToLowerInvariant();

        if (ext != ".csv" && ext != ".xlsx" && ext != ".xls")
        {
          importError = "Unsupported file type. Please select a .csv, .xlsx, or .xls file.";
          importFileName = null;
          return;
        }

        if (ext == ".csv")
          ParseCsvFromStream(ms);
        else
          ParseExcelFromStream(ms);

        // Auto-select column with a phone-like name
        if (importColumns.Count > 0)
        {
          var phoneCol = importColumns.FirstOrDefault(c =>
            c.Contains("phone", StringComparison.OrdinalIgnoreCase) ||
            c.Contains("mobile", StringComparison.OrdinalIgnoreCase) ||
            c.Contains("number", StringComparison.OrdinalIgnoreCase) ||
            c.Contains("msisdn", StringComparison.OrdinalIgnoreCase) ||
            c.Contains("tel", StringComparison.OrdinalIgnoreCase));

          if (phoneCol != null)
            importSelectedColumn = phoneCol;
        }
      }
      catch (Exception ex)
      {
        importError = $"Error reading file: {ex.Message}";
        importFileName = null;
        Console.WriteLine($"Import error: {ex}");
      }
      finally
      {
        isParsingFile = false;
        StateHasChanged();
      }
    }

    private async Task TriggerFileUpload()
    {
      var dotNetHelper = DotNetObjectReference.Create(this);
      await JSRuntime.InvokeVoidAsync("uploadFile", "fileUploadInput", dotNetHelper);
    }

    private void HandleConfigChange(ChangeEventArgs e)
    {
        errorMessage   = string.Empty;
        successMessage = string.Empty;

        if (Guid.TryParse(e.Value?.ToString(), out var id))
            selectedConfig = smsConfigurations.FirstOrDefault(
                c => c.ClientProviderConfigurationId == id);
        else
            selectedConfig = null;
    }

    // ── Helpers ─────────────────────────────────────────────────────────────

    private static List<string> ParseNumbers(string raw) =>
        raw.Split(new[] { '\n', '\r', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
           .Select(s => s.Trim())
           .Where(s => !string.IsNullOrWhiteSpace(s))
           .Distinct()
           .ToList();

    private static bool IsLikelyPhoneNumber(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        var digits = new string(value.Where(char.IsDigit).ToArray());
        return digits.Length >= 7 && digits.Length <= 15;
    }

    /// Ensures number starts with "+". Pure-digit strings of 10+ chars get a "+" prepended.
    private static string NormalisePhone(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        // Already has +
        if (value.StartsWith("+")) return value;
        // Strip any leading zeros or spaces, then prepend +
        var digits = new string(value.Where(char.IsDigit).ToArray());
        return digits.Length >= 7 ? "+" + digits : value;
    }

    private static string InferCountry(string number)
    {
        if (!number.StartsWith("+")) return "—";
        return number[1..] switch
        {
            var d when d.StartsWith("233") => "🇬🇭 Ghana",
            var d when d.StartsWith("234") => "🇳🇬 Nigeria",
            var d when d.StartsWith("254") => "🇰🇪 Kenya",
            var d when d.StartsWith("27")  => "🇿🇦 South Africa",
            var d when d.StartsWith("255") => "🇹🇿 Tanzania",
            var d when d.StartsWith("256") => "🇺🇬 Uganda",
            var d when d.StartsWith("1")   => "🇺🇸 US/CA",
            var d when d.StartsWith("44")  => "🇬🇧 United Kingdom",
            var d when d.StartsWith("49")  => "🇩🇪 Germany",
            var d when d.StartsWith("33")  => "🇫🇷 France",
            _                              => "🌍 International"
        };
    }
    

    private void ToggleSchedule()
    {
        isScheduled = !isScheduled;
        if (!isScheduled) scheduledAt = null;
    }

    // ── Pagination ───────────────────────────────────────────────────────────

    private void GoPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        currentPage = page;
    }

    private void OnPageSizeChange() => currentPage = 1;

    private void OnPageInputChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var p)) GoPage(p);
    }

    // ── Row selection ────────────────────────────────────────────────────────

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool b && b)
            foreach (var n in PagedNumbers) selectedRows.Add(n);
        else
            foreach (var n in PagedNumbers) selectedRows.Remove(n);
    }

    private void ToggleRow(string num, ChangeEventArgs e)
    {
        if (e.Value is bool b && b) selectedRows.Add(num);
        else selectedRows.Remove(num);
    }

    private void DeleteSelected()
    {
        phoneNumbers = phoneNumbers.Except(selectedRows).ToList();
        selectedRows.Clear();
        if (currentPage > TotalPages) currentPage = TotalPages;
    }

    private void ClearAll()
    {
        phoneNumbers.Clear();
        selectedRows.Clear();
        currentPage = 1;
    }

    // ── Paste modal ───────────────────────────────────────────────────────────

    private void OpenPasteModal()
    {
        pasteBuffer    = string.Empty;
        showPasteModal = true;
    }

    private void ClosePasteModal() => showPasteModal = false;

    private void ApplyPaste()
    {
        phoneNumbers   = phoneNumbers.Concat(ParseNumbers(pasteBuffer)).Distinct().ToList();
        currentPage    = 1;
        selectedRows.Clear();
        showPasteModal = false;
        StateHasChanged();
    }

    // ── Import modal ──────────────────────────────────────────────────────────

    private void OpenImportModal()
    {
        ResetImportFile();
        showImportModal = true;
    }

    private void CloseImportModal() => showImportModal = false;

    private void ResetImportFile()
    {
        importFileName       = null;
        importColumns        = new();
        importRawRows        = new();
        importSelectedColumn = string.Empty;
        importError          = string.Empty;
    }
    

    private void ParseCsvFromStream(MemoryStream ms)
    {
        ms.Position = 0;
        using var reader = new StreamReader(ms, leaveOpen: true);

        var lines = new List<string>();
        string? line;
        while ((line = reader.ReadLine()) != null)
            lines.Add(line);

        if (lines.Count == 0) { importError = "The file appears to be empty."; return; }

        var headers = SplitCsvLine(lines[0]);
        importColumns = headers
            .Select((h, i) => string.IsNullOrWhiteSpace(h) ? $"Column {i + 1}" : h.Trim())
            .ToList();

        importRawRows = new();
        for (int r = 1; r < lines.Count; r++)
        {
            if (string.IsNullOrWhiteSpace(lines[r])) continue;
            var cells = SplitCsvLine(lines[r]);
            var row   = new Dictionary<string, string>();
            for (int c = 0; c < importColumns.Count; c++)
                row[importColumns[c]] = c < cells.Count ? cells[c].Trim().Trim('"') : string.Empty;
            importRawRows.Add(row);
        }
    }

    private static List<string> SplitCsvLine(string line)
    {
        // Simple CSV split – handles quoted fields
        var result  = new List<string>();
        var current = new System.Text.StringBuilder();
        bool inQuotes = false;

        foreach (char ch in line)
        {
            if (ch == '"')
            {
                inQuotes = !inQuotes;
            }
            else if (ch == ',' && !inQuotes)
            {
                result.Add(current.ToString());
                current.Clear();
            }
            else
            {
                current.Append(ch);
            }
        }
        result.Add(current.ToString());
        return result;
    }

    private void ParseExcelFromStream(MemoryStream ms)
    {
        // Requires ClosedXML NuGet package:
        // <PackageReference Include="ClosedXML" Version="0.102.*" />
        ms.Position = 0;
        using var workbook = new ClosedXML.Excel.XLWorkbook(ms);
        var worksheet = workbook.Worksheets.FirstOrDefault();
        if (worksheet == null)
        {
            importError = "No worksheets found in the Excel file.";
            return;
        }

        var usedRange = worksheet.RangeUsed();
        if (usedRange == null)
        {
            importError = "The first worksheet appears to be empty.";
            return;
        }

        var rows = usedRange.RowsUsed().ToList();
        if (rows.Count == 0) return;

        // Header row
        var headerRow = rows[0];
        importColumns = headerRow.Cells()
            .Select((cell, i) =>
            {
                var val = cell.GetString().Trim();
                return string.IsNullOrWhiteSpace(val) ? $"Column {i + 1}" : val;
            })
            .ToList();

        // Data rows
        importRawRows = new();
        for (int r = 1; r < rows.Count; r++)
        {
            var cells = rows[r].Cells().ToList();
            var row   = new Dictionary<string, string>();
            for (int c = 0; c < importColumns.Count; c++)
            {
                var cellValue = c < cells.Count ? ExtractCellValue(cells[c]) : string.Empty;
                row[importColumns[c]] = cellValue;
            }
            importRawRows.Add(row);
        }
    }

  
    private static string ExtractCellValue(ClosedXML.Excel.IXLCell cell)
    {
        try
        {
            if (cell.IsEmpty()) return string.Empty;

            if (cell.HasFormula)
            {
                // Try the cached/calculated value first
                try
                {
                    var cached = cell.CachedValue.ToString()?.Trim() ?? string.Empty;
                    if (!string.IsNullOrWhiteSpace(cached) && cached != cell.FormulaA1)
                        return cached;
                }
                catch { /* cached value unavailable */ }

                // Fall back: strip leading "=" from the formula text
                // e.g. "=233548324259" -> "233548324259"
                var formula = cell.FormulaA1?.Trim() ?? string.Empty;
                if (formula.StartsWith("="))
                    formula = formula[1..].Trim().Trim('"');
                return formula;
            }

            return cell.GetString().Trim();
        }
        catch
        {
            return string.Empty;
        }
    }

    private void ApplyImport()
    {
        if (string.IsNullOrEmpty(importSelectedColumn)) return;

        var newNumbers = importRawRows
            .Select(r => r.TryGetValue(importSelectedColumn, out var v) ? NormalisePhone(v.Trim()) : string.Empty)
            .Where(v => !string.IsNullOrWhiteSpace(v) && IsLikelyPhoneNumber(v))
            .Distinct()
            .ToList();

        phoneNumbers    = phoneNumbers.Concat(newNumbers).Distinct().ToList();
        currentPage     = 1;
        selectedRows.Clear();
        showImportModal = false;
        StateHasChanged();
    }

    // ── Validation & Send ────────────────────────────────────────────────────

    private bool IsValid()
    {
        if (selectedConfig == null)                 return false;
        if (string.IsNullOrWhiteSpace(messageBody)) return false;
        if (messageBody.Length > 1600)              return false;
        if (!phoneNumbers.Any())                    return false;
        return true;
    }

    private async Task HandleSend()
    {
        showValidation = true;
        successMessage = string.Empty;
        errorMessage   = string.Empty;

        if (!IsValid()) return;

        isSending = true;
        StateHasChanged();

        try
        {
            var request = new SendSmsRequest
            {
                SmsClientProviderConfigurationId = selectedConfig!.SmsProviderConfigurationId,
                Sender       = string.IsNullOrWhiteSpace(senderName) ? null : senderName.Trim(),
                Message      = messageBody.Trim(),
                PhoneNumbers = phoneNumbers
            };

            Console.WriteLine($"Sending SMS via config '{selectedConfig.Description}' " +
                              $"(client: {HardcodedClientCode}) to {phoneNumbers.Count} number(s).");

            var result = await ApiClient.Send2Async(HardcodedClientCode, request);

            Console.WriteLine($"Send2Async → Success: {result?.Success}, Message: {result?.Message}");

            if (result?.Success == true)
            {
                successMessage = result.Message
                    ?? $"SMS sent successfully to {phoneNumbers.Count} number(s)!";
                showValidation = false;
            }
            else
            {
                errorMessage = result?.Message ?? "Send failed. Please try again.";
            }
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}): {ex.Message}";
            Console.WriteLine($"ApiException sending SMS: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Unexpected error: {ex.Message}";
            Console.WriteLine($"Exception sending SMS: {ex.Message}");
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }
}

<script>

  window.uploadFile = (elementId, dotNetHelper) => {
    const input = document.getElementById(elementId);
    if (!input) return;

    input.onchange = async () => {
      const file = input.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = async (e) => {
        const base64 = e.target.result.split(',')[1];
        await dotNetHelper.invokeMethodAsync('HandleFileUpload', file.name, base64);
      };
      reader.readAsDataURL(file);
    };

    input.click();
  };
</script>