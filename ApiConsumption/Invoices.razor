@page "/invoices"
@using Microsoft.AspNetCore.Components.Web
@using NovaAccounts.Components.Shared
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg:        #f0f2f7;
    --surface:   #ffffff;
    --border:    #e2e6f0;
    --text:      #1a1f36;
    --muted:     #6b7399;
    --accent:    #4f46e5;
    --accent-lt: #eef2ff;
    --green:     #22c55e;
    --radius:    12px;
    --shadow:    0 1px 4px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.06);
  }

  .container-fluid.mt-4 {
    padding: 1.75rem 2rem;
    max-width: 1800px;
    margin: 0 auto;
  }

  /* ── breadcrumb ─────────────────────────────────── */
  .breadcrumb {
    font-size: .8rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: .4rem;
  }
  .breadcrumb span { color: var(--accent); font-weight: 500; }
  .breadcrumb .sep { opacity: .4; }

  /* ── card ───────────────────────────────────────── */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .card-header {
    padding: .85rem 1.25rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: .6rem;
  }
  .card-header h2 { font-size: .9rem; font-weight: 600; margin: 0; }
  .card-header .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent); flex-shrink: 0;
  }
  .card-body { padding: 1.25rem; }

  /* ── search / filter collapsible ────────────────── */
  .filter-toggle {
    display: flex;
    align-items: center;
    gap: .5rem;
    cursor: pointer;
    padding: .6rem 0;
    margin-bottom: .5rem;
    user-select: none;
    border-bottom: 1px solid var(--border);
  }
  .filter-toggle .toggle-icon {
    width: 20px; height: 20px;
    border-radius: 50%;
    background: var(--accent-lt);
    color: var(--accent);
    font-size: .75rem;
    font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: background .15s;
  }
  .filter-toggle:hover .toggle-icon { background: var(--accent); color: #fff; }
  .filter-toggle span {
    font-size: .875rem;
    font-weight: 600;
    color: var(--text);
  }

  .filter-panel {
    background: #fafbfd;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr) auto;
    gap: 1rem;
    align-items: end;
  }
  @@media (max-width: 780px) { .filter-panel { grid-template-columns: 1fr 1fr; } }
  @@media (max-width: 480px) { .filter-panel { grid-template-columns: 1fr; } }

  .filter-field { display: flex; flex-direction: column; gap: .35rem; }
  .filter-field label {
    font-size: .72rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .05em;
  }
  .filter-field input,
  .filter-field select {
    padding: .5rem .75rem;
    border: 1px solid var(--border);
    border-radius: 7px;
    font-family: 'DM Sans', sans-serif;
    font-size: .85rem;
    color: var(--text);
    background: var(--surface);
    transition: border-color .18s, box-shadow .18s;
    appearance: none;
  }
  .filter-field input:focus,
  .filter-field select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(79,70,229,.1);
  }
  .filter-field input::placeholder { color: #b0b7d3; }

  .btn-filter-search {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .52rem 1.1rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 7px;
    font-family: 'DM Sans', sans-serif;
    font-size: .82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .18s, transform .12s;
    white-space: nowrap;
    height: fit-content;
  }
  .btn-filter-search:hover { background: #4338ca; transform: translateY(-1px); }

  /* ── entries row ─────────────────────────────────── */
  .entries-row {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-bottom: 1rem;
    font-size: .82rem;
    color: var(--muted);
  }
  .entries-row select {
    padding: .25rem .5rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    font-family: 'DM Mono', monospace;
    font-size: .78rem;
    color: var(--text);
    background: var(--surface);
  }

  /* ── invoices table ─────────────────────────────── */
  .inv-table-wrap { overflow-x: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: .85rem;
  }
  thead tr { border-bottom: 2px solid var(--border); }
  thead th {
    padding: .6rem .9rem;
    text-align: left;
    font-weight: 700;
    font-size: .8rem;
    color: var(--text);
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    transition: color .15s;
  }
  thead th:hover { color: var(--accent); }
  thead th .sort-icon { opacity: .35; margin-left: .25rem; font-size: .65rem; }

  tbody tr {
    border-bottom: 1px solid #f0f2f7;
    transition: background .12s;
  }
  tbody tr:hover { background: var(--accent-lt); }
  tbody td { padding: .75rem .9rem; color: var(--text); font-size: .85rem; white-space: nowrap; }

  td.td-invoice-num a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    font-size: .85rem;
  }
  td.td-invoice-num a:hover { text-decoration: underline; }

  td.td-mono {
    font-family: 'DM Mono', monospace;
    font-size: .8rem;
    color: var(--muted);
  }

  /* status badge */
  .badge-status {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: .22rem .65rem;
    border-radius: 20px;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .badge-paid    { background: #dcfce7; color: #166534; }
  .badge-pending { background: #fef9c3; color: #854d0e; }
  .badge-failed  { background: #fee2e2; color: #991b1b; }
  .badge-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  /* view button */
  .btn-view {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .32rem .85rem;
    background: #334155;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-family: 'DM Sans', sans-serif;
    font-size: .78rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .18s, transform .12s;
    white-space: nowrap;
  }
  .btn-view:hover { background: #1e293b; transform: translateY(-1px); }

  /* ── empty state ────────────────────────────────── */
  .empty-state {
    text-align: center;
    padding: 2.5rem 1rem;
    color: #c0c6de;
  }
  .empty-state .icon { font-size: 2rem; margin-bottom: .5rem; }
  .empty-state p { font-size: .85rem; }

  /* ── pagination ─────────────────────────────────── */
  .pagination-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.1rem;
    flex-wrap: wrap;
    gap: .6rem;
  }
  .pagination-info { font-size: .8rem; color: var(--muted); }

  .pagination-btns { display: flex; align-items: center; gap: .3rem; }
  .pg-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px; height: 32px;
    padding: 0 .4rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--muted);
    font-family: 'DM Sans', sans-serif;
    font-size: .8rem;
    font-weight: 500;
    cursor: pointer;
    transition: background .15s, border-color .15s, color .15s;
  }
  .pg-btn:hover:not(:disabled):not(.active) {
    background: var(--accent-lt);
    border-color: var(--accent);
    color: var(--accent);
  }
  .pg-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 700;
  }
  .pg-btn:disabled { opacity: .4; cursor: not-allowed; }

  /* ── footer ─────────────────────────────────────── */
  .dash-footer {
    margin-top: 1.5rem;
    text-align: center;
    font-size: .75rem;
    color: #b0b7d3;
  }
  .dash-footer a { color: var(--accent); text-decoration: none; }
</style>

<div class="container-fluid mt-4">

  <div class="breadcrumb">
    Portal <span class="sep">/</span> Payments <span class="sep">/</span> <span>Invoices</span>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="dot"></div>
      <h2>Invoices</h2>
    </div>
    <div class="card-body">

      <!-- Search / Filter toggle -->
      <div class="filter-toggle" @onclick="() => filterOpen = !filterOpen">
        <span class="toggle-icon">@(filterOpen ? "−" : "+")</span>
        <span>Search / Filter</span>
      </div>

      @if (filterOpen)
      {
        <div class="filter-panel">
          <div class="filter-field">
            <label>Invoice #</label>
            <input type="text" @bind="filterInvoiceNum" placeholder="e.g. 41606" />
          </div>
          <div class="filter-field">
            <label>Status</label>
            <select @bind="filterStatus">
              <option value="">All</option>
              <option value="PAID">Paid</option>
              <option value="PENDING">Pending</option>
              <option value="FAILED">Failed</option>
            </select>
          </div>
          <div class="filter-field">
            <label>Date From</label>
            <input type="date" @bind="filterDateFrom" />
          </div>
          <button class="btn-filter-search" @onclick="ApplyFilter">🔍 Search</button>
        </div>
      }

      <!-- Show N entries -->
      <div class="entries-row">
        Show
        <select @bind="pageSize" @bind:after="ResetPage">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
        entries
      </div>

      <!-- Table -->
      <div class="inv-table-wrap">
        <table>
          <thead>
            <tr>
              <th @onclick='() => Sort("InvoiceNum")'>Invoice # <span class="sort-icon">⇅</span></th>
              <th @onclick='() => Sort("InvoiceDate")'>Invoice Date <span class="sort-icon">⇅</span></th>
              <th @onclick='() => Sort("SmsQty")'>SMS Quantity <span class="sort-icon">⇅</span></th>
              <th @onclick='() => Sort("Validity")'>Validity <span class="sort-icon">⇅</span></th>
              <th @onclick='() => Sort("AmountDue")'>Amount Due <span class="sort-icon">⇅</span></th>
              <th @onclick='() => Sort("Status")'>Status <span class="sort-icon">⇅</span></th>
              <th @onclick='() => Sort("AmountPaid")'>Amount Paid <span class="sort-icon">⇅</span></th>
              <th @onclick='() => Sort("PaymentDate")'>Payment Date <span class="sort-icon">⇅</span></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @if (!PagedInvoices.Any())
            {
              <tr>
                <td colspan="9">
                  <div class="empty-state">
                    <div class="icon">🧾</div>
                    <p>No invoices found.</p>
                  </div>
                </td>
              </tr>
            }
            else
            {
              @foreach (var inv in PagedInvoices)
              {
                <tr>
                  <td class="td-invoice-num"><a href="#">@inv.InvoiceNum</a></td>
                  <td class="td-mono">@inv.InvoiceDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                  <td>@inv.SmsQty.ToString("N0")</td>
                  <td>@inv.Validity</td>
                  <td>GHS @inv.AmountDue.ToString("F2")</td>
                  <td>
                    <span class="badge-status @BadgeClass(inv.Status)">
                      <span class="badge-dot"></span>@inv.Status
                    </span>
                  </td>
                  <td>GHS @inv.AmountPaid.ToString("F2")</td>
                  <td class="td-mono">@inv.PaymentDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                  <td>
                    <button class="btn-view" @onclick="() => ViewInvoice(inv)">
                      👁 View
                    </button>
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="pagination-row">
        <span class="pagination-info">
          @PaginationInfo
        </span>
        <div class="pagination-btns">
          <button class="pg-btn" @onclick="() => currentPage = 1"         disabled="@(currentPage == 1)">«</button>
          <button class="pg-btn" @onclick="() => currentPage--"           disabled="@(currentPage == 1)">Previous</button>
          @for (int p = 1; p <= TotalPages; p++)
          {
            var pg = p;
            <button class="pg-btn @(currentPage == pg ? "active" : "")" @onclick="() => currentPage = pg">@pg</button>
          }
          <button class="pg-btn" @onclick="() => currentPage++"          disabled="@(currentPage == TotalPages)">Next</button>
          <button class="pg-btn" @onclick="() => currentPage = TotalPages" disabled="@(currentPage == TotalPages)">»</button>
        </div>
      </div>

    </div>
  </div>
  
</div>

@code {
  private bool   filterOpen       = false;
  private string filterInvoiceNum = string.Empty;
  private string filterStatus     = string.Empty;
  private DateTime? filterDateFrom;
  
  private int currentPage = 1;
  private int pageSize    = 10;
  
  private string sortField = "InvoiceDate";
  private bool   sortAsc   = false;
  
  private record Invoice(
    string   InvoiceNum,
    DateTime InvoiceDate,
    int      SmsQty,
    string   Validity,
    decimal  AmountDue,
    string   Status,
    decimal  AmountPaid,
    DateTime PaymentDate
  );
  
  private List<Invoice> allInvoices = new()
  {
    new("41606", new DateTime(2024,8,16,12,22,24), 3508, "Non-expiring", 100.00m, "PAID",    103.00m, new DateTime(2024,8,16,12,25,22)),
    new("41502", new DateTime(2024,7,10,9,14,5),   1694, "Non-expiring",  50.00m, "PAID",     51.50m, new DateTime(2024,7,10,9,20,11)),
    new("41398", new DateTime(2024,6,2,15,30,0),   7246, "Non-expiring", 200.00m, "PAID",    206.00m, new DateTime(2024,6,2,15,45,33)),
    new("41280", new DateTime(2024,5,18,11,5,44),   649, "Non-expiring",  20.00m, "PENDING",   0.00m, new DateTime(2024,5,18,11,5,44)),
    new("41177", new DateTime(2024,4,22,8,0,0),    307,  "Non-expiring",  10.00m, "FAILED",    0.00m, new DateTime(2024,4,22,8,0,0)),
  };

  private List<Invoice> filteredInvoices = new();

  protected override void OnInitialized()
  {
    filteredInvoices = allInvoices.ToList();
  }
  
  private void ApplyFilter()
  {
    filteredInvoices = allInvoices
      .Where(i =>
        (string.IsNullOrEmpty(filterInvoiceNum) || i.InvoiceNum.Contains(filterInvoiceNum)) &&
        (string.IsNullOrEmpty(filterStatus)     || i.Status == filterStatus) &&
        (filterDateFrom == null                  || i.InvoiceDate.Date >= filterDateFrom.Value.Date)
      ).ToList();
    currentPage = 1;
  }
  
  private void Sort(string field)
  {
    if (sortField == field) sortAsc = !sortAsc;
    else { sortField = field; sortAsc = true; }
  }

  private IEnumerable<Invoice> SortedInvoices => sortField switch
  {
    "InvoiceNum"  => sortAsc ? filteredInvoices.OrderBy(i => i.InvoiceNum)   : filteredInvoices.OrderByDescending(i => i.InvoiceNum),
    "InvoiceDate" => sortAsc ? filteredInvoices.OrderBy(i => i.InvoiceDate)  : filteredInvoices.OrderByDescending(i => i.InvoiceDate),
    "SmsQty"      => sortAsc ? filteredInvoices.OrderBy(i => i.SmsQty)       : filteredInvoices.OrderByDescending(i => i.SmsQty),
    "AmountDue"   => sortAsc ? filteredInvoices.OrderBy(i => i.AmountDue)    : filteredInvoices.OrderByDescending(i => i.AmountDue),
    "Status"      => sortAsc ? filteredInvoices.OrderBy(i => i.Status)       : filteredInvoices.OrderByDescending(i => i.Status),
    "AmountPaid"  => sortAsc ? filteredInvoices.OrderBy(i => i.AmountPaid)   : filteredInvoices.OrderByDescending(i => i.AmountPaid),
    "PaymentDate" => sortAsc ? filteredInvoices.OrderBy(i => i.PaymentDate)  : filteredInvoices.OrderByDescending(i => i.PaymentDate),
    _             => filteredInvoices.AsEnumerable()
  };
  
  private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)filteredInvoices.Count / pageSize));

  private IEnumerable<Invoice> PagedInvoices =>
    SortedInvoices.Skip((currentPage - 1) * pageSize).Take(pageSize);

  private string PaginationInfo
  {
    get
    {
      var total = filteredInvoices.Count;
      if (total == 0) return "Showing 0 entries";
      var from = (currentPage - 1) * pageSize + 1;
      var to   = Math.Min(currentPage * pageSize, total);
      return $"Showing {from} to {to} of {total} entries";
    }
  }

  private void ResetPage() => currentPage = 1;
  
  private string BadgeClass(string status) => status switch
  {
    "PAID"    => "badge-paid",
    "PENDING" => "badge-pending",
    "FAILED"  => "badge-failed",
    _         => "badge-pending"
  };

  private void ViewInvoice(Invoice inv)
  {
    // TODO: navigate to invoice detail page
    Console.WriteLine($"Viewing invoice {inv.InvoiceNum}");
  }
}
