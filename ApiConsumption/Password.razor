@page "/account/password"
@using Microsoft.AspNetCore.Components.Web
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg:        #f0f2f7;
    --surface:   #ffffff;
    --border:    #e2e6f0;
    --text:      #1a1f36;
    --muted:     #6b7399;
    --accent:    #4f46e5;
    --accent-lt: #eef2ff;
    --danger:    #ef4444;
    --success:   #22c55e;
    --radius:    12px;
    --shadow:    0 1px 4px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.06);
  }

  .container-fluid.mt-4 {
    padding: 1.75rem 2rem;
    max-width: 1800px;
    margin: 0 auto;
  }

  /* ── breadcrumb ─────────────────────────────────── */
  .breadcrumb {
    font-size: .8rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: .4rem;
  }
  .breadcrumb span { color: var(--accent); font-weight: 500; }
  .breadcrumb .sep { opacity: .4; }

  /* ── card ───────────────────────────────────────── */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .card-header {
    padding: .85rem 1.4rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: .6rem;
  }
  .card-header h2 { font-size: .95rem; font-weight: 700; margin: 0; color: var(--text); }
  .card-header .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent); flex-shrink: 0;
  }
  .card-body { padding: 1.75rem 1.4rem; max-width: 640px; }

  /* ── field group ────────────────────────────────── */
  .field-group {
    display: flex;
    flex-direction: column;
    gap: .4rem;
    margin-bottom: 1.1rem;
  }
  .field-group label {
    font-size: .82rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: .01em;
  }

  /* ── icon input ─────────────────────────────────── */
  .icon-input {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface);
    transition: border-color .18s, box-shadow .18s;
  }
  .icon-input:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(79,70,229,.1);
  }
  .icon-input.error {
    border-color: var(--danger);
    box-shadow: 0 0 0 3px rgba(239,68,68,.1);
  }
  .icon-slot {
    width: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f6fa;
    border-right: 1px solid var(--border);
    color: var(--muted);
    font-size: .9rem;
    flex-shrink: 0;
  }
  .icon-input input {
    flex: 1;
    padding: .65rem .85rem;
    border: none;
    outline: none;
    font-family: 'DM Sans', sans-serif;
    font-size: .875rem;
    color: var(--text);
    background: transparent;
    min-width: 0;
  }
  .icon-input input::placeholder { color: #b0b7d3; }

  /* show/hide toggle */
  .toggle-vis {
    padding: 0 .75rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--muted);
    font-size: .85rem;
    display: flex;
    align-items: center;
    transition: color .15s;
  }
  .toggle-vis:hover { color: var(--accent); }

  /* ── validation message ─────────────────────────── */
  .val-msg {
    font-size: .75rem;
    margin-top: .1rem;
  }
  .val-msg.error   { color: var(--danger); }
  .val-msg.success { color: var(--success); }

  /* ── password strength ──────────────────────────── */
  .strength-bar {
    display: flex;
    gap: 3px;
    margin-top: .35rem;
  }
  .strength-seg {
    height: 4px;
    flex: 1;
    border-radius: 2px;
    background: var(--border);
    transition: background .25s;
  }
  .strength-seg.weak   { background: #ef4444; }
  .strength-seg.fair   { background: #f59e0b; }
  .strength-seg.good   { background: #22c55e; }
  .strength-seg.strong { background: #16a34a; }
  .strength-label {
    font-size: .72rem;
    color: var(--muted);
    margin-top: .25rem;
  }

  /* ── divider ────────────────────────────────────── */
  .section-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1.5rem 0 1.25rem;
  }

  /* ── update button ──────────────────────────────── */
  .btn-update {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .65rem 1.6rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 9px;
    font-family: 'DM Sans', sans-serif;
    font-size: .875rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(79,70,229,.35);
    transition: background .18s, transform .12s, opacity .15s;
  }
  .btn-update:hover:not(:disabled) { background: #4338ca; transform: translateY(-1px); }
  .btn-update:disabled { opacity: .55; cursor: not-allowed; transform: none; }

  /* ── toast ──────────────────────────────────────── */
  .toast {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .6rem 1rem;
    border-radius: 8px;
    font-size: .82rem;
    font-weight: 500;
    margin-top: 1rem;
    animation: fadeIn .2s ease;
  }
  .toast.success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
  .toast.error   { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
  @@keyframes fadeIn { from { opacity:0; transform:translateY(-4px) } to { opacity:1; transform:none } }

  /* ── footer ─────────────────────────────────────── */
  .dash-footer {
    margin-top: 1.5rem;
    text-align: center;
    font-size: .75rem;
    color: #b0b7d3;
  }
  .dash-footer a { color: var(--accent); text-decoration: none; }
</style>

<div class="container-fluid mt-4">

  <div class="breadcrumb">
    Portal <span class="sep">/</span> My Account <span class="sep">/</span> <span>Password</span>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="dot"></div>
      <h2>Account Password</h2>
    </div>

    <div class="card-body">

      <!-- Current Password -->
      <div class="field-group">
        <label>Current Password</label>
        <div class="icon-input @(showCurrentError ? "error" : "")">
          <span class="icon-slot"></span>
          <input type="@(showCurrent ? "text" : "password")"
                 @value="currentPassword"
                 @bind:event="oninput"
                 @oninput="ClearMessages"
                 placeholder="Current Password" />
          <button type="button" class="toggle-vis" @onclick="() => showCurrent = !showCurrent"
                  title="@(showCurrent ? "Hide" : "Show")">
            @(showCurrent ? "🙈" : "👁")
          </button>
        </div>
        @if (showCurrentError)
        {
          <span class="val-msg error">Current password is required.</span>
        }
      </div>

      <!-- New Password -->
      <div class="field-group">
        <label>New Password</label>
        <div class="icon-input @(showNewError ? "error" : "")">
          <span class="icon-slot"></span>
          <input type="@(showNew ? "text" : "password")"
                 @value="newPassword"
                 @bind:event="oninput"
                 @oninput="OnNewPasswordInput"
                 placeholder="New Password" />
          <button type="button" class="toggle-vis" @onclick="() => showNew = !showNew"
                  title="@(showNew ? "Hide" : "Show")">
            @(showNew ? "🙈" : "👁")
          </button>
        </div>
        @if (!string.IsNullOrEmpty(newPassword))
        {
          <div class="strength-bar">
            @for (int i = 0; i < 4; i++)
            {
              var idx = i;
              <div class="strength-seg @StrengthSegClass(idx)"></div>
            }
          </div>
          <span class="strength-label">Strength: @StrengthLabel</span>
        }
        @if (showNewError)
        {
          <span class="val-msg error">New password must be at least 8 characters.</span>
        }
      </div>

      <!-- Confirm Password -->
      <div class="field-group">
        <label>Confirm Password</label>
        <div class="icon-input @(showConfirmError ? "error" : confirmPassword.Length > 0 && confirmPassword == newPassword ? "success-border" : "")">
          <span class="icon-slot"></span>
          <input type="@(showConfirm ? "text" : "password")"
                 @value="confirmPassword"
                 @bind:event="oninput"
                 @oninput="ClearMessages"
                 placeholder="New Password" />
          <button type="button" class="toggle-vis" @onclick="() => showConfirm = !showConfirm"
                  title="@(showConfirm ? "Hide" : "Show")">
            @(showConfirm ? "🙈" : "👁")
          </button>
        </div>
        @if (showConfirmError)
        {
          <span class="val-msg error">Passwords do not match.</span>
        }
        @if (!showConfirmError && confirmPassword.Length > 0 && confirmPassword == newPassword)
        {
          <span class="val-msg success">✓ Passwords match.</span>
        }
      </div>

      <hr class="section-divider" />

      <button class="btn-update" @onclick="UpdatePassword" disabled="@isUpdating">
        @if (isUpdating)
        { <span> Updating…</span> }
        else
        { <span>Update</span> }
      </button>

      @if (!string.IsNullOrEmpty(toastMessage))
      {
        <div class="toast @toastType">
          @(toastType == "success" ? "✓" : "✕") @toastMessage
        </div>
      }

    </div>
  </div>

 
</div>

@code {
  // ── field values ──────────────────────────────────
  private string currentPassword = string.Empty;
  private string newPassword     = string.Empty;
  private string confirmPassword = string.Empty;

  // ── visibility toggles ────────────────────────────
  private bool showCurrent = false;
  private bool showNew     = false;
  private bool showConfirm = false;

  // ── validation flags ──────────────────────────────
  private bool showCurrentError = false;
  private bool showNewError     = false;
  private bool showConfirmError = false;

  // ── ui state ──────────────────────────────────────
  private bool   isUpdating    = false;
  private string toastMessage  = string.Empty;
  private string toastType     = string.Empty; // "success" | "error"

  // ── password strength ─────────────────────────────
  private int StrengthScore
  {
    get
    {
      if (string.IsNullOrEmpty(newPassword)) return 0;
      int score = 0;
      if (newPassword.Length >= 8)                                   score++;
      if (newPassword.Any(char.IsUpper) && newPassword.Any(char.IsLower)) score++;
      if (newPassword.Any(char.IsDigit))                             score++;
      if (newPassword.Any(c => !char.IsLetterOrDigit(c)))            score++;
      return score;
    }
  }

  private string StrengthLabel => StrengthScore switch
  {
    1 => "Weak",
    2 => "Fair",
    3 => "Good",
    4 => "Strong",
    _ => ""
  };

  private string StrengthSegClass(int index)
  {
    if (index >= StrengthScore) return "";
    return StrengthScore switch
    {
      1 => "weak",
      2 => "fair",
      3 => "good",
      4 => "strong",
      _ => ""
    };
  }

  // ── handlers ──────────────────────────────────────
  private void OnNewPasswordInput(ChangeEventArgs e)
  {
    newPassword    = e.Value?.ToString() ?? "";
    showNewError   = false;
    toastMessage   = string.Empty;
  }

  private void ClearMessages(ChangeEventArgs _)
  {
    showCurrentError = false;
    showConfirmError = false;
    toastMessage     = string.Empty;
  }

  private async Task UpdatePassword()
  {
    // validate
    showCurrentError = string.IsNullOrWhiteSpace(currentPassword);
    showNewError     = newPassword.Length < 8;
    showConfirmError = confirmPassword != newPassword;

    if (showCurrentError || showNewError || showConfirmError) return;

    isUpdating   = true;
    toastMessage = string.Empty;
    await Task.Delay(800); // simulate API call

    
    isUpdating   = false;
    toastMessage = "Password updated successfully.";
    toastType    = "success";

    currentPassword = string.Empty;
    newPassword     = string.Empty;
    confirmPassword = string.Empty;
  }
}
