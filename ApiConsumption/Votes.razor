@page "/votes"

@using Microsoft.AspNetCore.Components.Web
@using NovaAccounts.Components.Layout
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.DataFields
@inject NovaAccounts.Shared.ApiClient ApiClient
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<h3>Vote Management</h3>

<div class="container-fluid mt-4">
    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    else
    {
        <!-- Statistics Cards -->
        <div class="row">
            <div class="col-md-4">
                <DashboardStatCard
                    IconClass="fa-check-square"
                    Value="@todayVotes"
                    DisplayValue="@todayVotes.ToString()"
                    Description="Today's Votes"
                    ColorClass="blue"
                    ElementId="todayVotes"/>
            </div>
            <div class="col-md-4">
                <DashboardStatCard
                    IconClass="fa-check-square"
                    Value="@totalVotes"
                    DisplayValue="@totalVotes.ToString("N0")"
                    Description="Total Votes"
                    ColorClass="green"
                    ElementId="totalVotes"/>
            </div>
            <div class="col-md-4">
                <DashboardStatCard
                    IconClass="fa-users"
                    Value="@uniqueVoters"
                    DisplayValue="@uniqueVoters.ToString("N0")"
                    Description="Unique Voters"
                    ColorClass="purple"
                    ElementId="uniqueVoters"/>
            </div>
        </div>
        
        <!-- Filter Section -->
        <div class="filter-section">
            <div class="filter-header">
                <h6><i class="filter-icon"></i> Filter Votes</h6>
            </div>
            <div class="filter-grid">
                <div class="filter-group">
                    <label for="phoneNumber">Phone Number</label>
                    <input type="text" id="phoneNumber" 
                           @bind="filterPhoneNumber" 
                           placeholder="233XXXXXXXXX"
                           class="filter-input" />
                </div>
                <div class="filter-group">
                    <label for="sessionId">Session ID</label>
                    <input type="text" id="sessionId" 
                           @bind="filterSessionId" 
                           placeholder="Session ID"
                           class="filter-input" />
                </div>
                <div class="filter-actions">
                    <button class="btn-primary" @onclick="ApplyFilters">
                        <i class="search-icon"></i> Search
                    </button>
                    <button class="btn-secondary" @onclick="ClearFilters">
                        Clear
                    </button>
                </div>
            </div>
        </div>

        <!-- Votes Table -->
        <ReusableDataTable TItem="VoteViewModel" 
                           Data="@votes" 
                           Columns="@voteColumns" 
                           Options="@voteOptions" />
    }
</div>

@code {
    private List<VoteViewModel>? votes;
    private bool isLoading = true;
    private string? errorMessage;
    private List<DataTableColumn> voteColumns = new();
    private DataTableOptions voteOptions = new();

    // Filter properties
    private string? filterPhoneNumber;
    private string? filterSessionId;

    // Statistics
    private int todayVotes = 0;
    private int totalVotes = 0;
    private int uniqueVoters = 0;

    protected override async Task OnInitializedAsync()
    {
        ConfigureVoteTable();
        await LoadVotes();
    }

    private async Task LoadVotes()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var results = await ApiClient.GetAllVotesAsync(
                filterPhoneNumber, 
                filterSessionId
            );

            if (results != null && results.Any())
            {
                votes = results.Select(r => new VoteViewModel
                {
                    Msisdn = r.Msisdn,
                    SessionId = r.SessionId,
                    Vote = r.Vote,
                    Timestamp = r.Timestamp
                }).ToList();

                // Update statistics
                totalVotes = votes.Count;
                todayVotes = votes.Count(v => v.Timestamp.Date == DateTime.Today);
                uniqueVoters = votes.Select(v => v.Msisdn).Distinct().Count();
            }
            else
            {
                votes = new List<VoteViewModel>();
                ResetStatistics();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading votes: {ex.Message}";
            Console.WriteLine($"Full Error: {ex}");
            votes = new List<VoteViewModel>();
            ResetStatistics();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        await LoadVotes();
    }

    private async Task ClearFilters()
    {
        filterPhoneNumber = null;
        filterSessionId = null;
        await LoadVotes();
    }

    private void ResetStatistics()
    {
        totalVotes = 0;
        todayVotes = 0;
        uniqueVoters = 0;
    }

    private void ConfigureVoteTable()
    {
        voteColumns = new List<DataTableColumn>
        {
            new() { 
                Header = "TIMESTAMP", 
                PropertyName = nameof(VoteViewModel.Timestamp), 
                DataType = "date",
                CustomRenderer = (item) => ((VoteViewModel)item).Timestamp.ToString("dd MMM yyyy HH:mm")
            },
            new() { 
                Header = "MSISDN", 
                PropertyName = nameof(VoteViewModel.Msisdn),
                CustomRenderer = (item) => $"<strong>{((VoteViewModel)item).Msisdn}</strong>"
            },
            new() { 
                Header = "SESSION ID", 
                PropertyName = nameof(VoteViewModel.SessionId),
                CustomRenderer = (item) => $"<code>{((VoteViewModel)item).SessionId}</code>"
            },
            new() { 
                Header = "VOTE", 
                PropertyName = nameof(VoteViewModel.Vote),
                CustomRenderer = (item) => 
                {
                    var vote = ((VoteViewModel)item).Vote;
                    return $"<span class='badge badge-success'>{vote}</span>";
                }
            }
        };

        voteOptions = new DataTableOptions
        {
            PageLength = 10,
            LengthMenu = new[] { 10, 25, 50, 100 },
            LengthMenuLabels = new[] { "10", "25", "50", "100" },
            SearchPlaceholder = "Search Votes",
            TableId = "voteTable",
            HeaderCssClass = "leadBold bg-blue-chambray font-white",
            RowCssClass = "lead font-blue-ebonyclay",
            Striped = true,
            AdditionalOptions = new Dictionary<string, object>
            {
                ["select"] = true,
                ["buttons"] = new[] { "copy", "csv", "excel", "pdf", "print", "colvis" },
                ["dom"] = "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6 text-end'Bf>>" +
                         "<'row'<'col-sm-12'tr>>" +
                         "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                ["order"] = new object[] { new object[] { 0, "desc" } },
                ["language"] = new Dictionary<string, object>
                {
                    ["search"] = "Search Votes:",
                    ["lengthMenu"] = "Show _MENU_ votes per page",
                    ["info"] = "Showing _START_ to _END_ of _TOTAL_ votes",
                    ["infoEmpty"] = "No votes found",
                    ["infoFiltered"] = "(filtered from _MAX_ total votes)",
                    ["emptyTable"] = "No vote data available",
                    ["zeroRecords"] = "No matching votes found"
                }
            }
        };
    }

    private class VoteViewModel
    {
        public string? Msisdn { get; set; }
        public string? SessionId { get; set; }
        public string? Vote { get; set; }
        public DateTimeOffset Timestamp { get; set; }
    }
}

<style>
    .filter-section {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        margin-bottom: 24px;
    }

    .filter-header {
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid #eaeaea;
    }

    .filter-header h6 {
        margin: 0;
        font-weight: 600;
        color: #333;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        align-items: end;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
    }

    .filter-group label {
        font-size: 14px;
        color: #666;
        margin-bottom: 6px;
        font-weight: 500;
    }

    .filter-input {
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 14px;
        transition: border-color 0.2s;
    }

    .filter-input:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .filter-actions {
        display: flex;
        gap: 12px;
    }

    .btn-primary, .btn-secondary {
        padding: 10px 20px;
        border-radius: 8px;
        border: none;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        flex: 1;
    }

    .btn-primary {
        background: #3b82f6;
        color: white;
    }

    .btn-primary:hover {
        background: #2563eb;
    }

    .btn-secondary {
        background: #f3f4f6;
        color: #666;
        border: 1px solid #ddd;
    }

    .btn-secondary:hover {
        background: #e5e7eb;
    }

    .badge-success {
        background: #10b981;
        color: white;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 500;
    }
</style>