@page "/topup"
@using Microsoft.AspNetCore.Components.Web
@using NovaAccounts.Components.Shared
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg:        #f0f2f7;
    --surface:   #ffffff;
    --border:    #e2e6f0;
    --text:      #1a1f36;
    --muted:     #6b7399;
    --accent:    #4f46e5;
    --accent-lt: #eef2ff;
    --radius:    12px;
    --shadow:    0 1px 4px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.06);
  }

  .container-fluid.mt-4 {
    padding: 1.75rem 2rem;
    max-width: 1800px;
    margin: 0 auto;
  }

  /* ── breadcrumb ─────────────────────────────────── */
  .breadcrumb {
    font-size: .8rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: .4rem;
  }
  .breadcrumb span { color: var(--accent); font-weight: 500; }
  .breadcrumb .sep { opacity: .4; }

  /* ── card ───────────────────────────────────────── */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .card-header {
    padding: .85rem 1.25rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: .6rem;
  }
  .card-header h2 { font-size: .9rem; font-weight: 600; margin: 0; }
  .card-header .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }
  .card-body { padding: 1.25rem; }

  /* ── tabs ───────────────────────────────────────── */
  .tab-bar {
    display: flex;
    border-bottom: 2px solid var(--border);
    margin-bottom: 1.5rem;
  }
  .tab-btn {
    padding: .6rem 1.25rem;
    font-size: .85rem;
    font-weight: 500;
    font-family: inherit;
    color: var(--muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    cursor: pointer;
    transition: color .18s, border-color .18s;
    white-space: nowrap;
  }
  .tab-btn:hover { color: var(--accent); }
  .tab-btn.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
    font-weight: 600;
  }

  /* ── packages table ─────────────────────────────── */
  .pkg-table-wrap { overflow-x: auto; }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: .9rem;
  }

  thead tr { border-bottom: 2px solid var(--border); }
  thead th {
    padding: .6rem 1.1rem;
    text-align: left;
    font-weight: 700;
    color: var(--text);
    font-size: .88rem;
    font-family: 'DM Sans', sans-serif;
  }
  thead th.col-right { text-align: right; }
  thead th.col-center { text-align: center; }

  tbody tr {
    border-bottom: 1px solid #f0f2f7;
    transition: background .12s;
  }
  tbody tr:hover { background: var(--accent-lt); }

  /* ── cell types ─────────────────────────────────── */

  /* currency cells: "GH¢ 10" — currency symbol muted, number dark */
  td.cell-currency {
    padding: .85rem 1.1rem;
    font-family: 'DM Sans', sans-serif;
    color: var(--text);
    font-size: .9rem;
    font-weight: 400;
    white-space: nowrap;
  }
  td.cell-currency .sym {
    color: var(--muted);
    font-size: .85rem;
    margin-right: .2rem;
  }
  td.cell-currency .num {
    color: var(--text);
    font-weight: 500;
  }

  /* price per sms: monospace, dark */
  td.cell-price {
    padding: .85rem 1.1rem;
    font-family: 'DM Sans', sans-serif;
    color: var(--text);
    font-size: .9rem;
    white-space: nowrap;
  }
  td.cell-price .sym {
    color: var(--muted);
    font-size: .85rem;
    margin-right: .2rem;
  }
  td.cell-price .num {
    color: var(--text);
    font-weight: 400;
  }

  /* quantity: right-aligned, dark, comma-formatted */
  td.cell-qty {
    padding: .85rem 1.1rem;
    text-align: center;
    font-family: 'DM Sans', sans-serif;
    font-size: .9rem;
    color: var(--text);
    font-weight: 400;
  }

  /* validity badge */
  td.cell-validity {
    padding: .85rem 1.1rem;
    text-align: center;
  }
  .badge-validity {
    display: inline-block;
    padding: .25rem .75rem;
    border-radius: 20px;
    font-size: .75rem;
    font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    letter-spacing: .02em;
  }
  .badge-non-expiring { background: #d1fae5; color: #065f46; }
  .badge-expiring     { background: #fef9c3; color: #854d0e; }

  /* action cell */
  td.cell-action {
    padding: .65rem 1.1rem;
    text-align: right;
  }

  .btn-buy {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .4rem 1rem;
    background: #334155;
    color: #fff;
    border: none;
    border-radius: 7px;
    font-family: 'DM Sans', sans-serif;
    font-size: .8rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .18s, transform .12s;
    white-space: nowrap;
  }
  .btn-buy:hover { background: #1e293b; transform: translateY(-1px); }

  /* ── divider ────────────────────────────────────── */
  .section-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1.5rem 0 1.25rem;
  }

  /* ── custom package form ────────────────────────── */
  .custom-pkg-hint {
    font-size: .82rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .custom-pkg-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 1rem;
    align-items: end;
    margin-bottom: 1.25rem;
  }
  @@media (max-width: 860px) { .custom-pkg-grid { grid-template-columns: 1fr 1fr; } }
  @@media (max-width: 540px) { .custom-pkg-grid { grid-template-columns: 1fr; } }

  .field-group { display: flex; flex-direction: column; gap: .35rem; }
  .field-group label {
    font-size: .75rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .05em;
    display: flex;
    align-items: center;
    gap: .2rem;
  }
  .field-group label .req { color: #ef4444; }

  .input-prefix-wrap {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color .18s, box-shadow .18s;
  }
  .input-prefix-wrap:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(79,70,229,.1);
  }
  .input-prefix {
    padding: .55rem .75rem;
    background: #f5f6fa;
    color: var(--muted);
    font-size: .8rem;
    font-weight: 600;
    font-family: 'DM Mono', monospace;
    border-right: 1px solid var(--border);
    display: flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .input-prefix-wrap input {
    flex: 1;
    padding: .55rem .75rem;
    border: none;
    outline: none;
    font-family: 'DM Sans', sans-serif;
    font-size: .875rem;
    color: var(--text);
    background: var(--surface);
    min-width: 0;
  }
  .input-prefix-wrap input::placeholder { color: #b0b7d3; }
  .input-suffix {
    padding: .55rem .75rem;
    background: #f5f6fa;
    color: var(--muted);
    font-size: .8rem;
    font-weight: 500;
    border-left: 1px solid var(--border);
    display: flex;
    align-items: center;
  }
  .input-prefix-wrap input[readonly] {
    background: #f8fafc;
    color: var(--muted);
    cursor: default;
  }

  .plain-input {
    width: 100%;
    padding: .57rem .85rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: .875rem;
    color: var(--text);
    background: var(--surface);
    transition: border-color .18s, box-shadow .18s;
    box-sizing: border-box;
  }
  .plain-input::placeholder { color: #b0b7d3; }
  .plain-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(79,70,229,.1);
  }

  .btn-buy-custom {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .6rem 1.4rem;
    background: #334155;
    color: #fff;
    border: none;
    border-radius: 9px;
    font-family: 'DM Sans', sans-serif;
    font-size: .875rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(51,65,85,.25);
    transition: background .18s, transform .12s;
  }
  .btn-buy-custom:hover { background: #1e293b; transform: translateY(-1px); }

  /* ── footer ─────────────────────────────────────── */
  .dash-footer {
    margin-top: 1.5rem;
    text-align: center;
    font-size: .75rem;
    color: #b0b7d3;
  }
  .dash-footer a { color: var(--accent); text-decoration: none; }
</style>

<div class="container-fluid mt-4">

  <div class="breadcrumb">
    Portal <span class="sep">/</span> Payments <span class="sep">/</span> <span>Topup</span>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="dot"></div>
      <h2>Credit Topup</h2>
    </div>
    <div class="card-body">

      <!-- Tabs -->
      <div class="tab-bar">
        <button class="tab-btn @(activeTab == "standard" ? "active" : "")"
                @onclick='() => activeTab = "standard"'>
          Non-Expiring Standard Packages
        </button>
        <button class="tab-btn @(activeTab == "express" ? "active" : "")"
                @onclick='() => activeTab = "express"'>
          Express Packages with Expiry
        </button>
      </div>

      <!-- Packages Table -->
      <div class="pkg-table-wrap">
        <table>
          <thead>
            <tr>
              <th>Amount</th>
              <th>Price Per SMS</th>
              <th class="col-center">SMS Quantity</th>
              <th class="col-center">Validity</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var pkg in ActivePackages)
            {
              <tr>
                <td class="cell-currency">
                  <span class="sym">GH¢</span><span class="num">@pkg.Amount.ToString("N0")</span>
                </td>
                <td class="cell-price">
                  <span class="sym">GH¢</span><span class="num">@pkg.PricePerSms.ToString("F4")</span>
                </td>
                <td class="cell-qty">@pkg.SmsQty.ToString("N0")</td>
                <td class="cell-validity">
                  @if (activeTab == "standard")
                  {
                    <span class="badge-validity badge-non-expiring">Non Expiring</span>
                  }
                  else
                  {
                    <span class="badge-validity badge-expiring">@pkg.Validity</span>
                  }
                </td>
                <td class="cell-action">
                  <button class="btn-buy" @onclick="() => BuyPackage(pkg)">
                    ● Buy
                  </button>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>

      <hr class="section-divider" />

      <!-- Custom Package -->
      <p class="custom-pkg-hint">Enter amount or quantity for your custom standard package</p>

      <div class="custom-pkg-grid">

        <div class="field-group">
          <label>Amount <span class="req">*</span></label>
          <div class="input-prefix-wrap">
            <span class="input-prefix">GH¢</span>
            <input type="number" min="0" step="1"
                   @value="customAmount" @bind:event="oninput"
                   @oninput="RecalcFromAmount"
                   placeholder="0" />
          </div>
        </div>

        <div class="field-group">
          <label>SMS Quantity <span class="req">*</span></label>
          <div class="input-prefix-wrap">
            <input type="number" min="0" step="1"
                   @value="customQty" @bind:event="oninput"
                   @oninput="RecalcFromQty"
                   placeholder="0" />
            <span class="input-suffix">+ 0</span>
          </div>
        </div>

        <div class="field-group">
          <label>Price Per SMS</label>
          <div class="input-prefix-wrap">
            <span class="input-prefix">GH¢</span>
            <input type="text" readonly value="@customPriceDisplay" placeholder="—" />
          </div>
        </div>

        <div class="field-group">
          <label>Discount Code</label>
          <input type="text" class="plain-input"
                 @bind="discountCode"
                 placeholder="If code is provided" />
        </div>

      </div>

      <button class="btn-buy-custom" @onclick="BuyCustomPackage">
        ● Buy Custom Package
      </button>

    </div>
  </div>
  
</div>

@code {
  private string activeTab = "standard";

  private record Package(decimal Amount, decimal PricePerSms, int SmsQty, string Validity = "");

  private List<Package> standardPackages = new()
  {
    new(10,    0.0325m, 307),
    new(20,    0.0308m, 649),
    new(50,    0.0295m, 1694),
    new(100,   0.0285m, 3508),
    new(200,   0.0276m, 7246),
    new(500,   0.0262m, 19083),
    new(1000,  0.0256m, 39062),
    new(2000,  0.0246m, 81300),
    new(3000,  0.0240m, 125000),
    new(5000,  0.0240m, 208333),
  };

  private List<Package> expressPackages = new()
  {
    new(10,   0.0350m, 285,   "7 Days"),
    new(20,   0.0330m, 606,   "14 Days"),
    new(50,   0.0315m, 1587,  "30 Days"),
    new(100,  0.0300m, 3333,  "30 Days"),
    new(200,  0.0290m, 6896,  "60 Days"),
    new(500,  0.0275m, 18181, "60 Days"),
    new(1000, 0.0265m, 37735, "90 Days"),
    new(2000, 0.0255m, 78431, "90 Days"),
  };

  private List<Package> ActivePackages =>
    activeTab == "standard" ? standardPackages : expressPackages;

  private decimal? customAmount;
  private int?     customQty;
  private string   discountCode       = string.Empty;
  private string   customPriceDisplay = string.Empty;
  private const decimal CustomRate    = 0.0325m;

  private void RecalcFromAmount(ChangeEventArgs e)
  {
    if (decimal.TryParse(e.Value?.ToString(), out var amt) && amt > 0)
    {
      customQty          = (int)Math.Floor(amt / CustomRate);
      customPriceDisplay = CustomRate.ToString("F4");
    }
    else
    {
      customQty          = null;
      customPriceDisplay = string.Empty;
    }
  }

  private void RecalcFromQty(ChangeEventArgs e)
  {
    if (int.TryParse(e.Value?.ToString(), out var qty) && qty > 0)
    {
      customAmount       = Math.Round(qty * CustomRate, 2);
      customPriceDisplay = CustomRate.ToString("F4");
    }
    else
    {
      customAmount       = null;
      customPriceDisplay = string.Empty;
    }
  }

  private void BuyPackage(Package pkg)
  {
    Console.WriteLine($"Buying package: GH¢{pkg.Amount} — {pkg.SmsQty} SMS");
  }

  private void BuyCustomPackage()
  {
    if (customAmount is null || customAmount <= 0) return;
    Console.WriteLine($"Custom package: GH¢{customAmount}, qty={customQty}, code={discountCode}");
  }
}
