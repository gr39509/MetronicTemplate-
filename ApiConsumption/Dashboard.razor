@page "/"
@using Microsoft.AspNetCore.Components.Web
@rendermode @(new InteractiveServerRenderMode(prerender: false))


  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <style>

    :root {
      --bg:        #f0f2f7;
      --surface:   #ffffff;
      --border:    #e2e6f0;
      --text:      #1a1f36;
      --muted:     #6b7399;
      --accent:    #4f46e5;
      --accent-lt: #eef2ff;
      --blue:      #2563eb;
      --blue-lt:   #dbeafe;
      --red:       #dc2626;
      --amber:     #f59e0b;
      --radius:    12px;
      --shadow:    0 1px 4px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.06);
    }
    

    /* ── layout ─────────────────────────────────────── */
    .container-fluid.mt-4 {
      padding: 1.75rem 2rem;
      max-width: 1800px;
      margin: 0 auto;
    }

    /* ── breadcrumb ─────────────────────────────────── */
    .breadcrumb {
      font-size: .8rem;
      color: var(--muted);
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      gap: .4rem;
    }
    .breadcrumb span { color: var(--accent); font-weight: 500; }
    .breadcrumb .sep { opacity: .4; }

    /* ── card ───────────────────────────────────────── */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: visible;
    }

    /* ── date filter bar ────────────────────────────── */
    .filter-bar {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding: 1rem 1.25rem;
      flex-wrap: wrap;
      position: relative;
    }

    .date-field {
      display: flex;
      align-items: center;
      gap: .5rem;
    }
    .date-field label {
      font-size: .82rem;
      font-weight: 600;
      color: var(--muted);
      white-space: nowrap;
    }
    .date-input-wrap {
      position: relative;
    }
    .date-input-wrap .clock {
      position: absolute;
      left: .65rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      font-size: .8rem;
      pointer-events: none;
    }
    .date-input-wrap input[type=text] {
      padding: .5rem .75rem .5rem 2rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-family: 'DM Mono', monospace;
      font-size: .82rem;
      color: var(--text);
      width: 148px;
      cursor: pointer;
      background: var(--surface);
      transition: border-color .18s, box-shadow .18s;
    }
    .date-input-wrap input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(79,70,229,.1);
    }

    .btn-submit {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      padding: .52rem 1.3rem;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 8px;
      font-family: inherit;
      font-size: .85rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 3px 10px rgba(79,70,229,.3);
      transition: background .18s, transform .12s;
    }
    .btn-submit:hover { background: #4338ca; transform: translateY(-1px); }

    /* ── calendar popover ───────────────────────────── */
    .cal-popover {
      display: none;
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      z-index: 100;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 0 8px 32px rgba(0,0,0,.12);
      padding: .75rem;
      width: 260px;
      animation: fadeIn .15s ease;
    }
    .cal-popover.open { display: block; }
    @@keyframes fadeIn { from { opacity:0; transform:translateY(-4px) } to { opacity:1; transform:none } }

    .cal-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: .6rem;
    }
    .cal-nav button {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1rem;
      color: var(--muted);
      padding: .2rem .4rem;
      border-radius: 5px;
      transition: background .15s;
    }
    .cal-nav button:hover { background: var(--accent-lt); color: var(--accent); }
    .cal-nav span {
      font-size: .85rem;
      font-weight: 600;
    }

    .cal-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 2px;
    }
    .cal-grid .day-name {
      text-align: center;
      font-size: .68rem;
      font-weight: 600;
      color: var(--muted);
      padding: .25rem 0;
      letter-spacing: .04em;
    }
    .cal-grid .day {
      text-align: center;
      padding: .32rem 0;
      border-radius: 6px;
      font-size: .8rem;
      cursor: pointer;
      transition: background .12s, color .12s;
    }
    .cal-grid .day:hover { background: var(--accent-lt); color: var(--accent); }
    .cal-grid .day.today { border: 1.5px solid var(--amber); color: var(--amber); font-weight: 600; }
    .cal-grid .day.selected { background: var(--accent); color: #fff; font-weight: 600; }
    .cal-grid .day.empty { cursor: default; }

    /* ── stat cards ─────────────────────────────────── */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      margin: 1.25rem 0;
    }
    @@media (max-width: 780px) { .stats-row { grid-template-columns: 1fr; } }

    .stat-card {
      border-radius: var(--radius);
      padding: 1.4rem 1.5rem 1rem;
      position: relative;
      overflow: hidden;
      min-height: 120px;
    }
    .stat-card.purple { background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); }
    .stat-card.blue   { background: linear-gradient(135deg, #2563eb 0%, #0ea5e9 100%); }
    .stat-card.red    { background: linear-gradient(135deg, #dc2626 0%, #f97316 100%); }

    .stat-card .stat-val {
      font-size: 2.2rem;
      font-weight: 700;
      color: #fff;
      line-height: 1;
      margin-bottom: .35rem;
      font-family: 'DM Mono', monospace;
    }
    .stat-card .stat-label {
      font-size: .72rem;
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: rgba(255,255,255,.75);
    }

    /* mini sparkline */
    .sparkline {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 50px;
      opacity: .45;
    }

    /* bar chart in red card */
    .mini-bars {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 50px;
      display: flex;
      align-items: flex-end;
      gap: 3px;
      padding: 0 12px;
      opacity: .45;
    }
    .mini-bar {
      flex: 1;
      background: rgba(255,255,255,.7);
      border-radius: 3px 3px 0 0;
    }

    /* ── traffic chart ──────────────────────────────── */
    .chart-card { margin-top: 0; }
    .chart-header {
      padding: 1rem 1.25rem .5rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: baseline;
      gap: .5rem;
    }
    .chart-header h2 { font-size: .95rem; font-weight: 700; }
    .chart-header .chart-date {
      font-size: .82rem;
      color: var(--muted);
      font-family: 'DM Mono', monospace;
    }

    .chart-wrap {
      padding: 1rem 1.25rem 1.25rem;
      position: relative;
    }

    canvas#trafficChart {
      width: 100% !important;
      height: 280px !important;
    }

    /* ── footer ─────────────────────────────────────── */
    .dash-footer {
      margin-top: 1.5rem;
      text-align: center;
      font-size: .75rem;
      color: #b0b7d3;
    }
    .dash-footer a { color: var(--accent); text-decoration: none; }
  </style>


<div class="container-fluid mt-4">

  <!-- Breadcrumb -->
  <div class="breadcrumb">
    Portal <span class="sep">/</span> <span>Dashboard</span>
  </div>

  <!-- Date Filter Bar -->
  <div class="card" style="margin-bottom:1.25rem;overflow:visible">
    <div class="filter-bar">

      <!-- Start Date -->
      <div class="date-field">
        <label>Start Date:</label>
        <div class="date-input-wrap" style="position:relative">
          <span class="clock">🕐</span>
          <input type="text" id="startInput" value="2026-03-11" readonly onclick="toggleCal('start')" />
          <div class="cal-popover" id="calStart"></div>
        </div>
      </div>

      <!-- End Date -->
      <div class="date-field">
        <label>End Date:</label>
        <div class="date-input-wrap" style="position:relative">
          <span class="clock">🕐</span>
          <input type="text" id="endInput" value="2026-03-11" readonly onclick="toggleCal('end')" />
          <div class="cal-popover" id="calEnd"></div>
        </div>
      </div>

      <button class="btn-submit">▶ Submit</button>
    </div>
  </div>

  <!-- Stat Cards -->
  <div class="stats-row">

    <div class="stat-card purple">
      <div class="stat-val">0</div>
      <div class="stat-label">Total Destinations</div>
      <svg class="sparkline" viewBox="0 0 300 50" preserveAspectRatio="none">
        <polyline points="0,40 50,38 100,35 150,35 200,33 250,35 300,35"
          fill="none" stroke="rgba(255,255,255,0.8)" stroke-width="2"/>
        <circle cx="50" cy="38" r="3" fill="white"/>
        <circle cx="150" cy="35" r="3" fill="white"/>
        <circle cx="250" cy="35" r="3" fill="white"/>
      </svg>
    </div>

    <div class="stat-card blue">
      <div class="stat-val">0</div>
      <div class="stat-label">Total Message Parts</div>
      <svg class="sparkline" viewBox="0 0 300 50" preserveAspectRatio="none">
        <polyline points="0,40 60,38 120,36 180,36 240,34 300,34"
          fill="none" stroke="rgba(255,255,255,0.8)" stroke-width="2"/>
        <circle cx="60" cy="38" r="3" fill="white"/>
        <circle cx="180" cy="36" r="3" fill="white"/>
        <circle cx="300" cy="34" r="3" fill="white"/>
      </svg>
    </div>

    <div class="stat-card red">
      <div class="stat-val">0</div>
      <div class="stat-label">Credit Usage</div>
      <div class="mini-bars" id="miniBars"></div>
    </div>

  </div>

  <!-- Traffic Chart -->
  <div class="card chart-card">
    <div class="chart-header">
      <h2>Traffic:</h2>
      <span class="chart-date" id="trafficDate">2026-03-11</span>
    </div>
    <div class="chart-wrap">
      <canvas id="trafficChart"></canvas>
    </div>
  </div>

</div>

<!-- Chart.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
  /* ── mini bars ─────────────────────────────────── */
  const miniBars = document.getElementById('miniBars');
  [8,14,6,10,4,12,7,16,5,9,11,3].forEach(h => {
    const b = document.createElement('div');
    b.className = 'mini-bar';
    b.style.height = h * 2.5 + 'px';
    miniBars.appendChild(b);
  });

  /* ── traffic chart ─────────────────────────────── */
  const hours = Array.from({length:24}, (_,i) => i.toString().padStart(2,'0') + ' hr');
  const data  = new Array(24).fill(0);

  const ctx = document.getElementById('trafficChart').getContext('2d');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: hours,
      datasets: [{
        label: 'Traffic',
        data,
        borderColor: '#2563eb',
        backgroundColor: 'rgba(37,99,235,.07)',
        borderWidth: 2,
        pointRadius: 4,
        pointBackgroundColor: '#2563eb',
        pointBorderColor: '#fff',
        pointBorderWidth: 2,
        tension: 0.3,
        fill: true,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: {
          grid: { color: '#e8ebf4' },
          ticks: { font: { family: "'DM Mono', monospace", size: 10 }, color: '#6b7399' }
        },
        y: {
          min: -1,
          max: 1,
          grid: { color: '#e8ebf4' },
          ticks: {
            stepSize: 0.2,
            font: { family: "'DM Mono', monospace", size: 10 },
            color: '#6b7399'
          }
        }
      }
    }
  });

  /* ── calendar ──────────────────────────────────── */
  let activeCal = null;
  const state = {
    start: { year: 2026, month: 2, selected: 11 },
    end:   { year: 2026, month: 2, selected: 11 },
  };

  function toggleCal(which) {
    if (activeCal === which) { closeCal(); return; }
    activeCal = which;
    renderCal(which);
    document.getElementById('cal' + cap(which)).classList.add('open');
  }

  function closeCal() {
    ['calStart','calEnd'].forEach(id => document.getElementById(id).classList.remove('open'));
    activeCal = null;
  }

  document.addEventListener('click', e => {
    if (!e.target.closest('.date-input-wrap')) closeCal();
  });

  function cap(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

  const MONTHS = ['January','February','March','April','May','June',
                  'July','August','September','October','November','December'];
  const DAYS   = ['Su','Mo','Tu','We','Th','Fr','Sa'];

  function renderCal(which) {
    const s   = state[which];
    const el  = document.getElementById('cal' + cap(which));
    const first = new Date(s.year, s.month, 1).getDay();
    const days  = new Date(s.year, s.month + 1, 0).getDate();
    const today = new Date();

    let html = `
      <div class="cal-nav">
        <button onclick="shiftMonth('${which}',-1)">‹</button>
        <span>${MONTHS[s.month]} ${s.year}</span>
        <button onclick="shiftMonth('${which}',1)">›</button>
      </div>
      <div class="cal-grid">
        ${DAYS.map(d => `<div class="day-name">${d}</div>`).join('')}
        ${Array(first).fill('<div class="day empty"></div>').join('')}`;

    for (let d = 1; d <= days; d++) {
      const isToday = today.getFullYear()===s.year && today.getMonth()===s.month && today.getDate()===d;
      const isSel   = s.selected === d;
      const cls     = [isToday?'today':'', isSel?'selected':''].filter(Boolean).join(' ');
      html += `<div class="day ${cls}" onclick="selectDay('${which}',${d})">${d}</div>`;
    }
    html += '</div>';
    el.innerHTML = html;
  }

  function shiftMonth(which, dir) {
    const s = state[which];
    s.month += dir;
    if (s.month > 11) { s.month = 0;  s.year++; }
    if (s.month < 0)  { s.month = 11; s.year--; }
    renderCal(which);
  }

  function selectDay(which, day) {
    state[which].selected = day;
    const s = state[which];
    const str = `${s.year}-${String(s.month+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
    document.getElementById(which + 'Input').value = str;
    document.getElementById('trafficDate').textContent = document.getElementById('startInput').value;
    renderCal(which);
  }
</script>
