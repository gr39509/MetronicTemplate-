@page "/account/coverage"
@using Microsoft.AspNetCore.Components.Web
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg:        #f0f2f7;
    --surface:   #ffffff;
    --border:    #e2e6f0;
    --text:      #1a1f36;
    --muted:     #6b7399;
    --accent:    #4f46e5;
    --accent-lt: #eef2ff;
    --radius:    12px;
    --shadow:    0 1px 4px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.06);
  }

  .container-fluid.mt-4 {
    padding: 1.75rem 2rem;
    max-width: 1800px;
    margin: 0 auto;
  }

  /* ── breadcrumb ─────────────────────────────────── */
  .breadcrumb {
    font-size: .8rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: .4rem;
  }
  .breadcrumb span { color: var(--accent); font-weight: 500; }
  .breadcrumb .sep { opacity: .4; }

  /* ── card ───────────────────────────────────────── */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  /* ── card header ────────────────────────────────── */
  .card-header {
    padding: 1rem 1.4rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: .75rem;
  }
  .flag {
    width: 28px;
    height: 20px;
    border-radius: 3px;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    box-shadow: 0 1px 3px rgba(0,0,0,.15);
  }
  .flag-stripe { flex: 1; }
  .flag-gh-red   { background: #006b3f; }   
  .flag-gh-gold  { background: #fcd116; }   
  .flag-gh-green { background: #ce1126; }  

  .country-name {
    font-size: .95rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: .01em;
  }
  .network-count {
    font-size: .875rem;
    color: var(--muted);
    font-style: italic;
  }

  /* ── table ──────────────────────────────────────── */
  .coverage-table-wrap { overflow-x: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: .875rem;
  }
  thead tr { border-bottom: 1px solid var(--border); }
  thead th {
    padding: .65rem 1.4rem;
    text-align: left;
    font-weight: 700;
    font-size: .82rem;
    color: var(--text);
    letter-spacing: .01em;
  }
  thead th.col-num { width: 60px; color: var(--muted); }

  tbody tr {
    border-bottom: 1px solid #f0f2f7;
    transition: background .12s;
  }
  tbody tr:last-child { border-bottom: none; }
  tbody tr:hover { background: var(--accent-lt); }

  tbody td {
    padding: .8rem 1.4rem;
    color: var(--text);
    font-size: .875rem;
  }
  tbody td.col-num {
    color: var(--muted);
    font-family: 'DM Mono', monospace;
    font-size: .8rem;
    width: 60px;
  }
  tbody td.col-network { font-weight: 400; }

  /* credit charge badge */
  .charge-badge {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-size: .8rem;
    color: var(--muted);
    font-weight: 500;
  }
  .charge-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
  }

  /* ── footer ─────────────────────────────────────── */
  .dash-footer {
    margin-top: 1.5rem;
    text-align: center;
    font-size: .75rem;
    color: #b0b7d3;
  }
  .dash-footer a { color: var(--accent); text-decoration: none; }
</style>

<div class="container-fluid mt-4">

  <div class="breadcrumb">
    Portal <span class="sep">/</span> My Account <span class="sep">/</span> <span>Coverage</span>
  </div>

  <div class="card">

    <!-- Header: flag + country name + network count -->
    <div class="card-header">
      <div class="flag">
        <div class="flag-stripe flag-gh-red"></div>
        <div class="flag-stripe flag-gh-gold"></div>
        <div class="flag-stripe flag-gh-green"></div>
      </div>
      <span class="country-name">@country.Name (@country.DialCode)</span>
      <span class="network-count">@country.Networks.Count networks.</span>
    </div>

    <!-- Networks Table -->
    <div class="coverage-table-wrap">
      <table>
        <thead>
          <tr>
            <th class="col-num">#</th>
            <th>Network</th>
            <th>Credit Charge</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var (net, i) in country.Networks.Select((n, i) => (n, i)))
          {
            <tr>
              <td class="col-num">@(i + 1)</td>
              <td class="col-network">@net.Name</td>
              <td>
                <span class="charge-badge">
                  <span class="charge-dot"></span>
                  @net.CreditCharge
                </span>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>

  </div>
  
</div>

@code {
  private CountryRecord country = new()
  {
    Name     = "Ghana",
    DialCode = "+233",
    Networks = new()
    {
      new("AirtelTigo",              "1 Per SMS"),
      new("Expresso Mobile (CDMA)", "1 Per SMS"),
      new("Glo GH",                 "1 Per SMS"),
      new("MTN (Scancom Ghana Ltd)","1 Per SMS"),
      new("Vodafone GH",            "1 Per SMS"),
    }
  };

  private record NetworkRecord(string Name, string CreditCharge);

  private class CountryRecord
  {
    public string Name     { get; set; } = string.Empty;
    public string DialCode { get; set; } = string.Empty;
    public List<NetworkRecord> Networks { get; set; } = new();
  }
}
