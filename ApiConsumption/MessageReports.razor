  private string rptStart = DateTime.Today.ToString("yyyy-MM-dd");
  private string rptEnd   = DateTime.Today.ToString("yyyy-MM-dd");

  private void SubmitSummary() { /* TODO: fetch summary stats */ }
  private string activeCal = "";
  private (int year, int month, int day) calStart = (DateTime.Today.Year, DateTime.Today.Month - 1, DateTime.Today.Day);
  private (int year, int month, int day) calEnd   = (DateTime.Today.Year, DateTime.Today.Month - 1, DateTime.Today.Day);

  private void ToggleCal(string which)
  {
    activeCal = activeCal == which ? "" : which;
  }

  private RenderFragment CalHtml(string which) => builder =>
  {
    var s     = which == "start" ? calStart : calEnd;
    var today = DateTime.Today;
    var first = new DateTime(s.year, s.month + 1, 1);
    var days  = DateTime.DaysInMonth(s.year, s.month + 1);
    var startDow = (int)first.DayOfWeek;

    string[] MONTHS = {"January","February","March","April","May","June","July","August","September","October","November","December"};
    string[] DAYS   = {"Su","Mo","Tu","We","Th","Fr","Sa"};

    int seq = 0;
    builder.OpenElement(seq++, "div");
    builder.AddAttribute(seq++, "class", "cal-nav");
    builder.OpenElement(seq++, "button");
    builder.AddAttribute(seq++, "type", "button");
    builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => ShiftCal(which, -1)));
    builder.AddContent(seq++, "‹");
    builder.CloseElement();
    builder.OpenElement(seq++, "span");
    builder.AddContent(seq++, $"{MONTHS[s.month]} {s.year}");
    builder.CloseElement();
    builder.OpenElement(seq++, "button");
    builder.AddAttribute(seq++, "type", "button");
    builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => ShiftCal(which, 1)));
    builder.AddContent(seq++, "›");
    builder.CloseElement();
    builder.CloseElement();

    builder.OpenElement(seq++, "div");
    builder.AddAttribute(seq++, "class", "cal-grid");
    foreach (var d in DAYS)
    {
      builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "dn"); builder.AddContent(seq++, d); builder.CloseElement();
    }
    for (int e = 0; e < startDow; e++)
    {
      builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "dd empty"); builder.CloseElement();
    }
    for (int d = 1; d <= days; d++)
    {
      var day = d;
      bool isToday = today.Year == s.year && today.Month == s.month + 1 && today.Day == d;
      bool isSel   = s.day == d;
      var cls = "dd" + (isToday ? " today" : "") + (isSel ? " sel" : "");
      builder.OpenElement(seq++, "div");
      builder.AddAttribute(seq++, "class", cls);
      builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => PickDay(which, day)));
      builder.AddContent(seq++, d.ToString());
      builder.CloseElement();
    }
    builder.CloseElement();
  };

  private void ShiftCal(string which, int dir)
  {
    var s = which == "start" ? calStart : calEnd;
    int m = s.month + dir;
    int y = s.year;
    if (m > 11) { m = 0;  y++; }
    if (m < 0)  { m = 11; y--; }
    if (which == "start") calStart = (y, m, s.day);
    else                  calEnd   = (y, m, s.day);
  }

  private void PickDay(string which, int day)
  {
    var s   = which == "start" ? calStart : calEnd;
    var str = $"{s.year}-{(s.month+1):D2}-{day:D2}";
    if (which == "start") { calStart = (s.year, s.month, day); rptStart = str; }
    else                  { calEnd   = (s.year, s.month, day); rptEnd   = str; }
    activeCal = "";
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (activeTab == "summary" && prevTab != "summary")
    {
      prevTab = activeTab;
      await Task.Delay(80);
      await JSRuntime.InvokeVoidAsync("eval", "if(window.__rptBuild) window.__rptBuild();");
    }
    else if (activeTab != "summary")
    {
      prevTab = activeTab;
    }
  }

  private record DeliveryRow(string MsgId, string To, string From, string Message,
                              int Length, string Status, string SentAt, string ReportedAt);
  private record ExportRow(string DateFrom, string DateTo, string Filter,
                           int Records, string Exported, string DownloadUrl);
}
