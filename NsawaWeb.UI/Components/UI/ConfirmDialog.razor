<Dialog Open="Open" Title="@Title" Size="sm" Busy="Busy" OnClose="OnCancel">
    <ChildContent>
        <p class="muted">@Message</p>
        <Alert Message="@Error" />
    </ChildContent>
    <Footer>
        <Button Variant="secondary" Disabled="Busy" OnClick="OnCancel">Cancel</Button>
        <Button Variant="@(Danger ? "danger" : "primary")" Loading="Busy" OnClick="OnConfirm">@ConfirmText</Button>
    </Footer>
</Dialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter, EditorRequired] public string Message { get; set; } = default!;
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
