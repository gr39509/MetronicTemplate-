<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- Shared pages, services and static assets for the web app and the mobile app. -->
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Keeps the NsawaWeb.* namespaces the code had before it moved here. -->
        <RootNamespace>NsawaWeb</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Microsoft.Extensions.DependencyInjection" />
        <Using Include="Microsoft.Extensions.Logging" />
    </ItemGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.8" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.8" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.8" />
        <PackageReference Include="QRCoder" Version="1.7.0" />
        <PackageReference Include="SkiaSharp" Version="3.119.1" />
        <PackageReference Include="Humanizer.Core" Version="3.0.1" />
        <ProjectReference Include="..\NsawaWeb.Services\NsawaWeb.Services.csproj" />
    </ItemGroup>

</Project>
