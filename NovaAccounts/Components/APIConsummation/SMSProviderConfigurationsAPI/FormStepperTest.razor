@page "/sms-configurations/create"
@page "/sms-configurations/create/{ClientIdentifier}"
@rendermode InteractiveServer

@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.FormStepper
@using NovaAccounts.Components.Shared

@inject ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Create SMS Provider Configuration</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Breadcrumb Navigation -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/">Clients</a>
                    </li>
                    @if (preSelectedClient != null)
                    {
                        <li class="breadcrumb-item">
                            <a href="/clients/@preSelectedClient.ClientId">@preSelectedClient.Name</a>
                        </li>
                    }
                    <li class="breadcrumb-item active" aria-current="page">Create SMS Configuration</li>
                </ol>
            </nav>

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">Create SMS Provider Configuration</h1>
                <div>
                    <button class="btn btn-outline-secondary mb-2" @onclick="NavigateBack">
                        <i class="fa fa-arrow-left"></i> Back to Client
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                    <p class="mt-3">Loading wizard...</p>
                </div>
            }
            else
            {
                <!-- Wizard Form -->
                <ReusableFormWizard Steps="@wizardSteps" 
                           Config="@wizardConfig" 
                           OnFinish="@HandleWizardFinish"
                           OnStepChanged="@HandleStepChanged"
                           OnStepValidation="@ValidateStep" />

                @if (submittedData.Any())
                {
                    <div class="mt-4">
                        <h3>Configuration Created Successfully!</h3>
                        <div class="alert alert-success">
                            <strong>Success!</strong> SMS configuration has been created successfully.
                        </div>
                        <div class="card">
                            <div class="card-body">
                                <h5>Configuration Details:</h5>
                                <ul>
                                    @foreach (var item in submittedData)
                                    {
                                        <li><strong>@item.Key:</strong> @item.Value</li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-outline-secondary mb-2" @onclick="NavigateBack">
                                <i class="fa fa-arrow-left"></i> Back to Client
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string? ClientIdentifier { get; set; }

    // Wizard components
    private List<WizardStep> wizardSteps = new();
    private WizardConfiguration wizardConfig = new();
    private Dictionary<string, object> submittedData = new();

    // Data collections
    private List<ClientViewModel> clients = new();
    private List<ProviderViewModel> smsProviders = new();
    private List<CredentialTypeViewModel> availableCredentialTypes = new();
    private ClientViewModel? preSelectedClient = null;
    private Guid? selectedClientId = null;
    private string selectedClientIdString = string.Empty;

    // Form fields
    private bool isDefault = false;
    private string defaultSenderId = string.Empty;
    private string messageEncoding = "GSM7";
    private bool enableDeliveryReports = true;
    private bool allowUnicode = false;

    // Loading states
    private bool isLoading = true;
    private bool isCreating = false;

    // Define required SMS credentials
    private readonly HashSet<string> requiredSmsCredentials = new(StringComparer.OrdinalIgnoreCase)
    {
        "API_KEY",
        "APIKEY",
        "ACCESS_KEY",
        "SECRET_KEY"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(ClientIdentifier) && clients.Any())
        {
            await PreSelectClient();
        }
    }

    private async Task LoadInitialData()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Load all data in parallel
            var clientsTask = LoadClients();
            var providersTask = LoadSmsProviders();
            var credentialsTask = LoadCredentialTypes();

            await Task.WhenAll(clientsTask, providersTask, credentialsTask);

            // Setup wizard after data is loaded
            SetupWizardConfig();
            SetupWizardSteps();

            // Pre-select client if identifier provided
            if (!string.IsNullOrEmpty(ClientIdentifier))
            {
                await PreSelectClient();
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SetupWizardConfig()
    {
        wizardConfig = new WizardConfiguration
        {
            Id = "smsConfigWizard",
            Title = "SMS Configuration Wizard",
            ShowProgressBar = true,
            ShowStepNumbers = true,
            BackButtonText = "Back",
            NextButtonText = "Continue",
            FinishButtonText = "Create Configuration",
            SuccessMessage = "SMS configuration has been created successfully!",
            ErrorMessage = "Please fill in all required fields."
        };
    }

    private void SetupWizardSteps()
    {
        // Create basic step structure without options first
        wizardSteps = new List<WizardStep>
        {
            new WizardStep
            {
                Title = "Basic Information",
                Description = "Select client and provider",
                Icon = "fa-info-circle",
                Fields = new List<WizardField>
                {
                    new WizardField
                    {
                        Id = "client",
                        Name = "ClientId",
                        Label = "CLIENT *",
                        Type = WizardFieldType.Select,
                        IsRequired = true,
                        ColClass = "col-md-6",
                        Options = new List<WizardSelectOption>()
                    },
                    new WizardField
                    {
                        Id = "provider",
                        Name = "ProviderId",
                        Label = "SMS PROVIDER *",
                        Type = WizardFieldType.Select,
                        IsRequired = true,
                        ColClass = "col-md-6",
                        Options = new List<WizardSelectOption>()
                    },
                    new WizardField
                    {
                        Id = "description",
                        Name = "Description",
                        Label = "DESCRIPTION *",
                        Type = WizardFieldType.Text,
                        IsRequired = true,
                        ColClass = "col-md-12",
                        Attributes = new Dictionary<string, object> { { "maxlength", "200" } }
                    }
                }
            },
            new WizardStep
            {
                Title = "SMS Settings",
                Description = "Configure SMS settings",
                Icon = "fa-cog",
                Fields = new List<WizardField>
                {
                    // new WizardField
                    // {
                    //     Id = "defaultSenderId",
                    //     Name = "DefaultSenderId",
                    //     Label = "DEFAULT SENDER ID",
                    //     Type = WizardFieldType.Text,
                    //     ColClass = "col-md-6",
                    //     Attributes = new Dictionary<string, object> { { "maxlength", "11" } }
                    // },
                    // new WizardField
                    // {
                    //     Id = "messageEncoding",
                    //     Name = "MessageEncoding",
                    //     Label = "MESSAGE ENCODING",
                    //     Type = WizardFieldType.Select,
                    //     ColClass = "col-md-6",
                    //     Options = new List<WizardSelectOption>
                    //     {
                    //         new WizardSelectOption { Value = "GSM7", Text = "GSM7 (Standard)" },
                    //         new WizardSelectOption { Value = "UCS2", Text = "UCS2 (Unicode)" },
                    //         new WizardSelectOption { Value = "AUTO", Text = "Auto Detect" }
                    //     }
                    // },
                    // new WizardField
                    // {
                    //     Id = "enableDeliveryReports",
                    //     Name = "EnableDeliveryReports",
                    //     Label = "ENABLE DELIVERY REPORTS",
                    //     Type = WizardFieldType.Checkbox,
                    //     ColClass = "col-md-6"
                    // },
                    // new WizardField
                    // {
                    //     Id = "allowUnicode",
                    //     Name = "AllowUnicode",
                    //     Label = "ALLOW UNICODE CHARACTERS",
                    //     Type = WizardFieldType.Checkbox,
                    //     ColClass = "col-md-6"
                    // },
                    new WizardField
                    {
                        Id = "isDefault",
                        Name = "IsDefault",
                        Label = "SET AS DEFAULT CONFIGURATION",
                        Type = WizardFieldType.Checkbox,
                        ColClass = "col-md-12"
                    }
                }
            },
            new WizardStep
            {
                Title = "Provider Credentials",
                Description = "Add required credentials",
                Icon = "fa-key",
                Fields = new List<WizardField>()
                // Will be populated dynamically when provider is selected
            },
            new WizardStep
            {
                Title = "Review & Create",
                Description = "Review all configuration details",
                Icon = "fa-check-circle",
                Fields = new List<WizardField>
                {
                    new WizardField
                    {
                        Name = "Client",
                        Label = "Client:",
                        Type = WizardFieldType.Display,
                        ColClass = "col-md-12"
                    },
                    new WizardField
                    {
                        Name = "Provider",
                        Label = "Provider:",
                        Type = WizardFieldType.Display,
                        ColClass = "col-md-12"
                    },
                    new WizardField
                    {
                        Name = "Description",
                        Label = "Description:",
                        Type = WizardFieldType.Display,
                        ColClass = "col-md-12"
                    },
                    new WizardField
                    {
                        Name = "IsDefault",
                        Label = "Default Configuration:",
                        Type = WizardFieldType.Display,
                        ColClass = "col-md-12"
                    }
                }
            }
        };

        // Now populate the options
        UpdateClientOptions();
        UpdateProviderOptions();
    }

    private async Task<bool> ValidateStep(int stepIndex)
    {
        if (wizardSteps == null || stepIndex >= wizardSteps.Count)
            return false;

        var currentStep = wizardSteps[stepIndex];
        var isValid = true;

        // Clear previous validation messages
        foreach (var field in currentStep.Fields)
        {
            field.ValidationMessage = string.Empty;
        }

        switch (stepIndex)
        {
            case 0: 
                var clientField = currentStep.Fields.FirstOrDefault(f => f.Name == "ClientId");
                var providerField = currentStep.Fields.FirstOrDefault(f => f.Name == "ProviderId");
                var descriptionField = currentStep.Fields.FirstOrDefault(f => f.Name == "Description");

                if (clientField != null && string.IsNullOrEmpty(clientField.Value?.ToString()))
                {
                    clientField.ValidationMessage = "Client selection is required";
                    isValid = false;
                }

                if (providerField != null && string.IsNullOrEmpty(providerField.Value?.ToString()))
                {
                    providerField.ValidationMessage = "SMS provider selection is required";
                    isValid = false;
                }

                if (descriptionField != null)
                {
                    if (string.IsNullOrEmpty(descriptionField.Value?.ToString()))
                    {
                        descriptionField.ValidationMessage = "Description is required";
                        isValid = false;
                    }
                    else if (descriptionField.Value.ToString().Length > 200)
                    {
                        descriptionField.ValidationMessage = "Description cannot exceed 200 characters";
                        isValid = false;
                    }
                }
                break;

            case 1: // SMS Settings
                var defaultSenderIdField = currentStep.Fields.FirstOrDefault(f => f.Name == "DefaultSenderId");
                if (defaultSenderIdField != null)
                {
                    var senderIdValue = defaultSenderIdField.Value?.ToString();
                    if (!string.IsNullOrEmpty(senderIdValue) && senderIdValue.Length > 11)
                    {
                        defaultSenderIdField.ValidationMessage = "Sender ID cannot exceed 11 characters";
                        isValid = false;
                    }
                }
                break;

            case 2: // Provider Credentials
                foreach (var field in currentStep.Fields.Where(f => f.IsRequired))
                {
                    if (field.Value == null || string.IsNullOrWhiteSpace(field.Value.ToString()))
                    {
                        field.ValidationMessage = $"{field.Label} is required";
                        isValid = false;
                    }
                    else if (field.Value.ToString().Length < 3)
                    {
                        field.ValidationMessage = $"{field.Label} must be at least 3 characters long";
                        isValid = false;
                    }
                    else if (field.Value.ToString().Length > 500)
                    {
                        field.ValidationMessage = $"{field.Label} cannot exceed 500 characters";
                        isValid = false;
                    }
                    else if (ContainsInvalidCharacters(field.Value.ToString()))
                    {
                        field.ValidationMessage = $"{field.Label} contains invalid characters";
                        isValid = false;
                    }
                }
                break;
        }

        return isValid;
    }

    private void HandleStepChanged(int stepIndex)
    {
        if (stepIndex == 2) // Credentials step
        {
            UpdateCredentialFields();
        }
        
        if (stepIndex == 3) // Review step
        {
            UpdateReviewFields();
        }
    }

    private void UpdateCredentialFields()
    {
        if (wizardSteps.Count <= 2) return;

        var credentialsStep = wizardSteps[2];
        credentialsStep.Fields.Clear();

        var providerId = GetFieldValue("ProviderId");
        if (!string.IsNullOrEmpty(providerId) && availableCredentialTypes.Any())
        {
            foreach (var credType in availableCredentialTypes)
            {
                var isRequired = IsCredentialRequired(credType.CredentialTypeName);
                
                credentialsStep.Fields.Add(new WizardField
                {
                    Id = $"cred_{credType.CredentialTypeName}",
                    Name = credType.CredentialTypeName,
                    Label = $"{credType.DisplayName.ToUpper()} {(isRequired ? "*" : "")}",
                    Type = WizardFieldType.Text,
                    IsRequired = isRequired,
                    ColClass = "col-md-12",
                    Attributes = new Dictionary<string, object> 
                    { 
                        { "type", "password" },
                        { "placeholder", $"Enter {credType.DisplayName}" },
                        { "autocomplete", "new-password" }
                    }
                });
            }
        }

        if (!credentialsStep.Fields.Any())
        {
            credentialsStep.Fields.Add(new WizardField
            {
                Id = "noCredentials",
                Name = "NoCredentials",
                Label = "No credentials required for selected provider",
                Type = WizardFieldType.Display,
                ColClass = "col-md-12",
                Value = "Select an SMS provider to see required credentials"
            });
        }
    }

    private void UpdateReviewFields()
    {
        if (wizardSteps.Count <= 3) return;

        var reviewStep = wizardSteps[3];
        
        foreach (var field in reviewStep.Fields)
        {
            switch (field.Name)
            {
                case "Client":
                    var clientId = GetFieldValue("ClientId");
                    var client = clients.FirstOrDefault(c => c.ClientId.ToString() == clientId);
                    field.Value = client != null ? $"{client.Name} ({client.Identifier})" : "Not selected";
                    break;
                    
                case "Provider":
                    var providerId = GetFieldValue("ProviderId");
                    var provider = smsProviders.FirstOrDefault(p => p.ProviderId.ToString() == providerId);
                    field.Value = provider?.Name ?? "Not selected";
                    break;
                    
                case "Description":
                    field.Value = GetFieldValue("Description") ?? "Not provided";
                    break;
                    
                    
                case "IsDefault":
                    var isDefaultValue = GetFieldValue("IsDefault");
                    field.Value = bool.TryParse(isDefaultValue, out bool isDefaultVal) && isDefaultVal ? "Yes" : "No";
                    break;
            }
        }
    }

    private string? GetFieldValue(string fieldName)
    {
        var field = wizardSteps.SelectMany(s => s.Fields).FirstOrDefault(f => f.Name == fieldName);
        return field?.Value?.ToString();
    }

    private async Task HandleWizardFinish(Dictionary<string, object> formData)
    {
        submittedData = formData;
        await CreateSmsConfiguration();
    }

    private async Task LoadClients()
    {
        try
        {
            var result = await ApiClient.AllAsync();
            if (result?.Success == true && result.Data != null)
            {
                clients = result.Data.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading clients: {ex.Message}");
        }
    }

    private void UpdateClientOptions()
    {
        if (wizardSteps.Count == 0) return;

        var clientField = wizardSteps[0].Fields.FirstOrDefault(f => f.Name == "ClientId");
        if (clientField != null)
        {
            var options = clients.Select(c => new WizardSelectOption 
            { 
                Value = c.ClientId.ToString(), 
                Text = $"{c.Name} ({c.Identifier})" 
            }).ToList();

            options.Insert(0, new WizardSelectOption { Value = "", Text = "-- Select Client --" });
            clientField.Options = options;
        }
    }

    private async Task LoadSmsProviders()
    {
        try
        {
            var result = await ApiClient.Provider2Async("SMS");
            if (result?.Success == true && result.Data != null)
            {
                smsProviders = result.Data.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading SMS providers: {ex.Message}");
        }
    }

    private void UpdateProviderOptions()
    {
        if (wizardSteps.Count == 0) return;

        var providerField = wizardSteps[0].Fields.FirstOrDefault(f => f.Name == "ProviderId");
        if (providerField != null)
        {
            var options = smsProviders.Select(p => new WizardSelectOption 
            { 
                Value = p.ProviderId.ToString(), 
                Text = p.Name 
            }).ToList();

            options.Insert(0, new WizardSelectOption { Value = "", Text = "-- Select SMS Provider --" });
            providerField.Options = options;
        }
    }

    private async Task LoadCredentialTypes()
    {
        try
        {
            var result = await ApiClient.All2Async();
            if (result?.Success == true && result.Data != null)
            {
                availableCredentialTypes = result.Data.Where(ct => ct.Active).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading credential types: {ex.Message}");
        }
    }

    private async Task PreSelectClient()
    {
        if (clients.Any() && !string.IsNullOrEmpty(ClientIdentifier))
        {
            var cleanIdentifier = ClientIdentifier;
            if (cleanIdentifier.Contains('.'))
            {
                cleanIdentifier = cleanIdentifier.Split('.')[0];
            }

            var client = clients.FirstOrDefault(c =>
                c.Identifier.Equals(cleanIdentifier, StringComparison.OrdinalIgnoreCase));

            if (client != null)
            {
                preSelectedClient = client;
                selectedClientId = client.ClientId;
                selectedClientIdString = client.ClientId.ToString();
                
                // Pre-select in wizard
                var clientField = wizardSteps[0].Fields.FirstOrDefault(f => f.Name == "ClientId");
                if (clientField != null)
                {
                    clientField.Value = client.ClientId.ToString();
                }
                StateHasChanged();
            }
        }
    }

    private bool IsCredentialRequired(string credentialTypeName)
    {
        return requiredSmsCredentials.Contains(credentialTypeName.ToUpper());
    }

    private bool ContainsInvalidCharacters(string value)
    {
        var invalidChars = new[] { '<', '>', '&', '\"', '\'' };
        return invalidChars.Any(c => value.Contains(c));
    }

    private async Task CreateSmsConfiguration()
    {
        try
        {
            isCreating = true;
            StateHasChanged();

            // Extract form data
            var clientId = GetFieldValue("ClientId");
            var providerId = GetFieldValue("ProviderId");
            var description = GetFieldValue("Description");
            var isDefault = GetFieldValue("IsDefault");
            

            if (string.IsNullOrEmpty(clientId) || string.IsNullOrEmpty(providerId) || string.IsNullOrEmpty(description))
            {
                return;
            }

            // Get client
            var client = clients.FirstOrDefault(c => c.ClientId.ToString() == clientId);
            if (client == null)
            {
                return;
            }

            // Create credentials list
            var clientProviderCredentials = new List<CreateClientProviderCredentialDto>();
            foreach (var credType in availableCredentialTypes)
            {
                var credentialValue = GetFieldValue(credType.CredentialTypeName);
                if (!string.IsNullOrWhiteSpace(credentialValue))
                {
                    clientProviderCredentials.Add(new CreateClientProviderCredentialDto
                    {
                        CredentialTypeName = credType.CredentialTypeName,
                        CredentialKey = credentialValue
                    });
                }
            }

            // Create the configuration
            var createCommand = new CreateSMSProviderConfigurationDto
            {
                ClientIdentifier = client.Identifier,
                Description = description.Trim(),
                ProviderId = Guid.Parse(providerId),
                ClientProviderCredentials = clientProviderCredentials,
                IsDefault = bool.TryParse(isDefault, out bool defaultVal) && defaultVal
            };

            var result = await ApiClient.Create6Async(createCommand);

            if (result?.Success == true)
            {
                await Task.Delay(2000);
                Navigation.NavigateTo($"/clients/{selectedClientId}", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating SMS configuration: {ex.Message}");
        }
        finally
        {
            isCreating = false;
            StateHasChanged();
        }
    }

    private void NavigateBack()
    {
        if (selectedClientId.HasValue)
        {
            Navigation.NavigateTo($"/clients/{selectedClientId}", forceLoad: true);
        }
        else
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }
}

