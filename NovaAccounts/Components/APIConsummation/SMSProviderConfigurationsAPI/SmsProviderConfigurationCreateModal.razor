@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.ModalFields
@using NovaAccounts.SharedModels.QuickNav
@inject ApiClient ApiClient

<ReusableModal @ref="smsConfigCreateModal"
               Title="Create SMS Provider Configuration"
               TriggerButtonText=""
               ShowTriggerButton="false"
               Size="ModalSize.Large"
               TitleFontSize="1.2rem"
               TitleColor="#007bff"
               BodyFontSize="0.95rem"
               HeaderClass="leadBold bg-blue-chambray font-white"
               BodyColor="#333"
               ShowSaveButton="true"
               SaveButtonText="Create Configuration"
               OnSave="@CreateSmsConfiguration"
               ShowCancelButton="true"
               CancelButtonText="Cancel">

    <BodyContent>
        @if (isLoadingClients || isLoadingProviders)
        {
            <div class="text-center p-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2">Loading data...</p>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Client *</label>
                        <select class="form-control @(string.IsNullOrEmpty(clientError) ? "" : "is-invalid")" 
                                value="@selectedClientIdString"
                                @onchange="HandleClientChange">
                            <option value="">-- Select Client --</option>
                            @foreach (var client in clients)
                            {
                                <option value="@client.ClientId">@client.Name (@client.Identifier)</option>
                            }
                        </select>
                        @if (!string.IsNullOrEmpty(clientError))
                        {
                            <div class="invalid-feedback">@clientError</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">SMS Provider *</label>
                        <select class="form-control @(string.IsNullOrEmpty(providerError) ? "" : "is-invalid")" 
                                value="@selectedProviderIdString"
                                @onchange="HandleProviderChange">
                            <option value="">-- Select SMS Provider --</option>
                            @foreach (var provider in smsProviders)
                            {
                                <option value="@provider.ProviderId">@provider.Name</option>
                            }
                        </select>
                        @if (!string.IsNullOrEmpty(providerError))
                        {
                            <div class="invalid-feedback">@providerError</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description *</label>
                        <input class="form-control @(string.IsNullOrEmpty(descriptionError) ? "" : "is-invalid")" 
                               @bind="description" 
                               @oninput="OnDescriptionInput"
                               placeholder="Enter configuration description" />
                        @if (!string.IsNullOrEmpty(descriptionError))
                        {
                            <div class="invalid-feedback">@descriptionError</div>
                        }
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" @bind="isDefault" />
                        <label class="form-check-label">Set as default configuration</label>
                        <small class="form-text text-muted d-block">This configuration will be used when no specific configuration is selected</small>
                    </div>
                </div>

                <div class="col-md-6">
                    <!-- Credentials Section -->
                    <div class="card mt-3">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Provider Credentials</h5>
                            <small class="text-muted">Add required credentials for the selected provider</small>
                        </div>
                        <div class="card-body">
                            @if (availableCredentialTypes.Any())
                            {
                                @foreach (var credType in availableCredentialTypes)
                                {
                                    var credentialError = GetCredentialError(credType.CredentialTypeName);
                                    var credentialValue = GetCredentialValue(credType.CredentialTypeName);
                                    var isRequired = IsCredentialRequired(credType.CredentialTypeName);
                                    
                                    <div class="mb-3">
                                        <label class="form-label">
                                            @credType.DisplayName 
                                            @if (isRequired)
                                            {
                                                <span class="text-danger">*</span>
                                            }
                                        </label>
                                        <input type="password"
                                               class="form-control @(string.IsNullOrEmpty(credentialError) ? "" : "is-invalid")"
                                               placeholder="Enter @credType.DisplayName"
                                               value="@credentialValue"
                                               @oninput="@(e => OnCredentialInput(credType.CredentialTypeName, e))" />
                                        @if (!string.IsNullOrEmpty(credentialError))
                                        {
                                            <div class="invalid-feedback">@credentialError</div>
                                        }
                                        <small class="form-text text-muted">
                                            @credType.CredentialTypeName
                                            @if (isRequired)
                                            {
                                                <span class="text-danger">(Required)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">(Optional)</span>
                                            }
                                        </small>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">Select a provider to see required credentials</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success mt-3">
                    <strong>Success!</strong> @successMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(formError))
            {
                <div class="alert alert-danger mt-3">
                    <strong>Error!</strong> @formError
                </div>
            }
        }
    </BodyContent>
</ReusableModal>

@code {
    private string currentUrl = "/sms-configurations";
    private ReusableModal smsConfigCreateModal = null!;
    
    private List<NavBarItem> navigationItems = new();

    // Data collections
    private List<ClientViewModel> clients = new();
    private List<ProviderViewModel> smsProviders = new();
    private List<CredentialTypeViewModel> availableCredentialTypes = new();

    // Form fields
    private string selectedClientIdString = string.Empty;
    private string selectedProviderIdString = string.Empty;
    private Guid? selectedClientId = null;
    private Guid? selectedProviderId = null;
    private string description = string.Empty;
    private bool isDefault = false;
    private string defaultSenderId = string.Empty;
    private string messageEncoding = "GSM7";
    private bool enableDeliveryReports = true;
    private bool allowUnicode = false;
    private Dictionary<string, string> credentials = new();
    private Dictionary<string, string> credentialErrors = new();

    // Validation errors
    private string clientError = string.Empty;
    private string providerError = string.Empty;
    private string descriptionError = string.Empty;
    private string formError = string.Empty;
    private string successMessage = string.Empty;

    // Loading states
    private bool isLoadingClients = false;
    private bool isLoadingProviders = false;

    // Define ONLY API_KEY as required for SMS providers - all others are optional
    private readonly HashSet<string> requiredSmsCredentials = new(StringComparer.OrdinalIgnoreCase)
    {
        "API_KEY",
        "APIKEY",
        "ACCESS_KEY",
        "SECRET_KEY"
    };

    [Parameter] public EventCallback<SMSClientProviderConfigurationViewModel> OnSmsConfigurationCreated { get; set; }

    protected override async Task OnInitializedAsync()
    {
        navigationItems = new()
        {
            new NavBarItem
            {
                Text = "Create SMS Configuration",
                Url = "/sms-configurations",
                IconClass = "icon-mobile",
                OnClick = async () => await OpenModal(),
                PreventNavigation = true
            },
            new NavBarItem
            {
                Text = "View Configurations",
                Url = "/sms-configurations",
                IconClass = "icon-list"
            }
        };

        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        await LoadClients();
        await LoadSmsProviders();
    }

    private async Task LoadClients()
    {
        try
        {
            isLoadingClients = true;
            StateHasChanged();

            var result = await ApiClient.AllAsync();
            if (result?.Success == true && result.Data != null)
            {
                clients = result.Data.ToList();
                Console.WriteLine($"Loaded {clients.Count} clients for SMS configuration");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading clients: {ex.Message}");
        }
        finally
        {
            isLoadingClients = false;
            StateHasChanged();
        }
    }

    private async Task LoadSmsProviders()
    {
        try
        {
            isLoadingProviders = true;
            StateHasChanged();

            // Get SMS providers (providerType = "SMS")
            var result = await ApiClient.Provider2Async("SMS");
            if (result?.Success == true && result.Data != null)
            {
                smsProviders = result.Data.ToList();
                Console.WriteLine($"Loaded {smsProviders.Count} SMS providers");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading SMS providers: {ex.Message}");
        }
        finally
        {
            isLoadingProviders = false;
            StateHasChanged();
        }
    }

    private async Task LoadCredentialTypes()
    {
        try
        {
            var result = await ApiClient.All2Async();
            if (result?.Success == true && result.Data != null)
            {
                availableCredentialTypes = result.Data.Where(ct => ct.Active).ToList();
                Console.WriteLine($"Loaded {availableCredentialTypes.Count} credential types for SMS");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading credential types: {ex.Message}");
        }
    }

    public async Task OpenModal()
    {
        // Reset form fields and messages
        selectedClientIdString = string.Empty;
        selectedProviderIdString = string.Empty;
        selectedClientId = null;
        selectedProviderId = null;
        description = string.Empty;
        isDefault = false;
        defaultSenderId = string.Empty;
        messageEncoding = "GSM7";
        enableDeliveryReports = true;
        allowUnicode = false;
        credentials.Clear();
        credentialErrors.Clear();
        
        clientError = string.Empty;
        providerError = string.Empty;
        descriptionError = string.Empty;
        formError = string.Empty;
        successMessage = string.Empty;

        // Load credential types when opening modal
        await LoadCredentialTypes();

        if (smsConfigCreateModal != null)
        {
            await smsConfigCreateModal.OpenModal();
        }
    }
    
    public async Task OpenModalWithClient(string clientIdentifier)
    {
        // Reset form first
        await OpenModal();
    
        // Find and pre-select the client
        var client = clients.FirstOrDefault(c => c.Identifier == clientIdentifier);
        if (client != null)
        {
            selectedClientId = client.ClientId;
            selectedClientIdString = client.ClientId.ToString();
            StateHasChanged();
        }
    }

    private void HandleClientChange(ChangeEventArgs e)
    {
        clientError = string.Empty;
        formError = string.Empty;
        successMessage = string.Empty;
        
        var value = e.Value?.ToString();
        selectedClientIdString = value ?? string.Empty;
        
        if (string.IsNullOrEmpty(value))
        {
            selectedClientId = null;
        }
        else
        {
            selectedClientId = Guid.Parse(value);
        }
        
        StateHasChanged();
    }

    private void HandleProviderChange(ChangeEventArgs e)
    {
        providerError = string.Empty;
        formError = string.Empty;
        successMessage = string.Empty;
        
        var value = e.Value?.ToString();
        selectedProviderIdString = value ?? string.Empty;
        
        if (string.IsNullOrEmpty(value))
        {
            selectedProviderId = null;
        }
        else
        {
            selectedProviderId = Guid.Parse(value);
        }
        
        StateHasChanged();
    }

    private void OnDescriptionInput(ChangeEventArgs e)
    {
        descriptionError = string.Empty;
        formError = string.Empty;
        successMessage = string.Empty;
        
        var value = e.Value?.ToString() ?? string.Empty;
        description = value;
        
        if (string.IsNullOrWhiteSpace(value))
        {
            descriptionError = "Description is required";
        }
        else if (value.Length > 200)
        {
            descriptionError = "Description cannot exceed 200 characters";
        }
        
        StateHasChanged();
    }

    private void OnCredentialInput(string credentialTypeName, ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        credentials[credentialTypeName] = value;

        // Validate credential in real-time
        ValidateCredential(credentialTypeName, value);
        
        StateHasChanged();
    }

    private string GetCredentialValue(string credentialTypeName)
    {
        return credentials.ContainsKey(credentialTypeName) ? credentials[credentialTypeName] : string.Empty;
    }

    private string GetCredentialError(string credentialTypeName)
    {
        return credentialErrors.ContainsKey(credentialTypeName) ? credentialErrors[credentialTypeName] : string.Empty;
    }

    private bool IsCredentialRequired(string credentialTypeName)
    {
        return requiredSmsCredentials.Contains(credentialTypeName.ToUpper());
    }

    private void ValidateCredential(string credentialTypeName, string value)
    {
        credentialErrors.Remove(credentialTypeName);

        if (IsCredentialRequired(credentialTypeName))
        {
            // Only API_KEY and similar keys are required - validate them strictly
            if (string.IsNullOrWhiteSpace(value))
            {
                credentialErrors[credentialTypeName] = $"{credentialTypeName} is required";
            }
            else if (value.Length < 3)
            {
                credentialErrors[credentialTypeName] = $"{credentialTypeName} must be at least 3 characters long";
            }
            else if (value.Length > 500)
            {
                credentialErrors[credentialTypeName] = $"{credentialTypeName} cannot exceed 500 characters";
            }
            else if (ContainsInvalidCharacters(value))
            {
                credentialErrors[credentialTypeName] = $"{credentialTypeName} contains invalid characters";
            }
        }
        else
        {
            // All other credentials are optional - only validate if provided
            if (!string.IsNullOrWhiteSpace(value))
            {
                if (value.Length > 500)
                {
                    credentialErrors[credentialTypeName] = $"{credentialTypeName} cannot exceed 500 characters";
                }
                else if (ContainsInvalidCharacters(value))
                {
                    credentialErrors[credentialTypeName] = $"{credentialTypeName} contains invalid characters";
                }
            }
            // No validation if optional field is empty
        }
    }

    private bool ContainsInvalidCharacters(string value)
    {
        // Check for potentially dangerous characters in credentials
        var invalidChars = new[] { '<', '>', '&', '\"', '\'' };
        return invalidChars.Any(c => value.Contains(c));
    }

    private bool ValidateCredentials()
    {
        credentialErrors.Clear();
        var isValid = true;

        foreach (var credType in availableCredentialTypes)
        {
            var credentialValue = GetCredentialValue(credType.CredentialTypeName);
            ValidateCredential(credType.CredentialTypeName, credentialValue);

            // Only fail validation for required credentials
            if (IsCredentialRequired(credType.CredentialTypeName) && 
                credentialErrors.ContainsKey(credType.CredentialTypeName))
            {
                isValid = false;
            }
            // Optional credentials with errors don't fail the overall validation
        }

        return isValid;
    }

    private async Task CreateSmsConfiguration()
    {
        try
        {
            // Clear previous messages
            formError = string.Empty;
            successMessage = string.Empty;
            
            // Validate all fields
            var isFormValid = ValidateForm();
            var areCredentialsValid = ValidateCredentials();
            
            if (!isFormValid || !areCredentialsValid)
            {
                formError = "Please fix the validation errors before creating the configuration.";
                return;
            }

            Console.WriteLine($"Creating SMS configuration for client: {selectedClientId}");

            // Get client identifier
            var client = clients.FirstOrDefault(c => c.ClientId == selectedClientId);
            if (client == null)
            {
                formError = "Selected client not found.";
                return;
            }

            // Create credentials list - include all non-empty credentials
            var clientProviderCredentials = credentials
                .Where(kvp => !string.IsNullOrWhiteSpace(kvp.Value))
                .Select(kvp => new CreateClientProviderCredentialDto
                {
                    CredentialTypeName = kvp.Key,
                    CredentialKey = kvp.Value
                })
                .ToList();

            // Create the configuration DTO
            var createCommand = new CreateSMSProviderConfigurationDto
            {
                ClientIdentifier = client.Identifier,
                Description = description.Trim(),
                ProviderId = selectedProviderId.Value,
                ClientProviderCredentials = clientProviderCredentials,
                IsDefault = isDefault
            };

            Console.WriteLine("Calling Create6Async for SMS...");

            // Call the Create6Async method (for SMS)
            var result = await ApiClient.Create6Async(createCommand);

            Console.WriteLine($"API Response Success: {result?.Success}");
            Console.WriteLine($"API Message: {result?.Message}");

            if (result?.Success == true && result.Data != null)
            {
                successMessage = result.Message ?? "SMS configuration created successfully!";
                Console.WriteLine("SMS configuration created successfully");
                
                // Clear form after successful creation
                ResetForm();
                
                // Notify parent component and wait for it to complete
                await OnSmsConfigurationCreated.InvokeAsync(result.Data);
                
                // Close modal after parent is notified
                await smsConfigCreateModal.CloseModal();
            }
            else
            {
                formError = result?.Message ?? "Failed to create SMS configuration. Please try again.";
                Console.WriteLine($"SMS configuration creation failed: {formError}");
            }
        }
        catch (ApiException ex)
        {
            formError = $"Server error ({ex.StatusCode}): {ex.Message}";
            Console.WriteLine($"API Exception: {ex}");
        }
        catch (Exception ex)
        {
            formError = $"Error creating SMS configuration: {ex.Message}";
            Console.WriteLine($"Exception: {ex}");
        }
        
        StateHasChanged();
    }

    private bool ValidateForm()
    {
        var isValid = true;

        // Validate Client
        if (!selectedClientId.HasValue)
        {
            clientError = "Please select a client";
            isValid = false;
        }
        else
        {
            clientError = string.Empty;
        }

        // Validate Provider
        if (!selectedProviderId.HasValue)
        {
            providerError = "Please select an SMS provider";
            isValid = false;
        }
        else
        {
            providerError = string.Empty;
        }

        // Validate Description
        if (string.IsNullOrWhiteSpace(description))
        {
            descriptionError = "Description is required";
            isValid = false;
        }
        else if (description.Length > 200)
        {
            descriptionError = "Description cannot exceed 200 characters";
            isValid = false;
        }
        else
        {
            descriptionError = string.Empty;
        }

        return isValid;
    }

    private void ResetForm()
    {
        selectedClientIdString = string.Empty;
        selectedProviderIdString = string.Empty;
        selectedClientId = null;
        selectedProviderId = null;
        description = string.Empty;
        isDefault = false;
        defaultSenderId = string.Empty;
        messageEncoding = "GSM7";
        enableDeliveryReports = true;
        allowUnicode = false;
        credentials.Clear();
        credentialErrors.Clear();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("SmsProviderConfigurationCreateModal component rendered");
        }
    }
}

