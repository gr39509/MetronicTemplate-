    private void HandleConfigurationChange(ChangeEventArgs e)
    {
        configurationError = string.Empty;
        formError = string.Empty;
        successMessage = string.Empty;
        
        var value = e.Value?.ToString();
        selectedConfigurationIdString = value ?? string.Empty;
        
        if (string.IsNullOrEmpty(value))
        {
            selectedConfigurationId = null;
        }
        else
        {
            selectedConfigurationId = Guid.Parse(value);
        }
        
        StateHasChanged();
    }

    private void ParsePhoneNumbers()
    {
        phoneNumbersList = phoneNumbersInput
            .Split(new[] { '\n', '\r', ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Trim())
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .Distinct()
            .ToList();
    }

    private int CalculateMessageSegments()
    {
        if (string.IsNullOrEmpty(message)) return 0;
        
        // GSM7 standard: 160 chars per segment
        int segmentSize = 160;
        return (int)Math.Ceiling((double)message.Length / segmentSize);
    }

    private async Task SendSms()
    {
        try
        {
            // Clear previous messages
            formError = string.Empty;
            successMessage = string.Empty;
            
            // Validate form
            if (!ValidateForm())
            {
                return;
            }

            isSending = true;
            StateHasChanged();

            // Parse phone numbers
            ParsePhoneNumbers();

            // Create the send request
            var sendRequest = new SendSmsRequest
            {
                SmsClientProviderConfigurationId = selectedConfigurationId,
                Sender = string.IsNullOrWhiteSpace(senderId) ? null : senderId.Trim(),
                Message = message.Trim(),
                PhoneNumbers = phoneNumbersList
            };

            Console.WriteLine($"Sending SMS to {phoneNumbersList.Count} numbers using configuration: {selectedConfigurationId}");
            Console.WriteLine($"Using client identifier: {ClientIdentifier}");

            // Call the Send2Async method
            var result = await ApiClient.Send2Async(ClientIdentifier, sendRequest);

            Console.WriteLine($"SMS Send Response Success: {result?.Success}");
            Console.WriteLine($"SMS Send Message: {result?.Message}");

            if (result?.Success == true)
            {
                successMessage = result.Message ?? $"SMS sent successfully to {phoneNumbersList.Count} number(s)!";
                Console.WriteLine("SMS sent successfully");
                
                // Notify parent component
                await OnSmsSent.InvokeAsync();
                
                // Close modal after a short delay to show success message
                await Task.Delay(2000);
                await smsSendModal.CloseModal();
            }
            else
            {
                formError = result?.Message ?? "Failed to send SMS. Please try again.";
                Console.WriteLine($"SMS send failed: {formError}");
            }
        }
        catch (ApiException ex)
        {
            formError = $"Server error ({ex.StatusCode}): {ex.Message}";
            Console.WriteLine($"API Exception: {ex}");
        }
        catch (Exception ex)
        {
            formError = $"Error sending SMS: {ex.Message}";
            Console.WriteLine($"Exception: {ex}");
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    private bool ValidateForm()
    {
        var isValid = true;

        // Validate Configuration
        if (!selectedConfigurationId.HasValue)
        {
            configurationError = "Please select an SMS configuration";
            isValid = false;
        }
        else
        {
            configurationError = string.Empty;
        }

        // Validate Phone Numbers
        if (string.IsNullOrWhiteSpace(phoneNumbersInput))
        {
            phoneNumbersError = "Please enter at least one phone number";
            isValid = false;
        }
        else
        {
            ParsePhoneNumbers();
            if (!phoneNumbersList.Any())
            {
                phoneNumbersError = "Please enter valid phone numbers";
                isValid = false;
            }
            else
            {
                phoneNumbersError = string.Empty;
            }
        }

        // Validate Message
        if (string.IsNullOrWhiteSpace(message))
        {
            messageError = "Please enter a message";
            isValid = false;
        }
        else if (message.Length > 1600)
        {
            messageError = "Message cannot exceed 1600 characters";
            isValid = false;
        }
        else
        {
            messageError = string.Empty;
        }

        // Validate Client Identifier
        if (string.IsNullOrEmpty(ClientIdentifier))
        {
            formError = "Client identifier is missing. Please refresh the page and try again.";
            isValid = false;
        }

        return isValid;
    }
}