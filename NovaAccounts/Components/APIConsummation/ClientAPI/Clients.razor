        }
    }

</style>

<script>
    // Make the DotNet reference available globally
    window.dotNetReference = null;

    // Set the DotNet reference when the component is initialized
    window.setDotNetReference = (reference) => {
        window.dotNetReference = reference;
    };

    window.viewClient = function (clientId) {
        console.log('View Client :', clientId);

        window.location.href = '/clients/' + clientId;
    };

    //for modal
    // window.viewClient = function(clientId) {
    //     if (window.dotNetReference) {
    //         window.dotNetReference.invokeMethodAsync('ViewClient', clientId)
    //             .catch(err => {
    //                 console.error('Error calling ViewClient:', err);
    //             });
    //     } else {
    //         console.error('DotNet reference not available');
    //     }
    // };

    window.editClient = function (clientId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('EditClient', clientId)
                .catch(err => {
                    console.error('Error calling EditClient:', err);
                });
        } else {
            console.error('DotNet reference not available for editClient');
        }
    };

    window.sendEmailToClient = function (clientId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('SendEmailToClient', clientId)
                .catch(err => {
                    console.error('Error calling SendEmailToClient:', err);
                });
        } else {
            console.error('DotNet reference not available for sendEmailToClient');
        }
    };
    
    window.viewTransactions = function (clientId) {
        console.log('View Client Transactions:', clientId);
        // Navigate to transactions page or open transactions modal
        window.location.href = '/clients/transactions/' + clientId;
    };
</script>

<script>
    window.showWelcomeAlert = () => {
        let timerInterval;
        Swal.fire({
            // title: "Morpheus just made it easier for you. Relax, and enjoy yourself.",
            icon: "success",
            width: 600,
            // html: "I will close in some few seconds.",
            timer: 3000,
            color: "#716add",
            background: "#fff url(rich-4897_256.gif)",
            backdrop: "rgba(0,0,123,0.4)\n" +
                "    url(\"/rich-4897_256.gif\")\n" +
                "    left top\n" +
                "    no-repeat",
            timerProgressBar: true,
            didOpen: () => {
                Swal.showLoading();
                const timer = Swal.getPopup().querySelector("b");
                timerInterval = setInterval(() => {
                    timer.textContent = `${Swal.getTimerLeft()}`;
                }, 100);
            },
            willClose: () => {
                clearInterval(timerInterval);
            }
            
        });
    };

</script>
