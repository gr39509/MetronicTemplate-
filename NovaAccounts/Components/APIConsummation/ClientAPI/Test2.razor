        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠️ Error loading OTP configurations: {ex.Message}");
            otpConfigurations = new List<OtpClientProviderConfigurationViewModel>();
        }
        finally
        {
            isLoadingOtpConfigs = false;
            StateHasChanged();
        }
    }

    private async Task LoadPaymentConfigurations(string clientIdentifier)
    {
        try
        {
            isLoadingPaymentConfigs = true;
            StateHasChanged();

            Console.WriteLine($"🔍 Loading payment configurations for: {clientIdentifier}");

            try
            {
                var result = await ApiClient.ConfigurationsPerClient3Async(clientIdentifier);
                if (result?.Success == true && result.Data != null)
                {
                    paymentConfigurations = result.Data.ToList();
                    Console.WriteLine($"✅ Generated client worked: {paymentConfigurations.Count} configs");
                    return;
                }
                else
                {
                    Console.WriteLine($"⚠️ Generated client returned no data: {result?.Message}");
                }
            }
            catch (Exception apiEx)
            {
                Console.WriteLine($"⚠️ Generated client failed: {apiEx.Message}");
            }

            Console.WriteLine("🔄 Falling back to manual JSON handling...");
            await LoadPaymentConfigurationsWithApiClientHttpClient(clientIdentifier);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ All payment config loading failed: {ex.Message}");
            paymentConfigurations = new List<PaymentClientProviderConfigurationViewModel>();
        }
        finally
        {
            isLoadingPaymentConfigs = false;
            StateHasChanged();
        }
    }

    private async Task LoadPaymentConfigurationsWithApiClientHttpClient(string clientIdentifier)
    {
        try
        {
            var httpClientField = typeof(ApiClient).GetField("_httpClient", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            
            if (httpClientField?.GetValue(ApiClient) is HttpClient httpClient)
            {
                Console.WriteLine("✅ Retrieved HttpClient from ApiClient");
                
                var url = $"api/PaymentProviderConfiguration/ConfigurationsPerClient?clientCode={Uri.EscapeDataString(clientIdentifier)}";
                Console.WriteLine($"🔍 Making request to: {url}");

                var response = await httpClient.GetAsync(url);
                var json = await response.Content.ReadAsStringAsync();
                
                Console.WriteLine($"✅ Response status: {response.StatusCode}");
                Console.WriteLine($"📄 Response length: {json.Length} chars");

                if (response.IsSuccessStatusCode)
                {
                    await ProcessPaymentConfigResponse(json);
                }
                else
                {
                    Console.WriteLine($"❌ HTTP error: {response.StatusCode}");
                    paymentConfigurations = new List<PaymentClientProviderConfigurationViewModel>();
                }
            }
            else
            {
                Console.WriteLine("❌ Could not access ApiClient's HttpClient");
                paymentConfigurations = new List<PaymentClientProviderConfigurationViewModel>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error using ApiClient's HttpClient: {ex.Message}");
            paymentConfigurations = new List<PaymentClientProviderConfigurationViewModel>();
        }
    }

    private async Task ProcessPaymentConfigResponse(string json)
    {
        try
        {
            var settings = new Newtonsoft.Json.JsonSerializerSettings
            {
                NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore,
                MissingMemberHandling = Newtonsoft.Json.MissingMemberHandling.Ignore,
                DateParseHandling = Newtonsoft.Json.DateParseHandling.None,
                DateFormatHandling = Newtonsoft.Json.DateFormatHandling.IsoDateFormat,
                FloatParseHandling = Newtonsoft.Json.FloatParseHandling.Decimal
            };

            try
            {
                var result = Newtonsoft.Json.JsonConvert.DeserializeObject<PaymentClientProviderConfigurationViewModelListApiResult>(json, settings);
                if (result?.Success == true && result.Data != null)
                {
                    paymentConfigurations = result.Data.ToList();
                    Console.WriteLine($"✅ Relaxed deserialization worked: {paymentConfigurations.Count} configs");
                    return;
                }
            }
            catch (Exception ex1)
            {
                Console.WriteLine($"⚠️ Relaxed deserialization failed: {ex1.Message}");
            }

            Console.WriteLine("🔄 Trying custom model deserialization...");
            await ProcessWithCustomModel(json);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error processing payment config response: {ex.Message}");
            paymentConfigurations = new List<PaymentClientProviderConfigurationViewModel>();
        }
    }

    private async Task ProcessWithCustomModel(string json)
    {
        try
        {
            var settings = new Newtonsoft.Json.JsonSerializerSettings
            {
                NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore,
                MissingMemberHandling = Newtonsoft.Json.MissingMemberHandling.Ignore
            };

            var customResult = Newtonsoft.Json.JsonConvert.DeserializeObject<CustomPaymentApiResult>(json, settings);
            
            if (customResult?.Success == true && customResult.Data != null)
            {
                paymentConfigurations = customResult.Data.Select(custom => new PaymentClientProviderConfigurationViewModel
                {
                    PaymentProviderConfigurationId = custom.PaymentProviderConfigurationId,
                    IsDefault = custom.IsDefault,
                    ClientProviderConfigurationId = custom.ClientProviderConfigurationId,
                    Description = custom.Description ?? string.Empty,
                    ClientIdentifier = custom.ClientIdentifier ?? string.Empty,
                    ProviderId = custom.ProviderId,
                    ProviderName = custom.ProviderName,
                    Url = custom.Url,
                    Provider = new ProviderViewModel
                    {
                        ProviderId = custom.ProviderId != Guid.Empty ? custom.ProviderId : Guid.NewGuid(),
                        Name = custom.ProviderName ?? "Payment Provider",
                        Description = "Payment service provider",
                        IsActive = true,
                        ProviderTypeName = "Payment",
                        Url = custom.Url,
                        CreatedAt = DateTimeOffset.Now,
                        ProviderType = new ProviderTypeViewModel
                        {
                            ProviderTypeName = "Payment",
                            DisplayName = "Payment Provider", 
                            Active = true
                        }
                    },
                    IsActive = custom.IsActive,
                    CreatedAt = custom.CreatedAt,
                    CreatedBy = custom.CreatedBy ?? "SYSTEM",
                    UpdatedAt = custom.UpdatedAt,
                    UpdatedBy = custom.UpdatedBy,
                    ClientProviderCredentials = custom.ClientProviderCredentials?.Select(cred => new ClientProviderCredentialViewModel
                    {
                        ClientProviderCredentialId = cred.ClientProviderCredentialId,
                        ClientProviderConfigurationId = cred.ClientProviderConfigurationId,
                        CredentialType = new CredentialTypeViewModel
                        {
                            CredentialTypeName = cred.CredentialType?.CredentialTypeName ?? "UNKNOWN",
                            DisplayName = cred.CredentialType?.DisplayName ?? "Unknown Credential",
                            Active = cred.CredentialType?.Active ?? false
                        },
                        CredentialKey = cred.CredentialKey ?? string.Empty
                    }).ToList() ?? new List<ClientProviderCredentialViewModel>()
                }).ToList();

                Console.WriteLine($"✅ Custom model loaded {paymentConfigurations.Count} configurations");
            }
            else
            {
                Console.WriteLine("❌ Custom model deserialization failed");
                paymentConfigurations = new List<PaymentClientProviderConfigurationViewModel>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Custom model processing failed: {ex.Message}");
            paymentConfigurations = new List<PaymentClientProviderConfigurationViewModel>();
        }
    }

