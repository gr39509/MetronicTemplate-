@* @page "/clients/{ClientId:guid}" *@
@using NovaAccounts.Components.APIConsummation.EmailProviderConfigurationsAPI
@using NovaAccounts.Components.APIConsummation.OtpProviderConfigurationsAPI
@using NovaAccounts.Components.APIConsummation.PaymentProviderConfigurationsAPI
@using NovaAccounts.Components.APIConsummation.SMSProviderConfigurationsAPI
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.ModalFields
@inject ApiClient ApiClient
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager

@* Include all Configuration Modals *@
<EmailProviderConfigurationCreateModal @ref="emailConfigCreateModal"
                                       OnEmailConfigurationCreated="HandleEmailConfigurationCreated" />

<EmailProviderConfigurationEditModal @ref="emailConfigEditModal"
                                     OnEmailConfigurationUpdated="HandleEmailConfigurationUpdated" />

<OtpProviderConfigurationCreateModal @ref="otpConfigCreateModal"
                                     OnOtpConfigurationCreated="HandleOtpConfigurationCreated" />

<OtpProviderConfigurationEditModal @ref="otpConfigEditModal"
                                   OnOtpConfigurationUpdated="HandleOtpConfigurationUpdated" />

<PaymentProviderConfigurationCreateModal @ref="paymentConfigCreateModal"
                                         OnPaymentConfigurationCreated="HandlePaymentConfigurationCreated" />

<PaymentProviderConfigurationEditModal @ref="paymentConfigEditModal"
                                       OnPaymentConfigurationUpdated="HandlePaymentConfigurationUpdated" />

<SmsProviderConfigurationCreateModal @ref="smsConfigCreateModal"
                                     OnSmsConfigurationCreated="HandleSmsConfigurationCreated" />

<SmsProviderConfigurationEditModal @ref="smsConfigEditModal"
                                   OnSmsConfigurationUpdated="HandleSmsConfigurationUpdated" />

<div class="container-fluid mt-4">
    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-3 h5">Loading client details...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            <h4><i class="fa fa-exclamation-triangle"></i> Error Loading Client</h4>
            <p><strong>@errorMessage</strong></p>
            <button class="btn btn-warning" @onclick="LoadClientDetailsAsync">
                <i class="fa fa-refresh"></i> Retry
            </button>
            <button class="btn btn-secondary ml-2" @onclick="NavigateBack">
                <i class="fa fa-arrow-left"></i> Go Back
            </button>
        </div>
    }
    else if (clientDetails != null)
    {
        <!-- Page Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <button class="btn btn-outline-secondary mb-2" @onclick="NavigateBack">
                            <i class="fa fa-arrow-left"></i> Back to Clients
                        </button>
                        <h2 class="mb-0">
                            <i class="fa fa-building"></i> @clientDetails.Name
                        </h2>
                        <p class="text-muted mb-0">Client Details & Configurations</p>
                    </div>
                    <div>
                        <span class="badge badge-success badge-lg">Active</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Client Information Card -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fa fa-info-circle"></i> Client Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="detail-group">
                            <label class="detail-label text-muted">Client ID:</label>
                            <div class="detail-value font-weight-bold">@clientDetails.ClientId</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="detail-group">
                            <label class="detail-label text-muted">Identifier:</label>
                            <div class="detail-value font-weight-bold">@clientDetails.Identifier</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="detail-group">
                            <label class="detail-label text-muted">Client Name:</label>
                            <div class="detail-value font-weight-bold">@clientDetails.Name</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="detail-group">
                            <label class="detail-label text-muted">Created Date:</label>
                            <div class="detail-value">@clientDetails.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(clientDetails.Description))
                {
                    <div class="row mt-3">
                        <div class="col-12">
                            <label class="detail-label text-muted">Description:</label>
                            <p class="detail-value">@clientDetails.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Tabs Navigation -->
        <ul class="nav nav-tabs" id="providerTabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="email-tab" data-toggle="tab" href="#email" role="tab">
                    <i class="icon-envelope"></i> Email Providers
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="sms-tab" data-toggle="tab" href="#sms" role="tab">
                    <i class="icon-mobile"></i> SMS Providers
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="otp-tab" data-toggle="tab" href="#otp" role="tab">
                    <i class="icon-shield"></i> OTP Providers
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="payment-tab" data-toggle="tab" href="#payment" role="tab">
                    <i class="icon-credit-card"></i> Payment Providers
                </a>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content border border-top-0 p-4" id="providerTabsContent">
            <div class="tab-pane fade show active" id="email" role="tabpanel" aria-labelledby="email-tab">
                <h4><i class="icon-envelope"></i> Email Provider Configurations</h4>
                <!-- Your Email Content Here -->
            </div>

            <div class="tab-pane fade" id="sms" role="tabpanel" aria-labelledby="sms-tab">
                <h4><i class="icon-mobile"></i> SMS Provider Configurations</h4>
                <!-- Your SMS Content Here -->
            </div>

            <div class="tab-pane fade" id="otp" role="tabpanel" aria-labelledby="otp-tab">
                <h4><i class="icon-shield"></i> OTP Provider Configurations</h4>
                <!-- Your OTP Content Here -->
            </div>

            <div class="tab-pane fade" id="payment" role="tabpanel" aria-labelledby="payment-tab">
                <h4><i class="icon-credit-card"></i> Payment Provider Configurations</h4>
                <!-- Your Payment Content Here -->
            </div>
        </div>

    }
</div>

<style>
    .detail-group {
        margin-bottom: 1rem;
    }

    .detail-label {
        font-weight: 600;
        font-size: 0.875rem;
        margin-bottom: 0.25rem;
    }

    .detail-value {
        font-size: 1rem;
    }

    .nav-tabs .nav-link {
        cursor: pointer;
        color: #495057;
        border: 1px solid transparent;
        border-bottom: none;
    }

    .nav-tabs .nav-link:hover {
        border-color: #dee2e6 #dee2e6 #fff;
        isolation: isolate;
    }

    .nav-tabs .nav-link.active {
        color: #495057;
        background-color: #fff;
        border-color: #dee2e6 #dee2e6 #fff;
        font-weight: 600;
    }

    .badge-lg {
        font-size: 1rem;
        padding: 0.5rem 1rem;
    }

    .table td {
        vertical-align: middle;
    }

    .card-header h5 {
        margin: 0;
    }

    .tab-content {
        background-color: #fff;
    }
</style>

@code {
    [Parameter]
    public Guid ClientId { get; set; }

    private EmailProviderConfigurationCreateModal emailConfigCreateModal = null!;
    private EmailProviderConfigurationEditModal emailConfigEditModal = null!;
    private OtpProviderConfigurationCreateModal otpConfigCreateModal = null!;
    private OtpProviderConfigurationEditModal otpConfigEditModal = null!;
    private PaymentProviderConfigurationCreateModal paymentConfigCreateModal = null!;
    private PaymentProviderConfigurationEditModal paymentConfigEditModal = null!;
    private SmsProviderConfigurationCreateModal smsConfigCreateModal = null!;
    private SmsProviderConfigurationEditModal smsConfigEditModal = null!;
    
    private ClientViewModel? clientDetails;
    private bool isLoading = false;
    private bool isLoadingEmailConfigs = false;
    private bool isLoadingSmsConfigs = false;
    private bool isLoadingOtpConfigs = false;
    private bool isLoadingPaymentConfigs = false;
    private string errorMessage = string.Empty;
    private string activeTab = "email";

    private List<EmailClientProviderConfigurationViewModel> emailConfigurations = new();
    private List<SMSClientProviderConfigurationViewModel> smsConfigurations = new();
    private List<OtpClientProviderConfigurationViewModel> otpConfigurations = new();
    private List<PaymentClientProviderConfigurationViewModel> paymentConfigurations = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadClientDetailsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadClientDetailsAsync();
    }

    private string GetTabClass(string tabName)
    {
        return activeTab == tabName ? "active" : "";
    }

    private async Task SwitchTab(string tabName)
    {
        if (activeTab != tabName)
        {
            activeTab = tabName;
            Console.WriteLine($"🔄 Switched to tab: {tabName}");
            
            // Force UI update
            StateHasChanged();
            
            // Small delay to ensure UI updates
            await Task.Delay(1);
        }
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/clients");
    }

    private async Task LoadClientDetailsAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            Console.WriteLine($"🔍 Loading client details for ID: {ClientId}");

            var result = await ApiClient.ClientAsync(ClientId);

            if (result?.Success == true && result.Data != null)
            {
                clientDetails = result.Data;
                Console.WriteLine($"✅ Loaded client: {clientDetails.Name}");

                await Task.WhenAll(
                    LoadEmailConfigurations(clientDetails.Identifier),
                    LoadSmsConfigurations(clientDetails.Identifier),
                    LoadOtpConfigurations(clientDetails.Identifier),
                    LoadPaymentConfigurations(clientDetails.Identifier)
                );
            }
            else
            {
                errorMessage = result?.Message ?? "Failed to load client details.";
                Console.WriteLine($"❌ API returned unsuccessful: {errorMessage}");
            }
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}). Please try again.";
            Console.WriteLine($"❌ API Exception: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading client details: {ex.Message}";
            Console.WriteLine($"❌ Error loading client details: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadEmailConfigurations(string clientIdentifier)
    {
        try
        {
            isLoadingEmailConfigs = true;
            StateHasChanged();

            Console.WriteLine($"🔍 Loading email configurations for client: {clientIdentifier}");

            var result = await ApiClient.ConfigurationsPerClientAsync(clientIdentifier);

            if (result?.Success == true && result.Data != null)
            {
                emailConfigurations = result.Data
                    .Where(c => c.IsActive)
                    .OrderByDescending(c => c.IsDefault)
                    .ThenBy(c => c.ProviderName)
                    .ToList();
                
                Console.WriteLine($"✅ Loaded {emailConfigurations.Count} email configurations");
            }
            else
            {
                Console.WriteLine($"⚠️ No email configurations loaded: {result?.Message}");
                emailConfigurations = new List<EmailClientProviderConfigurationViewModel>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠️ Error loading email configurations: {ex.Message}");
            emailConfigurations = new List<EmailClientProviderConfigurationViewModel>();
        }
        finally
        {
            isLoadingEmailConfigs = false;
            StateHasChanged();
        }
    }

    private async Task LoadSmsConfigurations(string clientIdentifier)
    {
        try
        {
            isLoadingSmsConfigs = true;
            StateHasChanged();

            Console.WriteLine($"🔍 Loading SMS configurations for client: {clientIdentifier}");

            var result = await ApiClient.ConfigurationsPerClient4Async(clientIdentifier);

            if (result?.Success == true && result.Data != null)
            {
                smsConfigurations = result.Data
                    .Where(c => c.IsActive)
                    .OrderByDescending(c => c.IsDefault)
