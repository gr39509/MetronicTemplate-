@*     private async Task LoadClients() *@
@*     { *@
@*         try *@
@*         { *@
@*             isLoading = true; *@
@*             errorMessage = string.Empty; *@
@*             StateHasChanged(); *@
@* *@
@*             // Call the AllAsync method from ApiClient *@
@*             var result = await ApiClient.AllAsync(); *@
@* *@
@*             if (result?.Success == true && result.Data != null) *@
@*             { *@
@*                 clients = result.Data.ToList(); *@
@*                 Console.WriteLine($"✅ Loaded {clients.Count} clients"); *@
@*             } *@
@*             else *@
@*             { *@
@*                 errorMessage = result?.Message ?? "No clients data received from server."; *@
@*                 clients = new List<ClientViewModel>(); *@
@*                 Console.WriteLine($"❌ API returned unsuccessful: {errorMessage}"); *@
@*             } *@
@*         } *@
@*         catch (ApiException apiEx) *@
@*         { *@
@*             errorMessage = $"Server error ({apiEx.StatusCode}). Please try again."; *@
@*             Console.WriteLine($"❌ API Exception loading clients: {apiEx.Message}"); *@
@*         } *@
@*         catch (Exception ex) *@
@*         { *@
@*             errorMessage = "Failed to load clients. Please try again."; *@
@*             Console.WriteLine($"❌ Error loading clients: {ex.Message}"); *@
@*         } *@
@*         finally *@
@*         { *@
@*             isLoading = false; *@
@*             StateHasChanged(); *@
@*         } *@
@*     } *@
