<style>
    .animatecard {
        -webkit-animation: tracking-in-contract-bck-top 1s cubic-bezier(0.215, 0.610, 0.355, 1.000) both;
        animation: tracking-in-contract-bck-top 1s cubic-bezier(0.215, 0.610, 0.355, 1.000) both;
       
    }


    @@-webkit-keyframes tracking-in-contract-bck-top {
        0% {
            letter-spacing: 1em;
            -webkit-transform: translateZ(400px) translateY(-300px);
            transform: translateZ(400px) translateY(-300px);
            opacity: 0;
        }
        40% {
            opacity: 0.6;
        }
        100% {
            -webkit-transform: translateZ(0) translateY(0);
            transform: translateZ(0) translateY(0);
            opacity: 1;
        }
    }
    @@keyframes tracking-in-contract-bck-top {
        0% {
            letter-spacing: 1em;
            -webkit-transform: translateZ(400px) translateY(-300px);
            transform: translateZ(400px) translateY(-300px);
            opacity: 0;
        }
        40% {
            opacity: 0.6;
        }
        100% {
            -webkit-transform: translateZ(0) translateY(0);
            transform: translateZ(0) translateY(0);
            opacity: 1;
        }
    }
    

    .detail-group {
        margin-bottom: 1rem;
    }

    .detail-label {
        font-weight: 600;
        font-size: 0.875rem;
        margin-bottom: 0.25rem;
    }

    .detail-value {
        font-size: 1rem;
    }

    .nav-tabs .nav-link {
        cursor: pointer;
        color: #495057;
        border: 1px solid transparent;
        border-bottom: none;
    }

    .nav-tabs .nav-link:hover {
        border-color: #dee2e6 #dee2e6 #fff;
        isolation: isolate;
    }

    .nav-tabs .nav-link.active {
        color: #495057;
        background-color: #fff;
        border-color: #dee2e6 #dee2e6 #fff;
        font-weight: 600;
    }

    .badge-lg {
        font-size: 1rem;
        padding: 0.5rem 1rem;
    }

    .table td {
        vertical-align: middle;
    }

    .card-header h5 {
        margin: 0;
    }

    .tab-content {
        background-color: #fff;
    }
</style>

<script>
    window.showWelcomeAlert = () => {
        let timerInterval;
        Swal.fire({
            // title: "Morpheus just made it easier for you. Relax, and enjoy yourself.",
            icon: "success",
            width: 600,
            // html: "I will close in some few seconds.",
            timer: 2000,
            color: "#716add",
            background: "#fff url(rich-4897_256.gif)",
            backdrop: "rgba(0,0,123,0.4)\n" +
                "    url(\"/rich-4897_256.gif\")\n" +
                "    left top\n" +
                "    no-repeat",
            timerProgressBar: true,
            didOpen: () => {
                Swal.showLoading();
                const timer = Swal.getPopup().querySelector("b");
                timerInterval = setInterval(() => {
                    timer.textContent = `${Swal.getTimerLeft()}`;
                }, 100);
            },
            willClose: () => {
                clearInterval(timerInterval);
            }

        });
    };

</script>