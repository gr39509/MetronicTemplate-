@page "/clients/{ClientId:guid}"
@rendermode InteractiveServer
@using NovaAccounts.Components.APIConsummation.EmailProviderConfigurationsAPI
@using NovaAccounts.Components.APIConsummation.OtpProviderConfigurationsAPI
@using NovaAccounts.Components.APIConsummation.PaymentProviderConfigurationsAPI
@using NovaAccounts.Components.APIConsummation.SMSProviderConfigurationsAPI
@using NovaAccounts.Components.Layout
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.ModalFields

@inject IConfiguration Configuration
@inject NavigationManager NavigationManager
@inject ApiClient ApiClient
@layout MainLayout

@* Include all Configuration Modals *@
<EmailProviderConfigurationCreateModal @ref="emailConfigCreateModal"
                                       OnEmailConfigurationCreated="HandleEmailConfigurationCreated" />

<EmailProviderConfigurationEditModal @ref="emailConfigEditModal"
                                     OnEmailConfigurationUpdated="HandleEmailConfigurationUpdated" />

<OtpProviderConfigurationCreateModal @ref="otpConfigCreateModal"
                                     OnOtpConfigurationCreated="HandleOtpConfigurationCreated" />

<OtpProviderConfigurationEditModal @ref="otpConfigEditModal"
                                   OnOtpConfigurationUpdated="HandleOtpConfigurationUpdated" />

<PaymentProviderConfigurationCreateModal @ref="paymentConfigCreateModal"
                                         OnPaymentConfigurationCreated="HandlePaymentConfigurationCreated" />

<PaymentProviderConfigurationEditModal @ref="paymentConfigEditModal"
                                       OnPaymentConfigurationUpdated="HandlePaymentConfigurationUpdated" />

<SmsProviderConfigurationCreateModal @ref="smsConfigCreateModal"
                                     OnSmsConfigurationCreated="HandleSmsConfigurationCreated" />

<SmsProviderConfigurationEditModal @ref="smsConfigEditModal"
                                   OnSmsConfigurationUpdated="HandleSmsConfigurationUpdated" />

<SmsSendModal @ref="smsSendModal" 
              ClientIdentifier="@clientDetails?.Identifier"
              OnSmsSent="HandleSmsSent" />

<EmailSendModal @ref="emailSendModal" 
                ClientIdentifier="@clientDetails?.Identifier"
                OnEmailSent="HandleEmailSent" />

<PaymentDebitModal @ref="paymentDebitModal" 
                   ClientIdentifier="@clientDetails?.Identifier"
                   OnPaymentProcessed="HandlePaymentProcessed" />

<PaymentCreditModal @ref="paymentCreditModal" 
                   ClientIdentifier="@clientDetails?.Identifier"
                   OnPaymentProcessed="HandlePaymentProcessed" />

<OtpTestModal @ref="otpTestModal" 
              ClientIdentifier="@clientDetails?.Identifier"
              OnOtpTested="HandleOtpTested" />


<div class="container-fluid mt-4">
    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-3 h5">Loading client details...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            <h4><i class="fa fa-exclamation-triangle"></i> Error Loading Client</h4>
            <p><strong>@errorMessage</strong></p>
            <button class="btn btn-warning" @onclick="LoadClientDetailsAsync">
                <i class="fa fa-refresh"></i> Retry
            </button>
            <button class="btn btn-secondary ml-2" @onclick="NavigateBack">
                <i class="fa fa-arrow-left"></i> Go Back
            </button>
        </div>
    }
    else if (clientDetails != null)
    {
        <!-- Page Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <button class="btn btn-outline-secondary mb-2" @onclick="NavigateBack">
                            <i class="fa fa-arrow-left"></i> Back to Clients
                        </button>
                        <h2 class="mb-0">
                            <i class="fa fa-building"></i> @clientDetails.Name
                        </h2>
                        <p class="text-muted mb-0">Client Details & Configurations</p>
                    </div>
                    <div>
                        <span class="badge badge-success badge-lg">Active</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Client Information Card -->
        <div class="card mb-4">
            <div class="card-header leadBold bg-blue-chambray font-white">
                <h5 class="mb-0"><i class="fa fa-info-circle"></i> Client Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="detail-group">
                            <label class="detail-label text-muted">Client ID:</label>
                            <div class="detail-value font-weight-bold">@clientDetails.ClientId</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="detail-group">
                            <label class="detail-label text-muted">Identifier:</label>
                            <div class="detail-value font-weight-bold">@clientDetails.Identifier</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="detail-group">
                            <label class="detail-label text-muted">Client Name:</label>
                            <div class="detail-value font-weight-bold">@clientDetails.Name</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="detail-group">
                            <label class="detail-label text-muted">Created Date:</label>
                            <div class="detail-value">@clientDetails.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(clientDetails.Description))
                {
                    <div class="row mt-3">
                        <div class="col-12">
                            <label class="detail-label text-muted">Description:</label>
                            <p class="detail-value">@clientDetails.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Tabs Navigation -->
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link @GetTabClass("email")"
                   @onclick='() => SwitchTab("email")'
                   role="button">
                    <i class="icon-envelope"></i> Email Providers
                    @if (emailConfigurations?.Any() == true)
                    {
                        <span class="badge badge-primary ml-1">@emailConfigurations.Count</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @GetTabClass("sms")"
                   @onclick='() => SwitchTab("sms")'
                   role="button">
                    <i class="icon-mobile"></i> SMS Providers
                    @if (smsConfigurations?.Any() == true)
                    {
                        <span class="badge badge-primary ml-1">@smsConfigurations.Count</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @GetTabClass("otp")"
                   @onclick='() => SwitchTab("otp")'
                   role="button">
                    <i class="icon-shield"></i> OTP Providers
                    @if (otpConfigurations?.Any() == true)
                    {
                        <span class="badge badge-primary ml-1">@otpConfigurations.Count</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @GetTabClass("payment")"
                   @onclick='() => SwitchTab("payment")'
                   role="button">
                    <i class="icon-credit-card"></i> Payment Providers
                    @if (paymentConfigurations?.Any() == true)
                    {
                        <span class="badge badge-primary ml-1">@paymentConfigurations.Count</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @GetTabClass("transactions")"
                   @onclick='() => SwitchTab("transactions")'
                   role="button">
                    <i class="fa fa-history"></i> Transactions
                    @if (transactions?.Data?.Any() == true)
                    {
                        <span class="badge badge-primary ml-1">@transactions.TotalCount</span>
                    }
                </a>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content border border-top-0 p-4" id="providerTabsContent">
            <!-- Email Provider Tab -->
            <div class="tab-pane fade @(activeTab == "email" ? "show active" : "")" id="email" role="tabpanel" aria-labelledby="email-tab">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4><i class="icon-envelope"></i> Email Provider Configurations</h4>
                    <a href="/email-configurations/create/@clientDetails.Identifier" class="btn btn-primary">
                        <i class="fa fa-plus"></i> Add Email Configuration
                    </a>
                </div>

                @if (isLoadingEmailConfigs)
                {
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2">Loading email configurations...</p>
                    </div>
                }
                else if (emailConfigurations?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Provider</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th>Default</th>
                                    <th>From Email</th>
                                    <th style="width: 150px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var config in emailConfigurations)
                                {
                                    <tr>
                                        <td>
                                            <strong>@config.Provider.Name</strong>
                                            @if (!string.IsNullOrEmpty(config.Url))
                                            {
                                                <br />
                                                <small class="text-muted">@config.Url</small>
                                            }
                                        </td>
                                        <td>@config.Description</td>
                                        <td>
                                            @if (config.IsActive)
                                            {
                                                <span class="badge badge-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            @if (config.IsDefault)
                                            {
                                                <span class="badge badge-info">Default</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(config.EmailFrom))
                                            {
                                                <div>@config.EmailFrom</div>
                                                @if (!string.IsNullOrEmpty(config.EmailFromName))
                                                {
                                                    <small class="text-muted">@config.EmailFromName</small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not set</span>
                                            }
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    @onclick='() => OpenEditEmailConfiguration(config.EmailProviderConfigurationId)'
                                                    title="Edit Configuration">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-success"
                                                    @onclick:preventDefault
                                                    @onclick:stopPropagation
                                                    @onclick='() => OpenSendEmailModal(config)'
                                                    title="Send Email">
                                                <i class="fa fa-paper-plane"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i>
                        No email provider configurations found for this client.
                        <a href="/email-configurations/create/@clientDetails.Identifier" class="btn btn-sm btn-primary ml-2">
                            <i class="fa fa-plus"></i> Create First Configuration
                        </a>
                    </div>
                }
            </div>

            <!-- SMS Provider Tab -->
            <div class="tab-pane fade @(activeTab == "sms" ? "show active" : "")" id="sms" role="tabpanel" aria-labelledby="sms-tab">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4><i class="icon-mobile"></i> SMS Provider Configurations</h4>
                    <button class="btn btn-primary"
                            @onclick="OpenCreateSmsConfiguration"
                            @onclick:preventDefault
                            @onclick:stopPropagation
                            disabled="@(clientDetails == null)"
                            title="Add SMS Configuration">
                        <i class="fa fa-plus"></i> Add SMS Configuration
                        @if (clientDetails == null)
                        {
                            <span class="spinner-border spinner-border-sm ml-2"></span>
                        }
                    </button>
                </div>

                @if (isLoadingSmsConfigs)
                {
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2">Loading SMS configurations...</p>
                    </div>
                }
                else if (smsConfigurations?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Provider</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th>Default</th>
                                    <th>Created Date</th>
                                    <th style="width: 100px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var config in smsConfigurations)
                                {
                                    <tr>
                                        <td>
                                            <strong>@config.Provider.Name</strong>
                                            @if (!string.IsNullOrEmpty(config.Url))
                                            {
                                                <br />
                                                <small class="text-muted">@config.Url</small>
                                            }
                                        </td>
                                        <td>@config.Description</td>
                                        <td>
                                            @if (config.IsActive)
                                            {
                                                <span class="badge badge-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            @if (config.IsDefault)
                                            {
                                                <span class="badge badge-info">Default</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No</span>
                                            }
                                        </td>
                                        <td>
                                            <small>@config.CreatedAt.ToString("yyyy-MM-dd")</small>
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    @onclick:preventDefault
                                                    @onclick:stopPropagation
                                                    @onclick='() => OpenEditSmsConfiguration(config.SmsProviderConfigurationId)'
                                                    title="Edit Configuration">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-success"
                                                    @onclick:preventDefault
                                                    @onclick:stopPropagation
                                                    @onclick='() => OpenSendSmsModal(config)'
                                                    title="Send SMS">
                                                <i class="fa fa-paper-plane"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i>
                        No SMS provider configurations found for this client.
                        <button class="btn btn-sm btn-primary ml-2" @onclick="OpenCreateSmsConfiguration">
                            <i class="fa fa-plus"></i> Create First Configuration
                        </button>
                    </div>
                }
            </div>

            <!-- OTP Provider Tab -->
            <div class="tab-pane fade @(activeTab == "otp" ? "show active" : "")" id="otp" role="tabpanel" aria-labelledby="otp-tab">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4><i class="icon-shield"></i> OTP Provider Configurations</h4>
                    <button class="btn btn-primary" @onclick:preventDefault
                            @onclick:stopPropagation @onclick="OpenCreateOtpConfiguration">
                        <i class="fa fa-plus"></i> Add OTP Configuration
                    </button>
                </div>

                @if (isLoadingOtpConfigs)
                {
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2">Loading OTP configurations...</p>
                    </div>
                }
                else if (otpConfigurations?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Provider</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th>Default</th>
                                    <th>Created Date</th>
                                    <th style="width: 200px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var config in otpConfigurations)
                                {
                                    <tr>
                                        <td>
                                            <strong>@config.Provider.Name</strong>
                                            @if (!string.IsNullOrEmpty(config.Url))
                                            {
                                                <br />
                                                <small class="text-muted">@config.Url</small>
                                            }
                                        </td>
                                        <td>@config.Description</td>
                                        <td>
                                            @if (config.IsActive)
                                            {
                                                <span class="badge badge-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            @if (config.IsDefault)
                                            {
                                                <span class="badge badge-info">Default</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No</span>
                                            }
                                        </td>
                                        <td>
                                            <small>@config.CreatedAt.ToString("yyyy-MM-dd")</small>
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    @onclick='() => OpenEditOtpConfiguration(config.ClientProviderConfigurationId)'
                                                    title="Edit Configuration">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-success"
                                                    @onclick:preventDefault
                                                    @onclick:stopPropagation
                                                    @onclick='() => OpenOtpTestModal(config)'
                                                    title="Test OTP">
                                                <i class="fa fa-shield"></i> Test OTP
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i>
                        No OTP provider configurations found for this client.
                        <button class="btn btn-sm btn-primary ml-2" @onclick="OpenCreateOtpConfiguration">
                            <i class="fa fa-plus"></i> Create First Configuration
                        </button>
                    </div>
                }
            </div>

            <!-- Payment Provider Tab -->
            <div class="tab-pane fade @(activeTab == "payment" ? "show active" : "")" id="payment" role="tabpanel" aria-labelledby="payment-tab">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4><i class="icon-credit-card"></i> Payment Provider Configurations</h4>
                    <button class="btn btn-primary" @onclick="OpenCreatePaymentConfiguration">
                        <i class="fa fa-plus"></i> Add Payment Configuration
                    </button>
                </div>

                @if (isLoadingPaymentConfigs)
                {
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2">Loading payment configurations...</p>
                    </div>
                }
                else if (paymentConfigurations?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Provider</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th>Default</th>
                                    <th>Created Date</th>
                                    <th style="width: 320px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var config in paymentConfigurations)
                                {
                                    <tr>
                                        <td>
                                            <strong>@config.Provider.Name</strong>
                                            @if (!string.IsNullOrEmpty(config.Url))
                                            {
                                                <br />
                                                <small class="text-muted">@config.Url</small>
                                            }
                                        </td>
                                        <td>@config.Description</td>
                                        <td>
                                            @if (config.IsActive)
                                            {
                                                <span class="badge badge-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            @if (config.IsDefault)
                                            {
                                                <span class="badge badge-info">Default</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No</span>
                                            }
                                        </td>
                                        <td>
                                            <small>@config.CreatedAt.ToString("yyyy-MM-dd")</small>
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    @onclick='() => OpenEditPaymentConfiguration(config.PaymentProviderConfigurationId)'
                                                    title="Edit Configuration">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-success"
                                                    @onclick:preventDefault
                                                    @onclick:stopPropagation
                                                    @onclick='() => OpenPaymentDebitModal(config)'
                                                    title="Test Debit">
                                                <i class="fa fa-credit-card"></i> Test Debit
                                            </button>
                                            <button type="button" class="btn btn-sm btn-warning"
                                                    @onclick:preventDefault
                                                    @onclick:stopPropagation
                                                    @onclick='() => OpenPaymentCreditModal(config)'
                                                    title="Test Credit">
                                                <i class="fa fa-money-bill"></i> Test Credit
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i>
                        No payment provider configurations found for this client.
                        <button class="btn btn-sm btn-primary ml-2" @onclick="OpenCreatePaymentConfiguration">
                            <i class="fa fa-plus"></i> Create First Configuration
                        </button>
                    </div>
                }
            </div>

            <!-- Transactions Tab -->
            <div class="tab-pane fade @(activeTab == "transactions" ? "show active" : "")" id="transactions" role="tabpanel" aria-labelledby="transactions-tab">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4><i class="fa fa-history"></i> Payment Transactions</h4>
                    <div class="d-flex align-items-center">
                        <!-- Date Range Filter -->
                        <div class="mr-2">
                            <label class="form-label mb-0 mr-2">From:</label>
                            <input type="date" class="form-control form-control-sm d-inline-block" style="width: 150px;"
                                   @bind="transactionsStartDate" @bind:event="onchange" @bind:after="OnTransactionsDateChange" />
                        </div>
                        <div class="mr-2">
                            <label class="form-label mb-0 mr-2">To:</label>
                            <input type="date" class="form-control form-control-sm d-inline-block" style="width: 150px;"
                                   @bind="transactionsEndDate" @bind:event="onchange" @bind:after="OnTransactionsDateChange" />
                        </div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshTransactions">
                            <i class="fa fa-refresh"></i> Refresh
                        </button>
                    </div>
                </div>

                @if (isLoadingTransactions)
                {
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2">Loading transactions...</p>
                    </div>
                }
                else if (transactions?.Data?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Invoice #</th>
                                    <th>Transaction Type</th>
                                    <th>Amount</th>
                                    <th>Phone Number</th>
                                    <th>Provider</th>
                                    <th>Status</th>
                                    <th>Reference</th>
                                    <th>Created Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var transaction in transactions.Data)
                                {
                                    <tr>
                                        <td>
                                            <strong>@transaction.InvoiceNo</strong>
                                        </td>
                                        <td>
                                            <span class="badge @GetTransactionTypeBadge(transaction.TransactionType)">
                                                @transaction.TransactionType
                                            </span>
                                        </td>
                                        <td>
                                            <strong>@transaction.Amount.ToString("F2") @transaction.Currency</strong>
                                        </td>
                                        <td>@transaction.PhoneNumber</td>
                                        <td>@transaction.ProviderCode</td>
                                        <td>
                                            <span class="badge @GetStatusBadge(transaction.Status)">
                                                @transaction.Status
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(transaction.ProviderReference))
                                            {
                                                <small class="text-muted">@transaction.ProviderReference</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>
                                        <td>
                                            <small>@transaction.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (transactions.TotalPages > 1)
                    {
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div>
                                <span class="text-muted">
                                    Showing @((transactions.PageNumber - 1) * transactions.PageSize + 1) to 
                                    @Math.Min(transactions.PageNumber * transactions.PageSize, transactions.TotalCount) 
                                    of @transactions.TotalCount entries
                                </span>
                            </div>
                            <nav>
                                <ul class="pagination mb-0">
                                    <li class="page-item @(transactions.HasPreviousPage ? "" : "disabled")">
                                        <button class="page-link" @onclick="() => ChangeTransactionPage(transactions.PageNumber - 1)">
                                            Previous
                                        </button>
                                    </li>
                                    @for (int i = 1; i <= transactions.TotalPages; i++)
                                    {
                                        var pageNumber = i;
                                        <li class="page-item @(i == transactions.PageNumber ? "active" : "")">
                                            <button class="page-link" @onclick="async () => await ChangeTransactionPage(pageNumber)"
                                                    @onclick:preventDefault @onclick:stopPropagation>
                                                @i
                                            </button>
                                        </li>
                                    }
                                    <li class="page-item @(transactions.HasNextPage ? "" : "disabled")">
                                        <button class="page-link" @onclick="() => ChangeTransactionPage(transactions.PageNumber + 1)">
                                            Next
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i>
                        No transactions found for this client.
                        @if (!string.IsNullOrEmpty(transactionsErrorMessage))
                        {
                            <br />
                            <small class="text-muted">@transactionsErrorMessage</small>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

