                        </div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshTransactions">
                            <i class="fa fa-refresh"></i> Refresh
                        </button>
                    </div>
                </div>

                @if (isLoadingTransactions)
                {
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2">Loading transactions...</p>
                    </div>
                }
                else if (transactions?.Data?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover">
                            <thead class="table-dark">
                            <tr>
                                <th>Invoice #</th>
                                <th>Transaction Type</th>
                                <th>Amount</th>
                                <th>Phone Number</th>
                                <th>Provider</th>
                                <th>Status</th>
                                <th>Transaction ID</th>
                                <th>Provider Reference</th>
                                <th>Created Date</th>
                                <th>Processed Date</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var transaction in transactions.Data)
                            {
                                <tr>
                                    <td>
                                        <strong>@transaction.InvoiceNo</strong>
                                    </td>
                                    <td>
                                        <span class="badge @GetTransactionTypeBadge(transaction.TransactionType)">
                                            @transaction.TransactionType
                                        </span>
                                    </td>
                                    <td>
                                        <strong>@transaction.Amount.ToString("F2") @transaction.Currency</strong>
                                    </td>
                                    <td>@transaction.PhoneNumber</td>
                                    <td>@transaction.Provider</td>
                                    <td>
                                        <span class="badge @GetStatusBadge(transaction.Status)">
                                            @transaction.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(transaction.Reference))
                                        {
                                            <small class="text-muted">@transaction.Reference</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(transaction.ProviderReference))
                                        {
                                            <small class="text-muted">@transaction.ProviderReference</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <small>@transaction.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss tt")</small>
                                    </td>
                                    @if (transaction.ProcessedAt != null)
                                    {
                                        <td>
                                            <small>@transaction.ProcessedAt?.ToString("yyyy-MM-dd HH:mm:ss tt")</small>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <small>Not Processed</small>
                                        </td>
                                    }
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (transactions.TotalPages > 1)
                    {
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div>
                                <span class="text-muted">
                                    Showing @((transactions.PageNumber - 1) * transactions.PageSize + 1) to 
                                    @Math.Min(transactions.PageNumber * transactions.PageSize, transactions.TotalCount) 
                                    of @transactions.TotalCount entries
                                </span>
                            </div>
                            <ReusablePagination CurrentPage="transactions.PageNumber" 
                                                TotalPages="transactions.TotalPages"
                                                PageChanged="ChangeTransactionPage" />
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i>
                        No transactions found for this client.
                        @if (!string.IsNullOrEmpty(transactionsErrorMessage))
                        {
                            <br />
                            <small class="text-muted">@transactionsErrorMessage</small>
                        }
                    </div>
                }
            </div>
        </div>
        
        <br/>
        <!-- Provider Analytics Section -->
        @if (hasTransactionData)
        {
            <div class="row">
                <div class="col-md-8">
                    <!-- Transaction Trends Over Time -->
                    <div class="card mb-4">
