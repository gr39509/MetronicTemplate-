    private async Task ChangeTransactionPage(int page)
    {
        try
        {
            Console.WriteLine($"ChangeTransactionPage called with page: {page}");
            Console.WriteLine($"Current page before change: {currentTransactionPage}");
            Console.WriteLine($"Total pages: {transactions?.TotalPages ?? 0}");

            // Validate page number
            if (page < 1)
            {
                Console.WriteLine($"Page {page} is less than 1, using page 1");
                page = 1;
            }

            if (transactions != null && page > transactions.TotalPages)
            {
                Console.WriteLine($"Page {page} is beyond total pages {transactions.TotalPages}, using page {transactions.TotalPages}");
                page = transactions.TotalPages;
            }

            // Only proceed if the page actually changed
            if (currentTransactionPage == page)
            {
                Console.WriteLine($"Already on page {page}, no change needed");
                return;
            }

            Console.WriteLine($"Changing from page {currentTransactionPage} to page {page}");
            currentTransactionPage = page;

            // Force UI update before API call
            StateHasChanged();
        
            // Small delay to ensure UI updates
            await Task.Delay(10);
        
            await LoadTransactionsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in ChangeTransactionPage: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }


