@*         if (endDate.HasValue) *@
@*             filters.Add($"to_{endDate:yyyyMMdd}"); *@
@*         if (!string.IsNullOrEmpty(clientCodesFilter)) *@
@*             filters.Add($"clients_{clientCodesFilter.Replace(",", "_")}"); *@
@*         if (selectedProviderId.HasValue) *@
