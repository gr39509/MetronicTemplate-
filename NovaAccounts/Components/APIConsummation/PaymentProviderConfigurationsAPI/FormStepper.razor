@page "/payment-configurations/create"
@page "/payment-configurations/create/{ClientIdentifier}"
@rendermode InteractiveServer

@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.FormStepper
@using NovaAccounts.Components.Shared

@inject ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Create Payment Provider Configuration</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Breadcrumb Navigation -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/">Clients</a>
                    </li>
                    @if (preSelectedClient != null)
                    {
                        <li class="breadcrumb-item">
                            <a href="/clients/@preSelectedClient.ClientId">@preSelectedClient.Name</a>
                        </li>
                    }
                    <li class="breadcrumb-item active" aria-current="page">Create Payment Configuration</li>
                </ol>
            </nav>

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">Create Payment Provider Configuration</h1>
                <div>
                    <button class="btn btn-outline-secondary mb-2" @onclick="NavigateBack">
                        <i class="fa fa-arrow-left"></i> Back to Client
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                    <p class="mt-3">Loading wizard...</p>
                </div>
            }
            else
            {
                <!-- Wizard Form -->
                <ReusableFormWizard Steps="@wizardSteps" 
                           Config="@wizardConfig" 
                           OnFinish="@HandleWizardFinish"
                           OnStepChanged="@HandleStepChanged"
                           OnStepValidation="@ValidateStep" />

                @if (submittedData.Any())
                {
                    <div class="mt-4">
                        <h3>Configuration Created Successfully!</h3>
                        <div class="alert alert-success">
                            <strong>Success!</strong> Payment configuration has been created successfully.
                        </div>
                        <div class="card">
                            <div class="card-body">
                                <h5>Configuration Details:</h5>
                                <ul>
                                    @foreach (var item in submittedData)
                                    {
                                        <li><strong>@item.Key:</strong> @item.Value</li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-outline-secondary mb-2" @onclick="NavigateBack">
                                <i class="fa fa-arrow-left"></i> Back to Client
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string? ClientIdentifier { get; set; }

    // Wizard components
    private List<WizardStep> wizardSteps = new();
    private WizardConfiguration wizardConfig = new();
    private Dictionary<string, object> submittedData = new();

    // Data collections
    private List<ClientViewModel> clients = new();
    private List<ProviderViewModel> paymentProviders = new();
    private List<CredentialTypeViewModel> availableCredentialTypes = new();
    private ClientViewModel? preSelectedClient = null;
    private Guid? selectedClientId = null;
    private string selectedClientIdString = string.Empty;

    // Form fields
    private bool isDefault = false;
    private string fromAccount = string.Empty;
    private string fromAccountName = string.Empty;
    private string callbackURL = string.Empty;
    private string defaultCurrency = "GHS";
    private int transactionTimeout = 30;
    private bool enableWebhooks = true;

    // Loading states
    private bool isLoading = true;
    private bool isCreating = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(ClientIdentifier) && clients.Any())
        {
            await PreSelectClient();
        }
    }

    private async Task LoadInitialData()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Load all data in parallel
            var clientsTask = LoadClients();
            var providersTask = LoadPaymentProviders();
            var credentialsTask = LoadCredentialTypes();

            await Task.WhenAll(clientsTask, providersTask, credentialsTask);

            // Setup wizard after data is loaded
            SetupWizardConfig();
            SetupWizardSteps();

            // Pre-select client if identifier provided
            if (!string.IsNullOrEmpty(ClientIdentifier))
            {
                await PreSelectClient();
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SetupWizardConfig()
    {
        wizardConfig = new WizardConfiguration
        {
            Id = "paymentConfigWizard",
            Title = "Payment Configuration Wizard",
            ShowProgressBar = true,
            ShowStepNumbers = true,
            BackButtonText = "Back",
            NextButtonText = "Continue",
            FinishButtonText = "Create Configuration",
            SuccessMessage = "Payment configuration has been created successfully!",
            ErrorMessage = "Please fill in all required fields."
        };
    }

    private void SetupWizardSteps()
    {
        // Create basic step structure without options first
        wizardSteps = new List<WizardStep>
        {
            new WizardStep
            {
                Title = "Basic Information",
                Description = "Select client and provider",
                Icon = "fa-info-circle",
                Fields = new List<WizardField>
                {
                    new WizardField
                    {
                        Id = "client",
                        Name = "ClientId",
                        Label = "CLIENT *",
                        Type = WizardFieldType.Select,
                        IsRequired = true,
                        ColClass = "col-md-6",
                        Options = new List<WizardSelectOption>()
                    },
                    new WizardField
                    {
                        Id = "provider",
                        Name = "ProviderId",
                        Label = "PAYMENT PROVIDER *",
                        Type = WizardFieldType.Select,
                        IsRequired = true,
                        ColClass = "col-md-6",
                        Options = new List<WizardSelectOption>()
                    },
                    new WizardField
                    {
                        Id = "description",
                        Name = "Description",
                        Label = "DESCRIPTION *",
                        Type = WizardFieldType.Text,
                        IsRequired = true,
                        ColClass = "col-md-12",
                        Attributes = new Dictionary<string, object> { { "maxlength", "200" } }
                    }
                }
            },
            new WizardStep
            {
                Title = "Account Details",
                Description = "Configure payment source account (optional)",
                Icon = "fa-credit-card",
                Fields = new List<WizardField>
                {
                    new WizardField
                    {
                        Id = "fromAccount",
                        Name = "FromAccount",
                        Label = "FROM ACCOUNT",
                        Type = WizardFieldType.Text,
                        IsRequired = false,
                        ColClass = "col-md-6",
                        Attributes = new Dictionary<string, object> { { "maxlength", "50" } }
                       
                    },
                    new WizardField
                    {
                        Id = "fromAccountName",
                        Name = "FromAccountName",
                        Label = "FROM ACCOUNT NAME",
                        Type = WizardFieldType.Text,
                        IsRequired = false,
                        ColClass = "col-md-6",
                        Attributes = new Dictionary<string, object> { { "maxlength", "100" } }
                     
                    }
                }
            },
            new WizardStep
            {
                Title = "Webhook Settings",
                Description = "Configure callback URL for payment notifications",
                Icon = "fa-bell",
                Fields = new List<WizardField>
                {
                    new WizardField
                    {
                        Id = "callbackURL",
                        Name = "CallbackURL",
                        Label = "CALLBACK URL",
                        Type = WizardFieldType.Text,
                        IsRequired = false,
                        ColClass = "col-md-12",
                        Attributes = new Dictionary<string, object> 
                        { 
                            { "maxlength", "500" },
                            { "placeholder", "https://example.com/api/payments/callback" }
                        }
                       // Description = "URL to receive payment status notifications (optional)"
                    }
                }
            },
            new WizardStep
            {
                Title = "Payment Settings",
                Description = "Configure payment behavior",
                Icon = "fa-cog",
                Fields = new List<WizardField>
                {
                    new WizardField
                    {
                        Id = "isDefault",
                        Name = "IsDefault",
                        Label = "SET AS DEFAULT CONFIGURATION",
                        Type = WizardFieldType.Checkbox,
                        ColClass = "col-md-6",
                       // Description = "This configuration will be used when no specific configuration is selected"
                    }
                }
            },
            new WizardStep
            {
                Title = "Provider Credentials",
                Description = "Add required credentials",
                Icon = "fa-key",
                Fields = new List<WizardField>()
                // Will be populated dynamically when provider is selected
            },
            new WizardStep
            {
                Title = "Review & Create",
                Description = "Review all configuration details",
                Icon = "fa-check-circle",
                Fields = new List<WizardField>
                {
                    new WizardField
                    {
                        Name = "Client",
                        Label = "Client:",
                        Type = WizardFieldType.Display,
                        ColClass = "col-md-12"
                    },
                    new WizardField
                    {
                        Name = "Provider",
                        Label = "Provider:",
                        Type = WizardFieldType.Display,
                        ColClass = "col-md-12"
                    },
                    new WizardField
                    {
                        Name = "Description",
                        Label = "Description:",
                        Type = WizardFieldType.Display,
                        ColClass = "col-md-12"
                    },
                    new WizardField
                    {
                        Name = "FromAccount",
                        Label = "From Account:",
                        Type = WizardFieldType.Display,
                        ColClass = "col-md-12"
                    },
                    new WizardField
                    {
                        Name = "FromAccountName",
                        Label = "From Account Name:",
                        Type = WizardFieldType.Display,
                        ColClass = "col-md-12"
                    },
                    new WizardField
                    {
