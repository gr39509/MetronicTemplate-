@page "/otp-management"
@using Microsoft.AspNetCore.Authorization
@using NovaAccounts.SharedModels.DataFields
@using NovaAccounts.Components.Layout
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@inject ApiClient ApiClient
@layout MainLayout

<PageTitle>OTP Management</PageTitle>

@* Modals *@
<OtpGenerateModal @ref="otpGenerateModal" OnOtpGenerated="HandleOtpGenerated" />
<OtpConfirmModal @ref="otpConfirmModal" OnOtpConfirmed="HandleOtpConfirmed" />
<OtpDetailsModal @ref="otpDetailsModal" />

<h1 class="page-title">
    OTP Management
    <small>Generate and confirm One-Time Passwords</small>
</h1>

<!-- Loading State -->
@if (isLoading)
{
    <div class="portlet light bordered">
        <div class="portlet-body text-center" style="padding: 50px 0;">
            <div class="spinner-border text-primary" role="status">
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-3">Loading OTP records...</p>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" @onclick="@(() => errorMessage = string.Empty)">
            <span>&times;</span>
        </button>
        <strong>Error!</strong> @errorMessage
        <button class="btn btn-sm btn-warning" @onclick="LoadOtpRecords" style="margin-left: 10px;">
            <i class="fa fa-refresh"></i> Retry
        </button>
    </div>
}
else
{
    <div class="portlet">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-lock font-dark"></i>
                <span class="caption-subject bold uppercase">OTP Records</span>
            </div>
            <div class="actions">
                <button class="btn btn-circle btn-icon-only btn-default" @onclick="LoadOtpRecords" title="Refresh">
                    <i class="fa fa-refresh"></i>
                </button>
                @* <button class="btn btn-circle btn-icon-only btn-default" @onclick="GenerateNewOtp" title="Generate OTP"> *@
                @*     <i class="fa fa-plus"></i> *@
                @* </button> *@
                @* <button class="btn btn-circle btn-icon-only btn-default" @onclick="ConfirmOtp" title="Confirm OTP"> *@
                @*     <i class="fa fa-check"></i> *@
                @* </button> *@
            </div>
        </div>
        <div class="portlet-body">
            <ReusableDataTable TItem="OtpCodes"
                               Data="@otpRecords"
                               Columns="@otpColumns"
                               Options="@otpOptions"
                               />
        </div>
    </div>
}

@code {
    private List<OtpCodes> otpRecords = new();
    private List<DataTableColumn> otpColumns = new();
    private DataTableOptions otpOptions = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    
    // Modal references
    private OtpGenerateModal otpGenerateModal = null!;
    private OtpConfirmModal otpConfirmModal = null!;
    private OtpDetailsModal otpDetailsModal = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("OnAfterRenderAsync - First render");
            await JSRuntime.InvokeVoidAsync("setDotNetReference", 
                DotNetObjectReference.Create(this));
            await JSRuntime.InvokeVoidAsync("showWelcomeAlert");
        }
    }

    [JSInvokable]
    public async Task ViewOtpDetails(string otpId)
    {
        Console.WriteLine($"ViewOtpDetails called with otpId: {otpId}");
        
        try
        {
            if (otpDetailsModal == null)
            {
                Console.WriteLine("otpDetailsModal is null");
                return;
            }
    
            await otpDetailsModal.OpenModal(otpId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in ViewOtpDetails: {ex.Message}");
        }
    }
    
    // [JSInvokable]
    // public async Task GenerateNewOtp()
    // {
    //     Console.WriteLine("🔑 GenerateNewOtp called");
    //     
    //     if (otpGenerateModal == null)
    //     {
    //         Console.WriteLine("otpGenerateModal is null");
    //         return;
    //     }
    //
    //     await otpGenerateModal.OpenModal();
    // }
    //
    // [JSInvokable]
    // public async Task ConfirmOtp()
    // {
    //     Console.WriteLine("ConfirmOtp called");
    //     
    //     if (otpConfirmModal == null)
    //     {
    //         Console.WriteLine("otpConfirmModal is null");
    //         return;
    //     }
    //
    //     await otpConfirmModal.OpenModal();
    // }

    protected override async Task OnInitializedAsync()
    {
        ConfigureOtpTable();
        await LoadOtpRecords();
    }

    private async Task LoadOtpRecords()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            // Call the All4Async method to get all OTP records
            var result = await ApiClient.All4Async();

            if (result?.Success == true && result.Data != null)
            {
                otpRecords = result.Data.ToList();
                Console.WriteLine($"Loaded {otpRecords.Count} OTP records");
            }
            else
            {
                errorMessage = result?.Message ?? "No OTP records received from server.";
                otpRecords = new List<OtpCodes>();
                Console.WriteLine($"API returned unsuccessful: {errorMessage}");
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = $"Server error ({apiEx.StatusCode}). Please try again.";
            Console.WriteLine($"API Exception loading OTP records: {apiEx.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load OTP records. Please try again.";
            Console.WriteLine($"Error loading OTP records: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ConfigureOtpTable()
    {
        otpColumns = new List<DataTableColumn>
        {
            new()
            {
                Header = "OTP ID",
                PropertyName = nameof(OtpCodes.OtpId),
                CssClass = "text-center",
                CustomRenderer = (item) =>
                {
                    var otp = (OtpCodes)item;
                    return $"<code>{otp.OtpId.ToString().Substring(0, 8)}...</code>";
                }
            },
            new()
            {
                Header = "USER ID",
                PropertyName = nameof(OtpCodes.UserId),
                CssClass = "text-center",
                CustomRenderer = (item) =>
                {
                    var otp = (OtpCodes)item;
                    return $"<code>{otp.UserId.ToString().Substring(0, 8)}...</code>";
                }
            },
            new()
            {
                Header = "TYPE",
                PropertyName = nameof(OtpCodes.OtpType),
                CustomRenderer = (item) =>
                {
                    var otpType = ((OtpCodes)item).OtpType;
                    var badgeClass = otpType switch
                    {
                        OtpType._0 => "badge-info",
                        OtpType._1 => "badge-primary",
                        OtpType._2 => "badge-secondary",
                        _ => "badge-light"
                    };
                    return $"<span class='badge {badgeClass}'>{otpType}</span>";
                }
            },
            new()
            {
                Header = "PURPOSE",
                PropertyName = nameof(OtpCodes.Purpose),
                CustomRenderer = (item) =>
                {
                    var purpose = ((OtpCodes)item).Purpose;
                    var badgeClass = purpose switch
                    {
                        OtpPurpose._0 => "badge-success",
                        OtpPurpose._1 => "badge-warning",
                        OtpPurpose._2 => "badge-danger",
                        _ => "badge-light"
                    };
                    return $"<span class='badge {badgeClass}'>{purpose}</span>";
                }
            },
            new()
            {
                Header = "CONTACT",
                PropertyName = nameof(OtpCodes.ContactValue),
                CustomRenderer = (item) =>
                {
                    var contact = ((OtpCodes)item).ContactValue;
                    return string.IsNullOrEmpty(contact)
                        ? "<span class='text-muted'>N/A</span>"
                        : contact;
                }
            },
            new()
            {
                Header = "EMAIL",
                PropertyName = nameof(OtpCodes.EmailValue),
                CustomRenderer = (item) =>
                {
                    var email = ((OtpCodes)item).EmailValue;
                    return string.IsNullOrEmpty(email)
                        ? "<span class='text-muted'>N/A</span>"
                        : $"<a href='mailto:{email}'>{email}</a>";
                }
            },
            new()
            {
                Header = "STATUS",
                PropertyName = nameof(OtpCodes.IsUsed),
                CustomRenderer = (item) =>
                {
                    var isUsed = ((OtpCodes)item).IsUsed ?? false;
                    return isUsed 
                        ? "<span class='badge badge-success'>Used</span>"
                        : "<span class='badge badge-warning'>Active</span>";
                }
            },
            new()
            {
                Header = "EXPIRES",
                PropertyName = nameof(OtpCodes.ExpireAt),
                CustomRenderer = (item) =>
                {
                    var expireAt = ((OtpCodes)item).ExpireAt;
                    var isExpired = expireAt < DateTimeOffset.Now;
                    var timeClass = isExpired ? "text-danger" : "text-success";
                    return $"<span class='{timeClass}'>{expireAt:yyyy-MM-dd HH:mm}</span>";
                }
            },
            new()
            {
                Header = "CREATED",
                PropertyName = nameof(OtpCodes.CreatedAt),
                CustomRenderer = (item) =>
                {
                    var createdAt = ((OtpCodes)item).CreatedAt;
                    return createdAt.ToString("yyyy-MM-dd HH:mm");
                }
            },
            new()
            {
                Header = "ACTIONS",
                PropertyName = "",
                Sortable = false,
                Searchable = false,
                Width = 120,
                CssClass = "text-center",
                CustomRenderer = (item) => 
                {
                    var otp = (OtpCodes)item;
                    var isUsed = otp.IsUsed ?? false;
                    var isExpired = otp.ExpireAt < DateTimeOffset.Now;
                    
                    if (isUsed || isExpired)
                    {
                        return $@"
        <div class='btn-group btn-group-sm' role='group'>
            <button type='button' class='btn btn-primary btn-xs' onclick='viewOtpDetails(""{otp.OtpId}"")' title='View Details'>
                <i class='fa fa-eye'></i>
            </button>
        </div>";
                    }
                    else
                    {
                        return $@"
        <div class='btn-group btn-group-sm' role='group'>
            <button type='button' class='btn btn-primary btn-xs' onclick='viewOtpDetails(""{otp.OtpId}"")' title='View Details'>
                <i class='fa fa-eye'></i>
            </button>
            <button type='button' class='btn btn-success btn-xs' onclick='confirmOtpRecord(""{otp.OtpId}"")' title='Confirm OTP'>
                <i class='fa fa-check'></i>
            </button>
        </div>";
                    }
                }
            }
        };

        otpOptions = new DataTableOptions
        {
            PageLength = 10,
            LengthMenu = new[] { 10, 25, 50 },
            LengthMenuLabels = new[] { "10", "25", "50" },
            SearchPlaceholder = "Search OTP Records",
            TableId = "otpRecordsTable",
            TableCssClass = "table table-striped table-bordered table-hover",
            HeaderCssClass = "leadBold bg-blue-chambray font-white",
            ShowSearch = true,
            ShowPaging = true,
            ShowInfo = true,
            Responsive = true,
            AdditionalOptions = new Dictionary<string, object>
            {
                ["order"] = new object[] { new object[] { 7, "desc" } } // Order by ExpireAt descending
            }
        };
    }
    
    // Handle OTP generation
    private async Task HandleOtpGenerated(OtpResponse generatedOtp)
    {
        Console.WriteLine($"Handling OTP generation: {generatedOtp.OtpId}");
        
        try
        {
           
            isLoading = true;
            StateHasChanged();
            
            // Small delay to ensure smooth UI transition
            await Task.Delay(300);
            
            // Reload the OTP records from server to get fresh data including the new OTP
            await LoadOtpRecords();
            
            Console.WriteLine("OTP records refreshed after generation");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error refreshing OTP records: {ex.Message}");
            errorMessage = "OTP was generated but couldn't refresh the records. Please refresh the page.";
            StateHasChanged();
        }
    }

    // Handle OTP confirmation
    private async Task HandleOtpConfirmed(ConfirmOtpResponse confirmationResult)
    {
        Console.WriteLine($"Handling OTP confirmation: {confirmationResult.IsValid}");
        
        try
        {
            // Show loading state briefly
            isLoading = true;
            StateHasChanged();
            
            // Small delay to ensure smooth UI transition
            await Task.Delay(300);
            
            // Reload the OTP records from server to get fresh data
            await LoadOtpRecords();
            
            Console.WriteLine("✅ OTP records refreshed after confirmation");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error refreshing OTP records: {ex.Message}");
            errorMessage = "OTP was confirmed but couldn't refresh the records. Please refresh the page.";
            StateHasChanged();
        }
    }
    
    // private async Task OnOtpRecordRowClick(OtpCodes otpRecord)
    // {
    //     Console.WriteLine($"OTP Record clicked: {otpRecord.OtpId}");
    //     await ViewOtpDetails(otpRecord.OtpId.ToString());
    // }
}

<script>

    window.dotNetReference = null;

    // Set the DotNet reference when the component is initialized
    window.setDotNetReference = (reference) => {
        window.dotNetReference = reference;
    };
    
    window.viewOtpDetails = function(otpId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('ViewOtpDetails', otpId)
                .catch(err => {
                    console.error('Error calling ViewOtpDetails:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    window.generateNewOtp = function () {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('GenerateNewOtp')
                .catch(err => {
                    console.error('Error calling GenerateNewOtp:', err);
                });
        } else {
            console.error('DotNet reference not available for generateNewOtp');
        }
    };

    window.confirmOtp = function () {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('ConfirmOtp')
                .catch(err => {
                    console.error('Error calling ConfirmOtp:', err);
                });
        } else {
            console.error('DotNet reference not available for confirmOtp');
        }
    };

    window.confirmOtpRecord = function (otpId) {
        if (window.dotNetReference) {
            // This would need to be implemented to open confirm modal with pre-filled OTP ID
            console.log('Confirm OTP Record:', otpId);
            // You could implement this to open the confirm modal with the OTP ID pre-filled
            alert('Confirm OTP functionality for: ' + otpId);
        } else {
            console.error('DotNet reference not available for confirmOtpRecord');
        }
    };
</script>

<script>
    window.showWelcomeAlert = () => {
        let timerInterval;
        Swal.fire({
            // title: "Morpheus just made it easier for you. Relax, and enjoy yourself.",
            icon: "success",
            width: 600,
            // html: "I will close in some few seconds.",
            timer: 5000,
            color: "#716add",
            background: "#fff url(rich-4897_256.gif)",
            backdrop: "rgba(0,0,123,0.4)\n" +
                "    url(\"/rich-4897_256.gif\")\n" +
                "    left top\n" +
                "    no-repeat",
            timerProgressBar: true,
            didOpen: () => {
                Swal.showLoading();
                const timer = Swal.getPopup().querySelector("b");
                timerInterval = setInterval(() => {
                    timer.textContent = `${Swal.getTimerLeft()}`;
                }, 100);
            },
            willClose: () => {
                clearInterval(timerInterval);
            }

        });
    };

</script>