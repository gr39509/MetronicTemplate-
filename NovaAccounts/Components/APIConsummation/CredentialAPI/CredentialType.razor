@page "/credential-type"
@using Microsoft.AspNetCore.Authorization
@using NovaAccounts.Components.APIConsummation.EmailProviderConfigurationsAPI
@using NovaAccounts.SharedModels.DataFields
@using NovaAccounts.Components.Layout
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

@rendermode InteractiveServer
@inject ApiClient ApiClient
@layout MainLayout

<PageTitle>Credential Types</PageTitle>



<h1 class="page-title">
    Credential Types Management
    <small>View credential type information</small>
</h1>

<!-- Loading State -->
@if (isLoading)
{
    <div class="portlet light bordered">
        <div class="portlet-body text-center" style="padding: 50px 0;">
            <div class="spinner-border text-primary" role="status">
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-3">Loading credential types...</p>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" @onclick="@(() => errorMessage = string.Empty)">
            <span>&times;</span>
        </button>
        <strong>Error!</strong> @errorMessage
        <button class="btn btn-sm btn-warning" @onclick="LoadCredentialTypes" style="margin-left: 10px;">
            <i class="fa fa-refresh"></i> Retry
        </button>
    </div>
}
else
{
    <div class="portlet">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-key font-dark"></i>
                <span class="caption-subject bold uppercase">Credential Types</span>
            </div>
            <div class="actions">
                <button class="btn btn-circle btn-icon-only btn-default" @onclick="LoadCredentialTypes" title="Refresh">
                    <i class="fa fa-refresh"></i>
                </button>
            </div>
        </div>
        <div class="portlet-body">
            <ReusableDataTable TItem="CredentialTypeViewModel"
                               Data="@credentialTypes"
                               Columns="@credentialTypeColumns"
                               Options="@credentialTypeOptions"
                               />
        </div>
    </div>
}

@code {
    private List<CredentialTypeViewModel> credentialTypes = new();
    private List<DataTableColumn> credentialTypeColumns = new();
    private DataTableOptions credentialTypeOptions = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("🔍 OnAfterRenderAsync - First render");
            await JSRuntime.InvokeVoidAsync("setDotNetReference", 
                DotNetObjectReference.Create(this));
            
           
        }
    }

  

    protected override async Task OnInitializedAsync()
    {
        ConfigureCredentialTypesTable();
        await LoadCredentialTypes();
    }
   

    private async Task LoadCredentialTypes()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            // Call the All2Async method from ApiClient to get credential types
            var result = await ApiClient.All2Async();

            if (result?.Success == true && result.Data != null)
            {
                credentialTypes = result.Data.ToList();
                Console.WriteLine($"Loaded {credentialTypes.Count} credential types");
            }
            else
            {
                errorMessage = result?.Message ?? "No credential types data received from server.";
                credentialTypes = new List<CredentialTypeViewModel>();
                Console.WriteLine($"API returned unsuccessful: {errorMessage}");
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = $"Server error ({apiEx.StatusCode}). Please try again.";
            Console.WriteLine($"❌ API Exception loading credential types: {apiEx.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load credential types. Please try again.";
            Console.WriteLine($"❌ Error loading credential types: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ConfigureCredentialTypesTable()
    {
        credentialTypeColumns = new List<DataTableColumn>
        {
            new()
            {
                Header = "CREDENTIAL TYPE",
                PropertyName = nameof(CredentialTypeViewModel.CredentialTypeName),
                CssClass = "text-center"
            },
            new()
            {
                Header = "DISPLAY NAME",
                PropertyName = nameof(CredentialTypeViewModel.DisplayName),
                CustomRenderer = (item) =>
                    $"<strong class='text-primary'>{((CredentialTypeViewModel)item).DisplayName}</strong>"
            },
            new()
            {
                Header = "STATUS",
                PropertyName = nameof(CredentialTypeViewModel.Active),
                CustomRenderer = (item) =>
                {
                    var isActive = ((CredentialTypeViewModel)item).Active;
                    return isActive 
                        ? "<span class='badge badge-success'>Active</span>"
                        : "<span class='badge badge-danger'>Inactive</span>";
                }
            }
            
        };

        credentialTypeOptions = new DataTableOptions
        {
            PageLength = 10,
            LengthMenu = new[] { 10, 25, 50 },
            LengthMenuLabels = new[] { "10", "25", "50" },
            SearchPlaceholder = "Search Credential Types",
            TableId = "credentialTypesTable",
            TableCssClass = "table table-striped table-bordered table-hover",
            HeaderCssClass = "leadBold bg-blue-chambray font-white",
            ShowSearch = true,
            ShowPaging = true,
            ShowInfo = true,
            Responsive = true,
            AdditionalOptions = new Dictionary<string, object>
            {
                ["order"] = new object[] { new object[] { 1, "asc" } } // Order by DisplayName ascending
            }
        };
    }
    
}

<script>
    window.setDotNetReference = function (dotNetHelper) {
        window.dotNetHelper = dotNetHelper;
        console.log("DotNet reference set:", dotNetHelper);
    };

</script>