@* OtpProviderConfigurationEditModal.razor *@
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.ModalFields
@inject ApiClient ApiClient

<ReusableModal @ref="otpConfigEditModal"
               Title="Edit OTP Provider Configuration"
               TriggerButtonText=""
               ShowTriggerButton="false"
               Size="ModalSize.Large"
               TitleFontSize="1.2rem"
               TitleColor="#007bff"
               BodyFontSize="0.95rem"
               HeaderClass="leadBold bg-blue-chambray font-white"
               BodyColor="#333"
               ShowSaveButton="true"
               SaveButtonText="Update Configuration"
               OnSave="@UpdateOtpConfiguration"
               ShowCancelButton="true"
               CancelButtonText="Cancel">

    <BodyContent>
        @if (isLoading)
        {
            <div class="text-center p-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2">Loading configuration details...</p>
            </div>
        }
        else if (configuration != null)
        {
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Client</label>
                        <input class="form-control" value="@configuration.ClientIdentifier" disabled />
                        <small class="form-text text-muted">Client cannot be changed</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Provider</label>
                        <input class="form-control" value="@configuration.Provider.Name" disabled />
                        <small class="form-text text-muted">Provider cannot be changed</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description *</label>
                        <input class="form-control @(string.IsNullOrEmpty(descriptionError) ? "" : "is-invalid")"
                               @bind="description"
                               @oninput="OnDescriptionInput"
                               placeholder="Enter configuration description" />
                        @if (!string.IsNullOrEmpty(descriptionError))
                        {
                            <div class="invalid-feedback">@descriptionError</div>
                        }
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" @bind="isDefault" />
                        <label class="form-check-label">Set as default configuration</label>
                        <small class="form-text text-muted d-block">This configuration will be used when no specific configuration is selected</small>
                    </div>
                </div>

                <div class="col-md-6">
                    <!-- OTP Specific Settings -->
                    @* <div class="card"> *@
                    @*     <div class="card-header"> *@
                    @*         <h6 class="card-title mb-0">OTP Settings</h6> *@
                    @*     </div> *@
                    @*     <div class="card-body"> *@
                    @*         <div class="mb-3"> *@
                    @*             <label class="form-label">Default OTP Length</label> *@
                    @*             <select class="form-control" @bind="defaultOtpLength"> *@
                    @*                 <option value="4">4 digits</option> *@
                    @*                 <option value="6">6 digits</option> *@
                    @*                 <option value="8">8 digits</option> *@
                    @*             </select> *@
                    @*             <small class="form-text text-muted">Number of digits in the OTP code</small> *@
                    @*         </div> *@
                    @* *@
                    @*         <div class="mb-3"> *@
                    @*             <label class="form-label">Default OTP Expiry (minutes)</label> *@
                    @*             <input type="number" class="form-control" @bind="defaultOtpExpiry" min="1" max="60" /> *@
                    @*             <small class="form-text text-muted">How long the OTP code remains valid</small> *@
                    @*         </div> *@
                    @* *@
                    @*         <div class="mb-3 form-check"> *@
                    @*             <input type="checkbox" class="form-check-input" @bind="allowAlphanumeric" /> *@
                    @*             <label class="form-check-label">Allow alphanumeric OTP codes</label> *@
                    @*             <small class="form-text text-muted d-block">If enabled, OTP can contain letters and numbers</small> *@
                    @*         </div> *@
                    @*     </div> *@
                    @* </div> *@

                    <!-- Status Toggle -->
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" @bind="isActive" />
                        <label class="form-check-label">Active Configuration</label>
                        <small class="form-text text-muted d-block">Enable or disable this configuration</small>
                    </div>
                </div>
            </div>

            <!-- Credentials Section -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">Provider Credentials</h5>
                    <small class="text-muted">
                        @if (availableCredentialTypes.Any())
                        {
                            <text>Update credentials for @configuration.ProviderName</text>
                        }
                        else
                        {
                            <text>Loading credential types...</text>
                        }
                    </small>
                </div>
                <div class="card-body">
                    @if (availableCredentialTypes.Any())
                    {
                        @foreach (var credType in availableCredentialTypes)
                        {
                            var existingCredential = configuration.ClientProviderCredentials?
                                .FirstOrDefault(c => c.CredentialType?.CredentialTypeName == credType.CredentialTypeName);
                            
                            <div class="mb-2">
                                <label class="form-label">@credType.DisplayName *</label>
                                <input type="password"
                                       class="form-control @(string.IsNullOrEmpty(GetCredentialError(credType.CredentialTypeName)) ? "" : "is-invalid")"
                                       placeholder="Enter @credType.DisplayName"
                                       value="@GetCredentialValue(credType.CredentialTypeName)"
                                       @oninput="@(e => OnCredentialInput(credType.CredentialTypeName, e))" />
                                
                                @if (!string.IsNullOrEmpty(GetCredentialError(credType.CredentialTypeName)))
                                {
                                    <div class="invalid-feedback">@GetCredentialError(credType.CredentialTypeName)</div>
                                }
                                
                                <small class="form-text text-muted">@credType.CredentialTypeName</small>
                                
                                @if (existingCredential != null && !string.IsNullOrEmpty(existingCredential.CredentialKey))
                                {
                                    <small class="form-text text-info">
                                        <i class="fa fa-info-circle"></i>
                                        Current value is set (enter new value only if you want to change it)
                                    </small>
                                }
                                else
                                {
                                    <small class="form-text text-warning">
                                        <i class="fa fa-exclamation-triangle"></i>
                                        This credential is required for the provider to function properly
                                    </small>
                                }
                            </div>
                        }
                    }
                    else if (!isLoadingCredentialTypes)
                    {
                        <p class="text-muted">No credential types available for this provider type.</p>
                    }
                    else
                    {
                        <div class="text-center">
                            <div class="spinner-border spinner-border-sm" role="status"></div>
                            <span class="ml-2">Loading credential types...</span>
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success mt-3">
                    <strong>Success!</strong> @successMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(formError))
            {
                <div class="alert alert-danger mt-3">
                    <strong>Error!</strong> @formError
                </div>
            }
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                <strong>Error!</strong> @errorMessage
                <button class="btn btn-sm btn-warning ml-2" @onclick="() => LoadConfiguration(currentConfigId)">
                    <i class="fa fa-refresh"></i> Retry
                </button>
            </div>
        }
    </BodyContent>
</ReusableModal>

@code {
    private ReusableModal otpConfigEditModal = null!;
    private OtpClientProviderConfigurationViewModel? configuration;
    private bool isLoading = false;
    private bool isLoadingCredentialTypes = false;
    private string errorMessage = string.Empty;
    private string formError = string.Empty;
    private string successMessage = string.Empty;
    private Guid currentConfigId;

    // Form fields
    private string description = string.Empty;
    private bool isDefault = false;
    private bool isActive = true;
    private int defaultOtpLength = 6;
    private int defaultOtpExpiry = 5;
    private bool allowAlphanumeric = false;
    private Dictionary<string, string> credentials = new();
    private List<CredentialTypeViewModel> availableCredentialTypes = new();

    // Validation errors
    private string descriptionError = string.Empty;
    private Dictionary<string, string> credentialErrors = new();

    [Parameter] public EventCallback<OtpClientProviderConfigurationViewModel> OnOtpConfigurationUpdated { get; set; }

    public async Task OpenModal(Guid configId)
    {
        errorMessage = string.Empty;
        formError = string.Empty;
        successMessage = string.Empty;
        configuration = null;
        currentConfigId = configId;

        if (otpConfigEditModal != null)
        {
            await otpConfigEditModal.OpenModal();
            await LoadCredentialTypes();
            await LoadConfiguration(currentConfigId);
        }
    }

    private async Task LoadCredentialTypes()
    {
        try
        {
            isLoadingCredentialTypes = true;
            var result = await ApiClient.All2Async();
            if (result?.Success == true && result.Data != null)
            {
                availableCredentialTypes = result.Data.Where(ct => ct.Active).ToList();
                Console.WriteLine($"Loaded {availableCredentialTypes.Count} credential types for OTP editing");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading credential types: {ex.Message}");
        }
        finally
        {
            isLoadingCredentialTypes = false;
            StateHasChanged();
        }
    }

   private async Task LoadConfiguration(Guid configId)
{
    try
    {
        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        Console.WriteLine($"🔍 Loading OTP configuration with ID: {configId}");

        // Get all clients first to find which client this configuration belongs to
        var clientsResult = await ApiClient.AllAsync();
        if (clientsResult?.Success == true && clientsResult.Data != null)
        {
            Console.WriteLine($"Found {clientsResult.Data.Count} clients");
            
            foreach (var client in clientsResult.Data)
            {
                Console.WriteLine($"Checking client: {client.Identifier} - {client.Name}");
                
                var configsResult = await ApiClient.ConfigurationsPerClient2Async(client.Identifier);
                if (configsResult?.Success == true && configsResult.Data != null)
                {
                    Console.WriteLine($"Found {configsResult.Data.Count} OTP configurations for client {client.Identifier}");
                    
                    var config = configsResult.Data.FirstOrDefault(c => c.ClientProviderConfigurationId == configId);
                    if (config != null)
                    {
                        configuration = config;
                        
                        Console.WriteLine($" SUCCESS: Found OTP configuration:");
                        Console.WriteLine($"   - Config ID: {config.ClientProviderConfigurationId}");
                        Console.WriteLine($"   - Description: {config.Description}");
                        Console.WriteLine($"   - Provider: {config.ProviderName}");
                        Console.WriteLine($"   - Client: {config.ClientIdentifier}");
                        Console.WriteLine($"   - IsDefault: {config.IsDefault}");
                        Console.WriteLine($"   - IsActive: {config.IsActive}");
                        Console.WriteLine($"   - Credentials Count: {config.ClientProviderCredentials?.Count ?? 0}");

                        // Populate form fields
                        description = configuration.Description ?? "";
                        isDefault = configuration.IsDefault;
                        isActive = configuration.IsActive;

                        // Populate credentials
                        credentials.Clear();
                        if (configuration.ClientProviderCredentials != null)
                        {
                            foreach (var cred in configuration.ClientProviderCredentials)
                            {
                                if (cred.CredentialType != null && !string.IsNullOrEmpty(cred.CredentialKey))
                                {
                                    credentials[cred.CredentialType.CredentialTypeName] = cred.CredentialKey;
                                    Console.WriteLine($"Found credential: {cred.CredentialType.CredentialTypeName}");
                                }
                            }
                        }

                        // Ensure we have entries for all available credential types
                        foreach (var credType in availableCredentialTypes)
                        {
                            if (!credentials.ContainsKey(credType.CredentialTypeName))
                            {
                                credentials[credType.CredentialTypeName] = string.Empty;
                            }
                        }
                        
                        Console.WriteLine($"Total credentials loaded: {credentials.Count}");
                        return;
                    }
                }
                else
                {
                    Console.WriteLine($"Failed to load configurations for client {client.Identifier}");
                }
            }
            errorMessage = "OTP configuration not found in any client.";
            Console.WriteLine($"OTP configuration {configId} not found in any client");
        }
        else
        {
            errorMessage = "Failed to load clients.";
            Console.WriteLine($"Failed to load clients");
        }
    }
    catch (Exception ex)
    {
        errorMessage = $"Error loading OTP configuration: {ex.Message}";
        Console.WriteLine($"Error loading OTP configuration: {ex.Message}");
        Console.WriteLine($"Stack Trace: {ex.StackTrace}");
    }
    finally
    {
        isLoading = false;
        StateHasChanged();
    }
}

private async Task UpdateOtpConfiguration()
{
    try
    {
        // Clear previous messages
        formError = string.Empty;
        successMessage = string.Empty;
        credentialErrors.Clear();
        
        // Validate all fields
        var isValid = ValidateForm();
        
        if (!isValid)
        {
            formError = "Please fix the validation errors before updating the configuration.";
            return;
        }

        if (configuration == null)
        {
            formError = "Configuration data is not loaded.";
            return;
        }

        Console.WriteLine($"Updating OTP configuration: {configuration.ClientProviderConfigurationId}");
        Console.WriteLine($"DEBUG - Configuration details:");
        Console.WriteLine($"   - ClientProviderConfigurationId: {configuration.ClientProviderConfigurationId}");
        Console.WriteLine($"   - ProviderId: {configuration.ProviderId}");
        Console.WriteLine($"   - ProviderName: {configuration.ProviderName}");
        Console.WriteLine($"   - ClientIdentifier: {configuration.ClientIdentifier}");

        // Create credentials list
        var clientProviderCredentials = new List<CreateClientProviderCredentialDto>();
        
        foreach (var credType in availableCredentialTypes)
        {
            var credentialValue = credentials.ContainsKey(credType.CredentialTypeName) 
                ? credentials[credType.CredentialTypeName] 
                : string.Empty;

            if (!string.IsNullOrWhiteSpace(credentialValue))
            {
                clientProviderCredentials.Add(new CreateClientProviderCredentialDto
                {
                    CredentialTypeName = credType.CredentialTypeName,
                    CredentialKey = credentialValue
                });
                Console.WriteLine($"Added credential: {credType.CredentialTypeName}");
            }
        }

        Console.WriteLine($"Total credentials to update: {clientProviderCredentials.Count}");

        // **CRITICAL FIX: Check if we're using the correct ID property**
        // The error suggests the backend expects a Payment configuration ID, but we have an OTP configuration
        // Let's try using ClientProviderConfigurationId directly as OtpClientProviderConfigurationId
        
        var updateCommand = new UpdateOtpProviderConfigurationDto
        {
            Description = description.Trim(),
            ProviderId = configuration.ProviderId,
            ClientProviderCredentials = clientProviderCredentials,
            OtpClientProviderConfigurationId = configuration.ClientProviderConfigurationId,
            IsDefault = isDefault
        };

        Console.WriteLine($"Calling Update3Async for OTP configuration:");
        Console.WriteLine($"   - OtpClientProviderConfigurationId: {updateCommand.OtpClientProviderConfigurationId}");
        Console.WriteLine($"   - Description: {updateCommand.Description}");
        Console.WriteLine($"   - ProviderId: {updateCommand.ProviderId}");
        Console.WriteLine($"   - IsDefault: {updateCommand.IsDefault}");
        Console.WriteLine($"   - Credentials Count: {updateCommand.ClientProviderCredentials?.Count ?? 0}");

        // **DEBUG: Let's check what type of configuration this really is**
        Console.WriteLine($"Configuration Type Check:");
        Console.WriteLine($"   - Has SmsProviderConfigurationId: {configuration.GetType().GetProperty("SmsProviderConfigurationId") != null}");
        Console.WriteLine($"   - Has EmailProviderConfigurationId: {configuration.GetType().GetProperty("EmailProviderConfigurationId") != null}");
        Console.WriteLine($"   - Has PaymentProviderConfigurationId: {configuration.GetType().GetProperty("PaymentProviderConfigurationId") != null}");
        
        // Check if this might actually be a Payment configuration misidentified as OTP
        var configType = configuration.GetType();
        foreach (var prop in configType.GetProperties())
        {
            if (prop.Name.EndsWith("ConfigurationId") && prop.Name != "ClientProviderConfigurationId")
            {
                var value = prop.GetValue(configuration);
                Console.WriteLine($"   - {prop.Name}: {value}");
            }
        }

        // Call the Update3Async method (for OTP)
        var result = await ApiClient.Update3Async(updateCommand);

        Console.WriteLine($"API Response Success: {result?.Success}");
        Console.WriteLine($"API Message: {result?.Message}");

        if (result?.Success == true && result.Data != null)
        {
            successMessage = result.Message ?? "OTP configuration updated successfully!";
            Console.WriteLine("OTP configuration updated successfully");
            
            // Update local configuration with new data
            configuration = result.Data;

            // Notify parent component
            await OnOtpConfigurationUpdated.InvokeAsync(result.Data);
            
            // Close modal after a brief delay to show success message
            await Task.Delay(1500);
            await otpConfigEditModal.CloseModal();
        }
        else
        {
            formError = result?.Message ?? "Failed to update OTP configuration. Please try again.";
            Console.WriteLine($"OTP configuration update failed: {formError}");
            
            // **ADDITIONAL DEBUGGING: Try to get the specific configuration to see its type**
            try 
            {
                Console.WriteLine($"Attempting to get configuration details directly...");
                var configDetails = await ApiClient.OtpProviderConfigurationAsync(configuration.ClientProviderConfigurationId);
                Console.WriteLine($"   - Direct API call success: {configDetails?.Success}");
                if (configDetails?.Data != null)
                {
                    Console.WriteLine($"   - Direct API data type: {configDetails.Data.GetType().Name}");
                }
            }
            catch (Exception debugEx)
            {
                Console.WriteLine($"Direct API call failed: {debugEx.Message}");
            }
        }
    }
    catch (ApiException ex)
    {
        formError = $"Server error ({ex.StatusCode}): {ex.Message}";
        Console.WriteLine($"API Exception: {ex}");
        Console.WriteLine($"API Response: {ex.Response}");
        
        // **SPECIFIC FIX ATTEMPT: The error suggests the ID might be for a different configuration type**
        // Let's check if we should be using a different update method
        Console.WriteLine($"POSSIBLE FIX: The configuration ID might be for a different provider type.");
        Console.WriteLine($"Try checking if this configuration exists in other provider type lists.");
    }
    catch (Exception ex)
    {
        formError = $"Error updating OTP configuration: {ex.Message}";
        Console.WriteLine($"Exception: {ex}");
        Console.WriteLine($"Stack Trace: {ex.StackTrace}");
    }
    
    StateHasChanged();
}

    private bool ValidateForm()
    {
        var isValid = true;

        // Validate Description
        if (string.IsNullOrWhiteSpace(description))
        {
            descriptionError = "Description is required";
            isValid = false;
        }
        else if (description.Length > 200)
        {
            descriptionError = "Description cannot exceed 200 characters";
            isValid = false;
        }
        else
        {
            descriptionError = string.Empty;
        }

        // Validate required credentials
        // credentialErrors.Clear();
        // foreach (var credType in availableCredentialTypes)
        // {
        //     var credentialValue = credentials.ContainsKey(credType.CredentialTypeName) 
        //         ? credentials[credType.CredentialTypeName] 
        //         : string.Empty;
        //
        //     // Check if this credential is required but empty
        //     if (string.IsNullOrWhiteSpace(credentialValue))
        //     {
        //         credentialErrors[credType.CredentialTypeName] = $"{credType.DisplayName} is required";
        //         isValid = false;
        //     }
        // }

        return isValid;
    }

    private string GetCredentialError(string credentialTypeName)
    {
        return credentialErrors.ContainsKey(credentialTypeName) ? credentialErrors[credentialTypeName] : string.Empty;
    }

    private void OnDescriptionInput(ChangeEventArgs e)
    {
        descriptionError = string.Empty;
        formError = string.Empty;
        successMessage = string.Empty;
        
        var value = e.Value?.ToString() ?? string.Empty;
        description = value;
        
        if (string.IsNullOrWhiteSpace(value))
        {
            descriptionError = "Description is required";
        }
        else if (value.Length > 200)
        {
            descriptionError = "Description cannot exceed 200 characters";
        }
        
        StateHasChanged();
    }

    private void OnCredentialInput(string credentialTypeName, ChangeEventArgs e)
    {
        formError = string.Empty;
        successMessage = string.Empty;
        
        var value = e.Value?.ToString() ?? string.Empty;
        if (!string.IsNullOrEmpty(credentialTypeName))
        {
            credentials[credentialTypeName] = value;
            
            // Clear error for this credential when user starts typing
            if (credentialErrors.ContainsKey(credentialTypeName))
            {
                credentialErrors.Remove(credentialTypeName);
            }
        }
        
        StateHasChanged();
    }

    private string GetCredentialValue(string credentialTypeName)
    {
        if (string.IsNullOrEmpty(credentialTypeName))
            return string.Empty;
            
        return credentials.ContainsKey(credentialTypeName) ? credentials[credentialTypeName] : string.Empty;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("OtpProviderConfigurationEditModal component rendered");
        }
    }
}