@page "/providers/{ProviderTypeName}"
@rendermode InteractiveServer
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.ModalFields
@using NovaAccounts.Components.Layout
@layout MainLayout

@inject ApiClient ApiClient
@inject NavigationManager NavigationManager

@* Provider Modals *@
<ProviderCreateModal @ref="providerCreateModal" OnProviderCreated="HandleProviderCreated" />
<ProviderEditModal @ref="providerEditModal" OnProviderUpdated="HandleProviderUpdated"/>

<div class="container-fluid mt-4">
    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-3 h5">Loading provider type details...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            <h4><i class="fa fa-exclamation-triangle"></i> Error Loading Provider Type</h4>
            <p><strong>@errorMessage</strong></p>
            <button class="btn btn-warning" @onclick="LoadProviderTypeDetails">
                <i class="fa fa-refresh"></i> Retry
            </button>
            <button class="btn btn-secondary ml-2" @onclick="NavigateBack">
                <i class="fa fa-arrow-left"></i> Go Back
            </button>
        </div>
    }
    else if (currentProviderType != null)
    {
        <!-- Page Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <button class="btn btn-outline-secondary mb-2" @onclick="NavigateBack">
                            <i class="fa fa-arrow-left"></i> Back to Providers
                        </button>
                        <h2 class="mb-0">
                            <i class="fa fa-cogs"></i> @currentProviderType.DisplayName Providers
                        </h2>
                        <p class="text-muted mb-0">Provider Management & Configurations</p>
                    </div>
                    <div>
                        @if (currentProviderType.Active)
                        {
                            <span class="badge badge-success badge-lg">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-danger badge-lg">Inactive</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Provider Type Information Card -->
        <div class="card mb-4">
            <div class="card-header leadBold bg-blue-chambray font-white">
                <h5 class="mb-0"><i class="fa fa-info-circle"></i> Provider Type Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="detail-group">
                            <label class="detail-label text-muted">Provider Type Name:</label>
                            <div class="detail-value font-weight-bold">@currentProviderType.ProviderTypeName</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-group">
                            <label class="detail-label text-muted">Display Name:</label>
                            <div class="detail-value font-weight-bold">@currentProviderType.DisplayName</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-group">
                            <label class="detail-label text-muted">Status:</label>
                            <div class="detail-value">
                                @if (currentProviderType.Active)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Inactive</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Providers Section -->
        <div class="card">
            <div class="card-header leadBold bg-blue-chambray font-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="icon-settings"></i> 
                        @currentProviderType.DisplayName Providers
                        @if (providers?.Any() == true)
                        {
                            <span class="badge badge-light ml-2">@providers.Count</span>
                        }
                    </h5>
                    <button class="btn btn-primary" @onclick="OpenCreateProvider" title="Add New Provider">
                        <i class="fa fa-plus"></i> Add Provider
                    </button>
                </div>
            </div>
            <div class="card-body">
                @if (isLoadingProviders)
                {
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2">Loading providers...</p>
                    </div>
                }
                else if (providers?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Provider Code</th>
                                    <th>Provider Name</th>
                                    <th>Description</th>
                                    <th>URL</th>
                                    <th>Status</th>
                                    <th>Created Date</th>
                                    <th style="width: 100px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var provider in providers)
                                {
                                    <tr>
                                        <td>
                                            <strong>@provider.Code</strong>
                                        </td>
                                        <td>
                                            <strong>@provider.Name</strong>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(provider.Description))
                                            {
                                                <div>@provider.Description</div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No description</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(provider.Url))
                                            {
                                                <a href="@provider.Url" target="_blank" class="text-primary" title="@provider.Url">
                                                    <i class="fa fa-external-link"></i> Link
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No URL</span>
                                            }
                                        </td>
                                        <td>
                                            @if (provider.IsActive)
                                            {
                                                <span class="badge badge-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <small>@provider.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    @onclick="() => OpenEditProvider(provider.ProviderId)"
                                                    title="Edit Provider">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i>
                        No providers found for this provider type.
                        <button class="btn btn-sm btn-primary ml-2" @onclick="OpenCreateProvider">
                            <i class="fa fa-plus"></i> Create First Provider
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .detail-group {
        margin-bottom: 1rem;
    }

    .detail-label {
        font-weight: 600;
        font-size: 0.875rem;
        margin-bottom: 0.25rem;
    }

    .detail-value {
        font-size: 1rem;
    }

    .badge-lg {
        font-size: 1rem;
        padding: 0.5rem 1rem;
    }

    .table td {
        vertical-align: middle;
    }

    .card-header h5 {
        margin: 0;
    }
</style>

@code {
    [Parameter]
    public string ProviderTypeName { get; set; } = string.Empty;

    private ProviderCreateModal providerCreateModal = null!;
    private ProviderEditModal providerEditModal = null!;
    
    private ProviderTypeViewModel? currentProviderType;
    private List<ProviderViewModel> providers = new();
    private bool isLoading = false;
    private bool isLoadingProviders = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadProviderTypeDetails();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadProviderTypeDetails();
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/providers", forceLoad:true);
    }

    private async Task LoadProviderTypeDetails()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            Console.WriteLine($"Loading provider type details: {ProviderTypeName}");

            // First, load all provider types to get the current one
            var providerTypesResult = await ApiClient.All5Async();

            if (providerTypesResult?.Success == true && providerTypesResult.Data != null)
            {
                currentProviderType = providerTypesResult.Data
                    .FirstOrDefault(pt => pt.ProviderTypeName == ProviderTypeName);
                
                if (currentProviderType != null)
                {
                    Console.WriteLine($"Loaded provider type: {currentProviderType.DisplayName}");

                    // Now load providers for this provider type
                    await LoadProviders();
                }
                else
                {
                    errorMessage = $"Provider type '{ProviderTypeName}' not found.";
                    Console.WriteLine($"Provider type not found: {ProviderTypeName}");
                }
            }
            else
            {
                errorMessage = providerTypesResult?.Message ?? "Failed to load provider types.";
                Console.WriteLine($"API returned unsuccessful: {errorMessage}");
            }
        }
        catch (ApiException ex)
        {
            errorMessage = $"Server error ({ex.StatusCode}). Please try again.";
            Console.WriteLine($"API Exception: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading provider type details: {ex.Message}";
            Console.WriteLine($"Error loading provider type details: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadProviders()
    {
        try
        {
            isLoadingProviders = true;
            StateHasChanged();

            Console.WriteLine($"Loading providers for type: {ProviderTypeName}");

            // Call the Provider2Async method with the provider type name
            var result = await ApiClient.Provider2Async(ProviderTypeName);

            if (result?.Success == true && result.Data != null)
            {
                providers = result.Data.ToList();
                Console.WriteLine($"Loaded {providers.Count} providers for type: {ProviderTypeName}");
            }
            else
            {
                Console.WriteLine($"No providers loaded: {result?.Message}");
                providers = new List<ProviderViewModel>();
            }
        }
        catch (ApiException ex)
        {
            Console.WriteLine($"API Exception loading providers: {ex.Message}");
            providers = new List<ProviderViewModel>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading providers: {ex.Message}");
            providers = new List<ProviderViewModel>();
        }
        finally
        {
            isLoadingProviders = false;
            StateHasChanged();
        }
    }

    // Action methods for providers
    private async Task OpenCreateProvider()
    {
        if (currentProviderType != null && providerCreateModal != null)
        {
            await providerCreateModal.OpenModalWithProviderType(currentProviderType.ProviderTypeName);
        }
    }

    private async Task OpenEditProvider(Guid providerId)
    {
        if (providerEditModal != null)
        {
            await providerEditModal.OpenModal(providerId);
        }
    }

    // Event handlers for provider operations
    private async Task HandleProviderCreated(ProviderViewModel createdProvider)
    {
        Console.WriteLine($"Provider created: {createdProvider.Name}");
        await LoadProviders();
    }

    private async Task HandleProviderUpdated(UpdateProviderDto updatedProvider)
    {
        Console.WriteLine($"Provider updated: {updatedProvider.Name}");
        await LoadProviders();
    }
}