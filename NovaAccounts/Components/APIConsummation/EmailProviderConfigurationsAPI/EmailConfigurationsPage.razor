<script>

    // Add these to your existing JavaScript
    window.viewEmailConfiguration = function(configId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('ViewEmailConfiguration', configId)
                .catch(err => {
                    console.error('Error calling ViewEmailConfiguration:', err);
                });
        } else {
            console.error('DotNet reference not available');
        }
    };

    window.editEmailConfiguration = function (configId) {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('EditEmailConfiguration', configId)
                .catch(err => {
                    console.error('Error calling EditEmailConfiguration:', err);
                });
        } else {
            console.error('DotNet reference not available for editEmailConfiguration');
        }
    };

    window.createNewEmailConfiguration = function () {
        if (window.dotNetReference) {
            window.dotNetReference.invokeMethodAsync('CreateNewEmailConfiguration')
                .catch(err => {
                    console.error('Error calling CreateNewEmailConfiguration:', err);
                });
        } else {
            console.error('DotNet reference not available for createNewEmailConfiguration');
        }
    };

    window.testEmailConfiguration = function (configId) {
        console.log('Test Email Configuration:', configId);
        // You can implement test functionality here
        alert('Test functionality for configuration: ' + configId);
    };
</script>