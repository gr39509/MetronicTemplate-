    {
        Console.WriteLine("📝 CreateNewEmailConfiguration called from JavaScript");
        
        if (emailConfigCreateModal == null)
        {
            Console.WriteLine("❌ emailConfigCreateModal is null");
            return;
        }
    
        await emailConfigCreateModal.OpenModal();
