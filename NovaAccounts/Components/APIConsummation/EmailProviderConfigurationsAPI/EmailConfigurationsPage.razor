@page "/email-configurations"
@using Microsoft.AspNetCore.Authorization
@using NovaAccounts.SharedModels.DataFields
@using NovaAccounts.Components.Layout
@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@inject ApiClient ApiClient
@layout MainLayout

<PageTitle>Email Configurations</PageTitle>

@* Modals *@
<EmailProviderConfigurationCreateModal @ref="emailConfigCreateModal" OnEmailConfigurationCreated="HandleEmailConfigurationCreated" />
@* <EmailProviderConfigurationEditModal @ref="emailConfigEditModal" OnEmailConfigurationUpdated="HandleEmailConfigurationUpdated" /> *@
@* <EmailProviderConfigurationDetailsModal @ref="emailConfigDetailsModal" /> *@

<h1 class="page-title">
    Email Provider Configurations
    <small>Manage email service provider configurations</small>
</h1>

<!-- Loading State -->
@if (isLoading)
{
    <div class="portlet light bordered">
        <div class="portlet-body text-center" style="padding: 50px 0;">
            <div class="spinner-border text-primary" role="status">
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-3">Loading email configurations...</p>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" @onclick="@(() => errorMessage = string.Empty)">
            <span>&times;</span>
        </button>
        <strong>Error!</strong> @errorMessage
        <button class="btn btn-sm btn-warning" @onclick="LoadEmailConfigurations" style="margin-left: 10px;">
            <i class="fa fa-refresh"></i> Retry
        </button>
    </div>
}
else
{
    <div class="portlet">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-envelope font-dark"></i>
                <span class="caption-subject bold uppercase">Email Configurations</span>
            </div>
            <div class="actions">
                <button class="btn btn-circle btn-icon-only btn-default" @onclick="LoadEmailConfigurations" title="Refresh">
                    <i class="fa fa-refresh"></i>
                </button>
                <button class="btn btn-circle btn-icon-only btn-default" @onclick="CreateNewEmailConfiguration" title="Add New Configuration">
                    <i class="fa fa-plus"></i>
                </button>
            </div>
        </div>
        <div class="portlet-body">
            <ReusableDataTable TItem="EmailClientProviderConfigurationViewModel"
                               Data="@emailConfigurations"
                               Columns="@emailConfigColumns"
                               Options="@emailConfigOptions"
                               />
        </div>
    </div>
}

