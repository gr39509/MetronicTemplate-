@*     private void ValidateCredential(string credentialTypeName, string value) *@
@*     { *@
@*         credentialErrors.Remove(credentialTypeName); *@
@* *@
@*         if (IsCredentialRequired(credentialTypeName)) *@
@*         { *@
@*             // Only API_KEY is required - validate it strictly *@
@*             if (string.IsNullOrWhiteSpace(value)) *@
@*             { *@
@*                 credentialErrors[credentialTypeName] = $"{credentialTypeName} is required"; *@
@*             } *@
@*             else if (value.Length < 3) *@
@*             { *@
@*                 credentialErrors[credentialTypeName] = $"{credentialTypeName} must be at least 3 characters long"; *@
@*             } *@
@*             else if (value.Length > 500) *@
@*             { *@
@*                 credentialErrors[credentialTypeName] = $"{credentialTypeName} cannot exceed 500 characters"; *@
@*             } *@
@*             else if (ContainsInvalidCharacters(value)) *@
@*             { *@
@*                 credentialErrors[credentialTypeName] = $"{credentialTypeName} contains invalid characters"; *@
@*             } *@
@*         } *@
@*         else *@
@*         { *@
@*             // All other credentials are optional - only validate if provided *@
@*             if (!string.IsNullOrWhiteSpace(value)) *@
@*             { *@
