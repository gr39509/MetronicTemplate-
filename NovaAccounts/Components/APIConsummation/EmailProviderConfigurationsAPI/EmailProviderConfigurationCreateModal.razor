@using NovaAccounts.Components.Shared
@using NovaAccounts.SharedModels.ApiService
@using NovaAccounts.SharedModels.ModalFields
@using NovaAccounts.SharedModels.QuickNav
@inject ApiClient ApiClient

@* <ReusableQuickNav NavItems="@navigationItems"  *@
@*                   NavId="emailConfigNav"  *@
@*                   ActiveUrl="@currentUrl" /> *@

<ReusableModal @ref="emailConfigCreateModal"
               Title="Create Email Provider Configuration"
               TriggerButtonText=""
               ShowTriggerButton="false"
               Size="ModalSize.Large"
               TitleFontSize="1.2rem"
               TitleColor="#007bff"
               BodyFontSize="0.95rem"
               HeaderClass="leadBold bg-blue-chambray font-white"
               BodyColor="#333"
               ShowSaveButton="true"
               SaveButtonText="Create Configuration"
               OnSave="@CreateEmailConfiguration"
               ShowCancelButton="true"
               CancelButtonText="Cancel">

    <BodyContent>
        @if (isLoadingClients || isLoadingProviders)
        {
            <div class="text-center p-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2">Loading data...</p>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Client *</label>
                        <select class="form-control @(string.IsNullOrEmpty(clientError) ? "" : "is-invalid")" 
                                value="@selectedClientIdString"
                                @onchange="HandleClientChange">
                            <option value="">-- Select Client --</option>
                            @foreach (var client in clients)
                            {
                                <option value="@client.ClientId">@client.Name (@client.Identifier)</option>
                            }
                        </select>
                        @if (!string.IsNullOrEmpty(clientError))
                        {
                            <div class="invalid-feedback">@clientError</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email Provider *</label>
                        <select class="form-control @(string.IsNullOrEmpty(providerError) ? "" : "is-invalid")" 
                                value="@selectedProviderIdString"
                                @onchange="HandleProviderChange">
                            <option value="">-- Select Email Provider --</option>
                            @foreach (var provider in emailProviders)
                            {
                                <option value="@provider.ProviderId">@provider.Name</option>
                            }
                        </select>
                        @if (!string.IsNullOrEmpty(providerError))
                        {
                            <div class="invalid-feedback">@providerError</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description *</label>
                        <input class="form-control @(string.IsNullOrEmpty(descriptionError) ? "" : "is-invalid")" 
                               @bind="description" 
                               @oninput="OnDescriptionInput"
                               placeholder="Enter configuration description" />
                        @if (!string.IsNullOrEmpty(descriptionError))
                        {
                            <div class="invalid-feedback">@descriptionError</div>
                        }
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" @bind="isDefault" />
                        <label class="form-check-label">Set as default configuration</label>
                        <small class="form-text text-muted d-block">This configuration will be used when no specific configuration is selected</small>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">From Email Address</label>
                        <input class="form-control @(string.IsNullOrEmpty(emailFromError) ? "" : "is-invalid")" 
                               @bind="emailFrom" 
                               @oninput="OnEmailFromInput"
                               placeholder="e.g., noreply@company.com" />
                        @if (!string.IsNullOrEmpty(emailFromError))
                        {
                            <div class="invalid-feedback">@emailFromError</div>
                        }
                        <small class="form-text text-muted">The email address that will appear as the sender</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">From Name</label>
                        <input class="form-control @(string.IsNullOrEmpty(emailFromNameError) ? "" : "is-invalid")" 
                               @bind="emailFromName" 
                               @oninput="OnEmailFromNameInput"
                               placeholder="e.g., Company Name" />
                        <small class="form-text text-muted">The display name that will appear as the sender</small>
                    </div>

                   
                    <!-- Credentials Section -->
                    <div class="card mt-3">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Provider Credentials</h5>
                            <small class="text-muted">Add required credentials for the selected provider</small>
                        </div>
                        <div class="card-body">
                            @if (availableCredentialTypes.Any())
                            {
                                @foreach (var credType in availableCredentialTypes)
                                {
                                    <div class="mb-2">
                                        <label class="form-label">@credType.DisplayName</label>
                                        <input type="password" 
                                               class="form-control" 
                                               placeholder="Enter @credType.DisplayName"
                                               value="@GetCredentialValue(credType.CredentialTypeName)"
                                               @oninput="@(e => OnCredentialInput(credType.CredentialTypeName, e))" />
                                        <small class="form-text text-muted">@credType.CredentialTypeName</small>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">Select a provider to see required credentials</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success mt-3">
                    <strong>Success!</strong> @successMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(formError))
            {
                <div class="alert alert-danger mt-3">
                    <strong>Error!</strong> @formError
                </div>
            }
        }
    </BodyContent>
</ReusableModal>

@code {
    private string currentUrl = "/email-configurations";
    private ReusableModal emailConfigCreateModal = null!;
    
    private List<NavBarItem> navigationItems = new();

    // Data collections
    private List<ClientViewModel> clients = new();
    private List<ProviderViewModel> emailProviders = new();
    private List<CredentialTypeViewModel> availableCredentialTypes = new();

    // Form fields
    private string selectedClientIdString = string.Empty;
    private string selectedProviderIdString = string.Empty;
    private Guid? selectedClientId = null;
    private Guid? selectedProviderId = null;
    private string description = string.Empty;
    private string emailFrom = string.Empty;
    private string emailFromName = string.Empty;
    private bool isDefault = false;
    private Dictionary<string, string> credentials = new();

    // Validation errors
    private string clientError = string.Empty;
    private string providerError = string.Empty;
    private string descriptionError = string.Empty;
    private string emailFromError = string.Empty;
    private string emailFromNameError = string.Empty;
    private string formError = string.Empty;
    private string successMessage = string.Empty;

    // Loading states
    private bool isLoadingClients = false;
    private bool isLoadingProviders = false;

    [Parameter] public EventCallback<EmailClientProviderConfigurationViewModel> OnEmailConfigurationCreated { get; set; }

    protected override async Task OnInitializedAsync()
    {
        navigationItems = new()
        {
            new NavBarItem
            {
                Text = "Create Email Configuration",
                Url = "/email-configurations",
                IconClass = "icon-envelope",
                OnClick = async () => await OpenModal(),
                PreventNavigation = true
            },
            new NavBarItem
            {
                Text = "View Configurations",
                Url = "/email-configurations",
                IconClass = "icon-list"
            }
        };

        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        await LoadClients();
        await LoadEmailProviders();
    }

    private async Task LoadClients()
    {
        try
        {
            isLoadingClients = true;
            StateHasChanged();

            var result = await ApiClient.AllAsync();
            if (result?.Success == true && result.Data != null)
            {
                clients = result.Data.ToList();
                Console.WriteLine($"Loaded {clients.Count} clients");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading clients: {ex.Message}");
        }
        finally
        {
            isLoadingClients = false;
            StateHasChanged();
        }
    }

    private async Task LoadEmailProviders()
    {
        try
        {
            isLoadingProviders = true;
            StateHasChanged();

            // Get email providers (providerType = "Email")
            var result = await ApiClient.Provider2Async("Email");
            if (result?.Success == true && result.Data != null)
            {
                emailProviders = result.Data.ToList();
                Console.WriteLine($"Loaded {emailProviders.Count} email providers");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading email providers: {ex.Message}");
        }
        finally
        {
            isLoadingProviders = false;
            StateHasChanged();
        }
    }

    private async Task LoadCredentialTypes()
    {
        try
        {
            var result = await ApiClient.All2Async();
            if (result?.Success == true && result.Data != null)
            {
                availableCredentialTypes = result.Data.Where(ct => ct.Active).ToList();
                Console.WriteLine($"Loaded {availableCredentialTypes.Count} credential types");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading credential types: {ex.Message}");
        }
    }

    public async Task OpenModal()
    {
        // Reset form fields and messages
        selectedClientIdString = string.Empty;
        selectedProviderIdString = string.Empty;
        selectedClientId = null;
        selectedProviderId = null;
        description = string.Empty;
        emailFrom = string.Empty;
        emailFromName = string.Empty;
        isDefault = false;
        credentials.Clear();
        
        clientError = string.Empty;
        providerError = string.Empty;
        descriptionError = string.Empty;
        emailFromError = string.Empty;
        emailFromNameError = string.Empty;
        formError = string.Empty;
        successMessage = string.Empty;

        // Load credential types when opening modal
        await LoadCredentialTypes();

        if (emailConfigCreateModal != null)
        {
            await emailConfigCreateModal.OpenModal();
        }
    }
    
    
    public async Task OpenModalWithClient(string clientIdentifier)
    {
        // Reset form first
        await OpenModal();
    
        // Find and pre-select the client
        var client = clients.FirstOrDefault(c => c.Identifier == clientIdentifier);
        if (client != null)
        {
            selectedClientId = client.ClientId;
            selectedClientIdString = client.ClientId.ToString();
            StateHasChanged();
        }
    }
    

    private void HandleClientChange(ChangeEventArgs e)
    {
        clientError = string.Empty;
        formError = string.Empty;
        successMessage = string.Empty;
        
        var value = e.Value?.ToString();
        selectedClientIdString = value ?? string.Empty;
        
        if (string.IsNullOrEmpty(value))
        {
            selectedClientId = null;
        }
        else
        {
            selectedClientId = Guid.Parse(value);
        }
        
        StateHasChanged();
    }

    private void HandleProviderChange(ChangeEventArgs e)
    {
        providerError = string.Empty;
        formError = string.Empty;
        successMessage = string.Empty;
        
        var value = e.Value?.ToString();
        selectedProviderIdString = value ?? string.Empty;
        
        if (string.IsNullOrEmpty(value))
        {
            selectedProviderId = null;
        }
        else
        {
            selectedProviderId = Guid.Parse(value);
        }
        
        StateHasChanged();
    }

    private void OnDescriptionInput(ChangeEventArgs e)
    {
        descriptionError = string.Empty;
        formError = string.Empty;
        successMessage = string.Empty;
        
        var value = e.Value?.ToString() ?? string.Empty;
        description = value;
        
        if (string.IsNullOrWhiteSpace(value))
        {
            descriptionError = "Description is required";
        }
        else if (value.Length > 200)
        {
            descriptionError = "Description cannot exceed 200 characters";
        }
        
        StateHasChanged();
    }

    private void OnEmailFromInput(ChangeEventArgs e)
    {
        emailFromError = string.Empty;
        formError = string.Empty;
        successMessage = string.Empty;
        
        var value = e.Value?.ToString() ?? string.Empty;
        emailFrom = value;
        
        if (!string.IsNullOrWhiteSpace(value) && !IsValidEmail(value))
        {
            emailFromError = "Please enter a valid email address";
        }
        
        StateHasChanged();
    }

    private void OnEmailFromNameInput(ChangeEventArgs e)
    {
        emailFromNameError = string.Empty;
        formError = string.Empty;
        successMessage = string.Empty;
        
        var value = e.Value?.ToString() ?? string.Empty;
        emailFromName = value;
        
        StateHasChanged();
    }

    private void OnCredentialInput(string credentialTypeName, ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        credentials[credentialTypeName] = value;
        
        StateHasChanged();
    }

    private string GetCredentialValue(string credentialTypeName)
    {
        return credentials.ContainsKey(credentialTypeName) ? credentials[credentialTypeName] : string.Empty;
    }

    private async Task CreateEmailConfiguration()
    {
        try
        {
            formError = string.Empty;
            successMessage = string.Empty;
            
            var isValid = ValidateForm();
            
            if (!isValid)
            {
                formError = "Please fix the validation errors before creating the configuration.";
                return;
            }

            Console.WriteLine($"Creating email configuration for client: {selectedClientId}");
            
            var client = clients.FirstOrDefault(c => c.ClientId == selectedClientId);
            if (client == null)
            {
                formError = "Selected client not found.";
                return;
            }

            var clientProviderCredentials = credentials
                .Where(kvp => !string.IsNullOrWhiteSpace(kvp.Value))
                .Select(kvp => new CreateClientProviderCredentialDto
                {
                    CredentialTypeName = kvp.Key,
                    CredentialKey = kvp.Value
                })
                .ToList();

            // Create the configuration DTO
            var createCommand = new CreateEmailProviderConfigurationDto
            {
                ClientIdentifier = client.Identifier,
                Description = description.Trim(),
                ProviderId = selectedProviderId.Value,
                ClientProviderCredentials = clientProviderCredentials,
                IsDefault = isDefault,
                EmailFrom = string.IsNullOrWhiteSpace(emailFrom) ? null : emailFrom.Trim(),
                EmailFromName = string.IsNullOrWhiteSpace(emailFromName) ? null : emailFromName.Trim()
            };

            Console.WriteLine("Calling Create2Async...");

            // Call the Create2Async method
            var result = await ApiClient.Create2Async(createCommand);

            Console.WriteLine($"API Response Success: {result?.Success}");
            Console.WriteLine($"API Message: {result?.Message}");

            if (result?.Success == true && result.Data != null)
            {
                successMessage = result.Message ?? "Email configuration created successfully!";
                Console.WriteLine("Email configuration created successfully");
                
                ResetForm();
                await OnEmailConfigurationCreated.InvokeAsync(result.Data);
                await emailConfigCreateModal.CloseModal();
            }
            else
            {
                formError = result?.Message ?? "Failed to create email configuration. Please try again.";
                Console.WriteLine($"Email configuration creation failed: {formError}");
            }
        }
        // catch (ApiException<ApiErrorResponse> apiEx)
        // {
        //     formError = apiEx.Result?.ErrorMessage ?? $"API Error: {apiEx.Message}";
        //     Console.WriteLine($"API Exception Details: {apiEx}");
        //     Console.WriteLine($"Status Code: {apiEx.StatusCode}");
        // }
        catch (ApiException ex)
        {
            formError = $"Server error ({ex.StatusCode}): {ex.Message}";
            Console.WriteLine($"API Exception: {ex}");
        }
        catch (Exception ex)
        {
            formError = $"Error creating email configuration: {ex.Message}";
            Console.WriteLine($"Exception: {ex}");
        }
        
        StateHasChanged();
    }

    private bool ValidateForm()
    {
        var isValid = true;

        // Validate Client
        if (!selectedClientId.HasValue)
        {
            clientError = "Please select a client";
            isValid = false;
        }
        else
        {
            clientError = string.Empty;
        }

        // Validate Provider
        if (!selectedProviderId.HasValue)
        {
            providerError = "Please select an email provider";
            isValid = false;
        }
        else
        {
            providerError = string.Empty;
        }

        if (string.IsNullOrWhiteSpace(description))
        {
            descriptionError = "Description is required";
            isValid = false;
        }
        else if (description.Length > 200)
        {
            descriptionError = "Description cannot exceed 200 characters";
            isValid = false;
        }
        else
        {
            descriptionError = string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(emailFrom) && !IsValidEmail(emailFrom))
        {
            emailFromError = "Please enter a valid email address";
            isValid = false;
        }
        else
        {
            emailFromError = string.Empty;
        }

        return isValid;
    }

    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return false;

        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }

    private void ResetForm()
    {
        selectedClientIdString = string.Empty;
        selectedProviderIdString = string.Empty;
        selectedClientId = null;
        selectedProviderId = null;
        description = string.Empty;
        emailFrom = string.Empty;
        emailFromName = string.Empty;
        isDefault = false;
        credentials.Clear();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("EmailProviderConfigurationCreateModal component rendered");
        }
    }
}