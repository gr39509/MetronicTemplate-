@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop

<style>
    .bootstrap-select .dropdown-menu {
        text-align: left !important;
    }

    .bootstrap-select .dropdown-menu li a {
        text-align: left !important;
    }
</style>

<div class="form-group row mb-3">
    <label class="@LabelClass">@Label</label>
    <div class="@InputClass">
        <select @ref="selectElement" 
                class="form-control selectpicker @CssClass" 
                name="@Name"
                id="@Id"
                multiple="@Multiple"
                required="@Required"
                data-live-search="@LiveSearch.ToString().ToLower()"
                data-size="@Size"
                title="@Placeholder"
                data-selected-text-format="@SelectedTextFormat"
                data-dropdown-align-right="false"
                @onchange="OnChangeHandler">
            @if (Options != null)
            {
                @foreach (var option in Options)
                {
                    <option value="@option.Value" 
                            selected="@option.Selected"
                            disabled="@option.Disabled"
                            data-subtext="@option.Subtext"
                            data-icon="@option.Icon">
                        @option.Text
                    </option>
                }
            }
        </select>
    </div>
</div>

@code {
    private ElementReference selectElement;
    private IJSObjectReference? jsModule;

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    // Parameters
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public string Placeholder { get; set; } = "--SELECT--";
    [Parameter] public List<SelectOption> Options { get; set; } = new();
    [Parameter] public bool LiveSearch { get; set; } = true;
    [Parameter] public int Size { get; set; } = 5;
    [Parameter] public bool Multiple { get; set; } = false;
    [Parameter] public string SelectedTextFormat { get; set; } = "count > 2";
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public string LabelClass { get; set; } = "col-md-4 col-form-label text-md-right";
    [Parameter] public string InputClass { get; set; } = "col-md-8";
    [Parameter] public EventCallback<string?> OnValueChanged { get; set; }
    [Parameter] public EventCallback<List<string>?> OnMultipleValueChanged { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public List<string>? Values { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeSelectPicker();
        }
    }

    private async Task InitializeSelectPicker()
    {
        jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import", "./bootstrapSelectInterop.js");
        
        await jsModule.InvokeVoidAsync("initializeSelectPicker", selectElement);

        // Set initial value(s) if provided
        if (!string.IsNullOrEmpty(Value))
        {
            await SetValue(Value);
        }
        else if (Values != null && Values.Any())
        {
            await SetValues(Values);
        }
    }

    private async Task OnChangeHandler(ChangeEventArgs e)
    {
        if (Multiple)
        {
            var values = await GetValues();
            await OnMultipleValueChanged.InvokeAsync(values);
        }
        else
        {
            var value = e.Value?.ToString();
            await OnValueChanged.InvokeAsync(value);
        }
    }

    // Public methods
    public async Task<string?> GetValue()
    {
        if (jsModule != null)
        {
            return await jsModule.InvokeAsync<string?>("getSelectValue", selectElement);
        }
        return null;
    }

    public async Task<List<string>?> GetValues()
    {
        if (jsModule != null)
        {
            return await jsModule.InvokeAsync<List<string>?>("getSelectValues", selectElement);
        }
        return null;
    }

    public async Task SetValue(string value)
    {
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("setSelectValue", selectElement, value);
        }
    }

    public async Task SetValues(List<string> values)
    {
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("setSelectValues", selectElement, values);
        }
    }

    public async Task Refresh()
    {
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("refreshSelectPicker", selectElement);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule != null)
        {
            await jsModule.DisposeAsync();
        }
    }
}


@code {
    public class SelectOption
    {
        public string Value { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
        public string? Subtext { get; set; }
        public string? Icon { get; set; }
        public bool Selected { get; set; } = false;
        public bool Disabled { get; set; } = false;
    }
}

