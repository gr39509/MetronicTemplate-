@using Microsoft.AspNetCore.Components
@using NovaAccounts.Models.QuickNav

<nav class="quick-nav">
    <a class="quick-nav-trigger" href="#0">
        <span aria-hidden="true"></span>
    </a>
    <ul id="@NavId">
        @if (NavItems != null)
        {
            @foreach (var item in NavItems)
            {
                <li>
                    <a href="@item.Url" class="@GetNavItemClass(item)">
                        <span>@item.Text</span>
                        @if (!string.IsNullOrEmpty(item.IconClass))
                        {
                            <i class="@item.IconClass"></i>
                        }
                    </a>
                </li>
            }
        }
    </ul>
    <span aria-hidden="true" class="quick-nav-bg"></span>
</nav>
<div class="quick-nav-overlay"></div>

@code {
    [Parameter] public List<NavItem> NavItems { get; set; } = new();
    [Parameter] public string NavId { get; set; } = "myNav";
    [Parameter] public string ActiveUrl { get; set; } = string.Empty;

    private string GetNavItemClass(NavItem item)
    {
        return item.Url == ActiveUrl || item.IsActive ? "active" : "";
    }

}

<script src="@Assets["/assets/layouts/global/scripts/quick-nav.js"]" type="text/javascript"></script>
<style>
    a {
        text-decoration: none;
        line-height: 50px;
        font-size: 1.4rem;
    }
   
</style>