<style>

    li.nav-item.open:has(li.active) > a {
        position: relative;
        background: #36c6d3;
        border-top-color: transparent;
        color: #fff;
    }
    li.nav-item.open:has(li.active) > a::after{
        content: "";
        display: block;
        float: right;
        position: absolute;
        right: 0;
        top: 8px;
        background: 0 0;
        width: 0;
        height: 0;
        border-top: 12px solid transparent;
        border-bottom: 12px solid transparent;
        border-right: 12px solid #fff;
    }
    

    li.nav-item.start.active, li.nav-item.start.active > a{
        background: #36c6d3;
        border-top-color: transparent;
        color: #fff;
    }
    li.nav-item.open:has(li.active) .arrow::before, li.nav-item.open:has(li.active) .sidebar-nav-icon{
        color: #fff !important;
    }
</style>