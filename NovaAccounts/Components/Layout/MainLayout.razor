<script>
    // Enhanced Blazor circuit recovery
    (function () {
        const maxRetries = 3;
        let retryCount = 0;

        function setupBlazorReconnection() {
            if (window.Blazor && Blazor.defaultReconnectionHandler) {
                const originalOnConnectionDown = Blazor.defaultReconnectionHandler.onConnectionDown;
                const originalOnConnectionUp = Blazor.defaultReconnectionHandler.onConnectionUp;
                const originalOnConnectionFailed = Blazor.defaultReconnectionHandler._onConnectionFailed;

                Blazor.defaultReconnectionHandler.onConnectionDown = function () {
                    console.log('🔴 Blazor circuit disconnected');
                    originalOnConnectionDown.call(this);
                };

                Blazor.defaultReconnectionHandler.onConnectionUp = function () {
                    console.log('🟢 Blazor circuit reconnected');
                    retryCount = 0;
                    originalOnConnectionUp.call(this);
                };

                // Enhanced reconnection logic
                Blazor.defaultReconnectionHandler._onConnectionFailed = function () {
                    console.log(`🔄 Reconnection attempt ${retryCount + 1}/${maxRetries}`);
                    
                    if (retryCount < maxRetries) {
                        retryCount++;
                        setTimeout(() => {
                            if (Blazor.reconnect) {
                                Blazor.reconnect();
                            }
                        }, 3000 * retryCount); // Exponential backoff
                    } else {
                        console.log('❌ Max reconnection attempts reached, reloading page');
                        window.location.reload();
                    }
                };
            }
        }

        // Initialize when Blazor is ready
        if (window.Blazor) {
            setupBlazorReconnection();
        } else {
            window.addEventListener('load', setupBlazorReconnection);
        }

        // Monitor circuit health
        setInterval(() => {
            if (window.Blazor && Blazor.circuit && Blazor.circuit.connected) {
                console.log('✅ Circuit healthy');
            }
        }, 30000);
    })();
</script>

