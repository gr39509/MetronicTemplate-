@page "/"
@layout EmptyLayout
@using Microsoft.Extensions.Options
@inject AuthService Auth
@inject IOptions<ContactOptions> ContactSettings
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Nova Nsawa · Ghana's funeral donation platform</PageTitle>
<HeadContent>
    <meta name="description" content="Nova Nsawa helps Ghanaian families manage funeral donations by cash, mobile money and card, with real-time tracking. Free for cash collections." />
    <meta property="og:title" content="Nova Nsawa · Ghana's funeral donation platform" />
    <meta property="og:description" content="Manage funeral donations through cash, mobile money and cards with complete transparency. Free for cash collections." />
    <meta property="og:image" content="images/landing/hero-mourners.jpg" />
    <meta property="og:locale" content="en_GH" />
</HeadContent>

<div class="landing" @ref="_root">
    <header class="nav">
        <div class="wrap nav__inner">
            <a class="nav__logo" href="/" aria-label="Nova Nsawa home"><img src="icons/Logo.jpg" alt="Nova Nsawa" width="170" height="29" /></a>
            <nav class="nav__links" aria-label="Page sections">
                <a href="#packages">Packages</a>
                <a href="#features">Features</a>
                <a href="#how">How it works</a>
                <a href="#contact">Contact</a>
            </nav>
            <div class="nav__actions">
                @if (_signedIn)
                {
                    <Button Href="/home" Icon="dashboard">Go to dashboard</Button>
                }
                else
                {
                    <Button Href="/login" Variant="ghost">Sign in</Button>
                    <Button Href="/register">Sign up free</Button>
                }
            </div>
        </div>
    </header>

    <main>
        @* Hero: a real funeral in Ghana, not a stock gradient. *@
        <section class="hero">
            <img class="hero__photo" src="images/landing/hero-mourners.jpg" alt="" width="1305" height="1151" fetchpriority="high" />
            <div class="wrap hero__inner">
                <div class="hero__copy">
                    <span class="eyebrow">Ghana's funeral donation platform</span>
                    <h1>Receive every donation. Account for every cedi.</h1>
                    <p class="lead">
                        Nova Nsawa brings cash, mobile money and card donations for a funeral into one place,
                        tracked as they arrive, so the family can focus on saying goodbye.
                    </p>
                    <div class="hero__cta">
                        @if (_signedIn)
                        {
                            <Button Href="/home" Size="lg" Icon="dashboard">Go to dashboard</Button>
                            <Button Href="/create-event" Size="lg" Variant="secondary" Icon="plus">Create an event</Button>
                        }
                        else
                        {
                            <Button Href="/register" Size="lg">Sign up for free</Button>
                            <Button Href="#packages" Size="lg" Variant="secondary" Class="btn--glass">See packages</Button>
                        }
                    </div>
                    <p class="hero__note"><Icon Name="check" Size="16" />Free for cash collections. No card needed to sign up.</p>
                </div>
            </div>
        </section>

        <section class="values" aria-label="Why families choose Nova Nsawa">
            <div class="wrap values__grid">
                <div class="value" data-reveal style="--i:0">
                    <span class="value__icon"><Icon Name="receipt" /></span>
                    <div>
                        <h2>Comprehensive</h2>
                        <p>Track every donation with detailed reporting, so the family sees exactly what was given.</p>
                    </div>
                </div>
                <div class="value" data-reveal style="--i:1">
                    <span class="value__icon"><Icon Name="clock" /></span>
                    <div>
                        <h2>Efficient</h2>
                        <p>Less time with notebooks and counting, more time for what matters during a difficult week.</p>
                    </div>
                </div>
                <div class="value" data-reveal style="--i:2">
                    <span class="value__icon"><Icon Name="heart" /></span>
                    <div>
                        <h2>Worldwide</h2>
                        <p>Family abroad can give by card, and everyone at home by mobile money or cash at the event.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="section" aria-labelledby="about-title">
            <div class="wrap split">
                <div class="split__copy" data-reveal>
                    <span class="eyebrow">About Nova Nsawa</span>
                    <h2 id="about-title">Simplify funeral donations with a platform built for Ghana</h2>
                    <p>
                        Funeral donations come from everywhere: envelopes at the gate, MoMo from relatives in Kumasi,
                        a card payment from a cousin in London. Nova Nsawa records all of them in one secure place, with
                        complete transparency for the family and the funeral committee.
                    </p>
                    <ul class="ticks">
                        <li><Icon Name="check" Size="16" />Web dashboard for the organiser and helpers</li>
                        <li><Icon Name="check" Size="16" />POS and phone collection at the funeral grounds</li>
                        <li><Icon Name="check" Size="16" />A donation link and QR code for every event</li>
                    </ul>
                </div>
                <figure class="split__media" data-reveal style="--i:1">
                    <img src="images/landing/product.jpg" alt="The Nova Nsawa dashboard on a laptop and POS terminal, with cedi notes and payment cards" width="1200" height="591" loading="lazy" />
                </figure>
            </div>
        </section>

        <section class="section section--tint" id="packages" aria-labelledby="packages-title">
            <div class="wrap">
                <div class="section__head section__head--center" data-reveal>
                    <span class="eyebrow">Packages</span>
                    <h2 id="packages-title">Choose how much help you want</h2>
                    <p>Run the collections yourselves, or let our team handle everything while you focus on the family.</p>
                </div>

                <div class="packages">
                    <article class="package package--green" data-reveal style="--i:0">
                        <header class="package__head">
                            <span class="package__badge">Nsawa Green</span>
                            <h3>Self-managed</h3>
                            <p>Full control of your donations with our easy platform. For families who prefer a hands-on approach.</p>
                        </header>
                        <div class="package__price">
                            <strong>Free</strong>
                            <span>for cash collections</span>
                        </div>
                        <ul class="package__list">
                            <li><Icon Name="check" Size="16" />Full access to all platform features</li>
                            <li><Icon Name="check" Size="16" />Cash, mobile money and card collections</li>
                            <li><Icon Name="check" Size="16" /><span><strong>1%</strong> on mobile money, capped at GH₵50</span></li>
                            <li><Icon Name="check" Size="16" /><span><strong>4%</strong> on card transactions</span></li>
                            <li><Icon Name="check" Size="16" />24/7 access and real-time tracking</li>
                        </ul>
                        <Button Href="/register" Block="true" Size="lg">Start with Green</Button>
                    </article>

                    <article class="package package--red" data-reveal style="--i:1">
                        <header class="package__head">
                            <span class="package__badge">Nsawa Red</span>
                            <h3>White-glove service</h3>
                            <p>Our professional team manages every collection for you, from the first announcement to the final report.</p>
                        </header>
                        <div class="package__price">
                            <strong>10%</strong>
                            <span>service fee, capped at GH₵50,000</span>
                        </div>
                        <ul class="package__list">
                            <li><Icon Name="check" Size="16" />We handle all collections for you</li>
                            <li><Icon Name="check" Size="16" />Live monitoring of every transaction</li>
                            <li><Icon Name="check" Size="16" />Dedicated customer support team</li>
                            <li><Icon Name="check" Size="16" />Custom reporting and donor communication</li>
                            <li><Icon Name="check" Size="16" />Priority support throughout the funeral</li>
                        </ul>
                        @if (!string.IsNullOrWhiteSpace(_contact.WhatsApp))
                        {
                            <a class="btn btn--donate btn--lg btn--block" href="@WhatsAppLink("Hello, I'd like to know more about Nsawa Red.")" target="_blank" rel="noopener">
                                <Icon Name="phone" Size="16" />Talk to our team
                            </a>
                        }
                        else
                        {
                            <a class="btn btn--donate btn--lg btn--block" href="#contact"><Icon Name="phone" Size="16" />Talk to our team</a>
                        }
                    </article>
                </div>

                <div class="compare" data-reveal>
                    <div class="table-wrap">
                        <table class="compare__table">
                            <caption class="sr-only">What each package includes</caption>
                            <thead>
                                <tr><th scope="col">Included</th><th scope="col">Green</th><th scope="col">Red</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Comparison)
                                {
                                    <tr>
                                        <th scope="row">@row.Feature</th>
                                        <td>@Mark(row.Green)</td>
                                        <td>@Mark(row.Red)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="compare__note">
                        Nsawa Red's 10% applies to the total collections it manages, capped at GH₵50,000.
                        @if (!string.IsNullOrWhiteSpace(_contact.TermsUrl))
                        {
                            <a href="@_contact.TermsUrl" target="_blank" rel="noopener">Terms &amp; conditions apply.</a>
                        }
                        else
                        {
                            <span>Terms &amp; conditions apply.</span>
                        }
                    </p>
                </div>
            </div>
        </section>

        <section class="section" id="features" aria-labelledby="features-title">
            <div class="wrap">
                <div class="section__head" data-reveal>
                    <span class="eyebrow">Features</span>
                    <h2 id="features-title">Everything the funeral committee needs</h2>
                </div>
                <div class="features-layout">
                    <figure class="features-layout__media" data-reveal>
                        <img src="images/landing/qr-funeral.jpg" alt="Mourners in red and black cloth seated at a funeral, beside a large donation QR code" width="1200" height="591" loading="lazy" />
                    </figure>
                    <div class="features">
                        <article class="feature" data-reveal style="--i:0">
                            <span class="feature__icon"><Icon Name="wallet" /></span>
                            <h3>Smart donation management</h3>
                            <p>Collect and track cash, mobile money and card donations in one list, with totals that update as gifts arrive.</p>
                        </article>
                        <article class="feature" data-reveal style="--i:1">
                            <span class="feature__icon"><Icon Name="qr" /></span>
                            <h3>Instant QR code donations</h3>
                            <p>Print the event's QR code on the programme or a banner. Sympathisers scan it and give from their phones.</p>
                        </article>
                        <article class="feature" data-reveal style="--i:2">
                            <span class="feature__icon"><Icon Name="calendar" /></span>
                            <h3>Complete event management</h3>
                            <p>Run several events, from the one-week observance to the thanksgiving service, each with its own records.</p>
                        </article>
                        <article class="feature" data-reveal style="--i:3">
                            <span class="feature__icon"><Icon Name="external" /></span>
                            <h3>Effortless sharing</h3>
                            <p>Share the donation link on WhatsApp, by SMS or on social media to reach family and friends anywhere.</p>
                        </article>
                        <article class="feature" data-reveal style="--i:4">
                            <span class="feature__icon"><Icon Name="users" /></span>
                            <h3>Groups and helpers</h3>
                            <p>Count gifts by circle, such as Family or Church, and add a Cashier to record donations at the gate.</p>
                        </article>
                        <article class="feature" data-reveal style="--i:5">
                            <span class="feature__icon"><Icon Name="smartphone" /></span>
                            <h3>Every network</h3>
                            <p>MTN MoMo, Telecel Cash and AT Money, plus Visa and Mastercard, with the cash recorded too.</p>
                        </article>
                    </div>
                </div>
            </div>
        </section>

        <section class="photo-band" aria-hidden="true" data-reveal>
            <img src="images/landing/procession.jpg" alt="" width="900" height="599" loading="lazy" />
            <img src="images/landing/pos-at-funeral.jpg" alt="" width="1200" height="591" loading="lazy" />
        </section>

        <section class="section" id="how" aria-labelledby="how-title">
            <div class="wrap">
                <div class="section__head" data-reveal>
                    <span class="eyebrow">How it works</span>
                    <h2 id="how-title">Ready before the one-week observance</h2>
                    <p>Setting up takes a few minutes. You can share the link the same day.</p>
                </div>
                <ol class="steps-row">
                    <li data-reveal style="--i:0">
                        <span class="step-num">1</span>
                        <h3>Create the event</h3>
                        <p>Add the name, dates, venue and a photo. Nsawa gives the event its own code, donation link and QR code.</p>
                    </li>
                    <li data-reveal style="--i:1">
                        <span class="step-num">2</span>
                        <h3>Share the link or QR code</h3>
                        <p>Post the link on WhatsApp and print the QR code on the funeral programme or a banner at the venue.</p>
                    </li>
                    <li data-reveal style="--i:2">
                        <span class="step-num">3</span>
                        <h3>Receive and withdraw</h3>
                        <p>Donations appear as they happen. When you're ready, send the balance to a mobile money wallet you have verified.</p>
                    </li>
                </ol>
            </div>
        </section>

        <section class="section section--tint" id="donors" aria-labelledby="donors-title">
            <div class="wrap donors">
                <div class="donors__copy" data-reveal>
                    <span class="eyebrow">For donors</span>
                    <h2 id="donors-title">Giving takes under a minute</h2>
                    <p>Donors don't download an app or create an account. They open the link or scan the QR code and follow four short steps.</p>
                    <ol class="donor-steps">
                        <li><strong>Enter their mobile money number.</strong> We text them a 4-digit code.</li>
                        <li><strong>Type the code</strong> to confirm the number is theirs.</li>
                        <li><strong>Choose an amount and network</strong>, add a message to the family, or give anonymously.</li>
                        <li><strong>Approve the payment</strong> on their phone.</li>
                    </ol>
                </div>
                <aside class="trust" data-reveal style="--i:1">
                    <span class="trust__icon"><Icon Name="shield" Size="22" /></span>
                    <h3>Nsawa never asks for a PIN</h3>
                    <p>Donors approve every payment themselves on their own phone, through their mobile money provider. Nsawa never sees or stores a PIN.</p>
                </aside>
            </div>
        </section>

        <section class="section" id="faq" aria-labelledby="faq-title">
            <div class="wrap faq-wrap">
                <div class="section__head" data-reveal>
                    <span class="eyebrow">Questions</span>
                    <h2 id="faq-title">Common questions</h2>
                </div>
                <div class="faq" data-reveal>
                    <details>
                        <summary>How much does Nova Nsawa cost?</summary>
                        <p>Creating an account is free, and cash collections are free. With Nsawa Green, mobile money donations carry a 1% fee capped at GH₵50, and card payments 4%. Nsawa Red is a 10% service fee on collections we manage, capped at GH₵50,000.</p>
                    </details>
                    <details>
                        <summary>Do donors need an account?</summary>
                        <p>No. They only need a mobile money number. A 4-digit code sent by text confirms the number before they give.</p>
                    </details>
                    <details>
                        <summary>Can we record cash given at the funeral?</summary>
                        <p>Yes. You or a Cashier you add can record cash and cheque donations on the event's Receive donation page, so every gift is in one list.</p>
                    </details>
                    <details>
                        <summary>How do we get the money?</summary>
                        <p>Open the event's Withdraw tab, verify the mobile money wallet, and send any amount up to the available balance. Service fees are already taken off the balance you see.</p>
                    </details>
                    <details>
                        <summary>Can someone give without showing their name?</summary>
                        <p>Yes. Donors can switch on "Give anonymously" and the family will see the gift as Anonymous.</p>
                    </details>
                </div>
            </div>
        </section>

        <section class="closing">
            <img class="closing__photo" src="images/landing/family.jpg" alt="" width="1356" height="668" loading="lazy" />
            <div class="wrap closing__inner" data-reveal>
                <div>
                    <h2>Let us carry the collections</h2>
                    <p>Create your account in a few minutes and share your donation link the same day.</p>
                </div>
                <div class="closing__cta">
                    @if (_signedIn)
                    {
                        <Button Href="/create-event" Size="lg" Icon="plus">Create an event</Button>
                    }
                    else
                    {
                        <Button Href="/register" Size="lg">Sign up for free</Button>
                        <Button Href="/login" Size="lg" Variant="secondary" Class="btn--glass">Sign in</Button>
                    }
                </div>
            </div>
        </section>

        @if (_contact.Any)
        {
            <section class="section" id="contact" aria-labelledby="contact-title">
                <div class="wrap">
                    <div class="section__head" data-reveal>
                        <span class="eyebrow">Contact</span>
                        <h2 id="contact-title">We're here to help</h2>
                        <p>Call, email or chat with us on WhatsApp. We'll help you set up or run the collections.</p>
                    </div>
                    <div class="contact">
                        @if (_contact.Address.Count > 0)
                        {
                            <div class="contact__card" data-reveal style="--i:0">
                                <span class="contact__icon"><Icon Name="map-pin" /></span>
                                <h3>Visit us</h3>
                                <address>
                                    @foreach (var line in _contact.Address)
                                    {
                                        <span>@line</span>
                                    }
                                </address>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_contact.Phone))
                        {
                            <div class="contact__card" data-reveal style="--i:1">
                                <span class="contact__icon"><Icon Name="phone" /></span>
                                <h3>Call us</h3>
                                <a class="contact__main" href="@Tel(_contact.Phone)">@_contact.Phone</a>
                                @foreach (var phone in _contact.OtherPhones)
                                {
                                    <a href="@Tel(phone)">@phone</a>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_contact.Email) || !string.IsNullOrWhiteSpace(_contact.WhatsApp))
                        {
                            <div class="contact__card" data-reveal style="--i:2">
                                <span class="contact__icon"><Icon Name="info" /></span>
                                <h3>Write to us</h3>
                                @if (!string.IsNullOrWhiteSpace(_contact.Email))
                                {
                                    <a class="contact__main" href="mailto:@_contact.Email">@_contact.Email</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(_contact.WhatsApp))
                                {
                                    <a class="btn btn--primary contact__wa" href="@WhatsAppLink("Hello Nova Nsawa, I have a question.")" target="_blank" rel="noopener">
                                        <Icon Name="smartphone" Size="16" />Chat on WhatsApp
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
    </main>

    <footer class="foot">
        <div class="wrap foot__grid">
            <div class="foot__brand">
                <img src="icons/Logo.jpg" alt="Nova Nsawa" width="150" height="25" />
                <p>We make collections for your funeral easy and convenient.</p>
            </div>
            <nav class="foot__col" aria-label="Explore">
                <h2>Explore</h2>
                <a href="#packages">Packages</a>
                <a href="#features">Features</a>
                <a href="#how">How it works</a>
                <a href="#contact">Contact</a>
            </nav>
            <nav class="foot__col" aria-label="Account">
                <h2>Account</h2>
                <a href="/login">Sign in</a>
                <a href="/register">Sign up</a>
            </nav>
            <nav class="foot__col" aria-label="Legal">
                <h2>Legal</h2>
                @if (!string.IsNullOrWhiteSpace(_contact.TermsUrl)) { <a href="@_contact.TermsUrl" target="_blank" rel="noopener">Terms of service</a> }
                @if (!string.IsNullOrWhiteSpace(_contact.PrivacyUrl)) { <a href="@_contact.PrivacyUrl" target="_blank" rel="noopener">Privacy policy</a> }
            </nav>
        </div>
        <div class="wrap foot__bottom">
            <span>© @DateTime.Now.Year Nova Nsawa</span>
            <span>Powered by <a href="https://fnfictsolutions.com/" target="_blank" rel="noopener">F &amp; F ICT Solutions</a></span>
        </div>
    </footer>
</div>

@code {
    private bool _signedIn;
    private ContactOptions _contact = new();
    private ElementReference _root;
    private IJSObjectReference? _reveal;

    private sealed record CompareRow(string Feature, bool Green, bool Red);

    // From the published package comparison on nsawa.vercel.app.
    private static readonly CompareRow[] Comparison =
    [
        new("Free account and platform access", true, true),
        new("Cash collection tracking, no fees on cash", true, true),
        new("Mobile money on MTN, Telecel and AT", true, true),
        new("Visa, Mastercard and debit cards", true, true),
        new("QR code for easy donations", true, true),
        new("Digital receipts", true, true),
        new("Live transaction monitoring", true, true),
        new("Our team manages the collections", false, true),
        new("Priority customer support", false, true),
        new("Custom donor communication", false, true),
        new("Dedicated support team", false, true),
        new("Customised, detailed reporting", false, true)
    ];

    protected override async Task OnInitializedAsync()
    {
        _contact = ContactSettings.Value;
        _signedIn = await Auth.IsAuthenticatedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _reveal = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reveal.js");
            await _reveal.InvokeVoidAsync("init", _root);
        }
        catch (JSException) { /* The page is fully readable without the effect. */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_reveal is null) return;
        try
        {
            await _reveal.InvokeVoidAsync("dispose", _root);
            await _reveal.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }

    private static RenderFragment Mark(bool included) => included
        ? @<span class="mark mark--yes"><Icon Name="check" Size="16" /><span class="sr-only">Included</span></span>
        : @<span class="mark mark--no"><span aria-hidden="true">–</span><span class="sr-only">Not included</span></span>;

    private static string Tel(string phone) => "tel:+" + Format.DigitsOnly(phone);

    private string WhatsAppLink(string message) =>
        $"https://wa.me/{Format.DigitsOnly(_contact.WhatsApp)}?text={Uri.EscapeDataString(message)}";
}
