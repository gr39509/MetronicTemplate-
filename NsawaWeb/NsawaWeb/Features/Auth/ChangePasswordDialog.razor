@inject AccountService Account
@inject ToastService Toasts

<Dialog Open="Open" Title="Change password" Subtitle="Use at least 6 characters. You'll stay signed in." Busy="_saving" OnClose="Close">
    <ChildContent>
        <Alert Message="@_error" />
        <form id="change-password" class="form" @onsubmit="Save" novalidate>
            <Field Label="Current password" For="cp-current" Error="@_errors["current"]">
                <PasswordInput Id="cp-current" @bind-Value="_current" Invalid="@(_errors.Has("current"))" />
            </Field>
            <Field Label="New password" For="cp-new" Error="@_errors["new"]">
                <PasswordInput Id="cp-new" @bind-Value="_new" Autocomplete="new-password" Invalid="@(_errors.Has("new"))" />
            </Field>
            <Field Label="Confirm new password" For="cp-confirm" Error="@_errors["confirm"]">
                <PasswordInput Id="cp-confirm" @bind-Value="_confirm" Autocomplete="new-password" Invalid="@(_errors.Has("confirm"))" />
            </Field>
        </form>
    </ChildContent>
    <Footer>
        <Button Variant="secondary" Disabled="_saving" OnClick="Close">Cancel</Button>
        <Button Type="submit" form="change-password" Loading="_saving">Change password</Button>
    </Footer>
</Dialog>

@code {
    private readonly FormErrors _errors = new();
    private string? _current, _new, _confirm, _error;
    private bool _saving;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    protected override void OnParametersSet()
    {
        if (!Open)
        {
            _current = _new = _confirm = _error = null;
            _errors.Clear();
        }
    }

    private async Task Save()
    {
        _error = null;
        _errors.Clear();
        _errors.Check(string.IsNullOrWhiteSpace(_current), "current", "Enter your current password.")
               .Check(string.IsNullOrWhiteSpace(_new), "new", "Enter a new password.")
               .Check((_new?.Length ?? 0) is > 0 and < 6, "new", "Use at least 6 characters.")
               .Check(string.IsNullOrWhiteSpace(_confirm), "confirm", "Type the new password again.")
               .Check(!string.IsNullOrEmpty(_confirm) && _confirm != _new, "confirm", "The passwords don't match.");
        if (_errors.Any) return;

        _saving = true;
        var result = await Account.ChangePasswordAsync(_current!, _new!, _confirm!);
        _saving = false;

        if (result.Failed)
        {
            _error = result.Message;
            return;
        }

        Toasts.Success("Password changed.");
        await Close();
    }

    private Task Close() => OpenChanged.InvokeAsync(false);
}
