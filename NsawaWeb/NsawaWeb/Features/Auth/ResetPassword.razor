@page "/admin/resetpassword"
@layout AuthLayout
@inject AccountService Account
@inject ToastService Toasts
@inject NavigationManager Navigation

<PageTitle>Set a new password · Nova Nsawa</PageTitle>

<div class="auth__panel">
    <img class="auth__mobile-logo" src="icons/Logo.jpg" alt="Nova Nsawa" width="170" height="29" />

    @if (_linkId is null)
    {
        <EmptyState Icon="alert" Title="This link is invalid or has expired"
                    Text="Password links can only be used once and stop working after a while. Ask Nova Nsawa support for a new link, or sign in if you remember your password.">
            <Action>
                <Button Href="/" Variant="secondary">Go to sign in</Button>
            </Action>
        </EmptyState>
    }
    else
    {
        <div class="auth__heading">
            <h2>Set a new password</h2>
            <p>Choose a password you haven't used here before. You'll sign in with it next.</p>
        </div>

        <Alert Message="@_error" />

        <form class="form" @onsubmit="SetPassword" novalidate>
            <Field Label="New password" For="reset-password" Error="@_errors["password"]">
                <PasswordInput Id="reset-password" @bind-Value="_password" Autocomplete="new-password" Invalid="@(_errors.Has("password"))" />
            </Field>
            <Field Label="Confirm new password" For="reset-confirm" Error="@_errors["confirm"]">
                <PasswordInput Id="reset-confirm" @bind-Value="_confirm" Autocomplete="new-password" Invalid="@(_errors.Has("confirm"))" />
            </Field>

            <ul class="checklist" aria-label="Password requirements">
                <li class="@(LongEnough ? "met" : "")">
                    <Icon Name="@(LongEnough ? "check-circle" : "check")" Size="14" />
                    At least 6 characters
                    <span class="sr-only">@(LongEnough ? "(done)" : "(not yet)")</span>
                </li>
                <li class="@(Matches ? "met" : "")">
                    <Icon Name="@(Matches ? "check-circle" : "check")" Size="14" />
                    Passwords match
                    <span class="sr-only">@(Matches ? "(done)" : "(not yet)")</span>
                </li>
            </ul>

            <Button Type="submit" Size="lg" Block="true" Loading="_busy">Save new password</Button>
        </form>

        <p class="auth__alt">Remembered it? <a href="/">Sign in</a></p>
    }
</div>

@code {
    private readonly FormErrors _errors = new();
    private string? _password, _confirm, _error;
    private Guid? _linkId;
    private bool _busy;

    [SupplyParameterFromQuery(Name = "id")] public string? Id { get; set; }

    private bool LongEnough => (_password?.Length ?? 0) >= 6;
    private bool Matches => !string.IsNullOrEmpty(_password) && _password == _confirm;

    private string? _parsedId = "\0";

    protected override void OnParametersSet()
    {
        // Only re-parse when the link itself changes, so an "expired" answer isn't undone by a re-render.
        if (Id == _parsedId) return;
        _parsedId = Id;
        _linkId = Guid.TryParse(Id, out var id) && id != Guid.Empty ? id : null;
    }

    private async Task SetPassword()
    {
        if (_linkId is not { } linkId) return;

        _error = null;
        _errors.Clear();
        _errors.Check(string.IsNullOrEmpty(_password), "password", "Choose a new password.")
               .Check(!LongEnough, "password", "Use at least 6 characters.")
               .Check(string.IsNullOrEmpty(_confirm), "confirm", "Type the new password again.")
               .Check(!Matches, "confirm", "The passwords don't match.");
        if (_errors.Any) return;

        _busy = true;
        var result = await Account.SetNewPasswordAsync(linkId, _password!, _confirm!);
        _busy = false;

        if (result.Failed)
        {
            if (result.Message?.Contains("expired", StringComparison.OrdinalIgnoreCase) == true)
            {
                _linkId = null;
                return;
            }
            _error = result.Message;
            return;
        }

        Toasts.Success("Password saved. Sign in with your new password.");
        Navigation.NavigateTo("/");
    }
}
