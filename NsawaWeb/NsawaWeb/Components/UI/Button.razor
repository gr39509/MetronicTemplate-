@* Primary action element. Renders a link when Href is set. *@
@if (Href is not null && !Disabled)
{
    <a href="@Href" class="@CssClass" @attributes="AdditionalAttributes">
        @if (Icon is not null) { <NsawaWeb.Components.UI.Icon Name="@Icon" Size="@IconSize" /> }
        @ChildContent
    </a>
}
else
{
    <button type="@Type" class="@CssClass" disabled="@(Disabled || Loading)" aria-busy="@(Loading ? "true" : null)"
            @onclick="HandleClick" @attributes="AdditionalAttributes">
        @if (Loading)
        {
            <span class="spinner" aria-hidden="true"></span>
        }
        else if (Icon is not null)
        {
            <NsawaWeb.Components.UI.Icon Name="@Icon" Size="@IconSize" />
        }
        @ChildContent
    </button>
}

@code {
    [Parameter] public string Variant { get; set; } = "primary";   // primary | secondary | ghost | danger
    [Parameter] public string? Size { get; set; }                  // sm | lg
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Block { get; set; }
    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private int IconSize => Size == "sm" ? 14 : 16;

    private string CssClass =>
        $"btn btn--{Variant}{(Size is null ? "" : $" btn--{Size}")}{(Block ? " btn--block" : "")}{(IconOnly ? " btn--icon" : "")} {Class}".TrimEnd();

    private Task HandleClick(MouseEventArgs e) => OnClick.HasDelegate ? OnClick.InvokeAsync(e) : Task.CompletedTask;
}
