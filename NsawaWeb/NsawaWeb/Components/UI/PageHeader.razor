<header class="page-header">
    <div class="page-header__text">
        @if (BackHref is not null)
        {
            <a class="back-link" href="@BackHref"><Icon Name="chevron-left" Size="16" />@BackLabel</a>
        }
        @if (Eyebrow is not null)
        {
            <span class="page-header__eyebrow">@Eyebrow</span>
        }
        <h1 class="page-header__title">@Title</h1>
        @if (Subtitle is not null)
        {
            <p class="page-header__subtitle">@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="page-header__actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public string BackLabel { get; set; } = "Back";
    [Parameter] public RenderFragment? Actions { get; set; }
}
