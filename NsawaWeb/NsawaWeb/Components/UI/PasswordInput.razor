<div class="password">
    <input id="@Id" class="input @(Invalid ? "invalid" : "")" type="@(_visible ? "text" : "password")"
           value="@Value" @oninput="OnInput" autocomplete="@Autocomplete" placeholder="@Placeholder" disabled="@Disabled" />
    <button type="button" class="password__toggle" @onclick="() => _visible = !_visible"
            aria-label="@(_visible ? "Hide password" : "Show password")">
        <Icon Name="@(_visible ? "eye-off" : "eye")" Size="18" />
    </button>
</div>

@code {
    private bool _visible;

    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        return ValueChanged.InvokeAsync(Value);
    }
}
