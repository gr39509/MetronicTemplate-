@using NsawaWeb.Application
@implements IDisposable
@inject ToastService ToastService

<div class="toasts" aria-live="polite">
    @foreach (var toast in ToastService.Items)
    {
        <div class="toast toast--@toast.Kind.ToString().ToLowerInvariant()" role="@(toast.Kind == ToastKind.Error ? "alert" : "status")">
            <Icon Name="@(toast.Kind switch { ToastKind.Success => "check-circle", ToastKind.Error => "alert", _ => "info" })" Size="18" />
            <span class="toast__text">@toast.Message</span>
            <button type="button" class="toast__close" aria-label="Dismiss" @onclick="() => ToastService.Dismiss(toast.Id)"><Icon Name="x" Size="16" /></button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => ToastService.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ToastService.Changed -= OnChanged;
}
