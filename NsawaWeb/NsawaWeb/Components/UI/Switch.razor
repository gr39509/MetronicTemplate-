<label class="switch">
    <input type="checkbox" role="switch" checked="@Value" disabled="@Disabled" @onchange="Changed" />
    <span class="switch__track"></span>
    <span class="switch__text">
        <strong>@Label</strong>
        @if (Description is not null) { <span>@Description</span> }
    </span>
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private async Task Changed(ChangeEventArgs e)
    {
        Value = e.Value is true || e.Value?.ToString() == "true";
        await ValueChanged.InvokeAsync(Value);
    }
}
