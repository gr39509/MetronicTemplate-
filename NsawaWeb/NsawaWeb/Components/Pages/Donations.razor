@page "/events/{eventId:guid}/donations"
@using NsawaWeb.Services.Services
@using System.Net.Http
@using System.Net.Http.Json
@using System.Reflection
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<div class="page-header">
    <button class="btn-back" @onclick="GoBack">← Back to Events</button>
    <h1 class="page-title">Donations</h1>
    @if (canMakeDonation)
    {
        <button class="btn-make-donation" @onclick="GoToDonate">
            + Receive Donation
        </button>
    }
    

</div>

@* @if (!string.IsNullOrEmpty(errorMessage)) *@
@* { *@
@*     <div class="error-alert"> *@
@*         @errorMessage *@
@*     </div> *@
@* } *@

@if (isLoadingSummary)
{
    <div class="loading-container">
        <div class="spinner-grow text-secondary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Loading donation summary...</p>
    </div>
}
else if (donationSummary != null)
{
    <!-- Summary Cards -->
    <div class="summary-grid">
        <div class="summary-card card-green">
            <div class="card-header">
                <span class="card-label">Total Donations</span>
                <img src="icons/Group 1912.svg" alt="" class="card-icon">
            </div>
            <div class="card-value">GH₵ @donationSummary.TotalDonations.ToString("N2")</div>
            <div class="card-count">@donationSummary.DonationsCount donations</div>
        </div>

        <div class="summary-card card-blue">
            <div class="card-header">
                <span class="card-label">Withdrawable Balance</span>
                <img src="icons/wallet.svg" alt="" class="card-icon">
            </div>
            <div class="card-value">GH₵ @donationSummary.WithdrawableBalance.ToString("N2")</div>
        </div>

        <div class="summary-card card-pink">
            <div class="card-header">
                <span class="card-label">Total Withdrawals</span>
                <img src="icons/wallet.svg" alt="" class="card-icon">
            </div>
            <div class="card-value">GH₵ @donationSummary.TotalWithdrawals.ToString("N2")</div>
        </div>

        <div class="summary-card card-yellow">
            <div class="card-header">
                <span class="card-label">Service Fee</span>
                <img src="icons/Group 1912.svg" alt="" class="card-icon">
            </div>
            <div class="card-value">GH₵ @donationSummary.ServiceFee.ToString("N2")</div>
        </div>
    </div>

    <!-- Payment Breakdown -->
    <div class="breakdown-section">
        <h3>Payment Breakdown</h3>
        <div class="breakdown-grid">
            <div class="breakdown-item">
                <span class="breakdown-label">Mobile Wallet</span>
                <span class="breakdown-value">GH₵ @donationSummary.MobileWalletDonations.ToString("N2")</span>
            </div>
            <div class="breakdown-item">
                <span class="breakdown-label">Cash</span>
                <span class="breakdown-value">GH₵ @donationSummary.CashDonations.ToString("N2")</span>
            </div>
            <div class="breakdown-item">
                <span class="breakdown-label">Cheque</span>
                <span class="breakdown-value">GH₵ @donationSummary.ChequeDonations.ToString("N2")</span>
            </div>
        </div>
    </div>
}

<!-- Filters -->
<div class="filters-card">
    <div class="filter-group">
        <label>Start Date</label>
        <input type="date" class="filter-input" @bind="startDate" />
    </div>
    <div class="filter-group">
        <label>End Date</label>
        <input type="date" class="filter-input" @bind="endDate" />
    </div>
    <div class="filter-group">
        <label>Payment Type</label>
        <select class="filter-input" @bind="selectedPaymentType">
            <option value="">All Types</option>
            @if (paymentTypes != null)
            {
                @foreach (var paymentType in paymentTypes)
                {
                    <option value="@paymentType.Name">@paymentType.Name</option>
                }
            }
            
        </select>
    </div>
    <button class="btn-filter" @onclick="ApplyFilters">Apply Filters</button>
    <button class="btn-clear" @onclick="ClearFilters">Clear</button>
</div>

@if (isLoadingDonations)
{
    <div class="loading-container">
        <div class="spinner-grow text-secondary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Loading donations...</p>
    </div>
}
else if (donations == null || !donations.Any())
{
    <div class="no-data">
        <h3>No Donations Found</h3>
        <p>There are no donations matching your criteria.</p>
    </div>
}
else
{
    <div class="table-card">
        <div class="table-header">
            <h3>Donation Records (@donations.Count)</h3>
            @* <button class="btn-export" @onclick="ExportDonations">Export CSV ↗</button> *@
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th>DATE</th>
                    <th>DONOR</th>
                    <th>PHONE</th>
                    <th>AMOUNT</th>
                    <th>PAYMENT TYPE</th>
                    <th>SOURCE</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var donation in donations)
                {
                    <tr>
                        <td>@donation.DateDonated.ToString("MM/dd/yy HH:mm")</td>
                        <td>@(string.IsNullOrEmpty(donation.DonorName) ? "Anonymous" : donation.DonorName)</td>
                        <td>@(string.IsNullOrEmpty(donation.DonorPhoneNumber) ? "N/A" : donation.DonorPhoneNumber)</td>
                        <td class="amount-cell">GH₵ @donation.Amount.ToString("N2")</td>
                        <td>
                            <span class="badge badge-@GetPaymentTypeBadgeClass(donation.PaymentType)">
                                @(string.IsNullOrEmpty(donation.PaymentType) ? "N/A" : donation.PaymentType)
                            </span>
                        </td>
                        <td>@(string.IsNullOrEmpty(donation.Source) ? "Direct" : donation.Source)</td>
                        <td>
                            <button class="btn-view-details" @onclick="() => ViewDonationDetails(donation)">
                                View Details
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Donation Details Modal -->
<div class="donation-modal @(showDetailsModal ? "show" : "")">
    @if (selectedDonation != null)
    {
        <div class="modal-content-wrapper">
            <button class="close-btn" @onclick="CloseDetailsModal">×</button>
            <h2 class="modal-title">Donation Details</h2>
            
            <div class="details-section">
                <div class="detail-row">
                    <span class="detail-label">Donor Name:</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(selectedDonation.DonorName) ? "Anonymous" : selectedDonation.DonorName)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Phone Number:</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(selectedDonation.DonorPhoneNumber) ? "N/A" : selectedDonation.DonorPhoneNumber)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Amount:</span>
                    <span class="detail-value amount-highlight">GH₵ @selectedDonation.Amount.ToString("N2")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Date:</span>
                    <span class="detail-value">@selectedDonation.DateDonated.ToString("MMMM dd, yyyy HH:mm")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Payment Type:</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(selectedDonation.PaymentType) ? "N/A" : selectedDonation.PaymentType)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Payment Method:</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(selectedDonation.PaymentMethod) ? "N/A" : selectedDonation.PaymentMethod)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Payment Provider:</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(selectedDonation.PaymentProvider) ? "N/A" : selectedDonation.PaymentProvider)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Transaction ID:</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(selectedDonation.TransactionId) ? "N/A" : selectedDonation.TransactionId)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Payment Reference:</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(selectedDonation.PaymentReference) ? "N/A" : selectedDonation.PaymentReference)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Source:</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(selectedDonation.Source) ? "Direct" : selectedDonation.Source)</span>
                </div>
                @if (selectedDonation.Group != null)
                {
                    <div class="detail-row">
                        <span class="detail-label">Group:</span>
                        <span class="detail-value">@selectedDonation.Group.GroupName</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selectedDonation.Message))
                {
                    <div class="detail-row message-row">
                        <span class="detail-label">Message:</span>
                        <span class="detail-value">@selectedDonation.Message</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid EventId { get; set; }

    private DonationSummaryViewModel donationSummary;
    private List<DonationViewModel> donations = new();
    private List<PaymentTypeViewModel> paymentTypes = new();
    private DonationViewModel selectedDonation;
    
    private bool isLoadingSummary = true;
    private bool isLoadingDonations = true;
    private bool showDetailsModal = false;
    private string errorMessage = string.Empty;
    
    private EventViewModel currentEvent;
    private bool canMakeDonation = false;

    // Filters
    private DateTime? startDate { get; set; } = DateTime.Today.AddDays(-7);
    private DateTime? endDate { get; set; } = DateTime.Now;
    private string selectedPaymentType = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPaymentTypes();
        await LoadDonationSummary();
        await LoadDonations();
        await LoadEventDetails();
    }

    private async Task LoadPaymentTypes()
    {
        try
        {
            var result = await ApiClient.All3Async();

            if (result.Success && result.Data != null)
            {
                paymentTypes = result.Data.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load payment types: {ex.Message}");
          
        }
    }

    private async Task LoadDonationSummary()
    {
        try
        {
            isLoadingSummary = true;
            errorMessage = string.Empty;

            var result = await ApiClient.DonationSummaryAsync(EventId);

            if (result.Success && result.Data != null)
            {
                donationSummary = result.Data;
            }
            else
            {
                errorMessage = result.Message ?? "Failed to load donation summary.";
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                401 => "You are not authorized. Please log in again.",
                404 => "Event not found.",
                500 => "Server error. Please try again later.",
                _ => $" "
            };
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred while loading summary.";
        }
        finally
        {
            isLoadingSummary = false;
            StateHasChanged();
        }
    }
    
    private async Task LoadEventDetails()
    {
        try
        {
            var affiliateResult = await ApiClient.MyAffiliateEventsAsync();
            
            if (affiliateResult.Success && affiliateResult.Data != null)
            {
                currentEvent = affiliateResult.Data.FirstOrDefault(e => e.Id == EventId);
                
                if (currentEvent != null && currentEvent.AffiliationRoles != null)
                {
                    // Check if user has Cashier role
                    canMakeDonation = currentEvent.AffiliationRoles.Any(role => 
                        role.Equals("Cashier", StringComparison.OrdinalIgnoreCase));
                }
            }
            
            if (currentEvent == null)
            {
                var myEventsResult = await ApiClient.MyEventsAsync();
                
                if (myEventsResult.Success && myEventsResult.Data != null)
                {
                    currentEvent = myEventsResult.Data.FirstOrDefault(e => e.Id == EventId);
                    
                    if (currentEvent != null)
                    {
                        canMakeDonation = true;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            canMakeDonation = false;
        }
    }

    private async Task LoadDonations()
    {
        try
        {
            isLoadingDonations = true;
            errorMessage = string.Empty;

            // Get HttpClient from ApiClient using reflection
            var httpClientField = typeof(ApiClient).GetField("_httpClient", BindingFlags.Public | BindingFlags.Instance);
            var httpClient = httpClientField?.GetValue(ApiClient) as HttpClient;
            
            if (httpClient == null)
            {
                errorMessage = "Unable to access HTTP client.";
                return;
            }

            // Build query parameters
            var queryParams = new List<string>();
            queryParams.Add($"eventId={EventId}");
            
            if (startDate.HasValue)
            {
                var startDateStr = startDate.Value.ToString("yyyy-MM-ddT00:00:00");
                queryParams.Add($"startDate={Uri.EscapeDataString(startDateStr)}");
            }
            
            if (endDate.HasValue)
            {
                var endDateStr = endDate.Value.ToString("yyyy-MM-ddT23:59:59");
                queryParams.Add($"endDate={Uri.EscapeDataString(endDateStr)}");
               
            }
            
            if (!string.IsNullOrEmpty(selectedPaymentType))
            {
                queryParams.Add($"paymentType={Uri.EscapeDataString(selectedPaymentType)}");
            }

            var queryString = string.Join("&", queryParams);
            var url = $"api/Event/Donations?{queryString}";

            var response = await httpClient.GetAsync(url);
            var responseContent = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<DonationViewModelListApiResult>();
                
                if (result?.Success == true && result.Data != null)
                {
                    donations = result.Data.OrderByDescending(d => d.DateDonated).ToList();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to load donations.";
                }
            }
            else
            {
                //errorMessage = $"Server returned error: {response.StatusCode}. {responseContent}";
            }
        }
        catch (Exception ex)
        {
            //errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoadingDonations = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilters()
    {
        await LoadDonations();
    }

    private async Task ClearFilters()
    {
        startDate = null;
        endDate = null;
        selectedPaymentType = string.Empty;
        await LoadDonations();
    }

    private void ViewDonationDetails(DonationViewModel donation)
    {
        selectedDonation = donation;
        showDetailsModal = true;
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedDonation = null;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/my-events");
    }

    private string GetPaymentTypeBadgeClass(string paymentType)
    {
        if (string.IsNullOrEmpty(paymentType))
            return "default";

        var paymentTypeInfo = paymentTypes.FirstOrDefault(pt => 
            pt.Name.Equals(paymentType, StringComparison.OrdinalIgnoreCase));

        if (paymentTypeInfo != null)
        {
            if (paymentTypeInfo.IsMoMo) return "wallet";
            if (paymentTypeInfo.IsCash) return "cash";
            if (paymentTypeInfo.IsCheque) return "cheque";
        }

        return "default";
    }
    
    void GoToDonate()
    {
        Navigation.NavigateTo($"/events/{EventId}/donate");
    }

    private void ExportDonations()
    {
        // TODO: I will implement it if needed
        
    }
}

