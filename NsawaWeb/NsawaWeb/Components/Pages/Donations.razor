    }

    /* Loading & Error States */
    .loading-container {
        text-align: center;
        padding: 40px;
    }

    .no-data {
        text-align: center;
        padding: 60px 20px;
        color: #666;
        background: white;
        border-radius: 15px;
    }

    .no-data h3 {
        font-size: 20px;
        margin-bottom: 10px;
    }

    .error-alert {
        background: #f8d7da;
        border: 1px solid #f5c6cb;
        color: #721c24;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }

        .filters-card {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-group {
            min-width: 100%;
        }

        .btn-filter,
        .btn-clear {
            width: 100%;
        }

        .modal-content-wrapper {
            padding: 30px 20px;
        }

        .detail-row {
            flex-direction: column;
            gap: 5px;
        }

        .detail-value {
            text-align: left;
        }
    }
</style>


