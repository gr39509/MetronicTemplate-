@page "/admin/resetpassword"
@using NsawaWeb.Services.Services
@using Microsoft.AspNetCore.WebUtilities
@using NsawaWeb.Components.Layout
@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@layout AccountLayout

<style>
    
    .btn-reset {
        width: 100%;
        padding: 15px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .btn-reset:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
    }

    .btn-reset:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    .btn-reset i {
        transition: transform 0.3s ease;
    }

    .btn-reset:hover:not(:disabled) i {
        transform: translateX(5px);
    }

    .alert {
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 25px;
        text-align: center;
    }

    .alert-success {
        background-color: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }

    .alert-danger {
        background-color: #fee2e2;
        color: #991b1b;
        border: 1px solid #fca5a5;
    }

    .alert-info {
        background-color: #dbeafe;
        color: #1e40af;
        border: 1px solid #93c5fd;
    }

    .back-link {
        text-align: center;
        margin-top: 30px;
    }

    .back-link a {
        color: #667eea;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s ease;
    }

    .back-link a:hover {
        color: #764ba2;
        text-decoration: underline;
    }

    .password-requirements {
        margin-top: 10px;
        font-size: 14px;
        color: #6c757d;
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid #667eea;
    }

    .password-requirements ul {
        margin: 0;
        padding-left: 20px;
    }

    .password-requirements li {
        margin-bottom: 5px;
    }

    .password-requirements li.valid {
        color: #28a745;
    }

    .password-requirements li.invalid {
        color: #6c757d;
    }

    /* Responsive styles */
    @@media (min-width: 768px) {
        .image-section {
            display: block;
        }
    }

    @@media (max-width: 767px) {
        .content-wrapper {
            flex-direction: column;
            min-height: auto;
        }

        .form-section {
            padding: 30px 20px;
        }

        h2 {
            font-size: 24px;
        }
    }
</style>
<link rel="stylesheet" href="css/login.css"/>
<div class="main-container">
    <div class="content-wrapper">
        <div class="image-section"></div>
        <div class="form-section">
            <div class="logo">
                <span class="logo-nova">NOVA</span><span class="logo-nsawa">NSAWA</span>
            </div>
            
            @if (isSuccess)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle" style="margin-right: 10px;"></i>
                    @successMessage
                </div>
                <div class="back-link">
                    <a href="/">Return to Login</a>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle" style="margin-right: 10px;"></i>
                    @errorMessage
                </div>
                <div class="back-link">
                    <a href="/">Return to Login</a>
                </div>
            }
            else if (isLoading)
            {
                <div class="alert alert-info">
                    <i class="fas fa-spinner fa-spin" style="margin-right: 10px;"></i>
                    Loading...
                </div>
            }
            else if (isInvalidLink)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle" style="margin-right: 10px;"></i>
                    Invalid or expired password reset link. Please request a new password reset.
                </div>
                <div class="back-link">
                    <a href="/">Return to Login</a>
                </div>
            }
            else
            {
                <h2>Set New Password</h2>
                
                <form @onsubmit="HandleSetNewPassword">
                    <div class="form-group">
                        <input type="password" 
                               class="form-control @(validationErrors.ContainsKey("password") ? "is-invalid" : "")" 
                               placeholder="New Password" 
                               @bind="setNewPasswordDto.Password"
                               required />
                        @if (validationErrors.ContainsKey("password"))
                        {
                            <div class="invalid-feedback">@validationErrors["password"]</div>
                        }
                    </div>
                    
                    <div class="form-group">
                        <input type="password" 
                               class="form-control @(validationErrors.ContainsKey("confirmPassword") ? "is-invalid" : "")" 
                               placeholder="Confirm New Password" 
                               @bind="setNewPasswordDto.ConfirmPassword" 
                               @* @bind:event="oninput" *@
                               @* disabled="@isResettingPassword" *@
                               required />
                        @if (validationErrors.ContainsKey("confirmPassword"))
                        {
                            <div class="invalid-feedback">@validationErrors["confirmPassword"]</div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(validationMessage))
                    {
                        <div class="alert alert-info">
                            @validationMessage
                        </div>
                    }

                    <div class="password-requirements">
                        <strong>Password Requirements:</strong>
                        <ul>
                            <li class="@(IsPasswordValidLength ? "valid" : "invalid")">
                                ✓ At least 6 characters long
                            </li>
                            <li class="@(DoPasswordsMatch ? "valid" : "invalid")">
                                ✓ Passwords must match
                            </li>
                        </ul>
                    </div>
                    
                    <button type="submit" class="btn-reset" disabled="@isResettingPassword">
                        @if (isResettingPassword)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                            <span>Setting New Password...</span>
                        }
                        else
                        {
                            <span>Set New Password</span>
                            <i class="fas fa-arrow-right"></i>
                        }
                    </button>
                    
                    <div class="back-link">
                        <a href="/">Back to Login</a>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@code {
    [Inject] private ApiClient? ApiClient { get; set; }
    
    private bool isLoading = true;
    private bool isResettingPassword = false;
    private bool isSuccess = false;
    private bool isInvalidLink = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private string validationMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();
    
    private SetNewPasswordDto setNewPasswordDto = new SetNewPasswordDto
    {
        Id = Guid.Empty,
        Password = string.Empty,
        ConfirmPassword = string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get the ID from the query string
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
            var queryParameters = QueryHelpers.ParseQuery(uri.Query);
            
            if (queryParameters.TryGetValue("id", out var idValue))
            {
                if (Guid.TryParse(idValue, out Guid userId))
                {
                    setNewPasswordDto.Id = userId;
                    isLoading = false;
                }
                else
                {
                    isInvalidLink = true;
                    isLoading = false;
                }
            }
            else
            {
                isInvalidLink = true;
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error processing reset link. Please try again.";
            Console.WriteLine($"Error processing reset link: {ex.Message}");
            isLoading = false;
        }
        
        await base.OnInitializedAsync();
    }

    private bool IsPasswordValidLength => setNewPasswordDto.Password.Length >= 6;
    private bool DoPasswordsMatch => setNewPasswordDto.Password == setNewPasswordDto.ConfirmPassword;

    private async Task HandleSetNewPassword()
    {
        if (isResettingPassword) return;
        
        // Clear previous messages and errors
        successMessage = string.Empty;
        errorMessage = string.Empty;
        validationMessage = string.Empty;
        validationErrors.Clear();
        
        // Validate form
        if (string.IsNullOrWhiteSpace(setNewPasswordDto.Password))
        {
            validationErrors["password"] = "New password is required.";
        }
        else if (setNewPasswordDto.Password.Length < 6)
        {
            validationErrors["password"] = "Password must be at least 6 characters long.";
        }
        
        if (string.IsNullOrWhiteSpace(setNewPasswordDto.ConfirmPassword))
        {
            validationErrors["confirmPassword"] = "Please confirm your new password.";
        }
        else if (setNewPasswordDto.Password != setNewPasswordDto.ConfirmPassword)
        {
            validationErrors["confirmPassword"] = "Passwords do not match.";
        }
        
        if (setNewPasswordDto.Id == Guid.Empty)
        {
            validationMessage = "Invalid reset link. Please request a new password reset.";
            isInvalidLink = true;
            StateHasChanged();
            return;
        }
        
        if (validationErrors.Count > 0)
        {
            StateHasChanged();
            return;
        }
        
        isResettingPassword = true;
        StateHasChanged();
        
        try
        {
            if (ApiClient != null)
            {
                var result = await ApiClient.SetNewPasswordAsync(setNewPasswordDto);
                
                if (result != null && result.Success)
                {
                    isSuccess = true;
                    successMessage = result.Message ?? "Your password has been successfully reset!";
                    
                    // Auto-redirect to login after 3 seconds
                    await Task.Delay(3000);
                    NavigationManager.NavigateTo("/", true);
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to reset password. The link may have expired.";
                    isInvalidLink = result?.Message?.Contains("expired", StringComparison.OrdinalIgnoreCase) ?? false;
                }
            }
            else
            {
                errorMessage = "API client is not available.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            Console.WriteLine($"Error setting new password: {ex.Message}");
        }
        finally
        {
            isResettingPassword = false;
            StateHasChanged();
        }
    }
}