@page "/events/{EventId:guid}/groups"
@using NsawaWeb.Services.Services
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<div class="groups-header">
    <button class="back-btn" @onclick="GoBack">← Back to Event</button>
    <h1 class="page-title">Event Groups</h1>
    <button class="create-btn" @onclick="OpenCreateModal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Add Group
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-alert">
        @errorMessage
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="success-alert">
        @successMessage
    </div>
}

@if (isLoading)
{
    <div class="loading-container">
        <div class="spinner-grow text-secondary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Loading groups...</p>
    </div>
}
else if (groups == null || !groups.Any())
{
    <div class="no-groups">
        <h3>No Groups Found</h3>
        <p>This event doesn't have any groups yet. Create one to organize donations.</p>
    </div>
}
else
{
    <div class="groups-grid">
        @foreach (var group in groups)
        {
            <div class="group-card">
                <div class="group-header">
                    <div class="group-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <div class="group-info">
                        <h3 class="group-name">@group.GroupName</h3>
                        <div class="group-status">
                            <span class="status-badge @(group.IsActive ? "active" : "inactive")">
                                @(group.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="group-details">
                    <div class="detail-row">
                        <svg class="detail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>Created @group.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(group.CreatedBy))
                    {
                        <div class="detail-row">
                            <svg class="detail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <span>Created by @group.CreatedBy</span>
                        </div>
                    }
                </div>

                <div class="action-buttons">
                    <button class="btn-edit" @onclick="() => OpenEditModal(group)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                        Edit
                    </button>
                    <button class="btn-delete" @onclick="() => ConfirmDelete(group)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                        Delete
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- Create Group Modal -->
<div class="create-modal @(showCreateModal ? "show" : "")">
    <div class="modal-content-create">
        <div class="modal-header">
            <h2>Add New Group</h2>
            <button class="close-btn" @onclick="CloseCreateModal">×</button>
        </div>

        @if (!string.IsNullOrEmpty(createErrorMessage))
        {
            <div class="modal-alert error-alert">
                @createErrorMessage
            </div>
        }

        <div class="modal-body">
            <div class="form-group">
                <label class="required">Group Name</label>
                <input type="text" class="form-input" @bind="newGroup.GroupName" 
                       placeholder="Enter group name (e.g., Family, Friends, Church)" />
                @if (!string.IsNullOrEmpty(validationErrors?.GroupName))
                {
                    <span class="validation-error">@validationErrors.GroupName</span>
                }
            </div>

            <div class="info-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <p>Groups help you organize and categorize donations for your event. You can assign donations to specific groups for better tracking.</p>
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn-cancel" @onclick="CloseCreateModal">Cancel</button>
            <button class="create-btn-submit" @onclick="CreateGroup" disabled="@isCreating">
                @if (isCreating)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Creating...</span>
                }
                else
                {
                    <span>Create Group</span>
                }
            </button>
        </div>
    </div>
</div>

<!-- Edit Group Modal -->
<div class="edit-modal @(showEditModal ? "show" : "")">
    <div class="modal-content-edit">
        <div class="modal-header">
            <h2>Edit Group</h2>
            <button class="close-btn" @onclick="CloseEditModal">×</button>
        </div>

        @if (!string.IsNullOrEmpty(editErrorMessage))
        {
            <div class="modal-alert error-alert">
                @editErrorMessage
            </div>
        }

        @if (editingGroup != null)
        {
            <div class="modal-body">
                <div class="form-group">
                    <label class="required">Group Name</label>
                    <input type="text" class="form-input" @bind="editingGroup.GroupName" 
                           placeholder="Enter group name" />
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseEditModal">Cancel</button>
                <button class="btn-save" @onclick="SaveGroup" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="delete-modal @(showDeleteModal ? "show" : "")">
    <div class="modal-content-delete">
        <div class="delete-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
        </div>
        <h2>Delete Group</h2>
        <p>Are you sure you want to delete <strong>@groupToDelete?.GroupName</strong>? This action cannot be undone.</p>
        <div class="modal-footer">
            <button class="btn-cancel" @onclick="CancelDelete">Cancel</button>
            <button class="btn-delete-confirm" @onclick="DeleteGroup" disabled="@isDeleting">
                @if (isDeleting)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Deleting...</span>
                }
                else
                {
                    <span>Delete</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid EventId { get; set; }

    private List<EventGroupViewModel> groups = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    // Create modal state
    private bool showCreateModal = false;
    private CreateGroupModel newGroup = new();
    private bool isCreating = false;
    private string createErrorMessage = string.Empty;
    private ValidationErrors validationErrors;

    // Edit modal state
    private bool showEditModal = false;
    private UpdateEventGroupDto editingGroup;
    private bool isSaving = false;
    private string editErrorMessage = string.Empty;

    // Delete modal state
    private bool showDeleteModal = false;
    private EventGroupViewModel groupToDelete;
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadGroups();
    }

    private async Task LoadGroups()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var result = await ApiClient.PerEventAsync(EventId);

            if (result.Success && result.Data != null)
            {
                groups = result.Data.OrderByDescending(g => g.CreatedAt).ToList();
            }
            else
            {
                errorMessage = result.Message ?? "Failed to load groups.";
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                401 => "You are not authorized. Please log in again.",
                404 => "Event not found.",
                500 => "Server error. Please try again later.",
                _ => $"An error occurred while loading groups. (Error code: {apiEx.StatusCode})"
            };
            Console.WriteLine($"API Error: {apiEx.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred while loading groups.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenCreateModal()
    {
        newGroup = new CreateGroupModel();
        validationErrors = null;
        createErrorMessage = string.Empty;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
        newGroup = new CreateGroupModel();
        validationErrors = null;
        createErrorMessage = string.Empty;
    }

    private async Task CreateGroup()
    {
        validationErrors = new ValidationErrors();
        bool isValid = true;

        // Validation
        if (string.IsNullOrWhiteSpace(newGroup.GroupName))
        {
            validationErrors.GroupName = "Group name is required.";
            isValid = false;
        }

        if (!isValid)
        {
            StateHasChanged();
            return;
        }

        try
        {
            isCreating = true;
            createErrorMessage = string.Empty;
            successMessage = string.Empty;

            var dto = new CreateEventGroupDto
            {
                EventId = EventId,
                GroupName = newGroup.GroupName
            };
            

            var result = await ApiClient.Create2Async(dto);

            if (result != null && result.Success)
            {
                successMessage = result.Message ?? "Group created successfully!";
                CloseCreateModal();
                await LoadGroups();

                // Clear success message after 3 seconds
                await Task.Delay(3000);
                successMessage = string.Empty;
                StateHasChanged();
            }
            else
            {
                createErrorMessage = result?.Message ?? "Failed to create group.";
            }
        }
        catch (ApiException apiEx)
        {

            createErrorMessage = apiEx.StatusCode switch
            {
                400 => "Invalid data. Please check your input.",
                401 => "You are not authorized to create groups.",
                404 => "Event not found.",
                409 => "A group with this name already exists for this event.",
                422 => "Validation failed. Please check all fields.",
                500 => "Server error. Please try again later.",
                _ => $"An error occurred while creating group. (Error code: {apiEx.StatusCode})"
            };
        }
        catch (Exception ex)
        {
            createErrorMessage = "An unexpected error occurred while creating group.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isCreating = false;
            StateHasChanged();
        }
    }

    private void OpenEditModal(EventGroupViewModel group)
    {
        editingGroup = new UpdateEventGroupDto
        {
            GroupId = group.Id,
            EventId = group.Id, // Assuming EventId is stored or you can track it
            GroupName = group.GroupName
        };

        editErrorMessage = string.Empty;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingGroup = null;
        editErrorMessage = string.Empty;
    }

    private async Task SaveGroup()
    {
        if (editingGroup == null) return;

        // Validation
        if (string.IsNullOrWhiteSpace(editingGroup.GroupName))
        {
            editErrorMessage = "Group name is required.";
            return;
        }

        try
        {
            isSaving = true;
            editErrorMessage = string.Empty;
            successMessage = string.Empty;

            // Set the EventId from the page parameter
            editingGroup.EventId = EventId;

            var result = await ApiClient.UpdatePOSTAsync(editingGroup);

            if (result != null && result.Success)
            {
                successMessage = "Group updated successfully!";
                CloseEditModal();
                await LoadGroups();

                // Clear success message after 3 seconds
                await Task.Delay(3000);
                successMessage = string.Empty;
                StateHasChanged();
            }
            else
            {
                editErrorMessage = result?.Message ?? "Failed to update group.";
            }
        }
        catch (ApiException apiEx)
        {
            editErrorMessage = apiEx.StatusCode switch
            {
                400 => "Invalid data. Please check your inputs.",
                401 => "You are not authorized to update this group.",
                404 => "Group not found.",
                500 => "Server error. Please try again later.",
                _ => $"An error occurred while updating group. (Error code: {apiEx.StatusCode})"
            };
            Console.WriteLine($"API Error: {apiEx.Message}");
        }
        catch (Exception ex)
        {
            editErrorMessage = "An unexpected error occurred while updating group.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void ConfirmDelete(EventGroupViewModel group)
    {
        groupToDelete = group;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        groupToDelete = null;
    }

    private async Task DeleteGroup()
    {
        if (groupToDelete == null) return;

        try
        {
            isDeleting = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            var deleteDto = new DeleteEventGroupDto
            {
                GroupId = groupToDelete.Id
            };

            var result = await ApiClient.DeletePOSTAsync(deleteDto);

            if (result != null && result.Success)
            {
                successMessage = $"{groupToDelete.GroupName} has been deleted successfully!";
                CancelDelete();
                await LoadGroups();

                // Clear success message after 3 seconds
                await Task.Delay(3000);
                successMessage = string.Empty;
                StateHasChanged();
            }
            else
            {
                errorMessage = result?.Message ?? "Failed to delete group.";
                CancelDelete();
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                401 => "You are not authorized to delete this group.",
                404 => "Group not found.",
                409 => "Cannot delete group. It may have associated donations.",
                500 => "Server error. Please try again later.",
                _ => $"An error occurred while deleting group. (Error code: {apiEx.StatusCode})"
            };
            Console.WriteLine($"API Error: {apiEx.Message}");
            CancelDelete();
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred while deleting group.";
            Console.WriteLine($"Error: {ex.Message}");
            CancelDelete();
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/my-events");
    }

    private class ValidationErrors
    {
        public string GroupName { get; set; }
    }

    private class CreateGroupModel
    {
        public string GroupName { get; set; }
    }
}

<style>
