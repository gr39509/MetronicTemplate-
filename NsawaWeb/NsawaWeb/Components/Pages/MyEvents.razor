@page "/my-events"
@using NsawaWeb.Services.Services
@using QRCoder
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<h1 class="page-title">Events</h1>

<button class="btn-create" @onclick="CreateNewEvent">Create New Event ↗</button>

@if (!string.IsNullOrEmpty(errorMessage))
{
<div class="error-alert">
    @errorMessage
</div>
}

@if (isLoading)
{
<div class="loading-container">
    <div class="spinner-grow text-secondary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <p class="mt-3">Loading your events...</p>
</div>
}
else if (events == null || !events.Any())
{
<div class="no-events">
    <h3>No Events Found</h3>
    <p>You haven't created any events yet. Click "Create New Event" to get started!</p>
</div>
}
else
{
<div class="table-card">
    <table class="table">
        <thead>
        <tr>
            <th>DATE</th>
            <th>EVENT</th>
            <th>TOTAL DONATIONS</th>
            <th>TOTAL WITHDRAWALS</th>
            <th>ACTIONS</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var evt in events)
        {
        <tr>
            <td>@evt.CreatedAt.ToString("MM/dd/yy")</td>
            <td>
                <div class="event-cell">
                    @if (!string.IsNullOrEmpty(evt.Banner))
                    {
                    <img src="@($"/api/imageproxy/getimage/{evt.Banner}")" alt="@evt.Title" class="event-image">
                    }
                    else
                    {
                    <img src="https://via.placeholder.com/60" alt="Event" class="event-image">
                    }
                    <span>@evt.Title</span>
                </div>
            </td>
            <td>@(evt.TotalDonations >0 ? "+" : "")  @evt.TotalDonations.ToString("N2")</td>
            <td>@(evt.TotalWithdrawals > 0 ? "-" : "") @evt.TotalWithdrawals.ToString("N2")</td>
            <td>
                <div class="action-menu">
                    <button class="action-btn" @onclick="() => ToggleMenu(evt.Id)">⋮</button>
                    @if (activeMenuId == evt.Id)
                    {
                        <div class="dropdown-menu-custom show">
                            <div class="dropdown-item-custom" @onclick="() => ViewEventDetails(evt.Id)">View Details</div>
                            <div class="dropdown-item-custom" @onclick="() => ViewDonations(evt.Id)">Donations</div>
                            <div class="dropdown-item-custom" @onclick="() => ViewWithdrawals(evt.Id)">Withdrawals</div>
                            <div class="dropdown-item-custom" @onclick="() => PublicDonate(evt.Id)">Donate</div>
                            <div class="dropdown-item-custom" @onclick="() => GenerateQrCode(evt.Id)">
                                <a download="@(evt.EventCode)_QRCode.png"
                                   href="@GenerateQrCode(evt.Id)" style="text-decoration: none; color: black;">
                                    Generate QR Code

                                </a>
                                
                            </div>
                            <div class="dropdown-item-custom delete" @onclick="() => DeleteEvent(evt.Id)">Delete Event</div>
                           
                        </div>
                    }
                </div>
            </td>
        </tr>
        }
        </tbody>
    </table>
</div>
}

<!-- Event Details Modal -->
<div class="event-modal @(showEventModal ? "show" : "")">
    @if (selectedEvent != null)
    {
        <div class="modal-content-wrapper">
            <button class="close-btn" @onclick="CloseEventModal">×</button>
            <button class="edit-details-btn" @onclick="EditEventDetails">
                Edit Event Details ↗
            </button>
            <div class="modal-grid">
                <div>
                    @if (!string.IsNullOrEmpty(selectedEvent.Banner))
                    {
                        <img src="@($"/api/imageproxy/getimage/{selectedEvent.Banner}")" alt="@selectedEvent.Title" class="event-poster">
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/400" alt="Event Poster" class="event-poster">
                    }
                </div>

                <div class="event-details">
                    <div class="stats-row">
                        <div class="stat-card stat-card-green">
                            <img src="icons/Group 1912.svg" alt="" class="stat-icon">
                            <div class="stat-label">Total Donations</div>
                            <div class="stat-value">+ @selectedEvent.TotalDonations.ToString("N2")</div>
                        </div>
                        <div class="stat-card stat-card-pink">
                            <img src="icons/wallet.svg" alt="" class="stat-icon">
                            <div class="stat-label">Total Donations Withdrawn</div>
                            <div class="stat-value">- @selectedEvent.TotalWithdrawals.ToString("N2")</div>
                        </div>
                    </div>

                    <h2 class="event-title">@selectedEvent.Title</h2>

                    <p class="event-description">
                        @(string.IsNullOrEmpty(selectedEvent.Description) ? "No description available." : selectedEvent.Description)
                    </p>

                    <div class="event-meta">
                        @if (selectedEvent.Organizer != null)
                        {
                            <div class="meta-item">
                                <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                                <span>@selectedEvent.Organizer.FullName</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(selectedEvent.Location))
                        {
                            <div class="meta-item">
                                <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                                <span>@selectedEvent.Location</span>
                            </div>
                        }
                    </div>

                    <div class="details-grid-1">
                        <div class="detail-item">
                            <div class="detail-label">Start Date</div>
                            <div class="detail-value">@selectedEvent.StartDate.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">End Date</div>
                            <div class="detail-value">@selectedEvent.EndDate.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>
                    <div class="details-grid-2">
                        <div class="detail-item">
                            <div class="detail-label">Event Code</div>
                            <div class="detail-value">@(string.IsNullOrEmpty(selectedEvent.EventCode) ? "N/A" : selectedEvent.EventCode)</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">R.S.V.P</div>
                            <div class="detail-value">@(string.IsNullOrEmpty(selectedEvent.Rsvp) ? "N/A" : selectedEvent.Rsvp)</div>
                        </div>
                    </div>

                    <div class="notification-toggle">
                        <span class="toggle-label">Notification</span>
                        <label class="toggle-switch">
                            <input type="checkbox" checked="@selectedEvent.NotifyOrganizer">
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    
                    <AddEventAffiliateModal 
                        EventId="@selectedEvent.Id" 
                        ShowModal="@showAffiliateModal"
                        OnClose="@CloseAffiliateModal"
                        OnSuccess="@HandleAffiliateAdded" />

                    <div style="justify-content: space-between;" class="details-btns">
                        @* <button class="add-affiliate-btn" @onclick="OpenAffiliateModal"> *@
                        @*     Add an Affiliate ↗ *@
                        @* </button> *@
                        <button class="view-affiliate-btn" @onclick="() => ViewAffiliates(selectedEvent.Id)">
                            View Affiliate ↗
                        </button>
                        <button class="add-affiliate-btn" @onclick="() => ViewGroups(selectedEvent.Id)">
                            View Groups ↗
                        </button>
                    </div>
                  
                </div>
            </div>
        </div>
    }
    else if (isLoadingEventDetails)
    {
        <div class="modal-content-wrapper">
            <button class="close-btn" @onclick="CloseEventModal">×</button>
            <div class="loading-container">
                <div class="spinner-border text-primary" role="status"></div>
                <p>Loading event details...</p>
            </div>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="delete-modal @(showDeleteConfirmation ? "show" : "")">
    <div class="modal-content-delete">
        <div class="delete-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
        </div>
        <h2>Delete Event</h2>
        
        @if (eventToDelete != null)
        {
            <p>
                Are you sure you want to Delete <strong>@eventToDelete.Title</strong>?
            </p>
            <p class="warning-text">
                This will delete the event and it will no longer accept donations. This action cannot be undone.
            </p>
        }

        @if (!string.IsNullOrEmpty(deleteErrorMessage))
        {
            <div class="delete-error-alert">
                @deleteErrorMessage
            </div>
        }

        <div class="modal-footer">
            <button class="btn-cancel" @onclick="CancelDelete" disabled="@isDeleting">Cancel</button>
            <button class="btn-delete-confirm" @onclick="ConfirmDelete" disabled="@isDeleting">
                @if (isDeleting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Deleting...</span>
                }
                else
                {
                    <span>Delete Event</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    private List<EventViewModel> events = new();
    private EventViewModel selectedEvent;
    private bool isLoading = true;
    private bool isLoadingEventDetails = false;
    private bool showEventModal = false;
    private string errorMessage = string.Empty;
    private Guid? activeMenuId = null;
    
    // Delete confirmation state
    private bool showDeleteConfirmation = false;
    private EventViewModel eventToDelete = null;
    private bool isDeleting = false;
    private string deleteErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEvents();
    }

    private async Task LoadEvents()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var result = await ApiClient.MyEventsAsync();

            if (result.Success && result.Data != null)
            {
                events = result.Data.OrderByDescending(e => e.CreatedAt).ToList();
            }
            else
            {
                errorMessage = result.Message ?? "Failed to load events.";
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                401 => "You are not authorized. Please log in again.",
                404 => "Events endpoint not found.",
                500 => "Server error. Please try again later.",
                _ => $"An error occurred while loading events. (Error code: {apiEx.StatusCode})"
            };

      
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred while loading events.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    
    private bool showAffiliateModal = false;

    private void OpenAffiliateModal()
    {
        showAffiliateModal = true;
    }

    private void CloseAffiliateModal()
    {
        showAffiliateModal = false;
    }

    private async Task HandleAffiliateAdded()
    {
        // Refresh event details or show success message
        Console.WriteLine("Affiliate added successfully!");
        
        // Optionally reload event data
        // if (selectedEvent != null)
        // {
        //     await ViewEventDetails(selectedEvent.Id);
        // }
    }

    private async Task ViewEventDetails(Guid eventId)
    {
        activeMenuId = null;
        
        try
        {
            isLoadingEventDetails = true;
            showEventModal = true;
            StateHasChanged();

            var result = await ApiClient.EventAsync(eventId);

            if (result.Success && result.Data != null)
            {
                selectedEvent = result.Data;
            }
            else
            {
                errorMessage = result.Message ?? "Failed to load event details.";
                showEventModal = false;
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                401 => "You are not authorized. Please log in again.",
                404 => "Event not found.",
                500 => "Server error. Please try again later.",
                _ => $"An error occurred while loading event details. (Error code: {apiEx.StatusCode})"
            };
            
            showEventModal = false;
            
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred while loading event details.";
            showEventModal = false;
           
        }
        finally
        {
            isLoadingEventDetails = false;
            StateHasChanged();
        }
    }
    
    private string GenerateQrCode(Guid eventId)
    {
        using QRCodeGenerator qrGenerator = new QRCodeGenerator();
        using QRCodeData qrCodeData =
            qrGenerator.CreateQrCode($"{Navigation.BaseUri.TrimEnd('/')}/donate/{eventId}", QRCodeGenerator.ECCLevel.Q);
        using PngByteQRCode qrCode = new PngByteQRCode(qrCodeData);
        byte[] qrCodeImage = qrCode.GetGraphic(20);
        return $"data:image/png;base64,{Convert.ToBase64String(qrCodeImage)}";
    }
    
    private void ViewAffiliates(Guid eventId)
    {
        Navigation.NavigateTo($"/events/{eventId}/affiliates");
    }
    
    private void ViewGroups(Guid eventId)
    {
        Navigation.NavigateTo($"/events/{eventId}/groups");
    }

    private void CloseEventModal()
    {
        showEventModal = false;
        selectedEvent = null;
    }

    private void EditEventDetails()
    {
        if (selectedEvent != null)
        {
            Navigation.NavigateTo($"/events/{selectedEvent.Id}/edit");
        }
    }
    

    private void ToggleMenu(Guid eventId)
    {
        activeMenuId = activeMenuId == eventId ? null : eventId;
    }

    private void CreateNewEvent()
    {
        Navigation.NavigateTo("/create-event");
    }

    private void ViewDonations(Guid eventId)
    {
        activeMenuId = null;
        Navigation.NavigateTo($"/events/{eventId}/donations");
    }
    
    private void PublicDonate(Guid eventId)
    {
        activeMenuId = null;
        Navigation.NavigateTo($"/donate/{eventId}");
    }

    private void ViewWithdrawals(Guid eventId)
    {
        activeMenuId = null;
        Navigation.NavigateTo($"/events/{eventId}/withdraw");
    }

    private void GenerateQRCode(Guid eventId)
    {
        activeMenuId = null;
        Navigation.NavigateTo($"/events/{eventId}/qr-code");
    }
    
    
    private void DeleteEvent(Guid eventId)
    {
        activeMenuId = null;
        
        // Find the event to delete
        eventToDelete = events.FirstOrDefault(e => e.Id == eventId);
        if (eventToDelete != null)
        {
            showDeleteConfirmation = true;
        }
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
        eventToDelete = null;
        deleteErrorMessage = string.Empty;
    }

    private async Task ConfirmDelete()
    {
        if (eventToDelete == null) return;

        try
        {
            isDeleting = true;
            deleteErrorMessage = string.Empty;
            errorMessage = string.Empty;
            StateHasChanged();

            var deactivateDto = new DeactivateEventDto
            {
                EventId = eventToDelete.Id
            };

            var result = await ApiClient.DeactivateAsync(deactivateDto);

            if (result != null && result.Success)
            {
                errorMessage = $"Event '{eventToDelete.Title}' has been deactivated successfully!";
                
                CancelDelete();
                
                await LoadEvents();
                
                await Task.Delay(3000);
                errorMessage = string.Empty;
                StateHasChanged();
            }
            else
            {
                deleteErrorMessage = result?.Message ?? "Failed to deactivate event. Please try again.";
            }
        }
        catch (ApiException apiEx)
        {

            deleteErrorMessage = apiEx.StatusCode switch
            {
                400 => "Invalid request. Please try again.",
                401 => "You are not authorized to deactivate this event.",
                404 => "Event not found.",
                409 => "Cannot deactivate event. It may have pending donations or withdrawals.",
                500 => "Server error. Please try again later.",
                _ => $"An error occurred while deactivating event. (Error code: {apiEx.StatusCode})"
            };
        }
        catch (Exception ex)
        {
            deleteErrorMessage = "An unexpected error occurred while deactivating event.";
            Console.WriteLine($"Delete error: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }
    
}

<script>
    

        function toggleMenu(btn) {
            const allMenus = document.querySelectorAll('.dropdown-menu-custom');
            const menu = btn.nextElementSibling;
            
            allMenus.forEach(m => {
                if (m !== menu) m.classList.remove('show');
            });
            
            menu.classList.toggle('show');
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.action-menu')) {
                document.querySelectorAll('.dropdown-menu-custom').forEach(m => {
                    m.classList.remove('show');
                });
            }
        });
        
    </script>
    
