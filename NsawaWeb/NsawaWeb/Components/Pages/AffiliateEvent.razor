        background: #f0f0f0;
        color: #333;
    }

    .btn-groups:hover {
        background: #e0e0e0;
        transform: translateY(-1px);
    }

    .text-muted {
        color: #999;
        font-size: 13px;
        font-style: italic;
    }

    /* Mobile Responsive */
    @@media (max-width: 768px) {
        .page-container {
            padding: 20px 15px;
        }

        .page-title {
            font-size: 24px;
        }

        .table-card {
            padding: 15px;
            border-radius: 15px;
        }

        .table-wrapper {
            margin: 0 -15px;
            padding: 0 15px;
        }

        .events-table {
            min-width: 1000px;
        }

        .action-buttons {
            min-width: 120px;
        }

        .btn-text {
            display: none;
        }

        .btn-action {
            justify-content: center;
            padding: 10px;
        }
