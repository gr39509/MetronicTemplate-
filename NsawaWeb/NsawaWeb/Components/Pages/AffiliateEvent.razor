        margin: 0;
    }

    .table-card {
        background: white;
        border-radius: 20px;
        padding: 20px;
        /*box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);*/
    }

    .table-header {
        margin-bottom: 20px;
    }

    .table-header h3 {
        font-size: 18px;
        font-weight: 700;
        margin: 0;
        color: #333;
    }

    .table-wrapper {
        overflow-x: auto;
