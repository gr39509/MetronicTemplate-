@page "/affiliate-events"
@using NsawaWeb.Services.Services
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<div class="page-container">
    <div class="page-header">
        <h1 class="page-title">Affiliate Events</h1>
        <p class="page-subtitle">Events where you have affiliate access</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-alert">
            <strong>Error:</strong> @errorMessage
        </div>
    }

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner-grow text-secondary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading affiliate events...</p>
        </div>
    }
    else if (events == null || !events.Any())
    {
        <div class="no-events">
            <div class="no-events-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <h3>No Affiliate Events</h3>
            <p>You don't have affiliate access to any events yet.</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-header">
                <h3>Events (@events.Count)</h3>
            </div>
            <div class="table-wrapper">
                <table class="events-table">
                    <thead>
                        <tr>
                            <th>EVENT</th>
                            <th>CODE</th>
                            <th>DATES</th>
                            <th>ORGANIZER</th>
                            <th>ROLES</th>
                            <th>DONATIONS</th>
                            <th>WITHDRAWALS</th>
                            <th>STATUS</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in events)
                        {
                            <tr>
                                <td>
                                    <div class="event-info">
                                        <div class="event-title-wrapper">
                                            <span class="event-title">@evt.Title</span>
                                            @if (evt.EventType != null)
                                            {
                                                <span class="event-type">@evt.EventType.Name</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(evt.Location))
                                        {
                                            <div class="event-location">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                                    <circle cx="12" cy="10" r="3"></circle>
                                                </svg>
                                                <span>@evt.Location</span>
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="event-code">@evt.EventCode</span>
                                </td>
                                <td>
                                    <div class="date-range">
                                        <div class="date-item">@evt.StartDate.ToString("MMM dd, yyyy")</div>
                                        <div class="date-separator">to</div>
                                        <div class="date-item">@evt.EndDate.ToString("MMM dd, yyyy")</div>
                                    </div>
                                </td>
                                <td>
                                    @if (evt.Organizer != null)
                                    {
                                        <div class="organizer-info">
                                            <div class="organizer-name">
                                                @(string.IsNullOrEmpty(evt.Organizer.OrganizationName) ? evt.Organizer.FullName : evt.Organizer.OrganizationName)
                                            </div>
                                            @if (!string.IsNullOrEmpty(evt.Organizer.PhoneNumber))
                                            {
                                                <div class="organizer-phone">@evt.Organizer.PhoneNumber</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (evt.AffiliationRoles != null && evt.AffiliationRoles.Any())
                                    {
                                        <div class="roles-tags">
                                            @foreach (var role in evt.AffiliationRoles)
                                            {
                                                <span class="role-tag">@role</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                </td>
                                <td>
                                    <span class="amount-value">GH₵ @evt.TotalDonations.ToString("N2")</span>
                                </td>
                                <td>
                                    <span class="amount-value">GH₵ @evt.TotalWithdrawals.ToString("N2")</span>
                                </td>
                                <td>
                                    <span class="status-badge @(evt.Active ? "active" : "inactive")">
                                        @(evt.Active ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn-action btn-donations" @onclick="() => ViewDonations(evt.Id)" title="View Donations">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                <polyline points="14 2 14 8 20 8"></polyline>
                                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                            </svg>
                                            <span class="btn-text">Donations</span>
                                        </button>
                                        @* <button class="btn-action btn-groups" @onclick="() => ViewGroups(evt.Id)" title="View Groups"> *@
                                        @*     <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"> *@
                                        @*         <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path> *@
                                        @*         <circle cx="9" cy="7" r="4"></circle> *@
                                        @*         <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path> *@
                                        @*         <path d="M16 3.13a4 4 0 0 1 0 7.75"></path> *@
                                        @*     </svg> *@
                                        @*     <span class="btn-text">Groups</span> *@
                                        @* </button> *@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<EventViewModel> events = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAffiliateEvents();
    }

    private async Task LoadAffiliateEvents()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var result = await ApiClient.MyAffiliateEventsAsync();

            if (result.Success && result.Data != null)
            {
                events = result.Data.OrderByDescending(e => e.CreatedAt).ToList();
            }
            else
            {
                errorMessage = result.Message ?? "Failed to load affiliate events.";
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                401 => "You are not authorized. Please log in again.",
                404 => "No affiliate events found.",
                500 => "Server error. Please try again later.",
                _ => $"An error occurred while loading events. (Error code: {apiEx.StatusCode})"
            };
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred while loading events.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ViewDonations(Guid eventId)
    {
        Navigation.NavigateTo($"/events/{eventId}/donations");
    }

    private void ViewGroups(Guid eventId)
    {
        Navigation.NavigateTo($"/events/{eventId}/groups");
    }
}

<style>
    .page-container {
