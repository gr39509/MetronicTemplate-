        margin: 0 0 10px 0;
        color: #1e7a6d;
    }

    .page-subtitle {
        font-size: 16px;
        color: #666;
        margin: 0;
    }

    .error-alert {
        background: #f8d7da;
        border: 1px solid #f5c6cb;
