@page "/events/{EventId:guid}/affiliates"
@using NsawaWeb.Services.Services
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<div class="affiliates-header">
    <button class="back-btn" @onclick="GoBack">← Back to Event</button>
    <h1 class="page-title">Event Affiliates</h1>
    <button class="create-btn" @onclick="OpenCreateModal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Add Affiliate
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-alert">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="success-alert">@successMessage</div>
}

@if (isLoading)
{
    <div class="loading-container">
        <div class="spinner-grow text-secondary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Loading affiliates...</p>
    </div>
}
else if (affiliates == null || !affiliates.Any())
{
    <div class="no-affiliates">
        <h3>No Affiliates Found</h3>
        <p>This event doesn't have any affiliates yet.</p>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="affiliates-table">
            <thead>
                <tr>
                    <th>Affiliate</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>Roles</th>
                    <th>SMS</th>
                    <th>Push</th>
                    <th>Added</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var affiliate in affiliates)
                {
                    <tr>
                        <td>
                            <div class="affiliate-cell">
                                <div class="affiliate-avatar">@GetInitials(affiliate.FullName)</div>
                                <div class="affiliate-meta">
                                    <span class="affiliate-name">@affiliate.FullName</span>
                                    @if (!string.IsNullOrEmpty(affiliate.OrganizationName))
                                    {
                                        <span class="affiliate-org">@affiliate.OrganizationName</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="td-text">@(string.IsNullOrEmpty(affiliate.PhoneNumber) ? "—" : affiliate.PhoneNumber)</span>
                        </td>
                        <td>
                            <span class="td-text address-text">@(string.IsNullOrEmpty(affiliate.Address) ? "—" : affiliate.Address)</span>
                        </td>
                        <td>
                            @if (affiliate.Roles != null && affiliate.Roles.Any())
                            {
                                <div class="roles-list">
                                    @foreach (var role in affiliate.Roles)
                                    {
                                        <span class="role-badge">@role</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="td-text">—</span>
                            }
                        </td>
                        <td>
                            <span class="notification-status @(affiliate.NotifyDonation ? "active" : "inactive")">
                                @(affiliate.NotifyDonation ? "ON" : "OFF")
                            </span>
                        </td>
                        <td>
                            <span class="notification-status @(affiliate.PushNotifyDonation ? "active" : "inactive")">
                                @(affiliate.PushNotifyDonation ? "ON" : "OFF")
                            </span>
                        </td>
                        <td>
                            <span class="created-date">@affiliate.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <button class="btn-edit" @onclick="() => OpenEditModal(affiliate)" title="Edit">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                    Edit
                                </button>
                                <button class="btn-delete" @onclick="() => ConfirmDelete(affiliate)" title="Delete">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


<!-- Edit Affiliate Modal -->
<div class="edit-modal @(showEditModal ? "show" : "")">
    <div class="modal-content-edit">
        <div class="modal-header">
            <h2>Edit Affiliate</h2>
            <button class="close-btn" @onclick="CloseEditModal">×</button>
        </div>

        @if (editingAffiliate != null)
        {
            <div class="modal-body">
                <div class="form-group">
                    <label class="required">Full Name *</label>
                    <input type="text" class="form-input" @bind="editingAffiliate.FullName" placeholder="Enter full name" />
                </div>

                <div class="form-group">
                    <label class="required">Phone Number *</label>
                    <input type="tel" class="form-input" @bind="editingAffiliate.PhoneNumber" placeholder="0123456789" maxlength="10" />
                </div>

                <div class="form-group">
                    <label>Organization Name</label>
                    <input type="text" class="form-input" @bind="editingAffiliate.OrganizationName" placeholder="Enter organization name" />
                </div>

                <div class="form-group">
                    <label>Address</label>
                    <input type="text" class="form-input" @bind="editingAffiliate.Address" placeholder="Enter address" />
                </div>

                <div class="form-group">
                    <label class="required">Roles</label>
                    <div class="roles-checkbox-container">
                        @if (availableRoles.Any())
                        {
                            @foreach (var role in availableRoles)
                            {
                                <label class="role-checkbox-item">
                                    <input type="checkbox"
                                           checked="@IsEditRoleSelected(role.Id)"
                                           @onchange="@(e => ToggleEditRole(role.Id, (bool)e.Value))" />
                                    <span class="role-checkbox-label">@role.Name</span>
                                </label>
                            }
                        }
                        else
                        {
                            <div class="no-roles-message">No roles available. Please contact administrator.</div>
                        }
                    </div>
                    @if (showEditRoleError && (editingAffiliate.RoleIds == null || !editingAffiliate.RoleIds.Any()))
                    {
                        <span class="validation-error">Please select at least one role.</span>
                    }
                </div>

                <div class="form-group-toggle">
                    <label class="toggle-container">
                        <span>SMS Notifications</span>
                        <input type="checkbox" @bind="editingAffiliate.NotifyDonation" />
                        <span class="toggle-checkmark"></span>
                    </label>
                </div>

                <div class="form-group-toggle">
                    <label class="toggle-container">
                        <span>Push Notifications</span>
                        <input type="checkbox" @bind="editingAffiliate.PushNotifyDonation" />
                        <span class="toggle-checkmark"></span>
                    </label>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseEditModal">Cancel</button>
                <button class="btn-save" @onclick="SaveAffiliate" disabled="@isSaving">
                    @if (isSaving) { <span>Saving...</span> } else { <span>Save Changes</span> }
                </button>
            </div>
        }
    </div>
</div>

<!-- Create Affiliate Modal -->
<div class="create-modal @(showCreateModal ? "show" : "")">
    <div class="modal-content-create">
        <div class="modal-header">
            <h2>Add New Affiliate</h2>
            <button class="close-btn" @onclick="CloseCreateModal">×</button>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-alert">@errorMessage</div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="success-alert">@successMessage</div>
        }

        <div class="modal-body">
            <div class="form-group">
                <label class="required">Full Name</label>
                <input type="text" class="form-input" @bind="newAffiliate.FullName" placeholder="Enter full name" />
                @if (!string.IsNullOrEmpty(validationErrors?.FullName))
                {
                    <span class="validation-error">@validationErrors.FullName</span>
                }
            </div>

            <div class="form-group">
                <label class="required">Phone Number</label>
                <input type="tel" class="form-input" @bind="newAffiliate.PhoneNumber" placeholder="0123456789" maxlength="10" />
                @if (!string.IsNullOrEmpty(validationErrors?.PhoneNumber))
                {
                    <span class="validation-error">@validationErrors.PhoneNumber</span>
                }
            </div>

            <div class="form-group">
                <label>Organization Name</label>
                <input type="text" class="form-input" @bind="newAffiliate.OrganizationName" placeholder="Enter organization name" />
            </div>

            <div class="form-group">
                <label>Address</label>
                <input type="text" class="form-input" @bind="newAffiliate.Address" placeholder="Enter address" />
            </div>

            <div class="form-group">
                <label class="required">Roles</label>
                <div class="roles-checkbox-container">
                    @if (availableRoles.Any())
                    {
                        @foreach (var role in availableRoles)
                        {
                            <label class="role-checkbox-item">
                                <input type="checkbox"
                                       checked="@IsRoleSelected(role.Id)"
                                       @onchange="@(e => ToggleRole(role.Id, (bool)e.Value))" />
                                <span class="role-checkbox-label">@role.Name</span>
                            </label>
                        }
                    }
                    else
                    {
                        <div class="no-roles-message">No roles available. Please contact administrator.</div>
                    }
                </div>
                @if (showRoleError)
                {
                    <span class="validation-error">Please select at least one role.</span>
                }
            </div>

            <div class="form-group-toggle">
                <label class="toggle-container">
                    <span>SMS Notifications</span>
                    <input type="checkbox" @bind="newAffiliate.NotifyDonation" />
                    <span class="toggle-checkmark"></span>
                </label>
            </div>

            <div class="form-group-toggle">
                <label class="toggle-container">
                    <span>Push Notifications</span>
                    <input type="checkbox" @bind="newAffiliate.PushNotifyDonation" />
                    <span class="toggle-checkmark"></span>
                </label>
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn-cancel" @onclick="CloseCreateModal">Cancel</button>
            <button class="create-btn" @onclick="CreateAffiliate" disabled="@isCreating">
                @if (isCreating) { <span>Creating...</span> } else { <span>Create Affiliate</span> }
            </button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="delete-modal @(showDeleteModal ? "show" : "")">
    <div class="modal-content-delete">
        <div class="delete-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
        </div>
        <h2>Delete Affiliate</h2>
        <p>Are you sure you want to delete <strong>@affiliateToDelete?.FullName</strong>? This action cannot be undone.</p>
        <div class="modal-footer">
            <button class="btn-cancel" @onclick="CancelDelete">Cancel</button>
            <button class="btn-delete-confirm" @onclick="DeleteAffiliate" disabled="@isDeleting">
                @if (isDeleting) { <span>Deleting...</span> } else { <span>Delete</span> }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid EventId { get; set; }

    private List<EventAffiliateViewModel> affiliates = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    
    private bool showCreateModal = false;
    private CreateAffiliateModel newAffiliate = new();
    private bool isCreating = false;
    private List<RoleViewModel> availableRoles = new();
    private HashSet<string> selectedRoles = new();
    private bool showRoleError = false;
    private ValidationErrors validationErrors;

   
    private bool showEditModal = false;
    private UpdateEventAffiliateDto editingAffiliate;
    private bool isSaving = false;
    private bool showEditRoleError = false;

   
    private bool showDeleteModal = false;
    private EventAffiliateViewModel affiliateToDelete;
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAffiliates();
        await LoadAvailableRoles();
    }

    private async Task LoadAffiliates()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            var result = await ApiClient.EventAffiliateAsync(EventId);
            if (result.Success && result.Data != null)
                affiliates = result.Data.OrderByDescending(a => a.CreatedAt).ToList();
            else
                errorMessage = result.Message ?? "Failed to load affiliates.";
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                401 => "You are not authorized. Please log in again.",
                404 => "Event not found.",
                500 => "Server error. Please try again later.",
                _ => $"An error occurred while loading affiliates. (Error code: {apiEx.StatusCode})"
            };
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred while loading affiliates.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenEditModal(EventAffiliateViewModel affiliate)
    {
        editingAffiliate = new UpdateEventAffiliateDto
        {
            EventAffiliateId = affiliate.Id,
            EventId = affiliate.EventId,
            FullName = affiliate.FullName,
            PhoneNumber = affiliate.PhoneNumber,
            Address = affiliate.Address,
            OrganizationName = affiliate.OrganizationName,
            NotifyDonation = affiliate.NotifyDonation,
            PushNotifyDonation = affiliate.PushNotifyDonation,
            RoleIds = affiliate.RoleIds?.ToList() ?? new List<string>()
        };
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingAffiliate = null;
    }

    private bool IsEditRoleSelected(string roleId) =>
        editingAffiliate?.RoleIds?.Contains(roleId) == true;

    private void ToggleEditRole(string roleId, bool isChecked)
    {
        if (editingAffiliate == null) return;
        if (isChecked)
        {
            editingAffiliate.RoleIds ??= new List<string>();
            if (!editingAffiliate.RoleIds.Contains(roleId))
                editingAffiliate.RoleIds.Add(roleId);
        }
        else
        {
            editingAffiliate.RoleIds?.Remove(roleId);
        }
        showEditRoleError = false;
    }

    private async Task SaveAffiliate()
    {
        if (editingAffiliate == null) return;
        if (string.IsNullOrWhiteSpace(editingAffiliate.FullName)) { errorMessage = "Full name is required."; return; }
        if (string.IsNullOrWhiteSpace(editingAffiliate.PhoneNumber) || editingAffiliate.PhoneNumber.Length != 10) { errorMessage = "Phone number must be exactly 10 digits."; return; }

        try
        {
            isSaving = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;
            var result = await ApiClient.UpdatePUTAsync(editingAffiliate);
            if (result.Success)
            {
                successMessage = "Affiliate updated successfully!";
                CloseEditModal();
                await LoadAffiliates();
                await Task.Delay(3000);
                successMessage = string.Empty;
                StateHasChanged();
            }
            else
            {
                errorMessage = result.Message ?? "Failed to update affiliate.";
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                400 => "Invalid data. Please check your inputs.",
                401 => "You are not authorized to update this affiliate.",
                404 => "Affiliate not found.",
                500 => "Server error. Please try again later.",
                _ => $"An error occurred while updating affiliate. (Error code: {apiEx.StatusCode})"
            };
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred while updating affiliate.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void OpenCreateModal()
    {
        newAffiliate = new CreateAffiliateModel { NotifyDonation = true, PushNotifyDonation = true };
        selectedRoles.Clear();
        validationErrors = null;
        showRoleError = false;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
        newAffiliate = new CreateAffiliateModel();
        selectedRoles.Clear();
        validationErrors = null;
        showRoleError = false;
    }

    private bool IsRoleSelected(string roleId) => selectedRoles.Contains(roleId);

    private void ToggleRole(string roleId, bool isChecked)
    {
        if (isChecked) selectedRoles.Add(roleId);
        else selectedRoles.Remove(roleId);
        showRoleError = false;
    }

    private async Task LoadAvailableRoles()
    {
        try
        {
            var result = await ApiClient.All4Async();
            if (result.Success && result.Data != null)
                availableRoles = result.Data.ToList();
            else
                errorMessage = "Failed to load roles. Please try again.";
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                401 => "You are not authorized to view roles.",
                500 => "Server error while loading roles.",
                _ => $"Failed to load roles. (Error code: {apiEx.StatusCode})"
            };
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred while loading roles.";
            Console.WriteLine($"Error loading roles: {ex.Message}");
        }
    }

    private async Task CreateAffiliate()
    {
        validationErrors = new ValidationErrors();
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(newAffiliate.FullName)) { validationErrors.FullName = "Full name is required."; isValid = false; }
        if (string.IsNullOrWhiteSpace(newAffiliate.PhoneNumber)) { validationErrors.PhoneNumber = "Phone number is required."; isValid = false; }
        else if (newAffiliate.PhoneNumber.Length != 10) { validationErrors.PhoneNumber = "Phone number must be exactly 10 digits."; isValid = false; }
        if (selectedRoles.Count == 0) { showRoleError = true; isValid = false; }

        if (!isValid) { StateHasChanged(); return; }

        try
        {
            isCreating = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            var dto = new CreateEventAffiliateDto
            {
                EventId = EventId,
                FullName = newAffiliate.FullName,
                PhoneNumber = newAffiliate.PhoneNumber,
                Address = newAffiliate.Address,
                OrganizationName = newAffiliate.OrganizationName,
                RoleIds = selectedRoles.ToList(),
                NotifyDonation = newAffiliate.NotifyDonation,
                PushNotifyDonation = newAffiliate.PushNotifyDonation
            };

            var result = await ApiClient.CreateAsync(dto);
            if (result.Success)
            {
                successMessage = result.Message ?? "Affiliate created successfully!";
                CloseCreateModal();
                await LoadAffiliates();
                await Task.Delay(3000);
                successMessage = string.Empty;
                StateHasChanged();
            }
            else
            {
                errorMessage = result.Message ?? "Failed to create affiliate.";
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                400 => "Invalid data. Please check your inputs.",
                401 => "You are not authorized to create affiliates.",
                404 => "Event not found.",
                409 => "An affiliate with this phone number already exists for this event.",
                422 => "Validation failed. Please check all fields.",
                500 => "Server error. Please try again later.",
                _ => $"An error occurred while creating affiliate. (Error code: {apiEx.StatusCode})"
            };
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred while creating affiliate.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isCreating = false;
            StateHasChanged();
        }
    }

    private void ConfirmDelete(EventAffiliateViewModel affiliate)
    {
        affiliateToDelete = affiliate;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        affiliateToDelete = null;
    }

    private async Task DeleteAffiliate()
    {
        if (affiliateToDelete == null) return;
        try
        {
            isDeleting = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            var deleteDto = new DeleteEventAffiliateDto { EventAffiliateId = affiliateToDelete.Id };
            var result = await ApiClient.DeleteDELETEAsync(deleteDto);

            if (result.Success)
            {
                successMessage = $"{affiliateToDelete.FullName} has been deleted successfully!";
                CancelDelete();
                await LoadAffiliates();
                await Task.Delay(3000);
                successMessage = string.Empty;
                StateHasChanged();
            }
            else
            {
                errorMessage = result.Message ?? "Failed to delete affiliate.";
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                401 => "You are not authorized to delete this affiliate.",
                404 => "Affiliate not found.",
                500 => "Server error. Please try again later.",
                _ => $"An error occurred while deleting affiliate. (Error code: {apiEx.StatusCode})"
            };
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred while deleting affiliate.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "NA";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return $"{parts[0][0]}{parts[parts.Length - 1][0]}".ToUpper();
    }

    private void GoBack() => Navigation.NavigateTo("/my-events");

    private class ValidationErrors
    {
        public string FullName { get; set; }
        public string PhoneNumber { get; set; }
        public string RoleIds { get; set; }
    }

    private class CreateAffiliateModel
    {
        public string FullName { get; set; }
        public string PhoneNumber { get; set; }
        public string Address { get; set; }
        public string OrganizationName { get; set; }
        public bool NotifyDonation { get; set; }
        public bool PushNotifyDonation { get; set; }
    }
}

<style>
   
    .affiliates-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
    }

    .back-btn {
        background: #f0f0f0;
        border: none;
        padding: 10px 20px;
        border-radius: 50px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        white-space: nowrap;
    }

    .back-btn:hover { background: #e0e0e0; }

    .page-title {
        margin: 0;
        font-size: 32px;
        font-weight: 800;
    }

    .create-btn {
        background: linear-gradient(90deg, #ffd700 0%, #ffed4e 100%);
        border: none;
        padding: 12px 24px;
        border-radius: 50px;
        font-weight: 600;
        color: black;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .create-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(30, 122, 109, 0.3);
    }

    .create-btn svg { width: 20px; height: 20px; stroke-width: 2.5; }

   
    .error-alert {
        background: #f8d7da;
        border: 1px solid #f5c6cb;
        color: #721c24;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .success-alert {
        background: #d4edda;
        border: 1px solid #c3e6cb;
        color: #155724;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }


    .loading-container { text-align: center; padding: 60px 20px; }

    .no-affiliates {
        text-align: center;
        padding: 60px 20px;
