@page "/donate/{EventId:guid}"
@layout AccountLayout
@using NsawaWeb.Components.Layout
@using NsawaWeb.Services.Services
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<div class="donate-page">
    @* <div class="donate-header"> *@
    @*     <div class="logo"> *@
    @*         <img src="/images/logo.png" alt="Logo" /> *@
    @*     </div> *@
    @* </div> *@

    <div class="donate-container">
        @if (isLoadingEvent)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary" role="status"></div>
                <p>Loading event details...</p>
            </div>
        }
        else if (eventDetails == null)
        {
            <div class="error-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <h2>Event Not Found</h2>
                <p>The event you're looking for doesn't exist or has been deactivated.</p>
            </div>
        }
        else
        {
            <div class="donate-content">
                <!-- Event Banner Section -->
                <div class="event-banner-section">
                    @if (!string.IsNullOrEmpty(eventDetails.Banner))
                    {
                        <img src="@($"/api/imageproxy/getimage/{eventDetails.Banner}")" alt="@eventDetails.Title" class="event-banner-image">
                    }
                    else
                    {
                        <div class="event-banner-placeholder">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                <polyline points="21 15 16 10 5 21"></polyline>
                            </svg>
                        </div>
                    }
                    
                    <div class="event-info-overlay">
                        <h1 class="event-title">@eventDetails.Title</h1>
                        @if (!string.IsNullOrEmpty(eventDetails.Location))
                        {
                            <div class="event-location">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                                <span>@eventDetails.Location</span>
                            </div>
                        }
                        <div class="event-date">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <span>@eventDetails.StartDate.ToString("MMM dd, yyyy") - @eventDetails.EndDate.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                </div>

                <!-- Donation Form Section -->
                <div class="donation-form-section">
                    @if (currentStep == DonationStep.PhoneEntry)
                    {
                        <div class="form-step">
                            <h2 class="form-title">Make a Donation</h2>
                            <p class="form-subtitle">Enter your phone number to get started</p>

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-error">@errorMessage</div>
                            }

                            <div class="form-group">
                                <label class="form-label">Phone Number (Without the first 0)</label>
                                <div class="phone-input-group">
                                    <span class="phone-prefix">+233</span>
                                    <input type="tel" 
                                           class="form-input" 
                                           placeholder="548XXXXX"
                                           maxlength="9"
                                           @bind="phoneNumber"
                                           @onkeypress="HandlePhoneKeyPress" />
                                </div>
                            </div>

                            <button class="primary-btn" 
                                    @onclick="RequestOTP"
                                    disabled="@(isProcessing || phoneNumber.Length != 9)">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span>Sending OTP...</span>
                                }
                                else
                                {
                                    <span>Continue</span>
                                }
                            </button>
                        </div>
                    }
                    else if (currentStep == DonationStep.OTPVerification)
                    {
                        <div class="form-step">
                            <button class="back-link" @onclick="GoBackToPhoneEntry">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                                </svg>
                                Back
                            </button>

                            <h2 class="form-title">Verify Your Number</h2>
                            <p class="form-subtitle">Enter the OTP sent to +233@phoneNumber</p>

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-error">@errorMessage</div>
                            }

                            <div class="form-group">
                                <label class="form-label">Full Name (Optional)</label>
                                <input type="text" 
                                       class="form-input" 
                                       placeholder="Enter your name"
                                       @bind="donorName" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">OTP Code</label>
                                <input type="text" 
                                       class="form-input otp-input" 
                                       placeholder="000000"
                                       maxlength="6"
                                       @bind="otpCode"
                                       @onkeypress="HandleOTPKeyPress" />
                            </div>

                            <button class="primary-btn" 
                                    @onclick="VerifyOTP"
                                    disabled="@(isProcessing)">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span>Verifying...</span>
                                }
                                else
                                {
                                    <span>Verify & Continue</span>
                                }
                            </button>

                            <button class="text-link" @onclick="ResendOTP" disabled="@isProcessing">
                                Resend OTP
                            </button>
                        </div>
                    }
                    else if (currentStep == DonationStep.DonationDetails)
                    {
                        <div class="form-step">
                            <button class="back-link" @onclick="GoBackToOTP">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                                </svg>
                                Back
                            </button>

                            <div class="donor-welcome">
                                <div class="donor-avatar">
                                    @if (!string.IsNullOrEmpty(verifiedDonor?.FullName))
                                    {
                                        <span>@verifiedDonor.FullName.Substring(0, 1).ToUpper()</span>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="12" cy="7" r="4"></circle>
                                        </svg>
                                    }
                                </div>
                                <div>
                                    <h2 class="form-title">Hello, @(!string.IsNullOrEmpty(verifiedDonor?.FullName) ? verifiedDonor.FullName : "Friend")!</h2>
                                    <p class="form-subtitle">Complete your donation</p>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-error">@errorMessage</div>
                            }

                            <div class="form-group">
                                <label class="form-label">Mobile Money Network</label>
                                <div class="network-grid">
                                    @foreach (var network in networks)
                                    {
                                        <div class="network-card @(selectedNetwork == network ? "selected" : "")" 
                                             @onclick="() => selectedNetwork = network">
                                            <div class="network-check">
                                                @if (selectedNetwork == network)
                                                {
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                                        <polyline points="20 6 9 17 4 12"></polyline>
                                                    </svg>
                                                }
                                            </div>
                                            <span class="network-name">@network</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Donation Amount (GH₵)</label>
                                <div class="amount-buttons">
                                    @foreach (var preset in presetAmounts)
                                    {
                                        <button class="amount-btn @(donationAmount == preset ? "selected" : "")"
                                                @onclick="() => donationAmount = preset">
                                            GH₵ @preset
                                        </button>
                                    }
                                </div>
                                <input type="number" 
                                       class="form-input amount-input" 
                                       placeholder="Enter custom amount"
                                       step="0.01"
                                       min="1"
                                       @bind="donationAmount" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">Message (Optional)</label>
                                <textarea class="form-textarea" 
                                          rows="3"
                                          placeholder="Leave a message of support..."
                                          @bind="donationMessage"></textarea>
                            </div>

                            <div class="form-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" @bind="isAnonymous" />
                                    <span class="checkbox-text">Make this donation anonymous</span>
                                </label>
                            </div>

                            <button class="primary-btn donate-btn" 
                                    @onclick="SubmitDonation"
                                    disabled="@(!CanSubmitDonation())">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span>Processing...</span>
                                }
                                else
                                {
                                    <span>Donate GH₵ @donationAmount.ToString("N2")</span>
                                }
                            </button>
                        </div>
                    }
                    else if (currentStep == DonationStep.Success)
                    {
                        <div class="success-state">
                            <div class="success-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                </svg>
                            </div>
                            <h2>Thank You!</h2>
                            <p class="success-message">
                                Your donation of <strong>GH₵ @donationAmount.ToString("N2")</strong> has been initiated.
                                Please complete the payment on your phone.
                            </p>
                            <div class="success-actions">
                                <button class="primary-btn" @onclick="MakeAnotherDonation">
                                    Make Another Donation
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="donate-footer">
        <p>Powered by Nsawa • Secure donations</p>
    </div>
</div>

@code {
    [Parameter]
    public Guid EventId { get; set; }

    private enum DonationStep
    {
        PhoneEntry,
        OTPVerification,
        DonationDetails,
        Success
    }

    private EventViewModel eventDetails;
    private DonationStep currentStep = DonationStep.PhoneEntry;
    
    private string phoneNumber = string.Empty;
    private string otpCode = string.Empty;
    private string donorName = string.Empty;
    private DonorViewModel verifiedDonor;
    
    private List<string> networks = new() { "MTN", "Vodafone", "AirtelTigo" };
    private string selectedNetwork = string.Empty;
    private double donationAmount = 0;
    private string donationMessage = string.Empty;
    private bool isAnonymous = false;
    
    private List<double> presetAmounts = new() { 10, 20, 50, 100, 200, 500 };
    
    private bool isLoadingEvent = true;
    private bool isProcessing = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEventDetails();
    }

    private async Task LoadEventDetails()
    {
        try
        {
            isLoadingEvent = true;
            var result = await ApiClient.EventAsync(EventId);
            
            if (result.Success && result.Data != null)
            {
                eventDetails = result.Data;
            }
        }
        catch (Exception)
        {
            eventDetails = null;
        }
        finally
        {
            isLoadingEvent = false;
        }
    }

    private async Task RequestOTP()
    {
        if (phoneNumber.Length != 9)
        {
            errorMessage = "Please enter a valid 9-digit phone number.";
            return;
        }

        try
        {
            isProcessing = true;
            errorMessage = string.Empty;

            var fullPhoneNumber = $"233{phoneNumber}";
            var requestDto = new RequestOTPDto { PhoneNumber = fullPhoneNumber };
            var result = await ApiClient.RequestOTP2Async(requestDto);

            if (result.Success)
            {
                currentStep = DonationStep.OTPVerification;
            }
            else
            {
                errorMessage = result.Message ?? "Failed to send OTP. Please try again.";
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                400 => "Invalid phone number format.",
                429 => "Too many requests. Please try again later.",
                500 => "Server error. Please try again.",
                _ => "Failed to send OTP. Please try again."
            };
        }
        catch (Exception)
        {
            errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task VerifyOTP()
    {
        // if (otpCode.Length != 6)
        // {
        //     errorMessage = "Please enter a valid 6-digit OTP code.";
        //     return;
        // }

        try
        {
            isProcessing = true;
            errorMessage = string.Empty;

            var fullPhoneNumber = $"233{phoneNumber}";
            var verifyDto = new VerifyOTPDto 
            { 
                PhoneNumber = fullPhoneNumber,
                Otp = otpCode,
                FullName = string.IsNullOrWhiteSpace(donorName) ? null : donorName
            };

            var result = await ApiClient.VerifyOTP2Async(verifyDto);

            if (result.Success && result.Data != null)
            {
                verifiedDonor = result.Data;
                currentStep = DonationStep.DonationDetails;
            }
            else
            {
                errorMessage = result.Message ?? "Invalid OTP. Please try again.";
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                400 => "Invalid or expired OTP.",
                404 => "OTP not found. Please request a new one.",
                500 => "Server error. Please try again.",
                _ => "Failed to verify OTP. Please try again."
            };
        }
        catch (Exception)
        {
            errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ResendOTP()
    {
        otpCode = string.Empty;
        await RequestOTP();
    }

    private bool CanSubmitDonation()
    {
        return !isProcessing 
               && !string.IsNullOrWhiteSpace(selectedNetwork)
               && donationAmount >= 1
               && verifiedDonor != null;
    }

    private async Task SubmitDonation()
    {
        if (!CanSubmitDonation()) return;

        try
        {
            isProcessing = true;
            errorMessage = string.Empty;

            var donationDto = new DonationDto
            {
                EventId = EventId,
                DonorId = verifiedDonor.Id,
                Amount = donationAmount,
                Network = selectedNetwork,
                Message = string.IsNullOrWhiteSpace(donationMessage) ? null : donationMessage,
                Anonymous = isAnonymous,
                DonorName = isAnonymous ? "Anonymous" : verifiedDonor.FullName,
                GroupId = null
            };

            var result = await ApiClient.DonateAsync(donationDto);

            if (result.Success && result.Data != null)
            {
                currentStep = DonationStep.Success;
                
                // Open payment URL in new tab if available
                if (!string.IsNullOrEmpty(result.Data.PayUrl))
                {
                    await Task.Delay(1000);
                    Navigation.NavigateTo(result.Data.PayUrl, true);
                }
            }
            else
            {
                errorMessage = result.Message ?? "Failed to process donation. Please try again.";
            }
        }
        catch (ApiException apiEx)
        {
            errorMessage = apiEx.StatusCode switch
            {
                400 => "Invalid donation details. Please check your information.",
                404 => "Event not found or is no longer accepting donations.",
                500 => "Server error. Please try again.",
                _ => "Failed to process donation. Please try again."
            };
        }
        catch (Exception)
        {
            errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void GoBackToPhoneEntry()
    {
        currentStep = DonationStep.PhoneEntry;
        otpCode = string.Empty;
        errorMessage = string.Empty;
    }

    private void GoBackToOTP()
    {
        currentStep = DonationStep.OTPVerification;
        selectedNetwork = string.Empty;
        donationAmount = 0;
        donationMessage = string.Empty;
        isAnonymous = false;
        errorMessage = string.Empty;
    }

    private void MakeAnotherDonation()
    {
        currentStep = DonationStep.DonationDetails;
        selectedNetwork = string.Empty;
        donationAmount = 0;
        donationMessage = string.Empty;
        isAnonymous = false;
        errorMessage = string.Empty;
    }

    private void HandlePhoneKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && phoneNumber.Length == 9)
        {
            RequestOTP();
        }
    }

    private void HandleOTPKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && otpCode.Length == 6)
        {
            VerifyOTP();
        }
    }
}

<style>
    :root {
        --brand: #2563eb;        
        --brand-soft: #eef2ff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border: #e5e7eb;
        --bg-page: #f8fafc;
        --bg-card: #ffffff;
        --success: #16a34a;
        --danger: #dc2626;
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: var(--bg-page);
        color: var(--text-main);
    }

    /* Page shell */
    .donate-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .donate-header {
        padding: 18px;
        display: flex;
        justify-content: center;
        background: white;
        border-bottom: 1px solid var(--border);
    }

    .logo img {
        height: 36px;
    }

    /* Container */
    .donate-container {
        flex: 1;
        display: flex;
        justify-content: center;
        padding: 32px 16px;
    }

    /* Card */
    .donate-content {
        background: var(--bg-card);
        max-width: 980px;
        width: 100%;
        border-radius: 14px;
        overflow: hidden;
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        /*box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);*/
    }

    /* Event section */
    .event-banner-section {
        position: relative;
        background: #0f172a;
    }

    .event-banner-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .event-info-overlay {
        position: absolute;
        inset: auto 0 0 0;
        padding: 28px;
        background: linear-gradient(to top, rgba(15,23,42,.85), transparent);
        color: white;
    }

    .event-title {
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .event-location,
    .event-date {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        opacity: .9;
    }

    .event-location svg,
    .event-date svg {
        width: 14px;
        height: 14px;
    }

    /* Form area */
    .donation-form-section {
        padding: 36px 32px;
    }

    .form-title {
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .form-subtitle {
        font-size: 14px;
        color: var(--text-muted);
        margin-bottom: 24px;
    }

    /* Back link */
    .back-link {
        background: none;
        border: none;
        color: var(--brand);
        font-weight: 600;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 16px;
        cursor: pointer;
    }
    .text-link{
        background: none;
        border: none;
        color: var(--brand);
        font-weight: 600;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 16px;
        margin-top: 20px;
        cursor: pointer;
    }

    /* Inputs */
    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 6px;
        display: block;
    }

    .form-input,
    .form-textarea {
        width: 100%;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid var(--border);
        font-size: 14px;
        transition: border .15s, box-shadow .15s;
    }

    .form-input:focus,
    .form-textarea:focus {
        outline: none;
        border-color: var(--brand);
        box-shadow: 0 0 0 3px rgba(37,99,235,.12);
    }

    .phone-input-group {
        display: flex;
        gap: 8px;
    }

    .phone-prefix {
        padding: 0 14px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #f1f5f9;
        font-weight: 600;
        font-size: 14px;
    }

    /* OTP */
    .otp-input {
        text-align: center;
        font-size: 20px;
        letter-spacing: 6px;
        font-weight: 700;
    }

    /* Networks */
    .network-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .network-card {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px;
        text-align: center;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        transition: all .15s;
    }

    .network-card:hover {
        border-color: var(--brand);
    }

    .network-card.selected {
        border-color: var(--brand);
        background: var(--brand-soft);
        color: var(--brand);
    }

    /* Amount buttons */
    .amount-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

    .amount-btn {
        padding: 8px 14px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: white;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
    }

    .amount-btn.selected {
        background: var(--brand);
        color: white;
        border-color: var(--brand);
    }

    /* Primary buttons */
    .primary-btn {
        width: 100%;
        margin-top: 8px;
        padding: 14px;
        border-radius: 12px;
        border: none;
        background: var(--brand);
        color: white;
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
    }

    .primary-btn:disabled {
        opacity: .6;
        cursor: not-allowed;
    }

    /* Alerts */
    .alert-error {
        background: #fef2f2;
        color: var(--danger);
        border: 1px solid #fecaca;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 13px;
        margin-bottom: 16px;
    }

    /* Success */
    .success-state {
        text-align: center;
        padding: 40px 10px;
    }

    .success-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #dcfce7;
        color: var(--success);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
    }

    /* Footer */
    .donate-footer {
        text-align: center;
        font-size: 12px;
        color: var(--text-muted);
        padding: 14px;
    }

    
    
    @@media (max-width: 1024px) {
    .donate-content {
        grid-template-columns: 1fr;
    }

    .event-banner-section {
        height: 260px;
